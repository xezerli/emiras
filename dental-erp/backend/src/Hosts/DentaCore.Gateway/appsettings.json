{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "Gateway": {
    "RequestsPerMinute": 600,
    "AuthRequestsPerMinute": 30,
    "MaxRequestBodyBytes": 10485760,
    "ForwardTenantHeader": false,
    "TrustedProxies": []
  },
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/v1/auth/{**rest}" } },
      "identity-admin": { "ClusterId": "identity", "Match": { "Path": "/v1/{resource:regex(^(users|roles)$)}/{**rest}" } },
      "clinic-core": { "ClusterId": "clinic-core", "Match": { "Path": "/v1/{resource:regex(^(patients|appointments|queue|waitlist|visits|treatment-plans|clinical-notes|prescriptions|procedure-codes|dashboard|sync)$)}/{**rest}" } },
      "search": { "ClusterId": "clinic-core", "Match": { "Path": "/v1/search/{**rest}" } },
      "audit": { "ClusterId": "clinic-core", "Match": { "Path": "/v1/admin/audit" } },
      "billing": { "ClusterId": "billing", "Match": { "Path": "/v1/{resource:regex(^(services|invoices|payments|cash-shifts)$)}/{**rest}" } },
      "notify": { "ClusterId": "notify", "Match": { "Path": "/hubs/{**rest}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity-api:8080/" } } },
      "clinic-core": { "Destinations": { "d1": { "Address": "http://clinic-core-api:8080/" } } },
      "billing": { "Destinations": { "d1": { "Address": "http://billing-api:8080/" } } },
      "notify": { "Destinations": { "d1": { "Address": "http://notify-api:8080/" } } }
    }
  }
}
