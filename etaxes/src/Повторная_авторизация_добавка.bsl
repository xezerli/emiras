
// ============================================================================
// Повторная авторизация при 401 (токен отклонён или истёк) и диагностика срока токена
// ============================================================================

Функция ВыполнитьЗапросСПовторнойАвторизацией(ПараметрыЗапроса)

	HTTPОтвет = ВыполнитьHTTPЗапрос(ПараметрыЗапроса);

	Если HTTPОтвет <> Неопределено И HTTPОтвет.КодСостояния = 401 Тогда

		Сообщить(НСтр("ru = 'Портал отклонил токен (401). '; az = 'Portal tokeni rədd etdi (401). '") + ПолучитьОписаниеСрокаТокена(Токен));

		Если ПереавторизоватьсяПриОтказе() Тогда
			ПодставитьЗаголовокТокенаАвторизации(ПараметрыЗапроса.Заголовки, Токен);
			HTTPОтвет = ВыполнитьHTTPЗапрос(ПараметрыЗапроса);
		КонецЕсли;

	КонецЕсли;

	Возврат HTTPОтвет;

КонецФункции

Функция ПереавторизоватьсяПриОтказе()

	Если ЗначениеЗаполнено(Организация) Тогда
		СохранитьЗначение("Обработка.ВзаимодействиеСПорталомETaxes.Токен." + КлючОрганизации(Организация), "");
	КонецЕсли;

	Токен = "";
	ТокенСессии = "";
	ОрганизацияТокена = Неопределено;

	Возврат ВойтиДляОрганизации(Организация);

КонецФункции

// Возвращает срок действия JWT из поля exp (для диагностики ошибки 401)
Функция ПолучитьОписаниеСрокаТокена(ТокенОписания) Экспорт

	Попытка

		Значение = СтрЗаменить(ТокенОписания, "Bearer ", "");

		Позиция = Найти(Значение, ".");
		Остаток = Сред(Значение, Позиция + 1);
		Позиция = Найти(Остаток, ".");
		Полезная = Лев(Остаток, Позиция - 1);

		Полезная = СтрЗаменить(СтрЗаменить(Полезная, "-", "+"), "_", "/");
		Пока СтрДлина(Полезная) % 4 <> 0 Цикл
			Полезная = Полезная + "=";
		КонецЦикла;

		Текст = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Полезная), КодировкаТекста.UTF8);
		Данные = ПолучитьЗначениеИзJSON(Текст);

		Срок = БезопасноеПолучениеЗначения(Данные, "exp", 0);
		ДатаСрока = '19700101' + Срок;

		Возврат НСтр("ru = 'Токен действителен до (UTC): '; az = 'Token bu vaxta qədər etibarlıdır (UTC): '") + Формат(ДатаСрока, "ДФ='dd.MM.yyyy HH:mm:ss'")
			+ "; " + НСтр("ru = 'сейчас (UTC): '; az = 'indi (UTC): '") + Формат(ТекущаяУниверсальнаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'");

	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции
