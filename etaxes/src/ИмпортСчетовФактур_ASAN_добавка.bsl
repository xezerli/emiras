
// ============================================================================
// Вход через ASAN İmza без отдельных форм: диалоги ввода и выбор субъекта.
// Заменяет форму "Авторизация" и "Выбор субъекта" компонента ETaxes.
// ============================================================================

// Вход для выбранной организации: сохранённый токен, иначе вход через ASAN İmza.
// Номер телефона, ID и токен запоминаются отдельно для каждой организации.
Функция ВойтиДляОрганизации(ВыбраннаяОрганизация) Экспорт

	Если Не ЗначениеЗаполнено(ВыбраннаяОрганизация) Тогда
		Сообщить(НСтр("ru = 'Сначала выберите организацию.'; az = 'Əvvəlcə təşkilatı seçin.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ВыбраннаяОрганизация = ОрганизацияТокена И ЗначениеЗаполнено(Токен) Тогда
		Возврат Истина;
	КонецЕсли;

	Ключ = КлючОрганизации(ВыбраннаяОрганизация);

	Токен = ВосстановитьЗначение("Обработка.ВзаимодействиеСПорталомETaxes.Токен." + Ключ);
	Если ЗначениеЗаполнено(Токен) И ПроверитьАктуальностьТокена(Токен) Тогда
		ОрганизацияТокена = ВыбраннаяОрганизация;
		Возврат Истина;
	КонецЕсли;

	Токен = "";
	ТокенСессии = "";
	ОрганизацияТокена = Неопределено;

	Если ВыполнитьВходЧерезASAN(ВыбраннаяОрганизация, Ключ) Тогда
		СохранитьЗначение("Обработка.ВзаимодействиеСПорталомETaxes.Токен." + Ключ, Токен);
		ОрганизацияТокена = ВыбраннаяОрганизация;
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция КлючОрганизации(ВыбраннаяОрганизация)

	Возврат СтрЗаменить(Строка(ВыбраннаяОрганизация.УникальныйИдентификатор()), "-", "_");

КонецФункции

Функция ВыполнитьВходЧерезASAN(ВыбраннаяОрганизация, Ключ)

	НомерТелефона = "";
	IDПользователя = "";

	Настройки = ВосстановитьЗначение("Обработка.ВзаимодействиеСПорталомETaxes.Настройки." + Ключ);
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство("НомерТелефона", НомерТелефона);
		Настройки.Свойство("IDПользователя", IDПользователя);
	КонецЕсли;

	НазваниеОрганизации = Строка(ВыбраннаяОрганизация);

	Если Не ВвестиСтроку(НомерТелефона, НСтр("ru = 'ASAN İmza (организация: '; az = 'ASAN İmza (təşkilat: '") + НазваниеОрганизации + НСтр("ru = '). Номер телефона (+994...)'; az = '). Telefon nömrəsi (+994...)'"), 20, Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ВвестиСтроку(IDПользователя, НСтр("ru = 'ASAN İmza (организация: '; az = 'ASAN İmza (təşkilat: '") + НазваниеОрганизации + НСтр("ru = '). ID пользователя'; az = '). İstifadəçi ID-si'"), 20, Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("НомерТелефона", НомерТелефона);
	Настройки.Вставить("IDПользователя", IDПользователя);
	СохранитьЗначение("Обработка.ВзаимодействиеСПорталомETaxes.Настройки." + Ключ, Настройки);

	ПараметрыАвторизации = Новый Структура;
	ПараметрыАвторизации.Вставить("СпособАвторизации", "ASAN");
	ПараметрыАвторизации.Вставить("НомерТелефона", НомерТелефона);
	ПараметрыАвторизации.Вставить("IDПользователя", IDПользователя);

	Токен = "";
	ТокенСессии = "";
	АвторизацияНаПорталеETaxes(ПараметрыАвторизации);

	Если Не ЗначениеЗаполнено(Токен) Тогда
		Сообщить(НСтр("ru = 'Ошибка авторизации пользователя.'; az = 'İstifadəçinin avtorizasiyası zamanı səhv.'"));
		Возврат Ложь;
	КонецЕсли;

	Субъекты = ПолучитьСписокДоступныхСубъектов();

	Если Субъекты.Количество() = 0 Тогда
		Сообщить(НСтр("ru = 'Не найдено доступных субъектов.'; az = 'Əlçatan subyekt tapılmadı.'"));
		Возврат Ложь;
	КонецЕсли;

	Если Субъекты.Количество() = 1 Тогда
		ВыбранныйСубъект = Субъекты[0];
	Иначе
		ВыбранныйСубъект = Субъекты.ВыбратьЭлемент(НСтр("ru = 'Выберите субъект, от лица которого вы проводите операцию'; az = 'Təmsil etdiyiniz subyekti seçin'"));
	КонецЕсли;

	Если ВыбранныйСубъект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат УстановитьСубъект(ВыбранныйСубъект.Значение);

КонецФункции

// Проверяет, что сохранённый токен ещё действителен
Функция ПроверитьАктуальностьТокена(ТокенПроверки) Экспорт

	ТокенСессии = ТокенПроверки;

	ПараметрыЗапроса = НоваяСтруктураПараметровЗапроса();
	ПараметрыЗапроса.HTTPМетод = "GET";
	ПараметрыЗапроса.АдресРесурса = "/api/po/invoice/public/v1/invoice/is-on-approval-list";
	ПодставитьЗаголовокТокенаАвторизации(ПараметрыЗапроса.Заголовки, ТокенСессии);

	HTTPОтвет = ВыполнитьHTTPЗапрос(ПараметрыЗапроса);

	Возврат HTTPОтвет <> Неопределено И HTTPОтвет.КодСостояния = 200;

КонецФункции

Процедура ВыходИзПорталаETaxes(ТокенВыхода) Экспорт

	Если ЗначениеЗаполнено(ОрганизацияТокена) Тогда
		СохранитьЗначение("Обработка.ВзаимодействиеСПорталомETaxes.Токен." + КлючОрганизации(ОрганизацияТокена), "");
	КонецЕсли;

	ОрганизацияТокена = Неопределено;
	ТокенСессии = "";
	Токен = "";

КонецПроцедуры
