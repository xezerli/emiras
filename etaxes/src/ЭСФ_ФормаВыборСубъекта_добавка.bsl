
// Выбор варианта (входящие/исходящие) и периода, затем вывод списка счетов-фактур
Процедура ПоказатьСчетаФактурыСВыборомПараметров()

	Варианты = Новый СписокЗначений;
	Варианты.Добавить("inbox", НСтр("ru = 'Входящие счета-фактуры'; az = 'Gələn hesab-fakturalar'"));
	Варианты.Добавить("outbox", НСтр("ru = 'Исходящие счета-фактуры'; az = 'Göndərilən hesab-fakturalar'"));

	Выбор = Варианты.ВыбратьЭлемент(НСтр("ru = 'Вариант'; az = 'Variant'"));
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДатаС = НачалоГода(ТекущаяДата());
	ДатаПо = ТекущаяДата();

	Если Не ВвестиДату(ДатаС, НСтр("ru = 'Период с'; az = 'Dövr (başlanğıc)'"), ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;

	Если Не ВвестиДату(ДатаПо, НСтр("ru = 'Период по'; az = 'Dövr (son)'"), ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЭСФ(ДатаС, ДатаПо, Выбор.Значение);

КонецПроцедуры
