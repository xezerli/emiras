
// ============================================================================
// Входящие электронные счета-фактуры (e-qaimə): POST /api/po/invoice/public/v2/invoice/find.inbox
// Использует ТокенСессии, полученный после авторизации и выбора субъекта.
// ============================================================================

Функция ПолучитьВходящиеЭСФ(ДатаС, ДатаПо) Экспорт

	Возврат ПолучитьЭСФ(ДатаС, ДатаПо, "inbox");

КонецФункции

// Вариант: "inbox" - входящие, "outbox" - исходящие
Функция ПолучитьЭСФ(ДатаС, ДатаПо, Вариант) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"), НСтр("ru = 'Дата создания'; az = 'Yaradılma tarixi'"));
	Таблица.Колонки.Добавить("Серия", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Серия и номер'; az = 'Seriya və nömrə'"));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Статус'; az = 'Status'"));
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Тип'; az = 'Tip'"));
	Таблица.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Вид'; az = 'Növ'"));
	Таблица.Колонки.Добавить("ВОЭНОтправителя", Новый ОписаниеТипов("Строка"), НСтр("ru = 'ВÖEN отправителя'; az = 'Göndərənin VÖEN-i'"));
	Таблица.Колонки.Добавить("Отправитель", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Отправитель'; az = 'Göndərən'"));
	Таблица.Колонки.Добавить("ВОЭНПолучателя", Новый ОписаниеТипов("Строка"), НСтр("ru = 'ВÖEN получателя'; az = 'Alıcının VÖEN-i'"));
	Таблица.Колонки.Добавить("Получатель", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Получатель'; az = 'Alıcı'"));
	Таблица.Колонки.Добавить("СуммаСНДС", Новый ОписаниеТипов("Число"), НСтр("ru = 'Сумма с НДС'; az = 'Yekun məbləğ'"));
	Таблица.Колонки.Добавить("СуммаБезНДС", Новый ОписаниеТипов("Число"), НСтр("ru = 'Сумма без НДС'; az = 'ƏDV-siz məbləğ'"));
	Таблица.Колонки.Добавить("НДС", Новый ОписаниеТипов("Число"), НСтр("ru = 'НДС'; az = 'ƏDV'"));
	Таблица.Колонки.Добавить("Основание", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Основание'; az = 'Əsas'"));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Идентификатор'; az = 'İD'"));

	Если Не ЗначениеЗаполнено(ТокенСессии) Тогда
		Сообщить(НСтр("ru = 'Нет токена авторизации. Сначала выполните вход и выберите субъект.'; az = 'Avtorizasiya tokeni yoxdur. Əvvəlcə daxil olun və subyekti seçin.'"));
		Возврат Таблица;
	КонецЕсли;

	// creationDateTo — верхняя граница, поэтому берём начало следующего дня
	ДатаНачала = НачалоДня(ДатаС);
	ДатаОкончания = НачалоДня(ДатаПо) + 86400;
	РазмерСтраницы = 50;
	Смещение = 0;

	Для НомерСтраницы = 1 По 400 Цикл

		// JSON собираем вручную: ЗаписатьJSON не принимает значение Null
		ТелоЗапроса = "{""sortBy"":""creationDate"",""sortAsc"":true,"
			+ """actionOwner"":null,""amountFrom"":null,""amountTo"":null,"
			+ """creationDateFrom"":""" + Формат(ДатаНачала, "ДФ='dd-MM-yyyy HH:mm'") + ""","
			+ """creationDateTo"":""" + Формат(ДатаОкончания, "ДФ='dd-MM-yyyy HH:mm'") + ""","
			+ """kinds"":" + МассивВJSON(МассивВидовЭСФ()) + ","
			+ """statuses"":" + МассивВJSON(МассивСтатусовЭСФ()) + ","
			+ """types"":[""current"",""corrected""],"
			+ """maxCount"":" + XMLСтрока(РазмерСтраницы) + ","
			+ """offset"":" + XMLСтрока(Смещение) + ","
			+ """productCode"":null,""productName"":null,""receiverName"":null,""receiverTin"":null,"
			+ """senderName"":null,""senderTin"":null,""serialNumber"":null}";

		ПараметрыЗапроса = НоваяСтруктураПараметровЗапроса();
		ПараметрыЗапроса.HTTPМетод = "POST";
		ПараметрыЗапроса.АдресРесурса = "/api/po/invoice/public/v2/invoice/find." + Вариант;
		ПараметрыЗапроса.ТелоЗапроса = ТелоЗапроса;
		ПодставитьЗаголовокТокенаАвторизации(ПараметрыЗапроса.Заголовки, ТокенСессии);

		HTTPОтвет = ВыполнитьHTTPЗапрос(ПараметрыЗапроса);

		Если HTTPОтвет = Неопределено Или HTTPОтвет.КодСостояния <> 200 Тогда
			СообщитьОтветПортала(HTTPОтвет, НСтр("ru = 'Ошибка получения списка ЭСФ.'; az = 'Hesab-fakturaların siyahısını alan zamanı səhv.'"));
			Сообщить(НСтр("ru = 'Отправленное тело запроса: '; az = 'Göndərilən sorğu gövdəsi: '") + ТелоЗапроса);
			Прервать;
		КонецЕсли;

		Данные = ПолучитьЗначениеИзJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		Счета = БезопасноеПолучениеЗначения(Данные, "invoices", Неопределено);

		Если ТипЗнч(Счета) <> Тип("Массив") Тогда
			Прервать;
		КонецЕсли;

		Для Каждого ДанныеСчета Из Счета Цикл

			Отправитель = БезопасноеПолучениеЗначения(ДанныеСчета, "sender", Неопределено);
			Получатель = БезопасноеПолучениеЗначения(ДанныеСчета, "receiver", Неопределено);

			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.ДатаСоздания = ДатаИзСтрокиПортала(ЗначениеИлиПусто(ДанныеСчета, "createdAt"));
			НоваяСтрока.Серия = ЗначениеИлиПусто(ДанныеСчета, "serialNumber");
			НоваяСтрока.Статус = ПредставлениеКодаЭСФ("status", ЗначениеИлиПусто(ДанныеСчета, "status"));
			НоваяСтрока.Тип = ПредставлениеКодаЭСФ("type", ЗначениеИлиПусто(ДанныеСчета, "type"));
			НоваяСтрока.Вид = ПредставлениеКодаЭСФ("kind", ЗначениеИлиПусто(ДанныеСчета, "kind"));
			НоваяСтрока.ВОЭНОтправителя = ЗначениеИлиПусто(Отправитель, "tin");
			НоваяСтрока.Отправитель = ЗначениеИлиПусто(Отправитель, "name");
			НоваяСтрока.ВОЭНПолучателя = ЗначениеИлиПусто(Получатель, "tin");
			НоваяСтрока.Получатель = ЗначениеИлиПусто(Получатель, "name");
			НоваяСтрока.СуммаСНДС = ЧислоИлиНоль(ДанныеСчета, "amount");
			НоваяСтрока.СуммаБезНДС = ЧислоИлиНоль(ДанныеСчета, "costWithoutVat");
			НоваяСтрока.НДС = ЧислоИлиНоль(ДанныеСчета, "vat");
			НоваяСтрока.Основание = СокрЛП(ЗначениеИлиПусто(ДанныеСчета, "invoiceComment") + " " + ЗначениеИлиПусто(ДанныеСчета, "invoiceComment2"));
			НоваяСтрока.Идентификатор = ЗначениеИлиПусто(ДанныеСчета, "id");

		КонецЦикла;

		Если БезопасноеПолучениеЗначения(Данные, "hasMore", Ложь) <> Истина Тогда
			Прервать;
		КонецЕсли;

		Смещение = Смещение + РазмерСтраницы;

	КонецЦикла;

	Таблица.Сортировать("ДатаСоздания Убыв");

	Возврат Таблица;

КонецФункции

Процедура ПоказатьВходящиеЭСФ(ДатаС, ДатаПо) Экспорт

	ПоказатьЭСФ(ДатаС, ДатаПо, "inbox");

КонецПроцедуры

Процедура ПоказатьЭСФ(ДатаС, ДатаПо, Вариант) Экспорт

	Таблица = ПолучитьЭСФ(ДатаС, ДатаПо, Вариант);

	Если Таблица.Количество() = 0 Тогда
		Сообщить(НСтр("ru = 'Входящие ЭСФ за период не найдены.'; az = 'Dövr üzrə daxil olan e-qaimə tapılmadı.'"));
		Возврат;
	КонецЕсли;

	ТабДок = Новый ТабличныйДокумент;

	Ширины = Новый Массив;
	Ширины.Добавить(16); Ширины.Добавить(18); Ширины.Добавить(16); Ширины.Добавить(10);
	Ширины.Добавить(14); Ширины.Добавить(13); Ширины.Добавить(34); Ширины.Добавить(13);
	Ширины.Добавить(30); Ширины.Добавить(14); Ширины.Добавить(14); Ширины.Добавить(12);
	Ширины.Добавить(50); Ширины.Добавить(18);

	КоличествоКолонок = Таблица.Колонки.Количество();

	Для Индекс = 0 По КоличествоКолонок - 1 Цикл
		Область = ТабДок.Область(1, Индекс + 1);
		Область.Текст = Таблица.Колонки[Индекс].Заголовок;
		Попытка
			Область.Шрифт = Новый Шрифт(Область.Шрифт, , , Истина);
		Исключение
		КонецПопытки;
		ТабДок.Область(1, Индекс + 1, 1, Индекс + 1).ШиринаКолонки = Ширины[Индекс];
	КонецЦикла;

	НомерСтроки = 1;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерСтроки = НомерСтроки + 1;
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл
			Значение = СтрокаТаблицы[Таблица.Колонки[Индекс].Имя];
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				Текст = Формат(Значение, "ДФ='dd.MM.yyyy HH:mm'");
			ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
				Текст = Формат(Значение, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
			Иначе
				Текст = Значение;
			КонецЕсли;
			ТабДок.Область(НомерСтроки, Индекс + 1).Текст = Текст;
		КонецЦикла;
	КонецЦикла;

	НомерСтроки = НомерСтроки + 1;
	ТабДок.Область(НомерСтроки, 9).Текст = НСтр("ru = 'Итого'; az = 'Cəmi'");
	ТабДок.Область(НомерСтроки, 10).Текст = Формат(Таблица.Итог("СуммаСНДС"), "ЧДЦ=2; ЧРГ=' '");
	ТабДок.Область(НомерСтроки, 11).Текст = Формат(Таблица.Итог("СуммаБезНДС"), "ЧДЦ=2; ЧРГ=' '");
	ТабДок.Область(НомерСтроки, 12).Текст = Формат(Таблица.Итог("НДС"), "ЧДЦ=2; ЧРГ=' '");

	ТабДок.ФиксацияСверху = 1;
	Если Вариант = "outbox" Тогда
		ЗаголовокДокумента = НСтр("ru = 'Исходящие счета-фактуры'; az = 'Göndərilən hesab-fakturalar'");
	Иначе
		ЗаголовокДокумента = НСтр("ru = 'Входящие счета-фактуры'; az = 'Gələn hesab-fakturalar'");
	КонецЕсли;
	ТабДок.Показать(ЗаголовокДокумента + " " + Формат(ДатаС, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаПо, "ДФ=dd.MM.yyyy"));

КонецПроцедуры

// Полные списки значений взяты из внешней обработки импорта счетов-фактур.
Функция МассивВидовЭСФ()

	Возврат МассивИзСтрок("defaultInvoice,agent,resale,recycling,taxCodex163,taxCodex177_5,returnInvoice,returnByAgent,returnRecycled,exportNoteInvoice,exciseGoodsTransfer");

КонецФункции

Функция МассивСтатусовЭСФ()

	Возврат МассивИзСтрок("approved,onApproval,updateApproval,updateRequested,cancelRequested,approvedBySystem,onApprovalEdited,canceled,cancelationRefused,correctionRefused");

КонецФункции

Функция МассивВJSON(Массив)

	Текст = "";
	Для Каждого Элемент Из Массив Цикл
		Текст = Текст + ?(Текст = "", "", ",") + """" + Элемент + """";
	КонецЦикла;
	Возврат "[" + Текст + "]";

КонецФункции

Функция МассивИзСтрок(Знач СтрокаЗначений)

	Результат = Новый Массив;
	Остаток = СтрокаЗначений;
	Пока Не ПустаяСтрока(Остаток) Цикл
		Позиция = Найти(Остаток, ",");
		Если Позиция = 0 Тогда
			Результат.Добавить(СокрЛП(Остаток));
			Прервать;
		КонецЕсли;
		Результат.Добавить(СокрЛП(Лев(Остаток, Позиция - 1)));
		Остаток = Сред(Остаток, Позиция + 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДатаИзСтрокиПортала(Знач Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	// "2026-10-27T14:56:32" -> "20261027145632"
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Текст, 19), "-", ""), "T", ""), ":", "");

	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ЗначениеИлиПусто(Данные, ИмяСвойства)

	Значение = БезопасноеПолучениеЗначения(Данные, ИмяСвойства, "");

	Если Значение = Null Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ЧислоИлиНоль(Данные, ИмяСвойства)

	Значение = БезопасноеПолучениеЗначения(Данные, ИмяСвойства, 0);

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ПредставлениеКодаЭСФ(Группа, Код)

	Словарь = Новый Соответствие;

	Если Группа = "status" Тогда
		Словарь.Вставить("approved", НСтр("ru = 'Подтверждена'; az = 'Təsdiqləndi'"));
		Словарь.Вставить("onApproval", НСтр("ru = 'На подтверждении'; az = 'Təsdiq gözləyir'"));
		Словарь.Вставить("updateApproval", НСтр("ru = 'Подтверждение изменений'; az = 'Düzəliş edildi'"));
		Словарь.Вставить("updateRequested", НСтр("ru = 'Запрос изменения'; az = 'Düzəlişə qaytarıldı'"));
		Словарь.Вставить("cancelRequested", НСтр("ru = 'Запрос отмены'; az = 'Ləğvə göndərildi'"));
		Словарь.Вставить("approvedBySystem", НСтр("ru = 'Подтверждена системой'; az = 'Sistem tərəfindən təsdiqləndi'"));
		Словарь.Вставить("onApprovalEdited", НСтр("ru = 'Отправлено на исправление'; az = 'Düzəlişə göndərildi'"));
		Словарь.Вставить("canceled", НСтр("ru = 'Отменена'; az = 'Ləğv edildi'"));
		Словарь.Вставить("cancelationRefused", НСтр("ru = 'Отмена отклонена'; az = 'Ləğv qəbul edilmədi'"));
		Словарь.Вставить("correctionRefused", НСтр("ru = 'Коррекция отклонена'; az = 'Korreksiya qəbul edilmədi'"));
	ИначеЕсли Группа = "type" Тогда
		Словарь.Вставить("current", НСтр("ru = 'Текущая'; az = 'Cari'"));
		Словарь.Вставить("corrected", НСтр("ru = 'Корректировочная'; az = 'Düzəliş'"));
	ИначеЕсли Группа = "kind" Тогда
		Словарь.Вставить("defaultInvoice", НСтр("ru = 'Предоставление товаров, работ и услуг'; az = 'Malların, işlərin və xidmətlərin təqdim edilməsi'"));
		Словарь.Вставить("agent", НСтр("ru = 'От комитента агенту (комиссионеру)'; az = 'Vəkalətverəndən agentə (komisyonçuya)'"));
		Словарь.Вставить("resale", НСтр("ru = 'От агента (комиссионера) покупателю'; az = 'Agentdən (komisyonçudan) alıcıya'"));
		Словарь.Вставить("recycling", НСтр("ru = 'На переработку или хранение'; az = 'Emala yaxud saxlamaya verilməsi'"));
		Словарь.Вставить("taxCodex163", НСтр("ru = 'По статье 163 НК'; az = 'VM-in 163-cü maddəsinə əsasən'"));
		Словарь.Вставить("taxCodex177_5", НСтр("ru = 'По статье 177.5 НК'; az = 'VM-in 177.5-ci maddəsinə əsasən'"));
		Словарь.Вставить("returnInvoice", НСтр("ru = 'Возврат товаров, работ и услуг'; az = 'Malların qaytarılması'"));
		Словарь.Вставить("returnByAgent", НСтр("ru = 'Возврат агентом комитенту'; az = 'Agent tərəfindən vəkalətverənə qaytarılması'"));
		Словарь.Вставить("returnRecycled", НСтр("ru = 'Возврат с переработки или хранения'; az = 'Emaldan yaxud saxlamadan qaytarılması'"));
		Словарь.Вставить("exportNoteInvoice", НСтр("ru = 'Экспорт товаров'; az = 'Malların ixrac qeydi ilə satışı'"));
		Словарь.Вставить("exciseGoodsTransfer", НСтр("ru = 'Перемещение подакцизных товаров'; az = 'Aksizli malların yerdəyişməsi'"));
	КонецЕсли;

	Представление = Словарь.Получить(Код);

	Возврат ?(Представление = Неопределено, Код, Представление);

КонецФункции
