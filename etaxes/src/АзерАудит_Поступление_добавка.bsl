
// ============================================================================
// Создание "Поступление товаров и услуг" в конфигурациях без реквизита документов
// "СерияИНомерСчетаФактуры" (например, Бухгалтерия Azeraudit). Реквизиты, которых в
// конфигурации нет, пропускаются (ЗаполнитьЗначенияСвойств). Поддерживаются входящие счета-фактуры.
// ============================================================================

// Истина для конфигурации, где данные счёта-фактуры хранятся в справочнике серий и номеров (УПП)
Функция ЭтоКонфигурацияСоСвязаннымиСериямиСФ() Экспорт

	Возврат Метаданные.Документы.ПоступлениеТоваровУслуг.Реквизиты.Найти("СерияИНомерСчетаФактуры") <> Неопределено;

КонецФункции

Функция СоздатьДокументыАзерАудит()

	НовыеКонтрагенты = Новый Соответствие;
	НоваяНоменклатура = Новый Соответствие;
	СозданныеДокументы = Новый Массив;
	Ошибки = Новый Массив;

	ВыбранныеДанные = ТаблицаДокументов.НайтиСтроки(Новый Структура("Пометка", Истина));
	МассивВозвратов = ПолучитьТипыВозвратныхСчетовФактур();

	СчетаФактурыКПропуску = НайтиЗагруженныеПоступленияАзерАудит(ВыбранныеДанные, СозданныеДокументы);

	Для Каждого Данные Из ВыбранныеДанные Цикл

		НомерСФ = Данные.Серия + Данные.Номер;

		Если СчетаФактурыКПропуску.Найти(НомерСФ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДанныеПоТоварам = Товары.НайтиСтроки(Новый Структура("УникальныйИдентификатор", Данные.УникальныйИдентификатор));

		Если ДанныеПоТоварам.Количество() = 0 Тогда
			Ошибки.Добавить(Новый Структура("СерияИНомер", Данные.Серия + " " + Данные.Номер + ": "
				+ НСтр("ru = 'нет товаров (получите данные документа)'; az = 'mal yoxdur (sənədin məlumatlarını alın)'")));
			Продолжить;
		КонецЕсли;

		Если ВариантИмпорта <> "inbox" Или МассивВозвратов.Найти(Данные.Вид) <> Неопределено Тогда
			Ошибки.Добавить(Новый Структура("СерияИНомер", Данные.Серия + " " + Данные.Номер + ": "
				+ НСтр("ru = 'в этой конфигурации поддерживается только создание Поступления товаров и услуг по входящим счетам-фактурам'; az = 'bu konfiqurasiyada yalnız daxil olan hesab-fakturalar üzrə Mal və xidmətlərin daxilolması yaradılır'")));
			Продолжить;
		КонецЕсли;

		Попытка
			СоздатьПоступлениеАзерАудит(Данные, ДанныеПоТоварам, НовыеКонтрагенты, НоваяНоменклатура, СозданныеДокументы);
		Исключение
			Ошибки.Добавить(Новый Структура("СерияИНомер", Данные.Серия + " " + Данные.Номер + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Новый Структура("СозданныеДокументы, Ошибки", СозданныеДокументы, Ошибки);

КонецФункции

Функция НайтиЗагруженныеПоступленияАзерАудит(ВыбранныеДанные, СозданныеДокументы)

	Результат = Новый Массив;

	Найденные = НайтиВведенныеПоступленияПоНомерам(ВыбранныеДанные);

	Для Каждого Данные Из ВыбранныеДанные Цикл

		Ссылка = ВведенноеПоступлениеПоСФ(Найденные, Данные);

		Если Ссылка <> Неопределено Тогда
			Результат.Добавить(Данные.Серия + Данные.Номер);
			СозданныеДокументы.Добавить(Новый Структура("СерияИНомер, Документ",
				НСтр("ru = 'В системе уже есть документ'; az = 'Sistemdə artıq sənəd var'") + " " + Данные.Серия + " " + Данные.Номер, Ссылка));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализоватьНомерСФ(Знач Номер)

	Возврат ВРег(СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(Номер), " ", ""), "-", ""), Символы.НПП, ""));

КонецФункции

// Поступления, у которых "Входящий номер" совпадает с серией и номером счёта-фактуры
// (в виде MT261012380322, MT 261012380322 или только номер). Возвращает соответствие
// "нормализованный номер" -> ссылка на документ. Находит и документы, введённые вручную.
Функция НайтиВведенныеПоступленияПоНомерам(СтрокиСФ) Экспорт

	Результат = Новый Соответствие;

	Если Метаданные.Документы.ПоступлениеТоваровУслуг.Реквизиты.Найти("НомерВходящегоДокумента") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Номера = Новый Массив;
	Для Каждого Данные Из СтрокиСФ Цикл
		Номера.Добавить(Данные.Серия + Данные.Номер);
		Номера.Добавить(Данные.Серия + " " + Данные.Номер);
		Номера.Добавить(Данные.Номер);
	КонецЦикла;

	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.НомерВходящегоДокумента КАК Номер
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.НомерВходящегоДокумента В (&Номера)
		|	И НЕ Док.ПометкаУдаления";

	ОтборПоОрганизации = ЗначениеЗаполнено(Организация)
		И Метаданные.Документы.ПоступлениеТоваровУслуг.Реквизиты.Найти("Организация") <> Неопределено;
	Если ОтборПоОрганизации Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И Док.Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номера", Номера);
	Если ОтборПоОрганизации Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(НормализоватьНомерСФ(Выборка.Номер), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВведенноеПоступлениеПоСФ(Найденные, Данные)

	Ссылка = Найденные[НормализоватьНомерСФ(Данные.Серия + Данные.Номер)];

	Если Ссылка = Неопределено Тогда
		Ссылка = Найденные[НормализоватьНомерСФ(Данные.Номер)];
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Подсветка строк списка, по которым в системе уже есть поступление (для конфигураций без УПП-реквизитов)
Процедура ПодсветитьЗагруженныеДокументыАзерАудит(ОформленияСтрок) Экспорт

	Строки = Новый Массив;
	Для Каждого ОформлениеСтроки Из ОформленияСтрок Цикл
		Строки.Добавить(ОформлениеСтроки.ДанныеСтроки);
	КонецЦикла;

	Найденные = НайтиВведенныеПоступленияПоНомерам(Строки);

	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ОформлениеСтроки Из ОформленияСтрок Цикл
		Если ВведенноеПоступлениеПоСФ(Найденные, ОформлениеСтроки.ДанныеСтроки) <> Неопределено Тогда
			ОформлениеСтроки.ЦветФона = WebЦвета.БледноЗеленый;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СоздатьПоступлениеАзерАудит(Данные, ДанныеПоТоварам, НовыеКонтрагенты, НоваяНоменклатура, СозданныеДокументы)

	ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();

	Попытка
		ДокументОбъект.Заполнить(Неопределено);
	Исключение
	КонецПопытки;

	ДокументОбъект.Дата = Данные.Дата;

	Попытка
		ДокументОбъект.УстановитьНовыйНомер();
	Исключение
	КонецПопытки;

	Шапка = Новый Структура;
	Шапка.Вставить("Организация", Организация);
	Шапка.Вставить("Склад", Склад);
	Шапка.Вставить("НомерВходящегоДокумента", Данные.Серия + Данные.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента", Данные.Дата);
	Шапка.Вставить("Комментарий", ПодставитьПараметрыВСтроку(НСтр("ru = 'Создан автоматически %1 %2 от %3'; az = 'Avtomatik olaraq yaradıldı %1 %2 - %3'"), Данные.Серия, Данные.Номер, Формат(Данные.Дата, "ДФ=dd.MM.yy")));
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);

	Контрагент = НайтиИлиСоздатьКонтрагентаАзерАудит(Данные, НовыеКонтрагенты);
	ДокументОбъект.Контрагент = Контрагент;

	Договор = НайтиИлиСоздатьДоговорАзерАудит(Контрагент);
	Если ЗначениеЗаполнено(Договор) Тогда
		ДокументОбъект.ДоговорКонтрагента = Договор;
	КонецЕсли;

	// Если в шапке документа цены вводятся с НДС, добавляем НДС 18% к ценам и суммам портала
	СуммаВключаетНДС = Ложь;
	Попытка
		СуммаВключаетНДС = ДокументОбъект.СуммаВключаетНДС = Истина;
	Исключение
	КонецПопытки;

	ИмеетсяТЧУслуги = Метаданные.Документы.ПоступлениеТоваровУслуг.ТабличныеЧасти.Найти("Услуги") <> Неопределено;

	Для Каждого СтрокаТовара Из ДанныеПоТоварам Цикл

		Номенклатура = НайтиИлиСоздатьНоменклатуруАзерАудит(СтрокаТовара, НоваяНоменклатура);

		Если СтрокаТовара.Услуга И ИмеетсяТЧУслуги Тогда
			НоваяСтрока = ДокументОбъект.Услуги.Добавить();
		Иначе
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
		КонецЕсли;

		БезНДС = СтрокаТовара.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Цена = СтрокаТовара.Цена;
		Сумма = СтрокаТовара.Сумма;
		Если СуммаВключаетНДС И Не БезНДС Тогда
			Цена = Цена + Цена * 18 / 100;
			Сумма = Сумма + Сумма * 18 / 100;
		КонецЕсли;

		ЗначенияСтроки = Новый Структура;
		ЗначенияСтроки.Вставить("Номенклатура", Номенклатура);
		ЗначенияСтроки.Вставить("Количество", СтрокаТовара.Количество);
		ЗначенияСтроки.Вставить("Цена", Цена);
		ЗначенияСтроки.Вставить("Сумма", Сумма);
		ЗначенияСтроки.Вставить("СтавкаНДС", СтрокаТовара.СтавкаНДС);
		ЗначенияСтроки.Вставить("СуммаНДС", СтрокаТовара.СуммаНДС);
		ЗначенияСтроки.Вставить("Содержание", СтрокаТовара.Номенклатура);
		ЗначенияСтроки.Вставить("Склад", Склад);

		Попытка
			ЗначенияСтроки.Вставить("ЕдиницаИзмерения", Номенклатура.ЕдиницаИзмерения);
		Исключение
		КонецПопытки;

		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияСтроки);

	КонецЦикла;

	Если ПроводитьДокументы Тогда
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекстОшибкиПроведения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			Сообщить(НСтр("ru = 'Документ записан, но не проведён: '; az = 'Sənəd yazıldı, lakin keçirilmədi: '") + Данные.Серия + " " + Данные.Номер + ". " + ТекстОшибкиПроведения);
		КонецПопытки;
	Иначе
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	СозданныеДокументы.Добавить(Новый Структура("СерияИНомер, Документ", Данные.Серия + " " + Данные.Номер, ДокументОбъект.Ссылка));

КонецПроцедуры

Функция ИмяРеквизитаИННКонтрагентов()

	Для Каждого Имя Из Новый Структура("ИНН, VOEN, ВОЭН, УНП") Цикл
		Если Метаданные.Справочники.Контрагенты.Реквизиты.Найти(Имя.Ключ) <> Неопределено Тогда
			Возврат Имя.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "ИНН";

КонецФункции

Функция НайтиИлиСоздатьКонтрагентаАзерАудит(Данные, НовыеКонтрагенты)

	Если ЗначениеЗаполнено(Данные.КонтрагентСсылка) Тогда
		Возврат Данные.КонтрагентСсылка;
	КонецЕсли;

	ИмяИНН = ИмяРеквизитаИННКонтрагентов();

	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту(ИмяИНН, Данные.ИНН);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Контрагент;
	КонецЕсли;

	Если НовыеКонтрагенты[Данные.ИНН] <> Неопределено Тогда
		Возврат НовыеКонтрагенты[Данные.ИНН];
	КонецЕсли;

	Объект = Справочники.Контрагенты.СоздатьЭлемент();

	Попытка
		Объект.Заполнить(Неопределено);
	Исключение
	КонецПопытки;

	Объект.Наименование = Данные.Контрагент;

	Значения = Новый Структура;
	Значения.Вставить("НаименованиеПолное", Данные.Контрагент);
	Значения.Вставить(ИмяИНН, Данные.ИНН);
	Значения.Вставить("Поставщик", Истина);
	Если Метаданные.Справочники.Контрагенты.Иерархический И ЗначениеЗаполнено(ГруппаПоставщиков) Тогда
		Значения.Вставить("Родитель", ГруппаПоставщиков);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, Значения);

	Объект.Записать();

	НовыеКонтрагенты.Вставить(Данные.ИНН, Объект.Ссылка);

	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьДоговорАзерАудит(Контрагент)

	Договор = Неопределено;

	Попытка
		Договор = Контрагент.ОсновнойДоговорКонтрагента;
	Исключение
	КонецПопытки;

	Если ЗначениеЗаполнено(Договор) Тогда
		Возврат Договор;
	КонецЕсли;

	Выборка = Справочники.ДоговорыКонтрагентов.Выбрать(, Контрагент);
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ПометкаУдаления Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();

	Попытка
		Объект.Заполнить(Неопределено);
	Исключение
	КонецПопытки;

	Объект.Владелец = Контрагент;
	Объект.Наименование = НСтр("ru = 'Основной договор'; az = 'Əsas müqavilə'");

	Значения = Новый Структура;
	Значения.Вставить("Организация", Организация);
	Попытка
		Значения.Вставить("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	Исключение
	КонецПопытки;
	Попытка
		Значения.Вставить("ВалютаВзаиморасчетов", Константы.ВалютаРегламентированногоУчета.Получить());
	Исключение
	КонецПопытки;
	ЗаполнитьЗначенияСвойств(Объект, Значения);

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьНоменклатуруАзерАудит(СтрокаТовара, НоваяНоменклатура)

	Если ЗначениеЗаполнено(СтрокаТовара.НоменклатураСсылка) Тогда
		Возврат СтрокаТовара.НоменклатураСсылка;
	КонецЕсли;

	Если НоваяНоменклатура[СтрокаТовара.Номенклатура] <> Неопределено Тогда
		Возврат НоваяНоменклатура[СтрокаТовара.Номенклатура];
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование = &Наименование
		|	И НЕ Номенклатура.ПометкаУдаления");
	Запрос.УстановитьПараметр("Наименование", СтрокаТовара.Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НоваяНоменклатура.Вставить(СтрокаТовара.Номенклатура, Выборка.Ссылка);
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Объект = Справочники.Номенклатура.СоздатьЭлемент();

	Попытка
		Объект.Заполнить(Неопределено);
	Исключение
	КонецПопытки;

	Объект.Наименование = СтрокаТовара.Номенклатура;

	ЕдиницаКлассификатора = НайтиИлиСоздатьЕдиницуКлассификатора(СтрокаТовара.ЕдиницаИзмерения);

	Значения = Новый Структура;
	Значения.Вставить("НаименованиеПолное", СтрокаТовара.Номенклатура);
	Значения.Вставить("Услуга", СтрокаТовара.Услуга);
	Значения.Вставить("ВидНоменклатуры", ?(СтрокаТовара.Услуга, ВидНоменклатурыУслуги, ВидНоменклатурыТовары));
	Значения.Вставить("ЕдиницаИзмерения", ЕдиницаКлассификатора);
	Значения.Вставить("БазоваяЕдиницаИзмерения", ЕдиницаКлассификатора);
	Если Метаданные.Справочники.Номенклатура.Иерархический Тогда
		Родитель = ?(СтрокаТовара.Услуга И ЗначениеЗаполнено(ГруппаНоменклатурыУслуга), ГруппаНоменклатурыУслуга, ГруппаНоменклатуры);
		Если ЗначениеЗаполнено(Родитель) Тогда
			Значения.Вставить("Родитель", Родитель);
		КонецЕсли;
	КонецЕсли;

	// Не затираем значения, заполненные по умолчанию, пустыми
	Для Каждого Элемент Из Значения Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Или ТипЗнч(Элемент.Значение) = Тип("Булево") Тогда
			ЗаполнитьЗначенияСвойств(Объект, Новый Структура(Элемент.Ключ, Элемент.Значение));
		КонецЕсли;
	КонецЦикла;

	Объект.Записать();

	НоваяНоменклатура.Вставить(СтрокаТовара.Номенклатура, Объект.Ссылка);

	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьЕдиницуКлассификатора(НаименованиеЕдиницы)

	Единица = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(НаименованиеЕдиницы);

	Если ЗначениеЗаполнено(Единица) Тогда
		Возврат Единица;
	КонецЕсли;

	ЕдиницаОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
	ЕдиницаОбъект.Наименование = НаименованиеЕдиницы;
	ЗаполнитьЗначенияСвойств(ЕдиницаОбъект, Новый Структура("НаименованиеПолное", НаименованиеЕдиницы));
	ЕдиницаОбъект.Записать();

	Возврат ЕдиницаОбъект.Ссылка;

КонецФункции

// Простой вывод результатов загрузки (без общего модуля сообщений УПП)
Процедура ПоказатьРезультатыИмпортаПросто(Результат) Экспорт

	Если Результат.СозданныеДокументы.Количество() > 0 Тогда
		Сообщить(НСтр("ru = 'Созданы документы: '; az = 'Yaradılan sənədlər: '") + Результат.СозданныеДокументы.Количество());
		Для Каждого Элемент Из Результат.СозданныеДокументы Цикл
			Сообщить("  " + Элемент.СерияИНомер + " -> " + Строка(Элемент.Документ));
		КонецЦикла;
	КонецЕсли;

	Если Результат.Ошибки.Количество() > 0 Тогда
		Сообщить(НСтр("ru = 'Не удалось создать: '; az = 'Yaratmaq mümkün olmadı: '") + Результат.Ошибки.Количество());
		Для Каждого Элемент Из Результат.Ошибки Цикл
			Сообщить("  " + Элемент.СерияИНомер);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
