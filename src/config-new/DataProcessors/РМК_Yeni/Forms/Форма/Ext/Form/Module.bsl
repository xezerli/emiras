// Модуль формы РМК_Yeni (управляемая форма, тёмный дизайн).
// Логика перенесена из обычной формы Обработка.РМК2.Форма.Форма.
// Этап 1: поиск/каталог, штрихкод/сканер, таблица чека, скидка, контрагент,
// продавец, продажа (Чек), возврат (Чек возврата), несколько чеков.
// Не перенесено (этап 2/3): подарочные карты, скидочные карты, акции (Компании), быстрый выбор.

&НаКлиенте
Перем Чеки;            // Массив структур отложенных чеков

&НаКлиенте
Перем ПропуститьПервуюАктивизациюГруппы;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПараметрыКаталога = КаталогТоваров.Параметры;
	ПараметрыКаталога.УстановитьЗначениеПараметра("Дата", ТекущаяДата());
	ПараметрыКаталога.УстановитьЗначениеПараметра("ТипЦен", Справочники.ТипыЦен.ПустаяСсылка());
	ПараметрыКаталога.УстановитьЗначениеПараметра("Склад", Справочники.Склады.ПустаяСсылка());
	ПараметрыКаталога.УстановитьЗначениеПараметра("БезГруппы", Истина);
	ПараметрыКаталога.УстановитьЗначениеПараметра("Группа", Справочники.Номенклатура.ПустаяСсылка());
	ПараметрыКаталога.УстановитьЗначениеПараметра("Поиск", "");
	ПараметрыКаталога.УстановитьЗначениеПараметра("ПоискШаблон", "%");

	ЭлементОтбора = ГруппыТоваров.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоГруппа");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПередОткрытием(Отказ)

	Чеки = Новый Массив;
	ПропуститьПервуюАктивизациюГруппы = Истина;

	Пользователь = глПерем.ТекущийПользователь;
	Настройки = ПолучитьНастройкиПользователя(Пользователь);
	Если Настройки.Ошибка <> "" Тогда
		ОбщегоНазначения.Хебердарлыг(Настройки.Ошибка, , НСтр("ru = 'Предупреждение'; az = 'Xəbərdarlıq'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Объект.Автор = Пользователь;
	Объект.Касса = Настройки.Касса;
	Объект.Склад = Настройки.Склад;
	Объект.ТипЦен = Настройки.ТипЦен;
	Объект.Валюта = глПерем.Манат;
	Объект.Курс = 1;
	ПечатьЧек = Настройки.ПечатьЧек;

	ПрименитьПараметрыКаталога();
	НовыйЧекПустой();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии()

	ОбновитьЗаголовокПользователя();
	ТекущийЭлемент = Элементы.ПоискСтрока;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)

	Если Объект.Товары.Количество() > 0 Или Чеки.Количество() > 0 Тогда
		Отказ = Истина;
		Если ОбщегоНазначения.Суал(НСтр("ru = 'Есть непроданные товары. Закрыть РМК?'; az = 'Satılması nəzərdə tutulan mallar var. Bağlansınmı?'")) = КодВозвратаДиалога.Да Тогда
			Объект.Товары.Очистить();
			Чеки.Очистить();
			Закрыть();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)

	глПерем.СканерИзФормы = Истина;
	Если Не ВводДоступен() Тогда
		Возврат;
	КонецЕсли;

	Данные = ТорговоеОборудование.ПолучитьДанныеСканера(Событие);

	Если Источник = "BarCodeScaner" И Событие = "BarCodeValue" Тогда
		Если Не ОбработатьШтрихкодПользователя(Данные) Тогда
			ДобавитьПоШтрихкоду(Данные);
		КонецЕсли;
	ИначеЕсли Событие = "MagneticStripeCardValue" Тогда
		ОбработатьШтрихкодПользователя(Данные);
	КонецЕсли;

	глПерем.Сканер.DeleteEvent();
	глПерем.Сканер.DataEventEnabled = 1;

КонецПроцедуры

#КонецОбласти

#Область НастройкиИЗаголовок

&НаСервере
Функция ПолучитьНастройкиПользователя(Пользователь)

	Результат = Новый Структура("Ошибка, Касса, Склад, ТипЦен, ПечатьЧек", "");
	Результат.Касса = Пользователь.ОсновнаяКасса;
	Результат.Склад = Пользователь.ОсновнойСклад;
	Результат.ТипЦен = Пользователь.РозничныйТипЦен;
	Результат.ПечатьЧек = Пользователь.ПечатьЧек;

	Если Не ЗначениеЗаполнено(Результат.Касса) Тогда
		Результат.Ошибка = НСтр("ru = 'Для продавца не выбрана касса. Обратитесь к администратору!'; az = 'Satıcı üçün kassa seçilməyib. Administratora müraciət edin!'");
	ИначеЕсли Не ЗначениеЗаполнено(Результат.Склад) Тогда
		Результат.Ошибка = НСтр("ru = 'Для продавца не выбран склад. Обратитесь к администратору!'; az = 'Satıcı üçün anbar seçilməyib. Administratora müraciət edin!'");
	ИначеЕсли Не ЗначениеЗаполнено(Результат.ТипЦен) Тогда
		Результат.Ошибка = НСтр("ru = 'Для продавца не выбран розничный тип цен. Обратитесь к администратору!'; az = 'Satıcı üçün pərakəndə satış tipi seçilməyib. Administratora müraciət edin!'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПрименитьПараметрыКаталогаНаСервере(ТипЦен, Склад)

	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("Дата", ТекущаяДата());
	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("ТипЦен", ТипЦен);
	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("Склад", Склад);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПараметрыКаталога()
	ПрименитьПараметрыКаталогаНаСервере(Объект.ТипЦен, Объект.Склад);
КонецПроцедуры

&НаСервере
Функция ПредставлениеНастроек(Автор, Касса, Склад)
	Возврат НСтр("ru = 'Продавец: '; az = 'Satıcı: '") + Автор + ";    "
		+ НСтр("ru = 'Касса: '; az = 'Kassa: '") + Касса + ";    "
		+ НСтр("ru = 'Склад: '; az = 'Anbar: '") + Склад;
КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовокПользователя()
	Элементы.ДекорПользователь.Заголовок = ПредставлениеНастроек(Объект.Автор, Объект.Касса, Объект.Склад);
КонецПроцедуры

&НаСервере
Функция ЗаголовокКонтрагентаНаСервере(Контрагент, Валюта, Курс)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат НСтр("ru = 'Покупатель не выбран'; az = 'Alıcı seçilməyib'");
	КонецЕсли;

	Результат = НСтр("ru = 'Покупатель: '; az = 'Alıcı: '") + Контрагент;
	ДолгКлиента = ОбщегоНазначения.ДолгКонтрагента(Контрагент, ТекущаяДата(), Валюта, Курс);
	Если ДолгКлиента <> 0 Тогда
		Результат = Результат + "; " + НСтр("ru = 'Долг: '; az = 'Borcu: '") + ДолгКлиента + " azn";
	КонецЕсли;
	СуммаБонуса = ОбщегоНазначения.СуммаБонуса(Контрагент, ТекущаяДата());
	Если СуммаБонуса > 0 Тогда
		Результат = Результат + "; " + НСтр("ru = 'Бонус: '; az = 'Bonus: '") + СуммаБонуса + " azn";
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ОбновитьПредставлениеЧека()

	Элементы.ДекорКонтрагент.Заголовок = ЗаголовокКонтрагентаНаСервере(Объект.Контрагент, Объект.Валюта, Объект.Курс);
	Элементы.ДекорСотрудник.Заголовок = НСтр("ru = 'Продавец (сотрудник): '; az = 'Satıcı (işçi): '")
		+ ?(ЗначениеЗаполнено(Объект.Сотрудник), Строка(Объект.Сотрудник), "—");
	Элементы.ДекорЧек.Заголовок = НСтр("ru = 'Чек №'; az = 'Çek №'") + Объект.ТекЧекНомер
		+ ?(ЗначениеЗаполнено(Объект.ДокПродажи), "   (" + НСтр("ru = 'ВОЗВРАТ'; az = 'QAYTARMA'") + ")", "");
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоги()

	ИтогСумма = Объект.Товары.Итог("Сумма");
	ИтогСкидка = Объект.Товары.Итог("Скидка");
	ИтогКоличество = Объект.Товары.Итог("Количество");
	Элементы.ДекорИтог.Заголовок = Формат(ИтогСумма, "ЧДЦ=2; ЧН=0,00");
	Элементы.ДекорИтогИнфо.Заголовок = НСтр("ru = 'Позиций: '; az = 'Mövqe: '") + Объект.Товары.Количество()
		+ "    " + НСтр("ru = 'Кол-во: '; az = 'Miqdar: '") + ИтогКоличество
		+ "    " + НСтр("ru = 'Скидка: '; az = 'Endirim: '") + Формат(ИтогСкидка, "ЧДЦ=2; ЧН=0,00");

КонецПроцедуры

#КонецОбласти

#Область ПоискИКаталог

&НаСервере
Процедура УстановитьГруппуНаСервере(Группа)

	Пусто = Не ЗначениеЗаполнено(Группа);
	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("БезГруппы", Пусто);
	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("Группа", Группа);

КонецПроцедуры

&НаСервере
Процедура УстановитьПоискНаСервере(Текст)

	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("Поиск", Текст);
	КаталогТоваров.Параметры.УстановитьЗначениеПараметра("ПоискШаблон", "%" + Текст + "%");
	// При текстовом поиске группа не ограничивает выдачу
	Если Текст <> "" Тогда
		КаталогТоваров.Параметры.УстановитьЗначениеПараметра("БезГруппы", Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппыТоваровПриАктивизацииСтроки(Элемент)

	Если ПропуститьПервуюАктивизациюГруппы Тогда
		ПропуститьПервуюАктивизациюГруппы = Ложь;
		Возврат;
	КонецЕсли;
	Данные = Элементы.ГруппыТоваров.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоискСтрока = "";
	УстановитьПоискНаСервере("");
	УстановитьГруппуНаСервере(Данные.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ВсеТоварыНажатие(Команда)
	ПоискСтрока = "";
	УстановитьПоискНаСервере("");
	УстановитьГруппуНаСервере(ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
КонецПроцедуры

&НаКлиенте
Процедура ПоискСтрокаПриИзменении(Элемент)

	Текст = СокрЛП(ПоискСтрока);
	Если Текст = "" Тогда
		УстановитьПоискНаСервере("");
		Возврат;
	КонецЕсли;

	// Сначала пробуем как штрихкод
	Если ДобавитьПоШтрихкоду(Текст) Тогда
		ПоискСтрока = "";
		УстановитьПоискНаСервере("");
		ТекущийЭлемент = Элементы.ПоискСтрока;
		Возврат;
	КонецЕсли;

	УстановитьПоискНаСервере(Текст);
	ТекущийЭлемент = Элементы.КаталогТоваров;

КонецПроцедуры

&НаКлиенте
Процедура КаталогТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДобавитьТекущийТовар(1);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТоварНажатие(Команда)
	ДобавитьТекущийТовар(1);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТоварСКоличествомНажатие(Команда)

	Количество = 1;
	Если Не ВвестиЧисло(Количество, НСтр("ru = 'Введите количество'; az = 'Miqdar daxil edin'"), 10, 3) Или Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	ДобавитьТекущийТовар(Количество);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекущийТовар(Количество)

	Данные = Элементы.КаталогТоваров.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобавитьСтроку(Данные.Ссылка, Неопределено, Количество);

КонецПроцедуры

&НаСервере
Функция НайтиПоШтрихкодуНаСервере(Штрихкод)

	Единица = Неопределено;
	Количество = 0;
	Товар = УправлениеНоменклатурой.НайтиПоШтрихкоду(Штрихкод, Единица, Количество, 0);
	Если ЗначениеЗаполнено(Товар) Тогда
		Возврат Новый Структура("Товар, Единица, Количество", Товар, Единица, Количество);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ДобавитьПоШтрихкоду(Штрихкод)

	Найдено = НайтиПоШтрихкодуНаСервере(Штрихкод);
	Если Найдено = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ДобавитьСтроку(Найдено.Товар, Найдено.Единица, ?(Найдено.Количество = 0, 1, Найдено.Количество));
	Возврат Истина;

КонецФункции

&НаСервере
Функция НайтиПользователяПоШтрихкоду(Штрихкод)
	Найденный = Справочники.Пользователи.НайтиПоРеквизиту("БарКод", СокрЛП(Штрихкод));
	Возврат Найденный;
КонецФункции

&НаКлиенте
Функция ОбработатьШтрихкодПользователя(Штрихкод)

	Найденный = НайтиПользователяПоШтрихкоду(Штрихкод);
	Если Найденный = Неопределено Или Найденный.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	СменитьПродавца(Найденный);
	Возврат Истина;

КонецФункции

&НаСервере
Функция ПолучитьНастройкиПродавцаНаСервере(Пользователь)
	Возврат ПолучитьНастройкиПользователя(Пользователь);
КонецФункции

&НаКлиенте
Процедура СменитьПродавца(Пользователь)

	Настройки = ПолучитьНастройкиПродавцаНаСервере(Пользователь);
	Если Настройки.Ошибка <> "" Тогда
		ОбщегоНазначения.Хебердарлыг(Настройки.Ошибка);
		Возврат;
	КонецЕсли;
	Объект.Автор = Пользователь;
	Объект.Касса = Настройки.Касса;
	Объект.Склад = Настройки.Склад;
	Объект.ТипЦен = Настройки.ТипЦен;
	ПечатьЧек = Настройки.ПечатьЧек;
	ПрименитьПараметрыКаталога();
	ОбновитьЗаголовокПользователя();

КонецПроцедуры

#КонецОбласти

#Область ТаблицаЧека

&НаСервере
Функция ДобавитьСтрокуНаСервере(Товар, Единица, Количество)

	Об = РеквизитФормыВЗначение("Объект");
	Если Не ЗначениеЗаполнено(Единица) Тогда
		Единица = Товар.ОсновнаяЕдиница;
	КонецЕсли;

	Найденные = Об.Товары.НайтиСтроки(Новый Структура("Товар, Единица", Товар, Единица));
	Если Найденные.Количество() > 0 Тогда
		Строка = Найденные[0];
		Строка.Количество = Строка.Количество + Количество;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(Об, Строка, "Количество", , Об.СкидочнаяКарта);
	Иначе
		Строка = Об.Товары.Добавить();
		Строка.Товар = Товар;
		Строка.Единица = Единица;
		РаботаСТЧДокумента.ИзмЕдин(Об, Строка, "", Об.Склад);
		Строка.Количество = Количество;
		Строка.ПроцентСкидки = Об.ПроцентСкидки;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(Об, Строка, "Цена", , Об.СкидочнаяКарта);
	КонецЕсли;
	Строка.Остаток = Формат(УправлениеЗапасами.ОстатокТовара(ТекущаяДата(), Товар, Об.Склад) / ?(Единица.Коэффициент = 0, 1, Единица.Коэффициент), "ЧГ=0");

	Индекс = Об.Товары.Индекс(Строка);
	ЗначениеВРеквизитФормы(Об, "Объект");
	Возврат Объект.Товары[Индекс].ПолучитьИдентификатор();

КонецФункции

&НаКлиенте
Процедура ДобавитьСтроку(Товар, Единица, Количество)

	Идентификатор = ДобавитьСтрокуНаСервере(Товар, Единица, Количество);
	Элементы.Товары.ТекущаяСтрока = Идентификатор;
	ОбновитьПредставлениеЧека();

КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуНаСервере(Идентификатор, Колонка)

	Об = РеквизитФормыВЗначение("Объект");
	Индекс = Объект.Товары.Индекс(Объект.Товары.НайтиПоИдентификатору(Идентификатор));
	Строка = Об.Товары[Индекс];
	РаботаСТЧДокумента.Выч_Суммы_ТЧ(Об, Строка, Колонка, , Об.СкидочнаяКарта);
	ЗаполнитьЗначенияСвойств(Объект.Товары[Индекс], Строка);

КонецПроцедуры

&НаСервере
Процедура СменитьЕдиницуНаСервере(Идентификатор)

	Об = РеквизитФормыВЗначение("Объект");
	Индекс = Объект.Товары.Индекс(Объект.Товары.НайтиПоИдентификатору(Идентификатор));
	Строка = Об.Товары[Индекс];
	РаботаСТЧДокумента.ИзмЕдин(Об, Строка, "", Об.Склад);
	РаботаСТЧДокумента.Выч_Суммы_ТЧ(Об, Строка, "Цена", , Об.СкидочнаяКарта);
	ЗаполнитьЗначенияСвойств(Объект.Товары[Индекс], Строка);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ПересчитатьСтрокуНаСервере(ТекущаяСтрока, "Количество");
		ПересчитатьИтоги();
	КонецЕсли;
КонецПроцедуры

