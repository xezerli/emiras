#Область НесколькоЧеков

&НаКлиенте
Процедура НовыйЧекПустой()

	Объект.Товары.Очистить();
	Объект.Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	Объект.Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	Объект.ПроцентСкидки = 0;
	Объект.СкидочнаяКарта = "";
	Объект.Комментарий = "";
	Объект.ДокПродажи = ПредопределенноеЗначение("Документ.Чек.ПустаяСсылка");
	Объект.Дата = ТекущаяДата();

	// Номер: следующий после максимального из отложенных
	Максимум = 0;
	Для Каждого Чек Из Чеки Цикл
		Максимум = Макс(Максимум, Чек.Номер);
	КонецЦикла;
	Объект.ТекЧекНомер = Максимум + 1;
	ОбновитьПредставлениеЧека();

КонецПроцедуры

&НаКлиенте
Функция ТекущийЧекВСтруктуру()

	Чек = Новый Структура("Номер, Автор, Контрагент, Сотрудник, ПроцентСкидки, Товары, Итог");
	Чек.Номер = Объект.ТекЧекНомер;
	Чек.Автор = Объект.Автор;
	Чек.Контрагент = Объект.Контрагент;
	Чек.Сотрудник = Объект.Сотрудник;
	Чек.ПроцентСкидки = Объект.ПроцентСкидки;
	Чек.Итог = Объект.Товары.Итог("Сумма");
	Чек.Товары = Новый Массив;
	Для Каждого Строка Из Объект.Товары Цикл
		Чек.Товары.Добавить(Новый Структура("Товар, Единица, Количество, Коэффициент, Цена, Скидка, ПроцентСкидки, Сумма, Партия, АвтоматимескаяСкидка, Остаток",
			Строка.Товар, Строка.Единица, Строка.Количество, Строка.Коэффициент, Строка.Цена, Строка.Скидка,
			Строка.ПроцентСкидки, Строка.Сумма, Строка.Партия, Строка.АвтоматимескаяСкидка, Строка.Остаток));
	КонецЦикла;
	Возврат Чек;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьИзСтруктуры(Чек)

	Объект.Товары.Очистить();
	Объект.ТекЧекНомер = Чек.Номер;
	Объект.Автор = Чек.Автор;
	Объект.Контрагент = Чек.Контрагент;
	Объект.Сотрудник = Чек.Сотрудник;
	Объект.ПроцентСкидки = Чек.ПроцентСкидки;
	Для Каждого Строка Из Чек.Товары Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	ОбновитьПредставлениеЧека();

КонецПроцедуры

&НаКлиенте
Процедура ОтложитьТекущийЧек()

	Если Объект.Товары.Количество() = 0 И Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;
	Чеки.Добавить(ТекущийЧекВСтруктуру());

КонецПроцедуры

&НаКлиенте
Процедура НовыйЧекНажатие(Команда)

	Если Объект.Товары.Количество() = 0 И Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;
	ОтложитьТекущийЧек();
	НовыйЧекПустой();

КонецПроцедуры

&НаКлиенте
Процедура АктивныеЧекиНажатие(Команда)

	Если Чеки.Количество() = 0 Тогда
		ОбщегоНазначения.Хебердарлыг(НСтр("ru = 'Отложенных чеков нет'; az = 'Gözləyən çek yoxdur'"));
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Индекс = 0 По Чеки.Количество() - 1 Цикл
		Чек = Чеки[Индекс];
		Список.Добавить(Индекс, НСтр("ru = 'Чек №'; az = 'Çek №'") + Чек.Номер + "  —  " + Формат(Чек.Итог, "ЧДЦ=2")
			+ ?(ЗначениеЗаполнено(Чек.Контрагент), "  (" + Чек.Контрагент + ")", ""));
	КонецЦикла;

	Выбранный = Список.ВыбратьЭлемент(НСтр("ru = 'Отложенные чеки'; az = 'Aktiv çeklər'"));
	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выбор = Чеки[Выбранный.Значение];
	Чеки.Удалить(Выбранный.Значение);
	ОтложитьТекущийЧек();
	ЗаполнитьИзСтруктуры(Выбор);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЧекНажатие(Команда)

	Если ОбщегоНазначения.Суал(НСтр("ru = 'Очистить текущий чек?'; az = 'Cari çek silinsinmi?'")) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолныеПрава.ПроверитьДоступ(Объект.Автор, "Удалить") Тогда
		Возврат;
	КонецЕсли;
	Если Чеки.Количество() > 0 Тогда
		Последний = Чеки[Чеки.ВГраница()];
		Чеки.Удалить(Чеки.ВГраница());
		ЗаполнитьИзСтруктуры(Последний);
	Иначе
		НовыйЧекПустой();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПродажаИВозврат

// Записывает документ с повторными попытками при блокировках (как в РМК2).
&НаСервере
Функция ЗаписатьДокументСПовтором(Док, РежимПроведения, Ошибка)

	Попытки = 0;
	Пока Попытки < 2000 Цикл
		Попытка
			Если РежимПроведения = Неопределено Тогда
				Док.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
			КонецЕсли;
			Возврат Истина;
		Исключение
			Ошибка = ОписаниеОшибки();
			Если (Найти(НРег(Ошибка), "блок") = 0) И (Найти(НРег(Ошибка), "lock") = 0) Тогда
				Прервать;
			КонецЕсли;
			Попытки = Попытки + 1;
		КонецПопытки;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ОформитьЧекНаСервере(ПараметрыОформления, Ошибка)

	Об = РеквизитФормыВЗначение("Объект");

	Док = Документы.Чек.СоздатьДокумент();
	Док.ИнстализацияДокумента();
	Док.Сотрудник = Об.Сотрудник;
	Док.Касса = Об.Касса;
	Док.Валюта = Док.Валюта;
	Док.Курс = Об.Курс;
	Док.Склад = Об.Склад;
	Док.Кассир = Об.Автор;
	Док.Автор = Об.Автор;
	Док.Дата = ТекущаяДата();
	Док.БС = ПараметрыОформления.БСчет;
	Док.СуммаОплатаБС = ПараметрыОформления.СуммаОплатаБС;
	Док.КолМес = ПараметрыОформления.КолМес;
	Док.ПроцентСкидки = Об.ПроцентСкидки;
	Док.ПечатьЧек = Истина;
	Док.Контрагент = Об.Контрагент;
	Док.Комментарий = Об.Комментарий;
	Док.РаспечататьЧекНДС = ПараметрыОформления.РаспечататьЧекНДС;

	Если ПараметрыОформления.ЭтоВозврат Тогда
		Док.ЧекНаВозврат = Истина;
		Док.ДокПродажи = Об.ДокПродажи;
		Док.Комментарий = "" + Об.ДокПродажи + " -" + Об.Комментарий;
		Если Не ЗначениеЗаполнено(Док.Контрагент) Тогда
			Док.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Satıcı");
		КонецЕсли;
	КонецЕсли;

	Для Каждого СтрокаТЗ Из Об.Товары Цикл
		СтрокаДок = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДок, СтрокаТЗ);
		СтрокаДок.СуммаБезПроцентов = СтрокаТЗ.Сумма;
		СтрокаДок.Цена = СтрокаДок.Цена + СтрокаДок.Цена * ПараметрыОформления.ПроцДоп / 100;
		СтрокаДок.Сумма = СтрокаДок.Сумма + СтрокаДок.Сумма * ПараметрыОформления.ПроцДоп / 100;
		СтрокаДок.Скидка = СтрокаДок.Скидка + СтрокаДок.Скидка * ПараметрыОформления.ПроцДоп / 100;
		Если (СтрокаДок.Сумма + СтрокаДок.Скидка) <> 0 Тогда
			СтрокаДок.ПроцентСкидки = СтрокаДок.Скидка * 100 / (СтрокаДок.Сумма + СтрокаДок.Скидка);
		КонецЕсли;
		Если Не ПараметрыОформления.ЭтоВозврат Тогда
			СтрокаДок.Штрихкод = СтрокаДок.Товар.Штрихкод;
		КонецЕсли;
	КонецЦикла;

	Если ПараметрыОформления.ЭтоВозврат Тогда
		Записан = ЗаписатьДокументСПовтором(Док, Неопределено, Ошибка);
	Иначе
		Записан = ЗаписатьДокументСПовтором(Док, РежимПроведенияДокумента.Оперативный, Ошибка);
	КонецЕсли;
	Если Не Записан Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Кассовые документы (приходы) как в РМК2 — только для продажи
	Если Не ПараметрыОформления.ЭтоВозврат Тогда
		СоздатьКассовыеДокументы(Док, Об.Касса, ПараметрыОформления.СуммаОплата, ПараметрыОформления.СуммаОплатаБС);
	КонецЕсли;

	Возврат Док.Ссылка;

КонецФункции

&НаСервере
Процедура СоздатьКассовыеДокументы(Док, Касса, СуммаОплата, СуммаОплатаБС)

	// Пропускаем, если у чека нет длинного номера (логика РМК2)
	Попытка
		Если Не ЗначениеЗаполнено(Док.Ссылка.ДлинныйНомерЧека) Тогда
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ПКО = Документы.ПКО.СоздатьДокумент();
	ПКО.Дата = ТекущаяДата();
	ПКО.Автор = Док.Автор;
	ПКО.Валюта = Док.Валюта;
	ПКО.Курс = 1;
	ПКО.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Satıcı");
	ПКО.Касса = Касса;
	ПКО.Комментарий = "Pərakəndə satış";
	ПКО.Основание = "Pərakəndə satış";
	ПКО.СтатяЗатрат = Справочники.СтатяЗатрат.ТоплаАЗ;
	ПКО.Сумма = СуммаОплата;
	ПКО.ТипОплата = 0;
	ПКО.ДокументОснования = Док.Ссылка;
	ЗаписатьКассовыйДокумент(ПКО);

	Если СуммаОплатаБС > 0 Тогда
		ПКОБанк = Документы.ПКО.СоздатьДокумент();
		ПКОБанк.Дата = ТекущаяДата();
		ПКОБанк.Автор = Док.Автор;
		ПКОБанк.Валюта = Док.Валюта;
		ПКОБанк.Курс = 1;
		ПКОБанк.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Satıcı");
		ПКОБанк.Касса = Касса;
		ПКОБанк.Комментарий = "Pərakəndə satış (POS TERMINAL)";
		ПКОБанк.Основание = "Pərakəndə satış (POS TERMINAL)";
		ПКОБанк.СтатяЗатрат = Справочники.СтатяЗатрат.НайтиПоНаименованию("P0STERMİNALDAN MƏDAXİL");
		ПКОБанк.Сумма = СуммаОплатаБС;
		ПКОБанк.ТипОплата = 0;
		ПКОБанк.ДокументОснования = Док.Ссылка;
		ЗаписатьКассовыйДокумент(ПКОБанк);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьКассовыйДокумент(Док)
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОформления(ДокументСсылка, ПараметрыОформления)

	Если ПечатьЧек > 0 Тогда
		Попытка
			Форма = ПолучитьФорму("Обработка.РМК2.Форма.ФормаТаблицаЧека");
			Форма.док = ДокументСсылка;
			Форма.ПечатьЧек = ПечатьЧек;
			Если ПараметрыОформления.ЭтоВозврат Тогда
				Форма.Открыть();
			Иначе
				Форма.ОткрытьМодально();
			КонецЕсли;
		Исключение
			ОбщегоНазначения.Хебердарлыг(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Объект.Комментарий = "";
	Объект.ДокПродажи = ПредопределенноеЗначение("Документ.Чек.ПустаяСсылка");
	Если Чеки.Количество() > 0 Тогда
		Последний = Чеки[Чеки.ВГраница()];
		Чеки.Удалить(Чеки.ВГраница());
		ЗаполнитьИзСтруктуры(Последний);
	Иначе
		НовыйЧекПустой();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродажаНажатие(Команда)

	Если ЗначениеЗаполнено(Объект.ДокПродажи) Тогда
		Если ОбщегоНазначения.Суал(НСтр("ru = 'Это возвратный чек. Заменить чек продажи (таблица будет очищена)?'; az = 'Bu çek qaytarma çekidir. Satış çekinə dəyişdirilsinmi(cədvəl silinəcək)?'")) = КодВозвратаДиалога.Да Тогда
			Объект.ДокПродажи = ПредопределенноеЗначение("Документ.Чек.ПустаяСсылка");
			Объект.Товары.Очистить();
			ОбновитьПредставлениеЧека();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Объект.Товары.Итог("Количество") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		Предупреждение(НСтр("ru = 'Не выбран продавец'; az = 'Satıcı seçilməyib'"));
		Возврат;
	КонецЕсли;

	Итог = Объект.Товары.Итог("Сумма");

	ФормаОплата = ПолучитьФорму("Обработка.РМК2.Форма.ФормаОплата");
	ФормаОплата.ПолеВводаСуммаДокумента = Итог;
	ФормаОплата.ПолеВводаСуммаДокументаНач = Итог;
	ФормаОплата.ПолеВводаСуммаОплата = Итог;
	ФормаОплата.СуммаБонуса = ОбщегоНазначения.СуммаБонуса(Объект.Контрагент, ТекущаяДата());
	ФормаОплата.СуммаАванса = 0;
	ФормаОплата.ПолеВводаСуммаАванса = 0;
	Если ФормаОплата.ОткрытьМодально() = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОформления = ПараметрыОплатыИзФормы(ФормаОплата, Ложь);
	Если ПараметрыОформления.СуммаОплата + ПараметрыОформления.СуммаОплатаБС <> ФормаОплата.ПолеВводаСуммаДокумента Тогда
		Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
			ОбщегоНазначения.Хебердарлыг(НСтр("ru = 'Сумма продажи отличается от суммы оплаты!'; az = 'Sənədin məbləği ilə ödəniş məbləği fərqlənir!'")
				+ Символы.ПС + НСтр("ru = 'Покупатель обязателен к заполнению'; az = 'Alıcı mütləq seçilməlidir'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Ответ = Вопрос(НСтр("ru = 'Распечатать без чека НДС?'; az = 'ƏDV çeki olmadan çap olunsun mu?'"), РежимДиалогаВопрос.ДаНет, 0);
	ПараметрыОформления.Вставить("РаспечататьЧекНДС", Ответ <> КодВозвратаДиалога.Да);

	Ошибка = "";
	ДокументСсылка = ОформитьЧекНаСервере(ПараметрыОформления, Ошибка);
	Если ДокументСсылка = Неопределено Тогда
		Предупреждение(Ошибка);
		Возврат;
	КонецЕсли;
	ПослеОформления(ДокументСсылка, ПараметрыОформления);

КонецПроцедуры

&НаКлиенте
Функция ПараметрыОплатыИзФормы(ФормаОплата, ЭтоВозврат)

	ПроцДоп = 0;
	КолМес = 0;
	Если ФормаОплата.ЭлементыФормы.Проценты.ТекущиеДанные <> Неопределено Тогда
		Если ФормаОплата.ПолеВводаСуммаДокументаНач <> 0 Тогда
			ПроцДоп = (ФормаОплата.ПолеВводаСуммаДокумента - ФормаОплата.ПолеВводаСуммаДокументаНач) * 100 / ФормаОплата.ПолеВводаСуммаДокументаНач;
		КонецЕсли;
		КолМес = ФормаОплата.ЭлементыФормы.Проценты.ТекущиеДанные.КолМес;
	КонецЕсли;

	ПараметрыОформления = Новый Структура;
	ПараметрыОформления.Вставить("ЭтоВозврат", ЭтоВозврат);
	ПараметрыОформления.Вставить("БСчет", ФормаОплата.Бс1);
	ПараметрыОформления.Вставить("СуммаОплатаБС", ФормаОплата.ПолеВводаСуммаОплатаБС);
	ПараметрыОформления.Вставить("СуммаОплата", ФормаОплата.ПолеВводаСуммаОплата - ФормаОплата.ПолеВводаСдача);
	ПараметрыОформления.Вставить("ПроцДоп", ПроцДоп);
	ПараметрыОформления.Вставить("КолМес", КолМес);
	ПараметрыОформления.Вставить("ПечатьЧек", ПечатьЧек);
	ПараметрыОформления.Вставить("РаспечататьЧекНДС", Истина);
	Возврат ПараметрыОформления;

КонецФункции

&НаКлиенте
Процедура ВозвратНажатие(Команда)

	Если Не ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		Предупреждение(НСтр("ru = 'Не выбран продавец'; az = 'Satıcı seçilməyib'"));
		Возврат;
	КонецЕсли;
	Если Не ПолныеПрава.ПроверитьДоступ(Объект.Автор, "Возврат") Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДокПродажи) Или Объект.Товары.Итог("Количество") = 0 Тогда
		Объект.ДокПродажи = ПредопределенноеЗначение("Документ.Чек.ПустаяСсылка");
		ФормаВыбора = ПолучитьФорму("Документ.Чек.ФормаВыбора");
		Если ФормаВыбора = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ФормаВыбора.ДокументСписок.Отбор.Сотрудник.Установить(Объект.Сотрудник);
		ФормаВыбора.ДокументСписок.Отбор.Сотрудник.Использование = Истина;
		ВыбранныйЧек = ФормаВыбора.ОткрытьМодально();
		Если ВыбранныйЧек <> Неопределено Тогда
			Объект.ДокПродажи = ВыбранныйЧек;
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДокПродажи) Тогда
		Предупреждение(НСтр("ru = 'Нужно выбрать документ продажи!'; az = 'Satış sənədini seçmək lazımdır!'"));
		Возврат;
	КонецЕсли;
	Если Объект.Товары.Итог("Количество") = 0 Тогда
		Возврат;
	КонецЕсли;

	Сообщение = ПроверитьСоответствиеПродаже();
	Если Сообщение <> "" Тогда
		Предупреждение(Сообщение);
		ОбновитьПредставлениеЧека();
		Возврат;
	КонецЕсли;

	Итог = Объект.Товары.Итог("Сумма");
	ФормаОплата = ПолучитьФорму("Обработка.РМК2.Форма.ФормаОплата");
	ФормаОплата.ДокументВозврата = Истина;
	ФормаОплата.ПолеВводаСуммаДокумента = Итог;
	ФормаОплата.ПолеВводаСуммаДокументаНач = Итог;
	ФормаОплата.ПолеВводаСуммаОплата = Итог;
	ФормаОплата.СуммаАванса = 0;
	ФормаОплата.ПолеВводаСуммаАванса = 0;
	ФормаОплата.ЭлементыФормы.Кнопка4.Доступность = Ложь;
	Если ФормаОплата.ОткрытьМодально() = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОформления = ПараметрыОплатыИзФормы(ФормаОплата, Истина);
	Если ПараметрыОформления.СуммаОплата + ПараметрыОформления.СуммаОплатаБС <> ФормаОплата.ПолеВводаСуммаДокумента Тогда
		Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
			ОбщегоНазначения.Хебердарлыг(НСтр("ru = 'Сумма продажи отличается от суммы оплаты!'; az = 'Sənədin məbləği ilə ödəniş məbləği fərqlənir!'")
				+ Символы.ПС + НСтр("ru = 'Покупатель обязателен к заполнению'; az = 'Alıcı mütləq seçilməlidir'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Ошибка = "";
	ДокументСсылка = ОформитьЧекНаСервере(ПараметрыОформления, Ошибка);
	Если ДокументСсылка = Неопределено Тогда
		Предупреждение(Ошибка);
		Возврат;
	КонецЕсли;
	ПослеОформления(ДокументСсылка, ПараметрыОформления);

КонецПроцедуры

// Сверяет товары возврата с документом продажи (как РМК2). Пустая строка — всё в порядке.
&НаСервере
Функция ПроверитьСоответствиеПродаже()

	Об = РеквизитФормыВЗначение("Объект");
	ТоварыПродажи = Об.ДокПродажи.Товары;
	Изменено = Ложь;
	Сообщение = "";

	Для Каждого Строка Из Об.Товары Цикл
		Найденная = ТоварыПродажи.Найти(Строка.Товар, "Товар");
		Если Найденная = Неопределено Тогда
			Возврат НСтр("ru = 'Ошибка! В выбранном документе продажи нет товара '; az = 'Səhv! Seçilmiş satış sənədində yoxdur: '") + Строка.Товар;
		ИначеЕсли Найденная.Количество <> 0 И Строка.Количество <> 0
			И (Найденная.СуммаБезПроцентов / Найденная.Количество) <> (Строка.Сумма / Строка.Количество) Тогда
			Сообщение = НСтр("ru = 'Цена товара изменена согласно документу продажи: '; az = 'Malın qiyməti satış sənədinə uyğun dəyişdirildi: '") + Строка.Товар;
			Строка.Цена = Найденная.Цена;
			Строка.Сумма = Строка.Количество * (Найденная.СуммаБезПроцентов / Найденная.Количество);
			Строка.Скидка = Строка.Цена * Строка.Количество - Строка.Сумма;
			Строка.ПроцентСкидки = 0;
			Если Строка.Цена * Строка.Количество <> 0 Тогда
				Строка.АвтоматимескаяСкидка = Строка.Скидка * 100 / (Строка.Цена * Строка.Количество);
			КонецЕсли;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Изменено Тогда
		ЗначениеВРеквизитФормы(Об, "Объект");
	КонецЕсли;
	Возврат Сообщение;

КонецФункции

#КонецОбласти

#Область Сервис

&НаКлиенте
Процедура ЖурналНажатие(Команда)
	Форма = ПолучитьФорму("ЖурналДокументов.ДокументыПродажи.ФормаСпискаДляРМК");
	Если Форма <> Неопределено Тогда
		Форма.Автор = Объект.Автор;
		Форма.ОткрытьМодально();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗедОтчетНажатие(Команда)
	Форма = ПолучитьФорму("Отчет.Z_отчет.Форма");
	Если Форма <> Неопределено Тогда
		Форма.Автор = Объект.Автор;
		Форма.ОткрытьМодально();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСменуНажатие(Команда)
	Если ЗакрытьСменуНаСервере(Объект.Касса, Объект.Автор) Тогда
		ОбщегоНазначения.Хебердарлыг(НСтр("ru = 'Кассовая смена закрыта!'; az = 'Kassa növbəsi bağlandı!'"));
	КонецЕсли;
КонецПроцедуры

&НаСервере
