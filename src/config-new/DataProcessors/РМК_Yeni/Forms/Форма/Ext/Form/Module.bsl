КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломИзменения(Элемент, Отказ)

	// Права на изменение чувствительных колонок проверяются так же, как в РМК2
	Поле = Элемент.ТекущийЭлемент;
	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Колонка = "";
	Если Поле.Имя = "ТоварыЦена" Тогда
		Колонка = "Цена";
	ИначеЕсли Поле.Имя = "ТоварыПроцентСкидки" Тогда
		Колонка = "ПроцентСкидки";
	ИначеЕсли Поле.Имя = "ТоварыСкидка" Тогда
		Колонка = "Скидка";
	КонецЕсли;
	Если Колонка <> "" И Не ПолныеПрава.ПроверитьДоступ(Объект.Автор, Колонка) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

