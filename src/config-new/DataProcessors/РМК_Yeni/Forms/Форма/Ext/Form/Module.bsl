Процедура СкидкаСбросНажатие(Команда)

	Если Не ПолныеПрава.ПроверитьДоступ(Объект.Автор, "Скидка") Тогда
		Возврат;
	КонецЕсли;
	ПроцентСкидкиНаВсеСтрокиНаСервере(0);
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентНажатие(Команда)

	Форма = ПолучитьФорму("Справочник.Контрагенты.ФормаВыбора");
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = Форма.ОткрытьМодально();
	Если Значение <> Неопределено Тогда
		Объект.Контрагент = Значение;
		ОбновитьПредставлениеЧека();
		ПроцентСкидкиНаВсеСтрокиНаСервере(Объект.ПроцентСкидки);
		ПересчитатьИтоги();
	КонецЕсли;

