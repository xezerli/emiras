&НаКлиенте
Процедура УдалитьСтрокуНажатие(Команда)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолныеПрава.ПроверитьДоступ(Объект.Автор, "Удалить") Тогда
		Возврат;
	КонецЕсли;
	Объект.Товары.Удалить(Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока));
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКоличествоНажатие(Команда)

	Данные = Элементы.Товары.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Количество = Данные.Количество;
	Если ВвестиЧисло(Количество, НСтр("ru = 'Количество'; az = 'Miqdar'"), 10, 3) Тогда
		Данные.Количество = Количество;
		ПересчитатьСтрокуНаСервере(Элементы.Товары.ТекущаяСтрока, "Количество");
		ПересчитатьИтоги();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СкидкаКонтрагентПродавец

&НаСервере
Процедура ПроцентСкидкиНаВсеСтрокиНаСервере(Процент)

	Об = РеквизитФормыВЗначение("Объект");
	Об.ПроцентСкидки = Процент;
	Для Каждого Строка Из Об.Товары Цикл
		Строка.ПроцентСкидки = Процент;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(Об, Строка, "ПроцентСкидки", , Об.СкидочнаяКарта);
	КонецЦикла;
	ЗначениеВРеквизитФормы(Об, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура СкидкаНажатие(Команда)

	Если Не ПолныеПрава.ПроверитьДоступ(Объект.Автор, "Скидка") Тогда
		Возврат;
	КонецЕсли;
	Процент = Объект.ПроцентСкидки;
	Если Не ВвестиЧисло(Процент, НСтр("ru = 'Скидка, %'; az = 'Endirim, %'"), 6, 2) Тогда
		Возврат;
	КонецЕсли;
	ПроцентСкидкиНаВсеСтрокиНаСервере(Процент);
	ПересчитатьИтоги();

КонецПроцедуры

