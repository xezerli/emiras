// обработчик сохранения настроек и закрытия формы
Процедура КнопкаОКНажатие(Кнопка)
	Модифицированность = Ложь;
	Закрыть(Истина);
КонецПроцедуры

// обработчик проверки изменения настроек отчета до закрытия формы
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)	
	СтандартнаяОбработка = Ложь;
	Если Модифицированность Тогда
		ответ = Вопрос("Настройки отчета изменены, сохранить?", РежимДиалогаВопрос.ДаНетОтмена);
		Если ответ = КодВозвратаДиалога.Да Тогда
			//проверим заполнение необходимых параметров
			Если ТипОтчета = "Из конфигурации" ИЛИ ТипОтчета="Внешний отчет" Тогда 
				Если ПустаяСтрока(ИмяОтчета) Тогда
					Предупреждение("Поле отчет не может быть пустым!");
					Отказ = Истина;
					СтандартнаяОбработка = Ложь;
				КонецЕсли;
			КонецЕсли;
			Закрыть(Истина);
		ИначеЕсли ответ = КодВозвратаДиалога.Нет Тогда
			Закрыть(ложь);
		ИначеЕсли ответ = КодВозвратаДиалога.Отмена Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура вычисляет даты начала и окончания для строки таблицы Отчеты
// Параметры
//	стрОтчет - строка таблицы СписокОтчетов
//	ДатаНач, ДатаКон - Дата, дата начала и дата конца для отчета
//
Процедура ПолучитьИнтервалОтчета(ДатаНач,ДатаКон);
	
	ДатаКон= ТекущаяДата();
	Если СокрЛП(ЗначениеКонечнойДаты)="Сегодня" Тогда
	ИначеЕсли СокрЛП(ЗначениеКонечнойДаты)="Конец пред.месяца" Тогда
        ДатаКон=ДобавитьМесяц(ДатаКон,-1);
		ДатаКон=КонецМесяца(ДатаКон);
	Иначе //не заполнен параметр	 
	КонецЕсли; 
	
	Если СокрЛП(ТипСмещенияНачальнойДаты)="Месяц" Тогда
		ДатаНач=ДобавитьМесяц(ДатаКон,-1*СмещениеНачальнойДаты);
		
	ИначеЕсли СокрЛП(ТипСмещенияНачальнойДаты)="С начала месяца" Тогда
		ДатаНач=ДобавитьМесяц(ДатаКон,-1*СмещениеНачальнойДаты);
		ДатаНач=НачалоМесяца(ДатаНач);

	ИначеЕсли СокрЛП(ТипСмещенияНачальнойДаты)="День" Тогда
		ДатаНач=НачалоДня(ДатаКон - СмещениеНачальнойДаты * 24*60*60);
		
	Иначе // НЕ задан тип смещения берем 2 месяца назад
		ДатаНач=ДобавитьМесяц(ДатаКон,-2);
	КонецЕсли; 
	
КонецПроцедуры

// процедура обработчик изменения параметра периода отчета
Процедура ПриИзмененииНастройкиПериодаОтчета(Элемент)
    ДатаНач=ТекущаяДата();
	ДатаКон=ДатаНач;
	ПолучитьИнтервалОтчета(ДатаНач,ДатаКон);
	ЭлементыФормы.НадписьРасчётныйПериодОтчета.Заголовок = Формат(ДатаНач,"ДФ=dd.MM.yyyy")+" - "+Формат(ДатаКон,"ДФ=dd.MM.yyyy");
КонецПроцедуры

// процедура обработчик нажатия на кнопку Сформировать отчет
Процедура КнопкаСформироватьНажатие(Элемент)
	Табл=Новый ТабличныйДокумент;
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	КодЗакрытия = Неопределено;
	Если НЕ (ОтборПоДоговору + ОтборПоКонтрагенту + ОтборПоНоменклатуре = "") Тогда
		Форма = ПолучитьФорму("ФормаВыбораПараметровОтчета");
		КодЗакрытия		= Форма.ОткрытьМодально();
		Контрагент		= форма.Контрагент;
		Договор			= форма.Договор;
		Номенклатура	= форма.Номенклатура;
	Иначе
		КодЗакрытия = Истина;
	КонецЕсли;
	Если КодЗакрытия = Истина Тогда
		стрОтчет = Новый Структура;
		стрОтчет.Вставить("Загружать", Загружать);
		стрОтчет.Вставить("ЗапрашиватьПериод", ЗапрашиватьПериод);
		стрОтчет.Вставить("ЗначениеКонечнойДаты", ЗначениеКонечнойДаты);
		стрОтчет.Вставить("ИмяОтчета", ИмяОтчета);
		стрОтчет.Вставить("КодОтчета", КодОтчета);
		стрОтчет.Вставить("НазваниеОтчета", НазваниеОтчета);
		стрОтчет.Вставить("ОтборПоДоговору", ОтборПоДоговору);
		стрОтчет.Вставить("ОтборПоКонтрагенту", ОтборПоКонтрагенту);
		стрОтчет.Вставить("ОтборПоНоменклатуре", ОтборПоНоменклатуре);
		стрОтчет.Вставить("ОтборПоОтветственному", ОтборПоОтветственному);
		стрОтчет.Вставить("ПараметрыИзКПК", ПараметрыИзКПК);
		стрОтчет.Вставить("СмещениеНачальнойДаты", СмещениеНачальнойДаты);
		стрОтчет.Вставить("ТипОтчета", ТипОтчета);
		стрОтчет.Вставить("ТипСмещенияНачальнойДаты", ТипСмещенияНачальнойДаты);
		
		формаОсновная = ПолучитьФорму("ФормаОсновная");
		
		ДатаНачала = Неопределено;
		ДатаОкончания = Неопределено;		
		Если ЗапрашиватьПериод Тогда 
			Форма=ПолучитьФорму("ВводПериода",ЭтаФорма);
			Форма.НачПериода = ТекущаяДата();
			Форма.КонПериода = Форма.НачПериода;
			ПолучитьИнтервалОтчета(Форма.НачПериода, Форма.КонПериода);
			Форма.НачПериода = НачалоДня(Форма.НачПериода);
			Форма.КонПериода = КонецДня(Форма.КонПериода);
			ДатаНачала = Форма.НачПериода;
			ДатаОкончания = Форма.КонПериода;			
			Результат=Форма.ОткрытьМодально();
			Если Результат=Истина Тогда 
				ДатаНачала = НачалоДня(Форма.НачПериода);
				ДатаОкончания = КонецДня(Форма.КонПериода);
			КонецЕсли;			
		КонецЕсли;
		формаОсновная.СформироватьОтчет(Табл, ТекАгент, стрОтчет, Контрагент, Договор, Номенклатура, ДатаНачала, ДатаОкончания);
		Табл.Показать();
	КонецЕсли;
КонецПроцедуры

// процедура проверяет соответствие значения в поле выбора со значением из выпадающего списка
// Параметры
//	полеВыбора - Поле выбора значения
//	прошлоеЗначение - строка со значение ранее выбранного поля
//
Процедура ПроверитьЗаполнениеКолонки(полеВыбора, прошлоеЗначение, ИгнорироватьТочкуВИмениПоля = Ложь)
	
	Если полеВыбора.СписокВыбора.Количество() = 0 Тогда
	//список выбора - пуст, очищаем значение
		полеВыбора.Значение = "";
		Возврат;
	ИначеЕсли НЕ ПустаяСтрока(прошлоеЗначение) Тогда
	// если раньше было указано значение - то пробуем оставить его
		Если (полеВыбора.СписокВыбора.НайтиПоЗначению(прошлоеЗначение) = Неопределено) Тогда
		// указанное значение отсутствует в списке выбора 
			полеВыбора.Значение = "";
		Иначе
		// указанное значение присутствует в списке выбора, ничего не делаем
			полеВыбора.Значение = прошлоеЗначение;
			Возврат;
		КонецЕсли	
	КонецЕсли;
	// автовыбор значения при условии что в списке выбора только одно значение
	// в списке выбора единственная позиция, проверяем, если она не составное поле - то ставим её по умолчанию, иначе - ""
	//Если полеВыбора.СписокВыбора.Количество() = 1 Тогда
		//полеВыбора.Значение = ?(Найти(полеВыбора.СписокВыбора[0].Значение, ".") = 0 ИЛИ ИгнорироватьТочкуВИмениПоля, 
		//							полеВыбора.СписокВыбора[0].Значение, "");
	//КонецЕсли;
КонецПроцедуры

// функция проверяет является-ли передаваемый параметром Отчет, отчетом на базе Схемы компоновки данных
// Параметры
//	Отчет - Внешний отчет, проверяемый на внешний отчет на базе Схемы компоновки данных
// Результат
//	Истина - Отчет - внешний отчет на базе Схемы компоновки данных, в этом случае будут 
//			заполнены списки выбора для настройки параметров отбора по контрагенту и договору
//	Ложь - Отчет - внешний отчет НЕ на базе Схемы компоновки данных
Функция ВыборОтчетаСКД(Отчет)
	Попытка
		Если Отчет.СхемаКомпоновкиДанных=Неопределено Тогда 
			Возврат Ложь; 
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;		
	
	ИнициализироватьКомпоновщикОтчета(Отчет);
	
	СохраненнаяНастройка=ПрочитатьИзРегистраСохраненныеНастройки(ТекАгент, КодОтчета);	
	Если СохраненнаяНастройка=Неопределено Тогда
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		Попытка
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(СохраненнаяНастройка));
		Исключение
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КонецПопытки;
	КонецЕсли;
	Отчет.КомпоновщикНастроек.Восстановить();
	
	_ОтборПоКонтрагенту		= ОтборПоКонтрагенту;
	_ОтборПоДоговору		= ОтборПоДоговору;
	_ОтборПоОтветственному	= ОтборПоОтветственному;
	_ОтборПоНоменклатуре	= ОтборПоНоменклатуре;

	//_ОтборПоКонтрагенту		= ЭлементыФормы.ОтборПоКонтрагенту.Значение;
	//_ОтборПоДоговору		= ЭлементыФормы.ОтборПоДоговору.Значение;
	//_ОтборПоОтветственному	= ЭлементыФормы.ОтборПоОтветственному.Значение;
	//_ОтборПоНоменклатуре	= ЭлементыФормы.ОтборПоНоменклатуре.Значение;

	ЭлементыФормы.ОтборПоКонтрагенту.СписокВыбора.Очистить();
	ЭлементыФормы.ОтборПоДоговору.СписокВыбора.Очистить();
	ЭлементыФормы.ОтборПоОтветственному.СписокВыбора.Очистить();
	ЭлементыФормы.ОтборПоНоменклатуре.СписокВыбора.Очистить();
	                               
	Для Каждого ПолеОтбора Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл		
		Если ТипЗнч(ПолеОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить; // группы отбора пропускаем, у них нет левого значения
		КонецЕсли;
		поле = Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.Элементы.Найти(ПолеОтбора.ЛевоеЗначение);
		
		Если поле = Неопределено Тогда
			ЭлементыФормы.ОтборПоКонтрагенту.СписокВыбора.Добавить(ПолеОтбора.ЛевоеЗначение);
			ЭлементыФормы.ОтборПоДоговору.СписокВыбора.Добавить(ПолеОтбора.ЛевоеЗначение);
			ЭлементыФормы.ОтборПоОтветственному.СписокВыбора.Добавить(ПолеОтбора.ЛевоеЗначение);
			ЭлементыФормы.ОтборПоНоменклатуре.СписокВыбора.Добавить(ПолеОтбора.ЛевоеЗначение);
		иначе			
			Если Поле.Тип.СодержитТип(Тип("СправочникСсылка.Контрагенты")) Тогда
				ЭлементыФормы.ОтборПоКонтрагенту.СписокВыбора.Добавить(Поле.Заголовок);
			ИначеЕсли Поле.Тип.СодержитТип(Тип("СправочникСсылка.ДоговорыКонтрагентов")) Тогда
				ЭлементыФормы.ОтборПоДоговору.СписокВыбора.Добавить(Поле.Заголовок);
			ИначеЕсли Поле.Тип.СодержитТип(Тип("СправочникСсылка.Пользователи")) Тогда
				ЭлементыФормы.ОтборПоОтветственному.СписокВыбора.Добавить(Поле.Заголовок);
			ИначеЕсли Поле.Тип.СодержитТип(Тип("СправочникСсылка.Номенклатура")) Тогда
				ЭлементыФормы.ОтборПоНоменклатуре.СписокВыбора.Добавить(Поле.Заголовок);
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
	// Отбор по контрагенту можно выбрать из любого доступного поля отчета с типом Контрагенты,
	// даже если в настройках отчета такого отбора еще нет (он будет добавлен при формировании отчета)
	ДобавитьДоступныеПоляКонтрагентов(
		Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.Элементы, 
		ЭлементыФормы.ОтборПоКонтрагенту.СписокВыбора);
	ДобавитьПоляКонтрагентовИзСхемы(Отчет.СхемаКомпоновкиДанных, ЭлементыФормы.ОтборПоКонтрагенту.СписокВыбора);
	
	ПроверитьЗаполнениеКолонки(ЭлементыФормы.ОтборПоКонтрагенту, _ОтборПоКонтрагенту);
	ПроверитьЗаполнениеКолонки(ЭлементыФормы.ОтборПоДоговору, _ОтборПоДоговору);
	ПроверитьЗаполнениеКолонки(ЭлементыФормы.ОтборПоОтветственному, _ОтборПоОтветственному);
	ПроверитьЗаполнениеКолонки(ЭлементыФормы.ОтборПоНоменклатуре, _ОтборПоНоменклатуре);
	
	Возврат Истина;
КонецФункции

// Добавляет в список выбора поля отбора по контрагенту доступные поля отчета с типом Контрагенты
// Параметры
//	ДоступныеПоля - КоллекцияДоступныхПолейКомпоновкиДанных
//	СписокВыбора - СписокЗначений, список выбора поля ОтборПоКонтрагенту
//
Процедура ДобавитьДоступныеПоляКонтрагентов(ДоступныеПоля, СписокВыбора)
	Для Каждого Поле Из ДоступныеПоля Цикл
		ИмяПоля = Строка(Поле.Поле);
		Если Найти(ИмяПоля, "ПараметрыДанных") = 1 ИЛИ Найти(ИмяПоля, "СистемныеПоля") = 1 Тогда
			Продолжить;
		КонецЕсли;
		Если Поле.Папка Тогда
			ДобавитьДоступныеПоляКонтрагентов(Поле.Элементы, СписокВыбора);
		ИначеЕсли Поле.Тип.СодержитТип(Тип("СправочникСсылка.Контрагенты")) Тогда
			Если СписокВыбора.НайтиПоЗначению(ИмяПоля) = Неопределено 
				И СписокВыбора.НайтиПоЗначению(Поле.Заголовок) = Неопределено Тогда
				СписокВыбора.Добавить(ИмяПоля, Поле.Заголовок);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Добавляет в список выбора поля отбора по контрагенту поля наборов данных схемы компоновки
// с типом Контрагенты или с именем Контрагент. Нужна, если компоновщик настроек отчета
// не инициализирован схемой и не содержит доступных полей (например, во внешних отчетах)
// Параметры
//	Схема - СхемаКомпоновкиДанных отчета
//	СписокВыбора - СписокЗначений, список выбора поля ОтборПоКонтрагенту
//
Процедура ДобавитьПоляКонтрагентовИзСхемы(Схема, СписокВыбора)
	Для Каждого НаборДанных Из Схема.НаборыДанных Цикл
		Для Каждого Поле Из НаборДанных.Поля Цикл
			Попытка
				ИмяПоля = Поле.ПутьКДанным;
				ЭтоКонтрагент = (ИмяПоля = "Контрагент") 
					ИЛИ Поле.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Контрагенты"));
			Исключение
				// папки полей не содержат пути к данным и типа значения
				Продолжить;
			КонецПопытки;
			Если ЭтоКонтрагент И СписокВыбора.НайтиПоЗначению(ИмяПоля) = Неопределено Тогда
				СписокВыбора.Добавить(ИмяПоля, ?(ПустаяСтрока(Поле.Заголовок), ИмяПоля, Поле.Заголовок));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Открыть форму настройки для отчета, указанного в активной строке таблицы Отчеты
Процедура Кнопка1СНастройкиОтчета(Кнопка)
	Перем СохраненнаяНастройка;	//переменная для получения и отображения ранее сохраненной настройки отчета
	
	Если НЕ ЗначениеЗаполнено(ИмяОтчета) Тогда
		Сообщить("Не задано поле 'ИмяОтчета' для отчета "+НазваниеОтчета);
		Возврат ;
	КонецЕсли; 
	
	Отчет = Неопределено;
	Попытка
		Если ТипОтчета="Из конфигурации" Тогда //из конфигурации
			Отчет = Отчеты[ИмяОтчета].Создать();  //попробуем создать отчет
		ИначеЕсли ТипОтчета="Внешний отчет" Тогда
			Отчет = СоздатьВнешнийОтчетМобиС(ИмяОтчета, ТекАгент);
		КонецЕсли;
	Исключение
		Сообщить("Не удалось найти в конфигурации отчет "+ИмяОтчета);
		Возврат ;
	КонецПопытки; 
	Если Отчет=Неопределено Тогда
		Сообщить("Не удалось найти в конфигурации отчет "+ИмяОтчета);
		Возврат ;
	КонецЕсли;
	
	СохраненнаяНастройка = ПрочитатьИзРегистраСохраненныеНастройки(ТекАгент,КодОтчета);
	
	Попытка
		Если Отчет.СхемаКомпоновкиДанных = Неопределено Тогда 
			Возврат; 
		КонецЕсли;

		ИнициализироватьКомпоновщикОтчета(Отчет);
		
		Если СохраненнаяНастройка = Неопределено Тогда
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		Иначе
			Попытка
				Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(СохраненнаяНастройка));
			Исключение
				Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
			КонецПопытки;
		КонецЕсли;
		
		Отчет.КомпоновщикНастроек.Восстановить();
		
		ФормаНастройка = ПолучитьФорму("НастройкиСКД", ЭтаФорма);
		ФормаНастройка.КомпоновщикНастроек=Отчет.КомпоновщикНастроек;
		
		Если ФормаНастройка.ОткрытьМодально() = Истина Тогда		
			СохраненнаяНастройка = ЗначениеВСтрокуВнутр(ФормаНастройка.КомпоновщикНастроек.ПолучитьНастройки());		
			ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, СохраненнаяНастройка, КодОтчета);
		КонецЕсли;
		
		ВыборОтчетаСКД(Отчет);
	Исключение
	КонецПопытки;
КонецПроцедуры

// процедура обновления списков для настройки поле отбора
Процедура ОбновитьПоляОтбора()
	Перем СохраненнаяНастройка;	//переменная для получения и отображения ранее сохраненной настройки отчета
	
	Отчет = Неопределено;
	Попытка
		Если ТипОтчета = "Встроенный" Тогда
			Возврат;
		ИначеЕсли ТипОтчета = "Из конфигурации" Тогда //из конфигурации
			Отчет = Отчеты[ИмяОтчета].Создать();  //попробуем создать отчет
		ИначеЕсли ТипОтчета = "Внешний отчет" Тогда
			Отчет = СоздатьВнешнийОтчетМобиС(ИмяОтчета, ТекАгент);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки; 
	Если Отчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыборОтчетаСКД(Отчет);
	
КонецПроцедуры

// обработчик вызываемый до открытия формы для обновления формы
Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	ЗакрыватьПриЗакрытииВладельца = Истина;
	
КонецПроцедуры

// обработчик изменения типа отчета
Процедура ТипОтчетаПриИзменении(Элемент)
	ЭтоВстроенныйОтчет = ТипОтчета = "Встроенный";
	ЭлементыФормы.Кнопка1СНастройкиОтчета.Доступность 	= НЕ ЭтоВстроенныйОтчет;
	ЭлементыФормы.ОтборПоКонтрагенту.Доступность 		= (НЕ ЭтоВстроенныйОтчет) И ПараметрыИзКПК;
	ЭлементыФормы.ОтборПоДоговору.Доступность 			= (НЕ ЭтоВстроенныйОтчет) И ПараметрыИзКПК;
	ЭлементыФормы.ОтборПоНоменклатуре.Доступность 		= (НЕ ЭтоВстроенныйОтчет) И ПараметрыИзКПК;
	ЭлементыФормы.ОтборПоОтветственному.Доступность 	= (НЕ ЭтоВстроенныйОтчет) И ПараметрыИзКПК;
	ЭлементыФормы.ПараметрыИзКПК.Доступность			= НЕ ЭтоВстроенныйОтчет;
	ЭлементыФормы.ИмяОтчета.Доступность					= НЕ ЭтоВстроенныйОтчет;
	Если ЭтоВстроенныйОтчет Тогда
		ИмяОтчета = "";
		ОтборПоДоговору = "";
		ОтборПоКонтрагенту = "1";
		ОтборПоНоменклатуре = "";
		ОтборПоОтветственному = "";		
		ПараметрыИзКПК = Ложь;
	КонецЕсли;
КонецПроцедуры

// обработчик выбора типа отчета
Процедура ТипОтчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если НЕ ТипОтчета = ВыбранноеЗначение Тогда
	// изменился тип отчета, необходимо выбрать соответствующий отчет
		ТипОтчета = ВыбранноеЗначение;
		СтандартнаяОбработка2 = Истина;
		ИмяОтчетаНачалоВыбора(ЭлементыФормы.ИмяОтчета, СтандартнаяОбработка2);		
	КонецЕсли;	
КонецПроцедуры

// обработчик выбора отчета необходимого типа
Процедура ИмяОтчетаНачалоВыбора(Элемент, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	СтандартнаяОбработка=ложь;
	
	Если ТипОтчета = "Из конфигурации" Тогда
		ОтчетыИзКонфигурации = Новый СписокЗначений;
		Для Каждого Отчет Из Метаданные.Отчеты Цикл
			Если Отчет.ОсновнаяСхемаКомпоновкиДанных <> Неопределено Тогда
				ОтчетыИзКонфигурации.Добавить("" + Отчет.Имя, "" + Отчет);
			КонецЕсли;
		КонецЦикла;
		ОтчетыИзКонфигурации.СортироватьПоПредставлению();
		ТекОтчет = ОтчетыИзКонфигурации.НайтиПоЗначению(ИмяОтчета);
		ТекОтчет = ОтчетыИзКонфигурации.ВыбратьЭлемент("Выберите отчет",текОтчет);
		Если ТекОтчет <> Неопределено Тогда
			Попытка
				Отчет = Отчеты[ТекОтчет.Значение].Создать();
			Исключение                               
				Сообщить("Не удалось найти в конфигурации отчет "+ТекОтчет.Значение);
				Возврат;
			КонецПопытки;
			Если НЕ ВыборОтчетаСКД(Отчет) Тогда
				Предупреждение("Отчёт должен быть построен на базе СКД");
				Возврат;
			КонецЕсли;
			
			ИмяОтчета      = ТекОтчет.Значение;
			НазваниеОтчета = ТекОтчет.Представление;
		КонецЕсли; 
	ИначеЕсли ТипОтчета = "Внешний отчет" Тогда
		
		ДиалогФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогФайла.Фильтр = "Внешний отчёт(*.erf)|*.erf";
		ДиалогФайла.Каталог = ПолучитьКаталог("ExtReps");
		ВнешнийОтчет = Неопределено;
		ОК = Истина;
		Если ДиалогФайла.Выбрать() Тогда
			СообщениеОшибки = "Выбранный файл НЕ является внешним отчётом
			|или данная обработка содержит синтаксические ошибки";
			Попытка
				ПолноеИмяФайлаОбработки = ДиалогФайла.ПолноеИмяФайла;
				ВнешнийОтчет = ВнешниеОтчеты.Создать(ПолноеИмяФайлаОбработки);
			Исключение
				Предупреждение(ОписаниеОшибки());
				Возврат;
			КонецПопытки;
			
			Если НЕ ВыборОтчетаСКД(ВнешнийОтчет) Тогда
				Предупреждение("Отчёт должен быть построен на базе СКД");
				Возврат;
			КонецЕсли;
			
			НазваниеОтчета   = ВнешнийОтчет.Метаданные().Синоним;
			ИмяОтчета        = ДиалогФайла.ПолноеИмяФайла;
		Иначе
			Ок = Ложь;  //Отказ от выбора файла
			НазваниеОтчета   = "";
			ИмяОтчета        = "";
			Возврат;
		КонецЕсли;
	КонецЕсли; 
КонецПроцедуры

// обработчик открытия формы
Процедура ПриОткрытии()
	ЗапрашиватьПериодПриИзменении(Неопределено);
	ПараметрыИзКПКПриИзменении(Неопределено);
	ПриИзмененииНастройкиПериодаОтчета(Неопределено);
	ТипОтчетаПриИзменении(Неопределено);
	ОбновитьПоляОтбора();
КонецПроцедуры

// обработчик изменения состояния флага запроса периода отчета с КПК
Процедура ЗапрашиватьПериодПриИзменении(Элемент)
	ЭлементыФормы.НадписьТипСмещенияНачальнойДаты.Доступность 			= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.ТипСмещенияНачальнойДаты.Доступность 					= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.НадписьСмещениеНачальнойДаты.Доступность 				= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.НадписьЗначениеКонечнойДаты.Доступность 				= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.ЗначениеКонечнойДаты.Доступность 						= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.НадписьВыбранныйПериодНаСегодняшнееЧисло.Доступность 	= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.НадписьРасчётныйПериодОтчета.Доступность 				= НЕ ЗапрашиватьПериод;
	ЭлементыФормы.СмещениеНачальнойДаты.Доступность						= НЕ ЗапрашиватьПериод;
КонецПроцедуры

// обработчик изменения состояния флага использования отбора
Процедура ПараметрыИзКПКПриИзменении(Элемент)
	ТипОтчетаПриИзменении(Неопределено);
КонецПроцедуры

