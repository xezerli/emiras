Функция ИнформацияОСистемеКратко()
	
	онлайнКлючей = КоличествоOnLineКлючей();

	СисИнфо = Новый СистемнаяИнформация;		
	ОС = СисИнфо.ВерсияОС;
	Платформа_ = СисИнфо.ВерсияПриложения + ?(ВерсияПлатформы = 81, ""," (" + СисИнфо.ТипПлатформы + ")");
	Конфигурация_ = Метаданные.Имя + " (" + Метаданные.Версия +  ")";
	ТипБазы = Лев(СтрокаСоединенияИнформационнойБазы(), 3);
	
	ЧислоКлючей = 0;
	Ключи=ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"СписокКПК");
	Если Ключи <> Неопределено Тогда
	Иначе
		ЧислоКлючей = Ключи.Количество();
	КонецЕсли;
	
	датаБиблиотеки = "нет данных";
	Если Сервер <> Неопределено Тогда
		датаБиблиотеки = Сервер.ПолучитьДатуСборки();
	КонецЕсли;
		
	Возврат 
		"Обработка: " + ВерсияОбработки + ?(ЧислоКлючей + онлайнКлючей > 0, " " + Формат(ЧислоКлючей, "ЧДЦ=0; ЧН=0; ЧГ=0") + "/" + Формат(онлайнКлючей, "ЧДЦ=0; ЧН=0; ЧГ=0"), "") + "
		|Основной каталог: " + КаталогЛогФайлов + "
		|Конфигурация: " + Конфигурация_ + "
		|Платформа: " + Платформа_ + "
		|PocketServer: " + датаБиблиотеки + "
		|Версия ОС: " + ОС;
КонецФункции

Процедура КнопкаИнформацияСпособПредоставленияБонусовНажатие(Элемент)
	текст = ИнформацияОСистемеКратко();
		
	Попытка
	    htmlFile = Новый COMОбъект("htmlfile");
	    htmlFile.ParentWindow.ClipboardData.Setdata("Text", Текст);
		текст = "Скопировано в буфер обмена
		|" + текст;
	Исключение
	КонецПопытки;
	
	Сообщить(текст);	
КонецПроцедуры

