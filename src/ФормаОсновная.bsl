// Формирует таблицу печатных форм для КПК
// Возвращаемое значение:
// 		ТаблицаЗначений, колонки:
// 			Наименование - Строка, название формы для пользователя КПК
// 			КодВладельца - Число, код объекта, которому принадлежит форма
// 			ФайлФормы - Строка, путь к файлу формы
Функция ПрочитатьПечатныеФормы() Экспорт
	ТаблПечФорм=Новый ТаблицаЗначений;
	ТаблПечФорм.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка"));
	ТаблПечФорм.Колонки.Добавить("КодВладельца",Новый ОписаниеТипов("Число"));
	ТаблПечФорм.Колонки.Добавить("ФайлФормы",Новый ОписаниеТипов("Строка"));
	
	НовСтр=ТаблПечФорм.Добавить();
	НовСтр.Наименование="ТОРГ-12";
	НовСтр.КодВладельца=12;
	НовСтр.ФайлФормы="torg12.xml";
	
	Если Конфигурация = "БухКазахстан" Тогда
		
		НовСтр=ТаблПечФорм.Добавить();
		НовСтр.Наименование="Счёт-фактура";
		НовСтр.КодВладельца=12;
