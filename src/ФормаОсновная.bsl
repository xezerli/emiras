							массивПродажаВозврат.Добавить(Новый Структура("Дата, Количество", 
							Выборка.ДатаПосещения, Выборка.КоличествоВозврат));
						КонецЕсли;
					КонецЦикла;
					
					строкаДни = "";
					строкаДействия = "";
					оформлениеПродажа = "";
					
					Для каждого стр из массивПродажаВозврат Цикл
						оформлениеПродажа = "<font color=" + ?(стр.Количество > 0, ЦветПродажа, ЦветВозврат) + ">";
						строкаДни = строкаДни + оформлениеПродажа + Формат(стр.Дата, "ДФ=дд.ММ") + "</font>";
