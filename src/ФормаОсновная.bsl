// Отправляет на КПК настройки колонок документов в соответствии с протоколом обмена
// Параметры:
// 		Адрес - Строка, адрес КПК
// Возвращаемое значение:
// 		Истина - успех
// 		Ложь - ошибка
Функция ВыгрузитьНастройкиКолонокДокументов(Адрес)
	Если НЕ ПорцияОбмена(Адрес,"DocColumns","Выгружаются настройки колонок документов...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Ответ = "";
	Табл=ПолучитьНастройкиКолонокДокументов();
	Для Каждого Стр Из Табл Цикл
		Ответ=Ответ
			+ ЦелоеВСтроку(Стр.Документ)+Таб
			+ ЦелоеВСтроку(Стр.Ячейка)+Таб
			+ УбратьСпецСимволы(Стр.Заголовок)+Таб
			+ УбратьСпецСимволы(Стр.Значение)+Таб
			+ ЦелоеВСтроку(Стр.Цвет)+РазделительСтрок;
	КонецЦикла;
		
	Возврат ПорцияОбмена(
		Адрес,
		Ответ,
		"Настройки колонок документов выгружены "+Табл.Количество()+" записей",
		"Ошибка выгрузки настроек колонок документов");
КонецФункции

Функция ПолучитьНумератор1(Агент, ВидДокумента1С, ВидДокументаМобиС)
	Нумератор = 
		"SELECT '" 
			+ Прав("0000"+СокрЛП(Агент.ФизЛицо.Код),4) + "'" 
			+ "||strftime('%m',date('now','localtime'))"
			+ "||strftime('%d',date('now','localtime'))"
			+ "||SUBSTR('00000000000'||"+ВидДокументаМобиС+".ID,-3)";
	Нумератор = Нумератор 
		+ " FROM " + ВидДокументаМобиС + " WHERE ID=?";	
	Возврат Нумератор;
КонецФункции

Функция ПолучитьНумератор2(Агент, ВидДокумента1С, ВидДокументаМобиС)
	Нумератор="SELECT CASE Firms.Prefix ";
	ВыборкаОрг=Справочники.Организации.Выбрать();
	Пока ВыборкаОрг.Следующий() Цикл
		ДлинаПрефиксаФирмы=СтрДлина(СокрЛП(ВыборкаОрг.Префикс));
		ДлинаНачалаКода=0; ДлинаНомера=0; ДлинаКодаАгента=0;
		Если ДлинаПрефиксаФирмы=3 Тогда
			ДлинаНачалаКода=7;
			ДлинаКодаАгента=3;
			ДлинаНомера=4;
		ИначеЕсли ДлинаПрефиксаФирмы=2 Тогда
			ДлинаНачалаКода=7;
			ДлинаКодаАгента=4;
			ДлинаНомера=4;
		ИначеЕсли ДлинаПрефиксаФирмы=1 Тогда
			ДлинаНачалаКода=6;
			ДлинаКодаАгента=4;
			ДлинаНомера=5;
		ИначеЕсли ДлинаПрефиксаФирмы=0 Тогда
			ДлинаНачалаКода=6;
			ДлинаКодаАгента=5;
			ДлинаНомера=5;
		Иначе
			Сообщить("Префикс организации "+ВыборкаОрг.Наименование+" превышает 3 символа");
			Продолжить;
		КонецЕсли;
		
		НачалоКода=СокрЛП(ВыборкаОрг.Префикс)+"_"+Прав("00000000000"+СокрЛП(Агент.ФизЛицо.Код),ДлинаКодаАгента);
		Запрос=Новый Запрос;
		Запрос.Текст="
			|ВЫБРАТЬ МАКСИМУМ(Док.Номер) КАК МаксНомер
			|ИЗ Документ."+ВидДокумента1С+" КАК Док
			|ГДЕ ПОДСТРОКА(Док.Номер,1,"+ДлинаНачалаКода+")=&НачалоКода";
		Запрос.Параметры.Вставить("НачалоКода",НачалоКода);
		Выборка=Запрос.Выполнить().Выбрать();
		МаксНомер="00000000000";
		Если Выборка.Следующий() Тогда
			Если ЗначениеЗаполнено(Выборка.МаксНомер) Тогда
				МаксНомер=Выборка.МаксНомер;
			КонецЕсли;
		КонецЕсли;
		МаксНомер=Число(Прав(МаксНомер,ДлинаНомера));
		
		Нумератор = Нумератор 
			+ " WHEN '"+СокрЛП(ВыборкаОрг.Префикс) 
			+ "' THEN '"
			+ НачалоКода+"'||SUBSTR('00000000000'||("+ВидДокументаМобиС+".ID+"+ЦелоеВСтроку(МаксНомер)+"),-"+Строка(ДлинаНомера)+")";
	КонецЦикла;
	Нумератор = Нумератор
		+ "END FROM " + ВидДокументаМобиС 
		+ " INNER JOIN Firms ON Firms.ID="+ВидДокументаМобиС+".Firm WHERE "+ВидДокументаМобиС+".ID=?";	
	Возврат Нумератор;
КонецФункции

Функция ПолучитьНачальныйНомер(Агент, ВидДокумента1С)
	ТекДата=НачалоДня(ТекущаяДата());
	Запрос=Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Свойства.Значение КАК УникКод ИЗ
	|	(ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Документ." + ВидДокумента1С + " ГДЕ Дата >= &ТекДата) КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Свойства ПО (Свойства.Объект = Док.Ссылка) ГДЕ
	|			Свойства.Свойство = &УникКодДокумента 
	|			И Док.Ссылка.Ответственный = &Агент";
	Запрос.Параметры.Вставить("УникКодДокумента", ПВХУникКодДокумента);
	Запрос.Параметры.Вставить("ТекДата",ТекДата);
	Запрос.Параметры.Вставить("Агент",Агент);
	Выборка=Запрос.Выполнить().Выбрать();
	НачНомер=1;
	
	СтрТекДата=Формат(ТекДата,"ДФ=dd.MM.yyyy");
	Пока Выборка.Следующий() Цикл
		Попытка
			УникКод=Выборка.УникКод;
			Если Не ЗначениеЗаполнено(УникКод) Тогда Продолжить; КонецЕсли;
			Если Найти(УникКод,СтрТекДата)=0 Тогда Продолжить; КонецЕсли;;
			Части=СтрЗаменить(УникКод,"_",РазделительСтрок);
			Если СтрЧислоСтрок(Части)<2 Тогда Продолжить; КонецЕсли;
			УникКод=СтрПолучитьСтроку(Части,2);
			Части=СтрЗаменить(УникКод," ",РазделительСтрок);
			Если СтрЧислоСтрок(Части)<2 Тогда Продолжить; КонецЕсли;
			ТекНомер=Число(СтрПолучитьСтроку(Части,1));
			Если ТекНомер<=0 Тогда Продолжить; КонецЕсли;
			НачНомер=Макс(НачНомер,ТекНомер+1);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат ЦелоеВСтроку(НачНомер);
КонецФункции

