//Выгружает формы, с которыми будет работать агент
// Параметры
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьПечатныеФормы(Адрес)
	Если НЕ ПорцияОбмена(Адрес,"PrnForms","Выгружаются печатные формы...") Тогда
		Возврат Ложь;
	КонецЕсли;
	ТаблПечФорм = Новый ТаблицаЗначений;
	Табл = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ПечатныеФормы");
	Если ТипЗнч(Табл) = Тип("ТаблицаЗначений") Тогда
		ТаблПечФорм = Табл.Скопировать(Новый Структура("Исп", Истина), "Наименование, ФайлФормы, КодВладельца");
	Иначе
		ТаблПечФорм = ПрочитатьПечатныеФормы();
	КонецЕсли;
	Счетчик=0;
	Ответ="";
	НомСтр=1;
	ТекстДок = Новый ТекстовыйДокумент;
	
	Для Каждого СтрПечФормы Из ТаблПечФорм Цикл
		Если НЕ ЗначениеЗаполнено(СтрПечФормы.ФайлФормы) Тогда Продолжить; КонецЕсли;
		
		ПолныйПуть = ПолучитьКаталог("Forms")+"\"+СокрЛП(СтрПечФормы.ФайлФормы);
		Файл=Новый Файл(ПолныйПуть);
		Если Файл.Существует() Тогда
			ТекстДок.Прочитать(ПолныйПуть,КодировкаТекста.UTF8);
			ТекстФормы=ТекстДок.ПолучитьТекст();
			Ответ=Ответ
				+ УбратьСпецСимволы(Лев(СтрПечФормы.Наименование,30))+Таб
				+ ЦелоеВСтроку(СтрПечФормы.КодВладельца)+Таб
				+ УбратьСпецСимволы(ТекстФормы)+РазделительСтрок;
			
			НомСтр=НомСтр+1;
			Счетчик=Счетчик+1;
		Иначе
			ДобавитьОшибку("Не найдена печатная форма "+СтрПечФормы.ФайлФормы);
		КонецЕсли; 
	КонецЦикла;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Печатные формы выгружено "+Счетчик+" записей","Ошибка выгрузки Печатных форм");
КонецФункции

