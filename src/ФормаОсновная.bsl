				стрТЗ.ИсторияПродаж = "<tt>"
					+ "<font color=" + ЦветТекст + ">Продажа&nbsp;</font>" + "<font color=" + ЦветПродажа + ">"
						+ "данных&nbsp;нет&gt; " + ЧислоВСтроку(КолвоМесяцевНазадДляИстории) + "&nbsp;мес." + "</font><br/>"
					+ "<font color=" + ЦветТекст + ">Остаток&nbsp;</font>" + "<font color=" + ЦветОстаток + ">" 
						+ Формат(стрОстаток.ДатаОстатка, "ДФ=дд.ММ") + " = " + СтрЗаменить(стрОстаток.Остаток, " ", "&nbsp;") 
						+ "&nbsp;" + СтрЗаменить(СокрЛП(Лев(Строка(Единица), 6)), " ", "&nbsp;") 
						+ "</font>"
					+ "</tt>";
				стрТЗ.ПроданоЗаТриПоследнихПосещения = 0;
				стрТЗ.КоличествоПосещений            = 0;
				стрТЗ.МинимДатаПродажи               = ТекДата;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//определим план
	//на КПК План продаж ВСЕГДА округляется до целого значения, если выгружен числом (по продаже, по заявке)
	
	Если ПараметрыАгента.ТипРекомендуемогоПлана = 0 Тогда  //По правилу 1,5
		Запрос = Новый Запрос;
		//в ТаблНоменклатуры Остаток всегда в базовой единице
		Запрос.Текст = ТекстКлиентыИТовары + "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(ТоварИзОстатков.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ТоварИзОстатков.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
		|	ВЫРАЗИТЬ(ТоварИзОстатков.АдресДоставки КАК СТРОКА(200)) КАК АдресДоставки,
		|	ВЫРАЗИТЬ(ТоварИзОстатков.ДатаОстатка КАК ДАТА) КАК ДатаОстатка,
		|	ВЫРАЗИТЬ(ТоварИзОстатков.Остаток КАК ЧИСЛО) КАК Остаток
		|ПОМЕСТИТЬ ТаблОст
		|ИЗ
		|	&ТаблОстатков КАК ТоварИзОстатков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Документ.Ссылка.Контрагент КАК Контрагент,
		|	Документ.Номенклатура КАК Номенклатура,
		|	НАЧАЛОПЕРИОДА(Документ.Ссылка.Дата, ДЕНЬ) КАК ДатаПосещения,
		|	Выбор когда Документ.Коэффициент = 0 Тогда Документ.Количество Иначе ЕСТЬNULL(Документ.Количество, 0) / ЕСТЬNULL(Документ.Коэффициент, 1) Конец КАК Количество,
		|	Документ.Ссылка
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремАдреса КАК ВремАдреса
		|		ПО Документ.Ссылка.Контрагент = ВремАдреса.Контрагент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблТов КАК ТаблТов
		|		ПО (ТаблТов.Номенклатура = Документ.Номенклатура)
		|ГДЕ
		|	Документ.Ссылка.Дата >= &НачалоПериода
		|	И Документ.Ссылка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВремАдреса.ИдКонтр КАК ИдКонтр,
		|	ВремАдреса.АдресДоставки КАК АдресДоставки,
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.ДатаПосещения КАК ДатаПосещения,
		|	Таблица.Количество КАК Количество,
		|	ЕСТЬNULL(ТаблОст.Остаток, 0) КАК Остаток,
		|	ТаблОст.ДатаОстатка КАК ДатаОстатка
		|ИЗ
		|	Таблица КАК Таблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремАдреса КАК ВремАдреса
		|		ПО Таблица.Контрагент = ВремАдреса.Контрагент
		|			И (&НЕСоздаватьТТпоАдресам
		|				ИЛИ (ВЫРАЗИТЬ(Таблица.Ссылка.АдресДоставки КАК СТРОКА(200))) = ВремАдреса.АдресДоставки)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблОст КАК ТаблОст
		|		ПО Таблица.Номенклатура = ТаблОст.Номенклатура
		|			И Таблица.Контрагент = ТаблОст.Контрагент
		|			И (&НЕСоздаватьТТпоАдресам
		|				ИЛИ (ВЫРАЗИТЬ(Таблица.Ссылка.АдресДоставки КАК СТРОКА(200))) = ТаблОст.АдресДоставки)
		|ГДЕ
		|	Таблица.Ссылка ССЫЛКА Документ.РеализацияТоваровУслуг
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПосещения УБЫВ
		|ИТОГИ
		|	СУММА(Количество),
		|	МАКСИМУМ(Остаток),
		|	МАКСИМУМ(ДатаОстатка)
		|ПО
		|	ИдКонтр,
		|	АдресДоставки,
		|	Номенклатура,
		|	ДатаПосещения
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Если тзОстатки = Неопределено Тогда 		
			Блокировщик = Неопределено;	
			БД = ОткрытьВнешнююБД(Блокировщик, Ложь);
			Если БД = Ложь Тогда
				Сообщить("Не удалось получить данные файла mobi_s.mdb, проверьте лог ошибок!", СтатусСообщения.Важное);
			Иначе			
				тзОстатки = новый ТаблицаЗначений();
				тзОстатки.колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
				тзОстатки.колонки.Добавить("ИдКонтр", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
				тзОстатки.колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
				тзОстатки.колонки.Добавить("АдресДоставки", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
				тзОстатки.колонки.Добавить("ДатаОстатка", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
				тзОстатки.колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
				
				Для каждого стрТЗ Из тзАдресовДоставки Цикл
					Остаток = 0;
					КолвоЗаписей = 0;
					ТекстЗапроса = "
					|SELECT OSTATKI.NOMENKLATURA, MIN(OSTATKI.OSTATOK) AS Ostatok, MAX(OSTATKI_POSL.MAXDATA) AS MAXDATA
					|FROM OSTATKI
					|    INNER JOIN (
					|        SELECT NOMENKLATURA, MAX(DATA) AS MAXDATA
					|        FROM OSTATKI
					|        WHERE KONTRAGENT=?
					|        GROUP BY NOMENKLATURA
					|    ) AS OSTATKI_POSL ON OSTATKI.NOMENKLATURA=OSTATKI_POSL.NOMENKLATURA
					|        AND OSTATKI.DATA = OSTATKI_POSL.MAXDATA
					|WHERE (OSTATKI.KONTRAGENT =?)
					|GROUP BY OSTATKI.NOMENKLATURA";
					Подгзапрос = БДПодготовитьЗапрос(БД, ТекстЗапроса);
					БДУстановитьПараметр(ПодгЗапрос, 1, СокрЛП(стрТЗ.ИдКонтр));
					БДУстановитьПараметр(ПодгЗапрос, 2, СокрЛП(стрТЗ.ИдКонтр));
					Пока БДСледующаяЗапись(ПодгЗапрос) Цикл
						
						Остаток = БДЗначениеВКолонке(ПодгЗапрос, 1);
						Если Остаток < 0 Тогда
							Остаток = 0;
						КонецЕсли; 
						идНом = БДЗначениеВКолонке(ПодгЗапрос, 0);
						ДатаОстатка = ДатаИзSQLite(БДЗначениеВКолонке(ПодгЗапрос, 2));
						мНоменклатура = ПолучитьСсылкуПоGUID(идНом, "Номенклатура");
						Если Номенклатура.Найти(мНоменклатура) = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						новСтр = тзОстатки.Добавить();
						новСтр.АдресДоставки = стрТЗ.АдресДоставки;
						новСтр.Контрагент = стрТЗ.Контрагент;
						новСтр.ИдКонтр = стрТЗ.ИдКонтр;
						новСтр.Номенклатура = мНоменклатура;
						новСтр.ДатаОстатка = НачалоДня(ДатаОстатка);
						новСтр.Остаток = Остаток;
						
					КонецЦикла; 
				БДЗакрытьПодготовленныйЗапрос(ПодгЗапрос);						
				КонецЦикла; 	
			КонецЕсли;
			ЗакрытьВнешнююБД(БД, Блокировщик);
		КонецЕсли;
		
		Запрос.Параметры.Вставить("ТаблОстатков", тзОстатки);			
		Запрос.УстановитьПараметр("Табл", тзАдресовДоставки);
		Запрос.УстановитьПараметр("ТаблНоменклатуры", Номенклатура);
		Запрос.Параметры.Вставить("НЕСоздаватьТТпоАдресам", (СпособОрганизацииТТ = 0));
		Запрос.Параметры.Вставить("НачалоПериода", НачалоДня(ДобавитьМесяц(ТекущаяДата(), -КолвоМесяцевНазадДляПлана)));
		
		Результат = Запрос.Выполнить();
		ВыборкаИдКонтр = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаИдКонтр.Следующий() Цикл
			ВыборкаАдресДоставки = ВыборкаИдКонтр.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаАдресДоставки.Следующий() Цикл
				ВыборкаНоменклатура = ВыборкаАдресДоставки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаНоменклатура.Следующий() Цикл
					Выборка = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Попыток = 0;
					ПродажаКоличество = 0;
					ОстатокКоличество = 0;
					ДобавитьСтрокуВПлан = Истина;											
					Пока Выборка.Следующий() Цикл
						Если Попыток = 0 Тогда
							ПродажаКоличество = Выборка.Количество;
							ОстатокКоличество = Выборка.Остаток;
						КонецЕсли;
						
						Если Выборка.ДатаОстатка >= Выборка.ДатаПосещения Тогда
							//(ПоследнийСнятыйОстаток+ПоследняяРеализация-ТекущийОстаток)*1.5/КолвоРеализаций-ТекущийОстаток
							План="("+Формат(ОстатокКоличество, "ЧДЦ=3; ЧРД=.; ЧН=; ЧГ=") + "+" 
								+ Формат(ПродажаКоличество,"ЧДЦ=3; ЧРД=.; ЧН=; ЧГ=")+"-КонОстаток)*1.5"+"-КонОстаток";
							//необходимо получить ИД контрагента из адреса и ссылки на него
							стр=тзПлан.Добавить();
							стр.План		   = План;
							стр.ИдКонтр        = СокрЛП(Выборка.ИдКонтр);
							стр.Номенклатура   = Выборка.Номенклатура;
							стр.ИсторияПродаж  = "";
							ДобавитьСтрокуВПлан = Ложь;
							Прервать;	
						Иначе
							Попыток = Попыток + 1;
						КонецЕсли;
						
						Если Попыток > 1 Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ДобавитьСтрокуВПлан Тогда
					//была только одна продажа в рассматриваемом периоде, остаток был снят ранее
						Если Попыток = 1 Тогда
							План="("+Формат(ОстатокКоличество, "ЧДЦ=3; ЧРД=.; ЧН=; ЧГ=") + "+" 
								+ Формат(ПродажаКоличество,"ЧДЦ=3; ЧРД=.; ЧН=; ЧГ=")+"-КонОстаток)*1.5"+"-КонОстаток";
							//необходимо получить ИД контрагента из адреса и ссылки на него
							стр=тзПлан.Добавить();
							стр.План			= План;
							стр.ИдКонтр 		= СокрЛП(ВыборкаНоменклатура.ИдКонтр);
							стр.Номенклатура 	= ВыборкаНоменклатура.Номенклатура;
							стр.ИсторияПродаж	= "";
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	ИначеЕсли ПараметрыАгента.ТипРекомендуемогоПлана = 1 ИЛИ ПараметрыАгента.ТипРекомендуемогоПлана = 2 Тогда  //Последняя реализация(1) / заявка(2)
	//в этом режиме на КПК в качестве плана выгружаются суммарные данные по продажам 
	//из документов с максимальной датой (для 2х и более за один день - товарные части документов будут суммированы)
	//а не данные по последней продаже товара клиенту		
		
		Запрос = Новый Запрос;
		Если ПараметрыАгента.ТипРекомендуемогоПлана = 1 Тогда 
			ТекстУсловие = "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Документ.Ссылка.Контрагент КАК Контрагент,
			|	Документ.Номенклатура КАК Номенклатура,
			|	НАЧАЛОПЕРИОДА(Документ.Ссылка.Дата, ДЕНЬ) КАК ДатаПосещения,
			|	СУММА(Выбор когда Документ.Коэффициент = 0 Тогда Документ.Количество Иначе ЕСТЬNULL(Документ.Количество / ЕСТЬNULL(Документ.Коэффициент, 1), 0) Конец) КАК Количество,
			|	Документ.Ссылка
			|ПОМЕСТИТЬ Таблица
			|ИЗ
			|	Документ.РеализацияТоваровУслуг.Товары КАК Документ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремАдреса КАК ВремАдреса
			|		ПО Документ.Ссылка.Контрагент = ВремАдреса.Контрагент
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблТов КАК ТаблТов
			|		ПО (ТаблТов.Номенклатура = Документ.Номенклатура)
			|ГДЕ
			|	Документ.Ссылка.Дата >= &НачалоПериода
			|	И Документ.Ссылка.Проведен
			|
			|СГРУППИРОВАТЬ ПО
			|	Документ.Ссылка.Контрагент,
			|	Документ.Номенклатура,
			|	Документ.Ссылка,
			|	НАЧАЛОПЕРИОДА(Документ.Ссылка.Дата, ДЕНЬ)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Таблица.Номенклатура КАК Номенклатура,
			|	Таблица.ДатаПосещения КАК ДатаПосещения,
			|	Таблица.Количество КАК Количество,
			|	ВремАдреса.ИдКонтр КАК ИдКонтр,
			|	ВремАдреса.АдресДоставки КАК АдресДоставки
			|ИЗ
			|	Таблица КАК Таблица
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремАдреса КАК ВремАдреса
			|		ПО Таблица.Контрагент = ВремАдреса.Контрагент
			|			И (&НЕСоздаватьТТпоАдресам
			|				ИЛИ (ВЫРАЗИТЬ(Таблица.Ссылка.АдресДоставки КАК СТРОКА(200))) = ВремАдреса.АдресДоставки)
			|ГДЕ
			|	Таблица.Ссылка ССЫЛКА Документ.РеализацияТоваровУслуг
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаПосещения УБЫВ
			|ИТОГИ
			|	СУММА(Количество)
			|ПО
			|	ДатаПосещения,
			|	ИдКонтр,
			|	АдресДоставки,
			|	Номенклатура";
		Иначе
			ТекстУсловие = "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Документ.Ссылка.ДоговорКонтрагента.Владелец КАК Контрагент,
			|	Документ.Номенклатура КАК Номенклатура,
			|	НАЧАЛОПЕРИОДА(Документ.Ссылка.Дата, ДЕНЬ) КАК ДатаПосещения,
			|	СУММА(Документ.Количество) КАК Количество,
			|	Документ.Ссылка
			|ПОМЕСТИТЬ Таблица
			|ИЗ
			|	Документ.СчетНаОплатуПокупателю.Товары КАК Документ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремАдреса КАК ВремАдреса
			|		ПО Документ.Ссылка.ДоговорКонтрагента.Владелец = ВремАдреса.Контрагент
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблТов КАК ТаблТов
			|		ПО (ТаблТов.Номенклатура = Документ.Номенклатура)
			|ГДЕ
			|	Документ.Ссылка.Дата >= &НачалоПериода
			|	И НЕ Документ.Ссылка.ПометкаУдаления
			|
			|СГРУППИРОВАТЬ ПО
			|	Документ.Ссылка.ДоговорКонтрагента.Владелец,
			|	Документ.Номенклатура,
			|	Документ.Ссылка,
			|	НАЧАЛОПЕРИОДА(Документ.Ссылка.Дата, ДЕНЬ)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Таблица.Номенклатура КАК Номенклатура,
			|	Таблица.ДатаПосещения КАК ДатаПосещения,
			|	Таблица.Количество КАК Количество,
			|	ВремАдреса.ИдКонтр КАК ИдКонтр,
			|	ВремАдреса.АдресДоставки КАК АдресДоставки
			|ИЗ
			|	Таблица КАК Таблица
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремАдреса КАК ВремАдреса
			|		ПО Таблица.Контрагент = ВремАдреса.Контрагент
			|			И (&НЕСоздаватьТТпоАдресам
			|				ИЛИ (ВЫРАЗИТЬ(Таблица.Ссылка.АдресДоставки КАК СТРОКА(200))) = ВремАдреса.АдресДоставки)
			|ГДЕ
			|	Таблица.Ссылка ССЫЛКА Документ.СчетНаОплатуПокупателю
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаПосещения УБЫВ
			|ИТОГИ
			|	СУММА(Количество)
			|ПО
			|	ДатаПосещения,
			|	ИдКонтр,
			|	АдресДоставки,
			|	Номенклатура";
		КонецЕсли;
		
		Запрос.Текст = ТекстКлиентыИТовары + ТекстУсловие;
		Запрос.УстановитьПараметр("Табл", тзАдресовДоставки);
		Запрос.УстановитьПараметр("ТаблНоменклатуры", Номенклатура);
		Запрос.УстановитьПараметр("НЕСоздаватьТТпоАдресам", (СпособОрганизацииТТ = 0));
		Запрос.Параметры.Вставить("НачалоПериода", НачалоДня(ДобавитьМесяц(ТекущаяДата(), -КолвоМесяцевНазадДляПлана)));
		ДатаПоследнегоДокумента = ДатаПустая();
		
		Результат = Запрос.Выполнить();
		ВыборкаДаты = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДаты.Следующий() Цикл
			ВыборкаКонтрагентов = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаКонтрагентов.Следующий() Цикл    //бежим по Контрагентам
				ВыборкаАдреса = ВыборкаКонтрагентов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаАдреса.Следующий() Цикл //по номенклатурам
					ВыборкаНоменклатура = ВыборкаАдреса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаНоменклатура.Следующий() Цикл
						стрТЗ = тзПлан.Добавить();
						стрТЗ.ИдКонтр = СокрЛП(ВыборкаКонтрагентов.ИдКонтр);
						стрТЗ.Номенклатура = ВыборкаНоменклатура.Номенклатура;
						стрТЗ.План = СтрЗаменить(ЦелоеВСтроку(Окр(ВыборкаНоменклатура.Количество, 0)), ",", ".");
						стрТЗ.ИсторияПродаж = "";							
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
			Прервать;
		КонецЦикла;
	
	ИначеЕсли ПараметрыАгента.ТипРекомендуемогоПлана = 3 Тогда  //По скорости продаж
		Если тзИстория.Количество() <> 0 Тогда
			НачалоТекДня = НачалоДня(ТекущаяДата());
			Для каждого стрИстория Из тзИстория Цикл
				МинимДатаПродажи = НачалоДня(стрИстория.МинимДатаПродажи);
				ДнейПродажи      = Окр((НачалоТекДня - МинимДатаПродажи) / 86400, 0);
				Если (ДнейПродажи <> 0) И (стрИстория.КоличествоПосещений <> 0) Тогда
					СкоростьПродаж = стрИстория.ПроданоЗаТриПоследнихПосещения / ДнейПродажи;
					МыПридемКВамВСледующийРазЧерез = ДнейПродажи / стрИстория.КоличествоПосещений;
					//План в виде например строка "(500-КонОстаток)*1.5"
					стрТЗ = тзПлан.Добавить();
					стрТЗ.ИдКонтр = стрИстория.ИдКонтр;
					стрТЗ.Номенклатура = стрИстория.Номенклатура;
					стрТЗ.План = "(" + ЧислоВСтроку(Окр(СкоростьПродаж * МыПридемКВамВСледующийРазЧерез, 2, 1)) + "-КонОстаток)*1.5"; 
					стрТЗ.ИсторияПродаж = "";
				КонецЕсли;				
			КонецЦикла; 	
		КонецЕсли; 
	КонецЕсли; 
	
	//вывод результатов
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	тзПлан.ИдКонтр КАК ИдКонтр,
	|	ВЫРАЗИТЬ(тзПлан.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	тзПлан.План КАК План,
	|	тзПлан.ИсторияПродаж КАК История
	|ПОМЕСТИТЬ ВремПлан
	|ИЗ
	|	&тзПлан КАК тзПлан
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	тзИстория.ИдКонтр КАК ИдКонтр,
	|	ВЫРАЗИТЬ(тзИстория.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	тзИстория.План КАК План,
	|	тзИстория.ИсторияПродаж КАК История
	|ПОМЕСТИТЬ ВремИстория
	|ИЗ
	|	&тзИстория КАК тзИстория
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПланИстория.ИдКонтр КАК ИдКонтр,
	|	ПланИстория.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ПланИстория.План) КАК План,
	|	МАКСИМУМ(ПланИстория.История) КАК История
	|ПОМЕСТИТЬ ПланИстория
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВремПлан.ИдКонтр КАК ИдКонтр,
	|		ВремПлан.Номенклатура КАК Номенклатура,
	|		ВремПлан.План КАК План,
	|		"""" КАК История
	|	ИЗ
	|		ВремПлан КАК ВремПлан
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВремИстория.ИдКонтр,
	|		ВремИстория.Номенклатура,
	|		"""",
	|		ВремИстория.История
	|	ИЗ
	|		ВремИстория КАК ВремИстория) КАК ПланИстория
	|
	|СГРУППИРОВАТЬ ПО
	|	ПланИстория.ИдКонтр,
	|	ПланИстория.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ТаблТов
	|ИЗ
	|	&ТаблНоменклатуры КАК ТАБЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПланИстория.ИдКонтр КАК ИдКонтр,
	|	ВЫРАЗИТЬ(ТаблТов.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ПланИстория.План КАК План,
	|	ПланИстория.История КАК История
	|ИЗ
	|	ПланИстория КАК ПланИстория
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблТов КАК ТаблТов
	|		ПО ПланИстория.Номенклатура = ТаблТов.Номенклатура";
	
	Запрос.УстановитьПараметр("тзИстория", тзИстория);
	Запрос.УстановитьПараметр("тзПлан", тзПлан);
	Запрос.УстановитьПараметр("ТаблНоменклатуры", Номенклатура);
	
	Подсказки = Запрос.Выполнить().Выбрать();
	
	Ответ = "";
	Счетчик = 0;
	Пока Подсказки.Следующий() Цикл
		Ответ = Ответ
			+ СокрЛП(Подсказки.ИдКонтр) + Таб    //код Контрагента
			+ УникИдентификатор(Подсказки.Номенклатура) + Таб     //код Номенклатуры			
			+ ?(ПустаяСтрока(Подсказки.План), "", "CAST(((" + СокрЛП(Подсказки.План) + ") + 0.5) AS INTEGER)") + Таб //план
			+ СокрЛП(Подсказки.История) + РазделительСтрок;   //история продаж (строкой)
		
		Счетчик = Счетчик + 1;
		Если Счетчик % 20 = 0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка выгрузки подсказок");
				Возврат Ложь;
			КонецЕсли;
			Ответ = "";
		КонецЕсли;
	КонецЦикла;
	Возврат ПорцияОбмена(Адрес, Ответ, "Подсказки продаж выгружены " + Счетчик + " записей","Ошибка выгрузки подсказок");
КонецФункции

// Выгружает подсказки продаж по запросу с КПК
// Параметры
// Адрес - идентификатор сессии обмена
// спКонтрагентов - список Контрагентов
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьПодсказкиПродажПоЗапросу(Адрес, ТелоСообщения, НачСтр)
	Если НЕ ПорцияОбмена(Адрес,"OK","Выгружаются подсказки по запросу") Тогда
		Возврат Ложь;
	КонецЕсли;
	тзАдресовДоставки = новый ТаблицаЗначений;
	тзАдресовДоставки.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	тзАдресовДоставки.Колонки.Добавить("АдресДоставки", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	тзАдресовДоставки.Колонки.Добавить("ИдКонтр", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(32, ДопустимаяДлина.Переменная)));
	
	КолСтр = СтрЧислоСтрок(ТелоСообщения);  //в теле сообщения перечислены коды Контрагентов
	Для Н = НачСтр По КолСтр Цикл
		мКод           = СтрПолучитьСтроку(ТелоСообщения, Н);
		мКонтрагент    = Справочники.Контрагенты.ПустаяСсылка();
		мАдресДоставки = "";
		
		ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
		Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
			ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
			Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
				Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
					ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ПолучитьКонтрагентаИАдресПоКоду(мКод, мКонтрагент, мАдресДоставки, ПапкаРодителя);
		
		Если мКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		//РАЗОБРАТЬСЯ ДобавитьОшибку("Не найден контрагент с кодом "+мКод);
		Иначе
			стрТЗ = тзАдресовДоставки.Добавить();
			стрТЗ.Контрагент = мКонтрагент;
			
			Если СпособОрганизацииТТ = 1 И Значениезаполнено(мАдресДоставки) Тогда
				стрТЗ.АдресДоставки = мАдресДоставки; //к адресу нужно добавить контрагента, т.к. 2 контрагента могут иметь одинаковый адрес (а одном торговом центре)
				стрТЗ.ИдКонтр       = мКод; 
			Иначе
				стрТЗ.АдресДоставки = "";
				стрТЗ.ИдКонтр       = мКонтрагент.Код; 
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЦикла;
	
	тзНоменклатура = Новый ТаблицаЗначений;
	ПолучитьСписокНоменклатуры(тзНоменклатура);
	ВыгрузитьПодсказкиПродаж(Адрес, тзАдресовДоставки, тзНоменклатура);
	
	Возврат СерверПослатьОтвет(Адрес, "", 1)
КонецФункции

// Выгружает подсказки продаж при полной загрузке
// Параметры
// Адрес - идентификатор сессии обмена
// ТаблМаршрутовСегодня - Маршрут на сегодня 
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьПодсказкиПродажПриПолнойЗагрузке(Адрес, ТаблКонтрагентов, Номенклатура)
	Если НЕ ПорцияОбмена(Адрес,"SalesHelp", "Выгружаются подсказки...") Тогда
		Возврат Ложь;
	КонецЕсли;
	тзАдресовДоставки = новый ТаблицаЗначений;
	тзАдресовДоставки.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	тзАдресовДоставки.Колонки.Добавить("ИдКонтр", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(32, ДопустимаяДлина.Переменная)));
	тзАдресовДоставки.Колонки.Добавить("АдресДоставки", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	
	Если ТаблКонтрагентов <> Неопределено Тогда
		Если СпособОрганизацииТТ = 0 Тогда
			Для Каждого стрТЗ Из ТаблКонтрагентов Цикл
				НовСтр = тзАдресовДоставки.Добавить();
				НовСтр.Контрагент	 = стрТЗ.Контрагент;
				НовСтр.ИдКонтр       = стрТЗ.Контрагент.Код; 
				НовСтр.АдресДоставки = "";
			КонецЦикла; 
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫРАЗИТЬ(Табл.Контрагент КАК Справочник.Контрагенты) КАК Контрагент
			|ПОМЕСТИТЬ Клиенты
			|ИЗ
			|	&Табл КАК Табл
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Клиенты.Контрагент КАК Контрагент,
			|	Клиенты.Контрагент.Код КАК КонтрагентКод,
			|	КИ.Представление КАК Адрес,
			|	КИ.Вид.Код КАК АдресКод,
			|	NULL КАК ФактАдрес
			|ИЗ
			|	Клиенты КАК Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КИ
			|		ПО Клиенты.Контрагент = КИ.Объект
			|ГДЕ
			|	КИ.Вид В(&АдресаДляТТ)
			|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Клиенты.Контрагент,
			|	Клиенты.Контрагент.Код,
			|	NULL,
			|	NULL,
			|	ВЫРАЗИТЬ(КИ.Представление КАК СТРОКА(200))
			|ИЗ
			|	Клиенты КАК Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КИ
			|		ПО Клиенты.Контрагент = КИ.Объект
			|ГДЕ
			|	КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
			|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
			|ИТОГИ
			|	МАКСИМУМ(КонтрагентКод),
			|	МАКСИМУМ(ФактАдрес)
			|ПО
			|	Контрагент";
			Запрос.УстановитьПараметр("Табл", ТаблКонтрагентов);
			Запрос.УстановитьПараметр("АдресаДляТТ", АдресаДляТТ.ВыгрузитьКолонку("АдресДляТТ"));
			
			Результат = Запрос.Выполнить();
			ВыборкаКонтрагент = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаКонтрагент.Следующий() Цикл
				НовСтр = тзАдресовДоставки.Добавить();
				НовСтр.Контрагент	 = ВыборкаКонтрагент.Контрагент;
				НовСтр.ИдКонтр       = СокрЛП(ВыборкаКонтрагент.КонтрагентКод);
				НовСтр.АдресДоставки = ВыборкаКонтрагент.ФактАдрес;
				Выборка = ВыборкаКонтрагент.Выбрать();
				Пока Выборка.Следующий() Цикл
					Если ЗначениеЗаполнено(Выборка.Адрес) Тогда
						НовСтр = тзАдресовДоставки.Добавить();
						НовСтр.Контрагент	 = Выборка.Контрагент;
						НовСтр.ИдКонтр       = Лев(
							Выборка.КонтрагентКод + "                            ", ДлинаКодаКонтрагенты) + СокрЛП(Выборка.АдресКод);
						НовСтр.АдресДоставки = Выборка.Адрес;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	ОтветОтКПК = ВыгрузитьПодсказкиПродаж(Адрес, тзАдресовДоставки, Номенклатура);
	
	Возврат ОтветОтКПК;
КонецФункции

// Выгружает каналы сбыта
// Параметры
// Адрес - идентификатор сессии обмена
// тзНоменклатуры - Таблица с номенклатурой
// спКонтрагентов - контрагенты
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСвойстваОбъектов(Адрес, тзНоменклатуры, спКонтрагентов, тзАдресаДляТТ, Выгружать)
	Если НЕ ПорцияОбмена(Адрес, "Properties", "Выгружаются свойства объектов...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Счетчик = 0;
	Ответ = "";
	найденныеСтроки = Новый Массив();
	
	Если Выгружать Тогда
		//Выгрузим значения свойства канал сбыта для Контрагента
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Код КАК КонтрагентКод,
		|	СвойстваКонтр.Значение КАК КаналСбыта
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойстваКонтр
		|		ПО Контрагенты.Ссылка = СвойстваКонтр.Объект
		|ГДЕ
		|	СвойстваКонтр.Свойство = &СвойствоКаналСбыта
		|	И Контрагенты.Ссылка В(&спКонтрагентов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтрагентКод
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("СвойствоКаналСбыта", ПВХКаналаСбытаКонтрагента);
		Запрос.УстановитьПараметр("спКонтрагентов", спКонтрагентов);
		ТекКод = "";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ТекКод <> Выборка.КонтрагентКод Тогда
				ТекКод = Выборка.КонтрагентКод; //исключим возможность двойников 
				Ответ = Ответ
					+ "КаналСбыта" + Таб
					+ "1" + Таб
					+ СокрЛП(Выборка.КонтрагентКод) + Таб
					+ Лев(УбратьСпецСимволы(Строка(Выборка.КаналСбыта)), 12) + РазделительСтрок;
				
				Счетчик = Счетчик + 1;
				Если Счетчик % 100 = 0 Тогда
					Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда
						ДобавитьОшибку("Ошибка выгрузки каналов сбыта");
						Возврат Ложь;
					КонецЕсли;
					Счетчик = 0;
					Ответ = "";
				КонецЕсли;
			КонецЕсли; 
			
		КонецЦикла;
		//Выгрузим значения категорий номенклатуры
		Запрос = Новый Запрос;
		
		Если Конфигурация = "БухКазахстан" Тогда
			Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
			|ПОМЕСТИТЬ НоменклатураВрем
			|ИЗ
			|	&ТаблНоменклатуры КАК ТАБЛ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Ном.Номенклатура КАК Номенклатура,
			|	ПОДСТРОКА(Категории.Категория.Наименование, 13, 12) КАК КаналСбыта
			|ИЗ
			|	РегистрСведений.КатегорииОбъектов КАК Категории
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураВрем КАК Ном
			|		ПО Категории.Объект = Ном.Номенклатура
			|ГДЕ
			|	Категории.Категория В(&СписокКатегорий)";
		Иначе
			Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
			|ПОМЕСТИТЬ НоменклатураВрем
			|ИЗ
			|	&ТаблНоменклатуры КАК ТАБЛ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Ном.Номенклатура КАК Номенклатура,
			|	ПОДСТРОКА(Категории.Свойство.Наименование, 13, 12) КАК КаналСбыта
			|ИЗ
			|	РегистрСведений.ЗначенияСвойствОбъектов КАК Категории
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураВрем КАК Ном
			|		ПО Категории.Объект = Ном.Номенклатура
			|ГДЕ
			|	Категории.Свойство В(&СписокКатегорий)
			|	И Категории.Значение = ИСТИНА";
		КонецЕсли;
		
		Запрос.Текст = Текст;
		ТЗ = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "КаналыСбыта");
		СписокКатегорий = ТЗ.ВыгрузитьКолонку("КаналСбытаНоменклатура");
		Запрос.УстановитьПараметр("СписокКатегорий", СписокКатегорий);		
		Запрос.УстановитьПараметр("ТаблНоменклатуры", тзНоменклатуры);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			УнКод = УникИдентификатор(Выборка.Номенклатура);
			Ответ = Ответ
				+ "КаналСбыта" + Таб
				+ "4" + Таб
				+ УнКод + Таб
				+ УбратьСпецСимволы(Выборка.КаналСбыта) + РазделительСтрок;
			
			Счетчик = Счетчик + 1;
			Если Счетчик % 100 = 0 Тогда
				Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда
					ДобавитьОшибку("Ошибка выгрузки каналов сбыта");
					Возврат Ложь;
				КонецЕсли;
				Счетчик = 0;
				Ответ = "";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Если Конфигурация = "БухКазахстан" Тогда
		//Выгрузим значения категорий для документов
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Код, Наименование ИЗ Справочник.КатегорииОбъектов ГДЕ НазначениеКатегории = &Док");
		Запрос.УстановитьПараметр("Док", ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Документы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл	
			Ответ = Ответ + Выборка.Код + "0" + Таб + "12" + Таб + "" + Таб + Выборка.Наименование + РазделительСтрок;
			Ответ = Ответ + Выборка.Код + "1" + Таб + "14" + Таб + "" + Таб + Выборка.Наименование + РазделительСтрок;
			Ответ = Ответ + Выборка.Код + "2" + Таб + "16" + Таб + "" + Таб + Выборка.Наименование + РазделительСтрок;
			Ответ = Ответ + Выборка.Код + "3" + Таб + "18" + Таб + "" + Таб + Выборка.Наименование + РазделительСтрок;
			Ответ = Ответ + Выборка.Код + "4" + Таб + "37" + Таб + "" + Таб + Выборка.Наименование + РазделительСтрок;
			Счетчик = Счетчик + 5;
			
			Если Счетчик % 100 = 0 Тогда
				Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда
					ДобавитьОшибку("Ошибка выгрузки каналов сбыта");
					Возврат Ложь;
				КонецЕсли;
				Счетчик = 0;
				Ответ = "";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Возврат ПорцияОбмена(Адрес,Ответ,"Свойства объектов выгружены " + Счетчик + " записей","Ошибка выгрузки свойств объектов");
КонецФункции

//Выгружает типы цен, которые есть в договорах выгруженных Контрагентов, плюс тип цен по-умолчанию
// Параметры
// Адрес - идентификатор сессии обмена
// СписокТиповЦен - Список типов цен
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьТипыЦен(Адрес, тзТиповЦен)
	Если НЕ ПорцияОбмена(Адрес,"PriceTypes","Выгружаются типы цен...") Тогда
		Возврат Ложь;
	КонецЕсли;
  	Счетчик=0;
	Ответ="";
	Для Каждого стрТЦ Из тзТиповЦен Цикл
		ТЦ = стрТЦ.ТипЦен;
		Если ТЦ = Справочники.ТипыЦенНоменклатуры.ПустаяСсылка() Тогда 
			Продолжить; 
		КонецЕсли;
		
		Ответ=Ответ
			+УникИдентификатор(ТЦ)+Таб
			+УбратьСпецСимволы(ТЦ.Наименование)+РазделительСтрок;
		
		Счетчик=Счетчик+1;
		Если Счетчик%50=0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка выгрузки типов цен");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	Возврат ПорцияОбмена(Адрес,Ответ,"Типы цен выгружены "+Счетчик+" записей","Ошибка выгрузки типов цен");
КонецФункции

//Выгружает значения цен из списка типов цен, заданных у Контрагентов, для выгруженной Номенклатуры
// Параметры
// Адрес - идентификатор сессии обмена
// тзНоменклатуры - Таблица с номенклатурой
// СписокТиповЦен - Список типов цен
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьЦены(Адрес, ТаблНоменклатуры, тзТиповЦен)
	
	Если НЕ ПорцияОбмена(Адрес, "Prices", "Выгружаются цены...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ АвтономныйРежим Тогда
		Сервер.ПерезапускКомпрессора(Адрес);
	КонецЕсли; 
	
	Ответ = "";
	Счетчик = 0;
	ТекДата = КонецДня(ТекущаяДата());
	Условие = "";
	Организация = ПараметрыАгента.Организации[0].Организация;
	Если Конфигурация = "БухКазахстан" Тогда
		Условие = " И Организация = &Организация";
	КонецЕсли;
	
	ЗапросНоменклатура = Новый Запрос;
	ЗапросНоменклатура.УстановитьПараметр("ТаблНоменклатуры", ТаблНоменклатуры);
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросНоменклатура.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
    ЗапросНоменклатура.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТАБЛ.Партия КАК Партия
	|ПОМЕСТИТЬ ТаблТов
	|ИЗ
	|	&ТаблНоменклатуры КАК ТАБЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	Результат = ЗапросНоменклатура.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ТаблТов.Номенклатура, Цены.Цена, Цены.Валюта ИЗ ТаблТов КАК ТаблТов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаСреза, ТипЦен = &ТипЦен" + Условие + ") КАК Цены
	|	ПО (Цены.Номенклатура = ТаблТов.Номенклатура)";
	
	Если Конфигурация = "БухБеларусь" Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ТаблТов.Номенклатура, ТаблТов.Партия, Цены.Цена, Цены.Валюта ИЗ ТаблТов КАК ТаблТов
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаСреза, ТипЦен = &ТипЦен" + Условие + ") КАК Цены
		|	ПО (Цены.Номенклатура = ТаблТов.Номенклатура)";
	КонецЕсли;
	КурсыВалют = Новый Соответствие;
	Валюта = Справочники.Валюты.Выбрать();
	Пока Валюта.Следующий() Цикл
		Структура = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ТекДата, Новый Структура("Валюта", Валюта.Ссылка));
		Структура.Кратность = ?(Структура.Кратность = 0, 1, Структура.Кратность);
		КурсыВалют.Вставить(Валюта.Ссылка, Структура);
	КонецЦикла;
	ВалютаКПК = ПараметрыАгента.ВалютаКПК;
	СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ТекДата, Новый Структура("Валюта", ВалютаКПК));
	
	Для Каждого стрТипЦен Из тзТиповЦен Цикл
		ТипЦен = стрТипЦен.ТипЦен;
		Если стрТипЦен.ТипЦен.Пустая() Тогда 
			Продолжить; 
		КонецЕсли;
		ТипЦенКод = УникИдентификатор(ТипЦен);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("ДатаСреза", ТекДата);
		Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
		Если Конфигурация = "БухКазахстан" Тогда
			Запрос.УстановитьПараметр("Организация", Организация);
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл                                     
			
			ТекЦена = ОкруглитьЦену(Выборка.Цена, ТипЦен.ПорядокОкругления, ТипЦен.ОкруглятьВБольшуюСторону);
			Если ВалютаКПК <> Выборка.Валюта Тогда
				Структура = КурсыВалют.Получить(Выборка.Валюта);
				ТекЦена = ПересчитатьИзВалютыВВалюту(ТекЦена, Выборка.Валюта, ВалютаКПК,
					Структура.Курс, СтруктураВалютаКПК.Курс, Структура.Кратность, СтруктураВалютаКПК.Кратность);
			КонецЕсли;
			
			Если Не ТипЦен.ЦенаВключаетНДС Тогда
				ТекЦена = Окр(ТекЦена * (1 + ?(ЗначениеЗаполнено(Выборка.Номенклатура.СтавкаНДС), ПолучитьСтавкуНДС(Выборка.Номенклатура.СтавкаНДС), 0) / 100), 2);
			КонецЕсли;
			
			Если ТекЦена = 0 Тогда Продолжить; КонецЕсли;
			КодТовара = УникИдентификатор(Выборка.Номенклатура);
			Если Конфигурация = "БухБеларусь" И Выборка.Партия <> "" Тогда
				КодТовара = КодТовара + "#" + УникИдентификатор(Выборка.Партия);
			КонецЕсли;
			Ответ=Ответ+
			КодТовара+Таб+
			ТипЦенКод+Таб+
			СуммаВСтроку(ТекЦена)+РазделительСтрок;
			Счетчик=Счетчик+1;	
			
			Если Счетчик%50=0 Тогда
				Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
					ДобавитьОшибку("Ошибка выгрузки цен");
					Возврат Ложь;
				КонецЕсли;
				Ответ="";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Цены выгружены "+Счетчик+" записей","Ошибка выгрузки цен");
	
КонецФункции

Функция ОкруглитьЦену(Число, ПараметрПорядокОкругления, ОкруглятьВБольшуюСторону)

	Перем Результат;
	
	Порядок = ПорядокОкругленияЦен[ПараметрПорядокОкругления];
	КоличествоИнтервал = Число / Порядок;
	КоличествоЦелыхИнтервалов = Цел(КоличествоИнтервал);
	Если КоличествоИнтервал = КоличествоЦелыхИнтервалов Тогда
		Результат = Число;
	Иначе                                                 
		Если ОкруглятьВБольшуюСторону Тогда
			Результат = Порядок * (КоличествоЦелыхИнтервалов + 1);
		Иначе
			Результат = Порядок * Окр(КоличествоИнтервал, 0 ,РежимОкругления.Окр15как20);
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Выгружает скидки
// Параметры
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСкидки(Адрес)
	Если НЕ ПорцияОбмена(Адрес,"Discounts","Выгружаются скидки...") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ АвтономныйРежим Тогда
		Сервер.ПерезапускКомпрессора(Адрес);
	КонецЕсли; 
	Ответ=""; Счетчик=0;
	Возврат ПорцияОбмена(Адрес,Ответ,"Скидки выгружены "+Счетчик+" записей","Ошибка выгрузки скидок");
КонецФункции

// Выгружает служебные данные Service
// Параметры 
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСлужебныеДанные(Адрес)
	Если НЕ ПорцияОбмена(Адрес,"Service","Выгружаются служебные данные...") Тогда
		Возврат Ложь;
	КонецЕсли;
    ПериодСнятияGPSКоординат = Формат(ПараметрыАгента.ПериодGPS,"ЧГ=0");
	ПериодОтправкиGPSКоординат = Формат(ПараметрыАгента.ПериодОтправкиКоординат,"ЧГ=0");
	Ответ =	ДатаВСтрокуДляКПК(ТекущаяДата())+Таб     	//Дата
			+УникИдентификатор(ПараметрыАгента.ТипЦенПоУмолчанию)+Таб     	//код типа цен поумолчанию
			+?(ПериодСнятияGPSКоординат="",0,ПериодСнятияGPSКоординат)+Таб  	//период снятия координат
			+?(ПериодОтправкиGPSКоординат="",0,ПериодОтправкиGPSКоординат)+Таб	//период отправки координат
			+?(ПараметрыАгента.ПечатьФормБезНомера,"1","0")+Таб	 //1 печатать документы с кпк с пустым полем номера
			+?(ПараметрыАгента.ВключитьGPSМониторинг,"1","0")+РазделительСтрок;
	Счетчик = 0;		
	//Если ПараметрыАгента.ВыгружатьОтчеты Тогда
		тзОтчеты = ПрочитатьОтчеты(ПараметрыАгента.Агент); 
		
		Для каждого стрОтчет Из тзОтчеты Цикл
			Если (стрОтчет.Загружать=Ложь) Тогда Продолжить; КонецЕсли;
 			Если ЗначениеЗаполнено(стрОтчет.НазваниеОтчета) Тогда
				Ответ=Ответ
					+стрОтчет.КодОтчета+Таб
					+УбратьСпецСимволы(стрОтчет.НазваниеОтчета)+Таб
					+?(ПараметрыАгента.ВыгружатьОтчеты,1,0)+Таб
					+?(стрОтчет.ЗапрашиватьПериод,1,0)+Таб
					+?(ПустаяСтрока(стрОтчет.ОтборПоКонтрагенту),0,1)+Таб
					+?(ПустаяСтрока(стрОтчет.ОтборПоДоговору),0,1)+Таб
					+?(ПустаяСтрока(стрОтчет.ОтборПоНоменклатуре),0,1)+РазделительСтрок;
				Счетчик = Счетчик + 1;	
			КонецЕсли; 
		КонецЦикла; 	  
	//КонецЕсли; 

	Возврат ПорцияОбмена(Адрес,Ответ,"Служебные данные выгружены "+Счетчик+" записей","Ошибка выгрузки служебных данных");
КонецФункции

// Выгрузить в КПК все сообщения для Агента с указанными статусами
// Параметры 
// Адрес - идентификатор сессии обмена
// Статусы - строка, задаются статусы сообщений через запятую
// тзНоменклатуры - таблица значений Номенклатура/детализация для дублирования сообщений по строкам детализации
// массивКонтрагенты - массив ссылок на контрагентов из доступных агенту
// ФлагЗавершенияОбмена - признак завершения обмена данными
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСообщения(Адрес, Статусы, тзНоменклатуры, массивКонтрагенты, НачалоОтвета, ФлагЗавершенияОбмена = 0)
	Если НЕ ПорцияОбмена(Адрес,НачалоОтвета,"Выгружаются сообщения...") Тогда
		Возврат Ложь;
	КонецЕсли;

	АвторСообщения = глЗначениеПеременной("глТекущийПользователь");
	Код = 0;
	Ответ = "";
	Счетчик = 0;
	Привязка = Неопределено;
	
	Блокировщик = Неопределено;
	БД = ОткрытьВнешнююБД(Блокировщик, Истина);
	Если БД = Ложь Тогда
		Сообщить(ОшибкаНетДоступаКВнешнейБД, СтатусСообщения.Важное);
		Статус = ПорцияОбмена(
			Адрес,Ответ,"Сообщения выгружены "+Счетчик+" записей","Ошибка выгрузки сообщений", ФлагЗавершенияОбмена);
		Возврат Статус;
	КонецЕсли;
	
	ТекстЗапроса=
		"Select CODE,DT,OBJTYPE,OBJKOD,THEME,BODY,ACTUALLY,TODO,AGENT,AUTHOR,STATUS "
		+ "from [messages] " 
		+ "where AGENT='" + СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код) + "' AND STATUS <> 4 ";
	ПодгЗапрос=БДПодготовитьЗапрос(БД, ТекстЗапроса);
	
	Пока БДСледующаяЗапись(ПодгЗапрос) Цикл //Цикл по записям DBF
		
		//заменить разделитель строки на символ 11
		код 			= БДЗначениеВКолонке(ПодгЗапрос, 0);
		дата 			= СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 1));    //дата записывается в требуемом формате в момент сохранения сообщения
		тема 			= СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 4));
		актуальность 	= БДЗначениеВКолонке(ПодгЗапрос, 6);
		сделатьДо 		= БДЗначениеВКолонке(ПодгЗапрос, 7);
		ТелоСообщения 	= 
			СтрЗаменить(
				СтрЗаменить(
					СтрЗаменить(
						СтрЗаменить(
							СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 5)),
							Символы.Таб, 
							" "),
						Символы.ВК + Символы.ПС,
						Символы.ВТаб),
					Символы.ВК,
					Символы.ВТаб),
				Символы.ПС,
				Символы.ВТаб);
		УбратьСпецСимволыВСтроке(ТелоСообщения, "" + Символы.ВТаб);
		ТипПривязки 	= СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 2));
		КодАгента   	= СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 8));
		КодПривязки 	= СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 3));
		АвторСообщения	= СокрЛП(БДЗначениеВКолонке(ПодгЗапрос, 9));
		СтатусСообщ		= БДЗначениеВКолонке(ПодгЗапрос, 10);
		СтатусСообщ		= "" + ?(СтатусСообщ = 1, 2, СтатусСообщ);                    
		Привязка		= Неопределено;
		Если ТипПривязки="1" Тогда  //КЛИЕНТ
			Попытка
				Об = ПолучитьСсылкуПоGUID(КодПривязки,"Контрагенты");
				Если НЕ Об = Неопределено Тогда
					Если Не Об.Пустая() Тогда
						Если НЕ массивКонтрагенты.Найти(Об) = Неопределено Тогда
							Привязка = Об.Код;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли
			Исключение
			КонецПопытки;
		ИначеЕсли ТипПривязки="4" Тогда //Товар
			Об = ПолучитьСсылкуПоGUID(КодПривязки,"Номенклатура");
			Если НЕ Об = Неопределено Тогда
				Если Не Об.Пустая() Тогда
					строкиДетализации = тзНоменклатуры.НайтиСтроки(новый Структура("Номенклатура", Об));
					код = код * 10000;
					индекс = 0;
					Для Каждого стр из строкиДетализации Цикл 
						Ответ=Ответ + ДобавитьСообщениеКВыгрузке(
							код + индекс, 
							дата, 
							АвторСообщения, 
							ТипПривязки, 
							УникИдентификатор(стр.Номенклатура), 
							тема, 
							ТелоСообщения, 
							актуальность, 
							СтатусСообщ, 
							сделатьДо);
						индекс = индекс + 1;
					КонецЦикла;
					Счетчик = Счетчик + индекс;
				КонецЕсли;
			КонецЕсли;
			Привязка = Неопределено;
		ИначеЕсли ТипПривязки="6" Тогда
			Привязка = КодАгента;
		КонецЕсли; 
		Если НЕ Привязка = Неопределено Тогда
			Ответ=Ответ + ДобавитьСообщениеКВыгрузке(
				код, дата, АвторСообщения, ТипПривязки, Привязка, тема, ТелоСообщения, актуальность, СтатусСообщ, сделатьДо);
			Счетчик = Счетчик + 1;
		КонецЕсли;		
	КонецЦикла;
	БДЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
	Статус = ПорцияОбмена(
		Адрес,Ответ,"Сообщения выгружены "+Счетчик+" записей","Ошибка выгрузки сообщений", ФлагЗавершенияОбмена);
	
	Если Статус Тогда
		//изменить статус на отосланные (2)
		
		БДЗапросБезРезультата(БД, "Update [messages] Set STATUS = 2 where AGENT='" + СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код) + "' AND STATUS = 1");
					
	КонецЕсли;	
	
	ЗакрытьВнешнююБД(БД, Блокировщик);	
					
	Возврат Статус;
КонецФункции	

// Формирует строку с параметрами сообщения в соответствии с протоколом обмена
// Параметры:
// 		CODE - Строка, код сообщения
// 		DT - Строка, дата и время создания сообщения в формате DD.MM.YYYY HH:MM:SS
// 		АвторСообщения - Строка, имя автора сообщения
// 		ТипПривязки - Строка, код таблицы, к которой привязано сообщение
// 			(1- клиент, 4 - товар, 6 - агент)
// 		Привязка - Строка, уникальный код объекта, к которому привязано сообщение
// 			(клиент, товар, или агент)
// 		THEME - Строка, тема сообщения
// 		ТелоСообщения - Строка, само сообщение
// 		ACTUALLY - Строка, дата и время, до которого сообщение актуально, пока не используется
// 		Статус - Строка, Статус сообщения: 2-Новое, 3-Прочитано, 4-Выполнено
// 		TODO - Флаг важности. Сейчас в КПК не задействовано.
// Возвращаемое значение:
// 		Строка, отформатированная в соответствии с протоколом обмена
Функция ДобавитьСообщениеКВыгрузке(CODE, DT, Автор, ТипПривязки, Привязка, THEME, ТелоСообщения, ACTUALLY, Статус, TODO)
	Ответ = ""
		+ ЦелоеВСтроку(CODE) + Таб
		+ DT + Таб
		+ Автор + Таб
		+ ЦелоеВСтроку(ТипПривязки)	+ Таб
	//Если код привязки к Агенту, то передадим КодАгента, иначе КодОбъектаПривязки		
		+ Привязка + Таб
		+ THEME + Таб
		+ ТелоСообщения + Таб
		+ Формат(ACTUALLY) + Таб
		+ ЦелоеВСтроку(Статус) + Таб
		+ TODO + РазделительСтрок;
	
    возврат Ответ;
КонецФункции
 
// Выгрузить в КПК все сообщения для Агента с указанными статусами
// Параметры 
// Адрес - идентификатор сессии обмена
// Статусы - строка, задаются статусы сообщений через запятую
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСообщенияПоЗапросу(Адрес, Статусы)
	
	Если ПараметрыАгента.ВыгружатьСообщения Тогда
		тзНоменклатуры = Новый ТаблицаЗначений;
		ПолучитьСписокНоменклатуры(тзНоменклатуры);
		
		МВТДолги = Неопределено;
		тзКонтрагенты = ПолучитьТаблицуКонтрагентов(
			ПараметрыАгента.Агент,
			ПараметрыАгента.ЗапретитьИзменятьТипЦен,
			ПараметрыАгента.ВыделятьЦветомКонтрагентов, 
			Истина, МВТДолги);
		
		Возврат ВыгрузитьСообщения(Адрес, "1,2,3", тзНоменклатуры, тзКонтрагенты.ВыгрузитьКолонку("Контрагент"), "OK", 1);
	Иначе
		Если НЕ ПорцияОбмена(Адрес, "OK", "Выгружаются сообщения...") Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат ПорцияОбмена(Адрес, "", "Выгрузка сообщений агенту отключена", "Ошибка выгрузки сообщений", 1);
	КонецЕсли;
	
КонецФункции	
 
// Реагирует на запрос на обновление остатков
// Параметры 
//	Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьОстатки(Адрес, Платформа)
	Если НЕ ПорцияОбмена(Адрес,"OK","Выполняется запрос 'Загрузка остатков'") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	тзНоменклатура = Новый ТаблицаЗначений;
	тзОстатки = Новый ТаблицаЗначений;
	ПолучитьСписокНоменклатуры(тзНоменклатура, тзОстатки);
	
	тзОрганизации = ПрочитатьОрганизации(ПараметрыАгента.Агент); 
	Если (ТипЗнч(тзОрганизации) <> Тип("ТаблицаЗначений")) Или (тзОрганизации.Количество() = 0) Тогда                            
		ДобавитьСообщение("Не заданы организации. Будут выгружены все.");
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка КАК Организация, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Грузоотправитель
		|ИЗ Справочник.Организации СГРУППИРОВАТЬ ПО Ссылка";
		тзОрганизации = Запрос.Выполнить().Выгрузить();
	КонецЕсли; 
    
	МВТДолги = Истина;
	тзКонтрагенты = ПолучитьТаблицуКонтрагентов(
		ПараметрыАгента.Агент,
		ПараметрыАгента.ЗапретитьИзменятьТипЦен,
		ПараметрыАгента.ВыделятьЦветомКонтрагентов, 
		Истина, МВТДолги); //получим выборку с контрагентами
	
	спКонтрагентов = тзКонтрагенты.ВыгрузитьКолонку("Контрагент"); //список контрагентов

	тзДоговоры = ПолучитьТаблицуДоговоров(
		спКонтрагентов,
		тзОрганизации, 
		ПараметрыАгента.ТипЦенПоУмолчанию, 
		ПараметрыАгента.ТипСоздаваемогоДокументаПокупка, 
		ПараметрыАгента.ТорговляСКолес, МВТДолги);
	
	тзТиповЦен = ПолучитьТаблицуТиповЦен(тзДоговоры);	
	
    //список номенклатуры
	Если НЕ ВыгрузитьНоменклатуру(Адрес, тзНоменклатура) Тогда 
		Возврат ложь; 
	КонецЕсли;
	
	Если НЕ ВыгрузитьОстаткиНоменклатуры(Адрес,тзОстатки) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Группы номенклатуры (папки) 
	Если НЕ ВыгрузитьГруппыНоменклатуры(Адрес, тзНоменклатура) Тогда 
		Возврат ложь; 
	КонецЕсли;
	
	//Состав групп номенклатуры
	Если НЕ ВыгрузитьСоставГруппНоменклатуры(Адрес, тзНоменклатура) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Типы цен
	Если НЕ ВыгрузитьТипыЦен(Адрес, тзТиповЦен) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Цены
	Если НЕ ВыгрузитьЦены(Адрес, тзНоменклатура, тзТиповЦен) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Единицы измерения	
	Если НЕ ВыгрузитьЕдиницы(Адрес, тзНоменклатура) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	Если (Платформа="Android") ИЛИ (Платформа="HTML") Тогда
		Если НЕ ВыгрузитьМаршруты(Адрес, Платформа, ПараметрыАгента.ВыгружатьМаршруты, Истина, спКонтрагентов) Тогда 
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;
	
	//сообщения	
	Если ПараметрыАгента.ВыгружатьСообщения Тогда
		Если ВыгрузитьСообщения(Адрес, "1,2,3", тзНоменклатура, тзКонтрагенты.ВыгрузитьКолонку("Контрагент"), "Messages") Тогда
		Иначе
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;
	
	Возврат СерверПослатьОтвет(Адрес, РазделительСтрок, 1); //передаем пустую строку
	
КонецФункции

// Реагирует на запрос выгрузки цен контрагента
// Параметры 
//	Адрес - идентификатор сессии обмена
//	ТелоЗапроса - запрос
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьЦеныКонтрагента(Адрес, ТелоЗапроса)
	параметрыЗапроса = СтрПолучитьСтроку(ТелоЗапроса, 5);
	параметрыЗапроса = СтрЗаменить(параметрыЗапроса, таб, РазделительСтрок);
	КодКлиента = СтрПолучитьСтроку(параметрыЗапроса, 1);
	ИдДоговора = СтрПолучитьСтроку(параметрыЗапроса, 2);
	
	тзНоменклатура = Новый ТаблицаЗначений;
	ПолучитьСписокНоменклатуры(тзНоменклатура);
	
	Если НЕ ПорцияОбмена(Адрес, "OK", "Выполняется запрос 'Загрузка цен контрагентов'") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Ответ = "";
	Счетчик = 0;
	ТекДата = КонецДня(ТекущаяДата());
	Условие = "";
	ТекстОтвета = "контрагента";
	Организация = Неопределено;
	Если Конфигурация = "БухКазахстан" Тогда
		Условие = " И Организация = &Организация";
		ТекстОтвета = "организации " + Организация;
		Если ЗначениеЗаполнено(ИдДоговора) Тогда
			Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(ИдДоговора)));
			Организация = ?(ЗначениеЗаполнено(Договор.Организация), Договор.Организация, ПараметрыАгента.Организации[0].Организация);
		КонецЕсли;
	КонецЕсли;
	
	ЗапросНоменклатура = Новый Запрос;
	ЗапросНоменклатура.УстановитьПараметр("ТаблНоменклатуры", тзНоменклатура);
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросНоменклатура.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
    ЗапросНоменклатура.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ТаблТов
	|ИЗ
	|	&ТаблНоменклатуры КАК ТАБЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	Результат = ЗапросНоменклатура.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ТаблТов.Номенклатура, Цены.Цена, Цены.Валюта ИЗ ТаблТов КАК ТаблТов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаСреза, ТипЦен = &ТипЦен" + Условие + ") КАК Цены
	|	ПО (Цены.Номенклатура = ТаблТов.Номенклатура)";
	КурсыВалют = Новый Соответствие;
	Валюта = Справочники.Валюты.Выбрать();
	Пока Валюта.Следующий() Цикл
		Структура = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ТекДата, Новый Структура("Валюта", Валюта.Ссылка));
		Структура.Кратность = ?(Структура.Кратность = 0, 1, Структура.Кратность);
		КурсыВалют.Вставить(Валюта.Ссылка, Структура);
	КонецЦикла;
	ВалютаКПК = ПараметрыАгента.ВалютаКПК;
	СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ТекДата, Новый Структура("Валюта", ВалютаКПК));
	
	ТипЦен = ПараметрыАгента.ТипЦенПоУмолчанию;
	ТипЦенКод = УникИдентификатор(ТипЦен);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаСреза", ТекДата);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Если Конфигурация = "БухКазахстан" Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл                                     
		
		Структура = КурсыВалют.Получить(Выборка.Валюта);
		ТекЦена = ОкруглитьЦену(Выборка.Цена, ТипЦен.ПорядокОкругления, ТипЦен.ОкруглятьВБольшуюСторону);
		Если ВалютаКПК <> Выборка.Валюта Тогда
			Структура = КурсыВалют.Получить(Выборка.Валюта);
			ТекЦена = ПересчитатьИзВалютыВВалюту(ТекЦена, Выборка.Валюта, ВалютаКПК,
				Структура.Курс, СтруктураВалютаКПК.Курс, Структура.Кратность, СтруктураВалютаКПК.Кратность);
			КонецЕсли;
			
		Если Не ТипЦен.ЦенаВключаетНДС Тогда
			ТекЦена = Окр(ТекЦена * (1 + ?(ЗначениеЗаполнено(Выборка.Номенклатура.СтавкаНДС), ПолучитьСтавкуНДС(Выборка.Номенклатура.СтавкаНДС), 0) / 100), 2);
		КонецЕсли;
		
		Если ТекЦена = 0 Тогда Продолжить; КонецЕсли;
		Ответ = Ответ + УникИдентификатор(Выборка.Номенклатура) + Таб + СуммаВСтроку(ТекЦена) + РазделительСтрок;
		Счетчик = Счетчик + 1;	
		Если Счетчик % 50 = 0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда
				ДобавитьОшибку("Ошибка выгрузки цен");
				Возврат Ложь;
			КонецЕсли;
			Ответ = "";
		КонецЕсли;
	КонецЦикла;
	
	Ответ = Ответ + РазделительСтрок;
	Если НЕ ПорцияОбмена(Адрес, Ответ , "Цены " + ТекстОтвета + " выгружены " + Счетчик + " записей", "Ошибка выгрузки цен контрагента") Тогда
		ДобавитьОшибку("Ошибка выгрузки цен контрагента");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СерверПослатьОтвет(Адрес, РазделительСтрок, 1); //передаем пустую строку	
	
КонецФункции

// Выгружает "быстрые остатки" после загрузки документов
// Параметры 
//	Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьБыстрыеОстатки(Адрес)
	Если НЕ ПорцияОбмена(Адрес,"OK","Выгружаются быстрые остатки") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблНоменклатура = Новый ТаблицаЗначений;
	ПолучитьСписокНоменклатуры(0, ТаблНоменклатура);
	
	Счетчик = 0;
	Ответ = "";
	Для Каждого стрНоменклатура Из ТаблНоменклатура Цикл
			УнКодТовара = УникИдентификатор(стрНоменклатура.Номенклатура);
		Если Конфигурация = "БухБеларусь" И стрНоменклатура.Партия <> "" Тогда
			УнКодТовара = УнКодТовара + "#" + УникИдентификатор(стрНоменклатура.Партия);
		КонецЕсли;
		УнКодСклада = УникИдентификатор(стрНоменклатура.Склад);
		Номенклатура = стрНоменклатура.Номенклатура;
		
		Ответ = Ответ
			+ УнКодТовара + Таб
			+ УнКодСклада + Таб
			+ КоличествоВСтроку(Окр(стрНоменклатура.Остаток))
			+ РазделительСтрок;
		
		Счетчик = Счетчик + 1;
		Если Счетчик % 50 = 0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда
				ДобавитьОшибку("Ошибка выгрузки быстрых остатков");
				Возврат Ложь;
			КонецЕсли;
			Ответ = "";
		КонецЕсли;
	КонецЦикла;
	Возврат ПорцияОбмена(Адрес,Ответ,"Быстрые остатки выгружены "+Счетчик+" записей","Ошибка выгрузки быстрых остатков");
КонецФункции

// Выгружает список файлов для обновления из файла update.ini
// формат файла update.ini первая строка версия обновления, остальные - список файлов
// Параметры 
//	Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСписокФайловДляОбновления(Адрес, Платформа)
	
	КаталогОбновления =  ПолучитьКаталог("Updates");
	Если  Платформа = "WM" Тогда
	    КаталогОбновления = КаталогОбновления + "\WM"
	ИначеЕсли Платформа = "Android" Тогда
	    КаталогОбновления = КаталогОбновления + "\Android"
	ИначеЕсли Платформа = "HTML" Тогда
	    КаталогОбновления = КаталогОбновления + "\HTML"
	КонецЕсли;
	Файл=Новый Файл(КаталогОбновления);
	Если НЕ Файл.Существует() Тогда
		СоздатьКаталог(КаталогОбновления); 
	КонецЕсли;
	ИмяФайла=КаталогОбновления +"\update.ini";
	Ответ="OK"+РазделительСтрок;
	//проверить наличие файла
	Файл=Новый Файл(ИмяФайла);
	Если НЕ Файл.Существует() Тогда
		Возврат СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок+РазделительСтрок,1);
	КонецЕсли;
	
	ФайлОбновить = Новый ЧтениеТекста(ИмяФайла);
	//проверить содержимое файла (пустой или только одна строка)
	Стр=ФайлОбновить.ПрочитатьСтроку();
	Если Стр=Неопределено Тогда
		Возврат СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок+РазделительСтрок,1);
	КонецЕсли;
	Попытка
		Версия =  Число(Стр);
    Исключение
		Возврат СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок+РазделительСтрок,1);
	КонецПопытки;
	Ответ = Ответ + Стр + РазделительСтрок;
	//выгружаем данные файла
	Пока Истина Цикл
		Стр=ФайлОбновить.ПрочитатьСтроку();
		Если Стр=Неопределено Тогда Прервать; КонецЕсли;
		Если ПустаяСтрока(Стр) Тогда Прервать; КонецЕсли;
		
		ИмяОбновляемогоФайла = КаталогОбновления+"\"+Стр;
		ОбнФайл=Новый Файл(ИмяОбновляемогоФайла);
		Если ОбнФайл.Существует() Тогда
			Ответ = Ответ + Стр + РазделительСтрок; 
		КонецЕсли;
	КонецЦикла;	
	
	Возврат СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,1);
КонецФункции

//Выгружает доп. реквизиты
// Параметры
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьДопРеквизиты(Адрес)
	Если НЕ ПорцияОбмена(Адрес, "Requisites", "Выгружаются доп. реквизиты...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Сч = 0;
	Ответ = "";
	
	ДокументКПК = Новый Соответствие;
	ДокументКПК.Вставить("12", ПараметрыАгента.РазрешитьПродажу);
	ДокументКПК.Вставить("13", ПараметрыАгента.РазрешитьПродажу);
	ДокументКПК.Вставить("14", ПараметрыАгента.РазрешитьЗаявку);
	ДокументКПК.Вставить("15", ПараметрыАгента.РазрешитьЗаявку);
	ДокументКПК.Вставить("16", ПараметрыАгента.РазрешитьПокупку);
	ДокументКПК.Вставить("17", ПараметрыАгента.РазрешитьПокупку);
	ДокументКПК.Вставить("18", ПараметрыАгента.РазрешитьПКО);
	ДокументКПК.Вставить("29", ПараметрыАгента.РазрешитьДобавлениеКлиентов);
	ДокументКПК.Вставить("37", ПараметрыАгента.РазрешитьИнвентаризацию);
	ДокументКПК.Вставить("38", ПараметрыАгента.РазрешитьИнвентаризацию);
	
	Документ1С = Новый Соответствие;
	Документ1С.Вставить("12", ПараметрыАгента.ТипСоздаваемогоДокумента);
	Документ1С.Вставить("13", ПараметрыАгента.ТипСоздаваемогоДокумента);
	Документ1С.Вставить("14", ПараметрыАгента.ТипСоздаваемогоДокументаЗаявка);
	Документ1С.Вставить("15", ПараметрыАгента.ТипСоздаваемогоДокументаЗаявка);
	Документ1С.Вставить("16", ПараметрыАгента.ТипСоздаваемогоДокументаПокупка);
	Документ1С.Вставить("17", ПараметрыАгента.ТипСоздаваемогоДокументаПокупка);
	Документ1С.Вставить("37", ПараметрыАгента.ТипСоздаваемогоДокументаИнвентаризация);
	Документ1С.Вставить("38", ПараметрыАгента.ТипСоздаваемогоДокументаИнвентаризация);
	
	Табл = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ДополнительныеРеквизиты");
	Если ТипЗнч(Табл) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Стр Из Табл Цикл
			Если Стр.Исп И ДокументКПК[Стр.Документ] И (Стр.ВариантДокумента = Строка(Документ1С[Стр.Документ]) Или Стр.ВариантДокумента = "") Тогда
				Ответ = Ответ 
					+ Стр.КодРеквизита + Таб 
					+ Стр.Наименование + Таб 
					+ Стр.Документ + Таб 
					+ Стр.ПолеПривязки + Таб 
					+ Стр.ТипДанных + Таб 
					+ Стр.Пометка + РазделительСтрок;
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Доп. реквизиты выгружены " + Сч + " записей","Ошибка выгрузки доп. реквизитов");
КонецФункции

//Выгружает значения доп. реквизитов
// Параметры
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьЗначенияДопРеквизитов(Адрес, МассивКонтрагентов, Организации)
	Если НЕ ПорцияОбмена(Адрес,"ReqValues","Выгружаются значения доп. реквизитов...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Сч = 0;
	Ответ = "";
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("КодРеквизита",	Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("КодЗначения",	Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("КодПривязки",	Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Представление",Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ЗначениеПоУмолчанию",Новый ОписаниеТипов("Булево"));
	
	ДокументКПК = Новый Соответствие;
	ДокументКПК.Вставить("12", ПараметрыАгента.РазрешитьПродажу);
	ДокументКПК.Вставить("13", ПараметрыАгента.РазрешитьПродажу);
	ДокументКПК.Вставить("14", ПараметрыАгента.РазрешитьЗаявку);
	ДокументКПК.Вставить("15", ПараметрыАгента.РазрешитьЗаявку);
	ДокументКПК.Вставить("16", ПараметрыАгента.РазрешитьПокупку);
	ДокументКПК.Вставить("17", ПараметрыАгента.РазрешитьПокупку);
	ДокументКПК.Вставить("18", ПараметрыАгента.РазрешитьПКО);
	ДокументКПК.Вставить("29", ПараметрыАгента.РазрешитьДобавлениеКлиентов);
	ДокументКПК.Вставить("37", ПараметрыАгента.РазрешитьИнвентаризацию);
	ДокументКПК.Вставить("38", ПараметрыАгента.РазрешитьИнвентаризацию);
	
	Документ1С = Новый Соответствие;
	Документ1С.Вставить("12", ПараметрыАгента.ТипСоздаваемогоДокумента);
	Документ1С.Вставить("13", ПараметрыАгента.ТипСоздаваемогоДокумента);
	Документ1С.Вставить("14", ПараметрыАгента.ТипСоздаваемогоДокументаЗаявка);
	Документ1С.Вставить("15", ПараметрыАгента.ТипСоздаваемогоДокументаЗаявка);
	Документ1С.Вставить("16", ПараметрыАгента.ТипСоздаваемогоДокументаПокупка);
	Документ1С.Вставить("17", ПараметрыАгента.ТипСоздаваемогоДокументаПокупка);
	Документ1С.Вставить("37", ПараметрыАгента.ТипСоздаваемогоДокументаИнвентаризация);
	Документ1С.Вставить("38", ПараметрыАгента.ТипСоздаваемогоДокументаИнвентаризация);
	
	Табл = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ДополнительныеРеквизиты");
	Если ТипЗнч(Табл) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Стр Из Табл Цикл
			Если Стр.Исп И Стр.ТипДанных = "0" И ДокументКПК[Стр.Документ]
				И (Стр.ВариантДокумента = Строка(Документ1С[Стр.Документ]) Или Стр.ВариантДокумента = "") Тогда
				Попытка
					Выполнить(Стр.Текст);
				Исключение
					СтрОшибка = "При заполнении значений дополнительного реквизита " + СокрЛП(стр.Наименование) + " произошла ошибка: " + ОписаниеОшибки();
					ДобавитьВЛогФайл(СтрОшибка, ПараметрыАгента.Агент, , СтатусСообщения.Важное);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Стр Из ТЗ Цикл
		Сч = Сч + 1;
		Ответ = Ответ
			+ Стр.КодЗначения + Таб 
			+ Стр.КодРеквизита + Таб 
			+ Стр.КодПривязки + Таб 
			+ Стр.Представление + Таб
			+ ?(Стр.ЗначениеПоУмолчанию, "1", "0") + РазделительСтрок;
		Если Сч % 100 = 0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда
				ДобавитьОшибку("Ошибка выгрузки значений реквизитов");
				Возврат Ложь;
			КонецЕсли;
			Ответ = "";
		КонецЕсли;
	КонецЦикла;
	
    Возврат ПорцияОбмена(Адрес, Ответ, "Значения доп. реквизитов выгружены " + Сч + " записей", "Ошибка выгрузки значений доп. реквизитов");
КонецФункции

//Выгружает значения доп. реквизитов
// Параметры
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьДокументыОснования(Адрес, Организации, МассивКонтрагентов, тзАдресаДляТТ, тзДоговоры, МВТДолги)
	Если НЕ ПорцияОбмена(Адрес,"DocReasons","Выгружаются документы основания...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Счетчик=0; Ответ="";
	НайденныеСтроки = Новый Массив();
	Если ПараметрыАгента.РазрешитьПКО И ВестиРасчетыПоДокументам Тогда
		ТекДата = КонецДня(ТекущаяДата());
		ЕстьТТпоАдресам = (тзАдресаДляТТ <> Неопределено);  //точки НЕ нужны
		//ТекстЗапроса =
		//"ВЫБРАТЬ
		//|	Долги.Организация,
		//|	Долги.Субконто1 КАК Контрагент,
		//|	Долги.Субконто2 КАК Договор,
		//|	ЕСТЬNULL(Долги.Субконто2.УстановленСрокОплаты, ЛОЖЬ) КАК УстановленСрокОплаты,
		//|	ЕСТЬNULL(Долги.Субконто2.СрокОплаты, 0) КАК СрокОплаты,
		//|	ЕСТЬNULL(Долги.Субконто3, Долги.Субконто2) КАК Основание,
		//|	НАЧАЛОПЕРИОДА(Долги.Субконто3.Дата, ДЕНЬ) КАК ОснованиеДата,
		//|	ЕСТЬNULL(Долги.Субконто3.Номер, Долги.Субконто2.Код) КАК ОснованиеНомер,
		//|	Долги.СуммаРазвернутыйОстатокДт - Долги.СуммаРазвернутыйОстатокКт КАК Долг
		//|ИЗ
		//|	РегистрБухгалтерии." + РегБух + ".Остатки(
		//|			&Дата,
		//|			НЕ Счет.Забалансовый
		//|				И НЕ Счет В ИЕРАРХИИ (&ИсключенныеСчета),
		//|			&ВидыСубконтоКД,
		//|			Субконто1 В (&Контрагенты)
		//|				И Субконто2.ВидДоговора В (&ВидыДоговоров)
		//|				И Организация В (&Организации)) КАК Долги";		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Долги.Организация,
		|	Долги.Контрагент КАК Контрагент,
		|	Долги.Договор КАК Договор,
		|	Долги.Документ КАК Основание,
		|	Долги.Документ.Дата КАК ОснованиеДата,
		|	ЕСТЬNULL(Долги.Документ.Номер, Долги.Документ.Код) КАК ОснованиеНомер,
		|	Долги.Долг - Долги.Аванс КАК Долг,
		|	Долги.ДолгПросрочен КАК ДолгПросрочен
		|ИЗ
		|	ОстаткиДокументы КАК Долги";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МВТДолги;
		
		Выборка = Запрос.Выполнить().Выбрать();
		ВыборкаДоговорУникИД = "";
	 
		КоэффПересчета = 1;
		Если ПараметрыАгента.ВалютаКПК <> мВалютаРегламентированногоУчета Тогда
			Структура = ПолучитьКурсВалюты(мВалютаРегламентированногоУчета, ТекущаяДата());
			СтруктураВалютаКПК = ПолучитьКурсВалюты(ПараметрыАгента.ВалютаКПК, ТекущаяДата());
			
			КоэффПересчета = Структура.Курс * СтруктураВалютаКПК.Кратность
			/ (?(СтруктураВалютаКПК.Курс = 0, 1, СтруктураВалютаКПК.Курс) * ?(Структура.Кратность = 0, 1, Структура.Кратность));
		КонецЕсли;
	
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Основание) Тогда
				Продолжить;
			КонецЕсли;
			
			Долг = Окр(Выборка.Долг * КоэффПересчета, 2);
			Долг = СуммаВСтроку(Долг);
			
			Красным = Ложь;
			//Если Выборка.УстановленСрокОплаты Тогда
			//	Если Истина Тогда  // ПоКалендарнымДням
			//		РазницаДатВСекундах = ТекДата - Выборка.ОснованиеДата;
			//		РазницаДней = Цел(РазницаДатВСекундах/(24 * 60 * 60));
			//	Иначе
			//		РазницаДней = ЧислоРабочихДней(Выборка.ОснованиеДата);
			//	КонецЕсли;
			//	ОсталосьДней=Выборка.СрокОплаты-РазницаДней;
			//	
			//	Красным=ОсталосьДней<0;
			//КонецЕсли;
			Красным=Выборка.ДолгПросрочен > 0;
			Основание="";
			
			Если Красным Тогда 
				Основание="<font color=""Red"">"; 
			КонецЕсли;
			Основание = Основание + УбратьСпецСимволы(Выборка.Основание.Метаданные().Представление() + " "
				+ Выборка.ОснованиеНомер+" от "+ Формат(Выборка.ОснованиеДата,"ДФ=dd.MM.yyyy"));
			Если Красным Тогда 
				Основание=Основание+"</font>"; 
			КонецЕсли;
			Основание =УбратьСпецСимволы(Основание);
			
			КонтрагентКод="";
			СоздаватьТТпоАдресам = Ложь;
			Если ЕстьТТпоАдресам Тогда      //ведём ТТ по Адресам
				Отбор = Новый Структура();
				Отбор.Вставить("Контрагент", Выборка.Контрагент);
				НайденныеСтроки = тзАдресаДляТТ.НайтиСтроки(Отбор);
				СоздаватьТТпоАдресам = (НайденныеСтроки.Количество()>1); //Несколько ТТ
			КонецЕсли; 
			
			Если СоздаватьТТпоАдресам Тогда //нужны ТТ поАдресам
				//добавить группу
				
				ОрганизацияКод = СокрЛП(Выборка.Организация.Код);
				КонтрагентКод = СокрЛП(Выборка.Контрагент.Код);
				ОснованиеКод = УникИдентификатор(Выборка.Основание) + "_" + УникИдентификатор(Выборка.Договор);
				ВыборкаДоговорУникИД = УникИдентификатор(Выборка.Договор);
				
				Ответ = Ответ +
				УникИдентификатор(Выборка.Основание) + "_" + УникИдентификатор(Выборка.Договор) + Таб +
				"18" + Таб +
				Основание + Таб +
				СокрЛП(Выборка.Организация.Код) + Таб +
				КонтрагентКод + Таб +
				ВыборкаДоговорУникИД + Таб +
				//ОснованиеКомментарий + Таб +
				"" + Таб +
				Долг + Таб +
				"" + Таб+
				ЦелоеВСтроку(Счетчик) + РазделительСтрок;			
				Счетчик = Счетчик + 1;
				
				Для каждого строка Из НайденныеСтроки Цикл
					
					Ответ = Ответ +
					ОснованиеКод + Таб +
					"18" + Таб +
					Основание + Таб +
					ОрганизацияКод + Таб+
					//код составим из кода контрагента и кода адреса
					УпаковатьКодКонтрагентаИКодАдреса(КонтрагентКод,строка.АдресКод) + Таб +
					ВыборкаДоговорУникИД + Таб +
					//ОснованиеКомментарий + Таб +
					"" + Таб +
					Долг + Таб +
					"" + Таб +
					ЦелоеВСтроку(Счетчик) + РазделительСтрок;			
					Счетчик = Счетчик + 1;
					Если Счетчик % 50 = 0 Тогда
						Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
							ДобавитьОшибку("Ошибка выгрузки документов оснований");
							Возврат Ложь;
						КонецЕсли;
						Ответ = "";
					КонецЕсли;
				КонецЦикла;
			Иначе				
				Если ЕстьТТпоАдресам И НайденныеСтроки.Количество() > 0 Тогда
					
					строка = НайденныеСтроки[0];
					
					Ответ=Ответ+
					УникИдентификатор(Выборка.Основание) + "_" + УникИдентификатор(Выборка.Договор) + Таб +
					"18"+Таб+
					Основание+Таб+
					СокрЛП(Выборка.Организация.Код)+Таб+
					//код составим из кода контрагента и кода адреса
					УпаковатьКодКонтрагентаИКодАдреса(СокрЛП(Выборка.Контрагент.Код),строка.АдресКод)+Таб+
					УникИдентификатор(Выборка.Договор)+Таб+
					""+Таб+
					Долг+Таб+
					""+Таб+
					ЦелоеВСтроку(Счетчик)+РазделительСтрок;			
					Счетчик=Счетчик+1;
					
				Иначе //ТТ по адресам НЕ ведутся Добавим просто контрагента
					Ответ=Ответ+
					УникИдентификатор(Выборка.Основание) + "_" + УникИдентификатор(Выборка.Договор) + Таб +
					"18"+Таб+
					Основание+Таб+
					СокрЛП(Выборка.Организация.Код)+Таб+
					СокрЛП(Выборка.Контрагент.Код)+Таб+
					УникИдентификатор(Выборка.Договор)+Таб+
					""+Таб+
					Долг+Таб+
					""+Таб+
					ЦелоеВСтроку(Счетчик)+РазделительСтрок;			
					Счетчик=Счетчик+1;
				КонецЕсли			
			КонецЕсли;				
			
			Если Счетчик%50=0 Тогда
				Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
					ДобавитьОшибку("Ошибка выгрузки документов оснований");
					Возврат Ложь;
				КонецЕсли;
				Ответ="";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПорцияОбмена(Адрес, Ответ, "Документы основания выгружены " + Счетчик + " записей", "Ошибка выгрузки документов оснований");
КонецФункции

// Определяет адреса доставки контрагентов
// Параметры:
// 		спКонтрагентов - Массив или СписокЗначений, содержит контрагентов, для которых определять адреса
// Возвращаемое значение:
// 		ТаблицаЗначений с колонками:
// 			КонтрагентКод - Строка, код контрагента
// 			Адрес - Строка, адрес контрагента
// 			Контрагент - ссылка на элем. спр. Контрагенты, контрагент
// 			АдресКод - Строка, код данного вида адреса
Функция  ПолучитьАдресаТТ(спКонтрагентов);
	Если СпособОрганизацииТТ = 0 Тогда  //по холдингам
		Возврат Неопределено;  //точки НЕ нужны
	КонецЕсли; 
	Если (АдресаДляТТ.Количество() < 2) Тогда //если выбран только один адрес для торг.точек, то НЕ разбиваем контрагентов на ТТ 
		Возврат Неопределено;  //точки НЕ нужны
	КонецЕсли;  
	
	//получим все адреса ТТ для нужных нам контрагентов
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Объект.Код КАК КонтрагентКод,
	|	КонтактнаяИнформация.Представление КАК Адрес,
	|	КонтактнаяИнформация.Объект КАК Контрагент,
	|	КонтактнаяИнформация.Вид.Код КАК АдресКод
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект В(&спКонтрагентов)
	|	И КонтактнаяИнформация.Вид В(&АдресаДляТТ)
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)";
	
	Запрос.УстановитьПараметр("спКонтрагентов", спКонтрагентов);
	Запрос.УстановитьПараметр("АдресаДляТТ", АдресаДляТТ.ВыгрузитьКолонку("АдресДляТТ"));
	
	тзАдресаДляТТ = Запрос.Выполнить().Выгрузить();
	возврат тзАдресаДляТТ;

КонецФункции // ПолучитьАдресаТТ()

// Определяет перечень типов цен, которые необходимо выгрузить на КПК
// Параметры:
// 		тзДоговоры - ТаблицаЗначений, содержит выгружаемые на КПК договоры. Содержит колонку
// 			ТипЦен - ссылка на элем. спр. ТипыЦенНоменклатуры, тип цен, применяемый для данного договора
// Возвращаемое значение:
// 		ТаблицаЗначений, содержит колонку ТипЦен
Функция ПолучитьТаблицуТиповЦен(тзДоговоры)
    тзТиповЦен = Неопределено;
	
	Если ПараметрыАгента.ВыгружатьТипыЦенИзДоговоров Тогда
		тзТиповЦен=Новый ТаблицаЗначений; //получим все типы цен
		тзТиповЦен = тзДоговоры.Скопировать(,"ТипЦен");
	Иначе
		ТЗ = ПрочитатьИзРегистраСохраненныеНастройки(ПараметрыАгента.Агент,"ДоступныеТипыЦен"); //это Табл значений
		Если ТипЗнч(ТЗ) <> Тип("ТаблицаЗначений") Тогда
			ТЗ = Новый ТаблицаЗначений;
		КонецЕсли;
		Если ТЗ.Колонки.Найти("ТипЦен")= Неопределено Тогда
			ТЗ.Колонки.Добавить("ТипЦен", Новый ОписаниеТипов("СправочникСсылка.ТипыЦенНоменклатуры"));
		КонецЕсли; 	 
		тзТиповЦен = ТЗ.Скопировать(ТЗ.НайтиСтроки(новый структура("Пометка", Истина)), "ТипЦен");
	КонецЕсли;
	
	стр = тзТиповЦен.Добавить();
	стр.ТипЦен = ПараметрыАгента.ТипЦенПоУмолчанию;
	тзТиповЦен.Свернуть("ТипЦен","");
	возврат тзТиповЦен;
		
КонецФункции // ПолучитьТаблицуТиповЦен()

Функция ВыгрузитьИнформациюОФотографиях(Адрес, спКонтрагентов, спНоменклатура, спЗадания)
	ДобавитьСообщение("Выгружается информация о новых изображениях...");
	
	КаталогФотоНаУстройстве = ПолучитьКаталог("Agents\"+СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код)+"\Photo\Device");
	КаталогНовыеФото = ПолучитьКаталог("Agents\"+СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код)+"\Photo\Device\New");
	КаталогУдалитьФото = ПолучитьКаталог("Agents\"+СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код)+"\Photo\Device\Delete");
	
	УдалитьФайлы(КаталогНовыеФото + "\", "*.*");
	УдалитьФайлы(КаталогУдалитьФото + "\", "*.*");
	
	ФотоНаУстройстве = Новый ТаблицаЗначений;
	ФотоНаУстройстве.Колонки.Добавить("ИмяФайла",Новый ОписаниеТипов("Строка"));
	ФотоНаУстройстве.Колонки.Добавить("РасширениеФайла",Новый ОписаниеТипов("Строка"));
	ФотоНаУстройстве.Индексы.Добавить("ИмяФайла");
	НеобходимыеФото = Новый ТаблицаЗначений;
	НеобходимыеФото.Колонки.Добавить("ИмяФайла",Новый ОписаниеТипов("Строка"));
	НеобходимыеФото.Индексы.Добавить("ИмяФайла");
	Файлы = НайтиФайлы(КаталогФотоНаУстройстве + "\", "*.*");
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ЭтоКаталог() Тогда Продолжить; КонецЕсли;
		
		НовСтр = ФотоНаУстройстве.Добавить();
		НовСтр.ИмяФайла = Файл.ИмяБезРасширения;
		НовСтр.РасширениеФайла = Файл.Расширение;
	КонецЦикла;
	
	КолвоФото = 0;
	Если Конфигурация = "БухКазахстан" Тогда
		ОбщийСписок = Новый Массив;
		Колво = спКонтрагентов.Количество();
		Для Н = 0 По Колво - 1 Цикл
			ОбщийСписок.Добавить(спКонтрагентов[Н]);
		КонецЦикла;
		Колво = спНоменклатура.Количество();
		Для Н = 0 По Колво - 1 Цикл
			Попытка
				ОбщийСписок.Добавить(спНоменклатура[Н]);
			Исключение
				Сообщить("" + ОписаниеОшибки() + " Строка " + Н);
			КонецПопытки;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ Ссылка ИЗ Справочник.ХранилищеДополнительнойИнформации
		|ГДЕ ВидДанных = &Изображение И Объект В(&ОбщийСписок) И ПометкаУдаления = ЛОЖЬ
		|СГРУППИРОВАТЬ ПО Ссылка";
		Запрос.Параметры.Вставить("ОбщийСписок",ОбщийСписок);
		Запрос.Параметры.Вставить("Изображение", Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ЕстьВерсияДанных = ЕстьВерсияДанных();
		Если НЕ ЕстьВерсияДанных Тогда
			СисИнфо = Новый  СистемнаяИнформация;
			Версия1С = СисИнфо.ВерсияПриложения;
			платформа81 = ?(Лев(Версия1С, 3) = "8.1", Истина, Ложь);		
			Если платформа81 Тогда
				ДобавитьСообщение("Платформа не поддерживает реквизит ВерсияДанных. " 
				+ "Изменение фотографий товаров и клиентов не отслеживается." + РазделительСтрок 
				+ "Необходимо обновление до 1С:Предприятие 8.2");
			Иначе
				ДобавитьСообщение(
				"Конфигурация запущена в режиме совместимости 8.1, в этом режиме не поддерживается реквизит ВерсияДанных.
				|Изменение фотографий товаров и клиентов не отслеживается.");	
			КонецЕсли
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			Запись = Выборка.Ссылка;
			
			КодТипа = "";
			ТипЗначения = ТипЗнч(Запись.Объект);
			Если ТипЗначения = Тип("СправочникСсылка.Номенклатура") Тогда
				КодТипа = "4";
			ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Контрагенты") Тогда
				КодТипа = "1";
			КонецЕсли;
			
			ИмяФайла = Строка(ТипЗначения);
			ИмяФайла = СтрЗаменить(ИмяФайла,"Справочник ссылка: ", "");
			УникИд = Строка(Запись.УникальныйИдентификатор());
			Если ЕстьВерсияДанных Тогда 
				УникИд = УникИд + ЗаменитьНедопустимыеСимволыВВерсииДанных(Запись.ВерсияДанных); 
			КонецЕсли;
			ИмяФайла = ИмяФайла+"-"+УникИд+"_"+Строка(Запись.Объект.УникальныйИдентификатор())+"_"+КодТипа;
			НовСтр = НеобходимыеФото.Добавить();
			НовСтр.ИмяФайла = ИмяФайла;
			
			Стр = ФотоНаУстройстве.Найти(ИмяФайла, "ИмяФайла");
			Если Стр = Неопределено Тогда
				Картинка = Запись.Хранилище.Получить();
				Если ТипЗнч(картинка) = Тип("Картинка") Тогда
					Попытка
						расширение = картинка.Формат();
					Исключение
						расширение = ФорматКартинки.НеизвестныйФормат;
					КонецПопытки;
					Если расширение = ФорматКартинки.НеизвестныйФормат Тогда 
					Иначе	
						Картинка.Записать(КаталогНовыеФото+"\"+ИмяФайла+"."+Строка(расширение));
						КолвоФото = КолвоФото + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  // казах
	
	Для Каждого Событие Из спЗадания Цикл
		Для Каждого Картинка Из Событие.ТаблицаИзображений Цикл
			ФС = Новый Файл(Картинка.Путь);
			Если ФС.Существует() Тогда
				ИмяФайла = "Сотытие-" + Строка(Событие.УникальныйИдентификатор()) + "_" + Картинка.НомерСтроки + "_34";
				Стр = ФотоНаУстройстве.Найти(ИмяФайла, "ИмяФайла");
				Если Стр = Неопределено Тогда
					Если ФС.Расширение <> ФорматКартинки.НеизвестныйФормат Тогда 
						НовСтр = НеобходимыеФото.Добавить();
						НовСтр.ИмяФайла = ИмяФайла;
						КопироватьФайл(Картинка.Путь, КаталогНовыеФото + "\" + ИмяФайла + Строка(ФС.Расширение));
						КолвоФото = КолвоФото + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	КолвоФотоУдалить = 0;
	Для Каждого Стр Из ФотоНаУстройстве Цикл
		Если НеобходимыеФото.Найти(Стр.ИмяФайла, "ИмяФайла") <> Неопределено Тогда 
			Продолжить; 
		КонецЕсли;		
		КопироватьФайл(
			КаталогФотоНаУстройстве + "\" + Стр.ИмяФайла + Стр.РасширениеФайла,
			КаталогУдалитьФото + "\" + Стр.ИмяФайла + Стр.РасширениеФайла);
		КолвоФотоУдалить=КолвоФотоУдалить+1;
	КонецЦикла;
	
	Если КолвоФото + КолвоФотоУдалить > 0 тогда
		СерверПослатьОтвет(Адрес,
			"NewPhoto" + РазделительСтрок 
			+ "Необходимо " 
				+ ?(КолвоФото > 0, "загрузить новые " + КолвоФото + " фото", "") 
				+ ?(КолвоФото > 0 И КолвоФотоУдалить > 0, " и ", "") 
				+ ?(КолвоФотоУдалить > 0, "удалить старые "+КолвоФотоУдалить+" фото", "") + РазделительСтрок 
			+ РазделительСтрок, 0);
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

// Реагирует на запрос полной загрузки
// Параметры 
// Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьДанные(Адрес, Платформа)
	ДобавитьСообщение("Выполняется запрос 'Полная загрузка'");
	Если ПараметрыАгента.ТипЦенПоУмолчанию.Пустая() Тогда
		Ответ="Не задан тип цен по-умолчанию";
		ДобавитьОшибку(Ответ);
		СерверПослатьОтвет(Адрес, Ответ + РазделительСтрок, 1);
		Возврат Ложь;
	КонецЕсли;
	
	// Применяем настройку агента ВалютаКПК     
	ПараметрыАгента.ВалютаКПК = ПараметрыАгента.ВалютаНастройка;
	ЗаписатьВРегистрСохраненныеНастройки(ПараметрыАгента.Агент, ПараметрыАгента.ВалютаНастройка, "ВалютаКПК");
	
	//создать таблицу номенклатуры	
	тзНоменклатура = Новый ТаблицаЗначений;
	тзОстатки = Новый ТаблицаЗначений;
	ПолучитьСписокНоменклатуры(тзНоменклатура, тзОстатки);
	тзОстатки.Индексы.Добавить("Номенклатура");
	спНоменклатура = тзНоменклатура.ВыгрузитьКолонку("Номенклатура"); //список товаров
	
// подготовить таблицу организаций
    тзОрганизации = ПрочитатьОрганизации(ПараметрыАгента.Агент); 
	Если (ТипЗнч(тзОрганизации) <> Тип("ТаблицаЗначений")) или (тзОрганизации.Количество()=0) Тогда
		ДобавитьСообщение("Не заданы организации.Будут выгружены все ");
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Организации.Ссылка КАК Организация,
		               |	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Грузоотправитель
		               |ИЗ
		               |	Справочник.Организации КАК Организации";
		
		тзОрганизации = Запрос.Выполнить().Выгрузить();
	КонецЕсли; 
	
	//подготовить таблицу контрагентов
	МВТДолги = Неопределено;
	тзКонтрагенты = ПолучитьТаблицуКонтрагентов(
		ПараметрыАгента.Агент,
		ПараметрыАгента.ЗапретитьИзменятьТипЦен,
		ПараметрыАгента.ВыделятьЦветомКонтрагентов, 
		Ложь, МВТДолги);
	Если тзКонтрагенты.Количество() = 0 Тогда
		Ответ="Контрагенты НЕ выгружены. Проверьте условия отбора. ";
		ДобавитьОшибку(Ответ);
		СерверПослатьОтвет(Адрес, Ответ + РазделительСтрок, 1);
		Возврат Ложь;
	КонецЕсли; 
	
	Ответ="OK"+РазделительСтрок;
	Если НЕ СерверПослатьОтвет(Адрес, Ответ, 0) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	//служебные данные	
	Если НЕ ВыгрузитьСлужебныеДанные(Адрес) Тогда 
		Возврат Ложь;
	КонецЕсли;
	//служебные данные	
	Если НЕ ВыгрузитьНастройкиАгента(Адрес) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если (Платформа="Android") ИЛИ (Платформа="HTML") Тогда
		Если НЕ ВыгрузитьНастройкиКолонокДокументов(Адрес) Тогда 
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//Список номенклатуры
	Если НЕ ВыгрузитьНоменклатуру(Адрес, тзНоменклатура) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	Если НЕ ВыгрузитьОстаткиНоменклатуры(Адрес, тзОстатки) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Группы номенклатуры (папки) 
	Если НЕ ВыгрузитьГруппыНоменклатуры(Адрес, тзНоменклатура) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Состав групп номенклатуры
	Если НЕ ВыгрузитьСоставГруппНоменклатуры(Адрес, тзНоменклатура) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	Если (Платформа="Android") ИЛИ (Платформа="HTML") Тогда
		Если НЕ ВыгрузитьСклады(Адрес) Тогда 
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;
	
	спКонтрагентов = тзКонтрагенты.ВыгрузитьКолонку("Контрагент"); //список контрагентов
	
	//подготовить таблицу адресов торговых точек
	тзАдресаДляТТ = ПолучитьАдресаТТ(спКонтрагентов);
	
	//подготовить таблицу Юр.лиц
	тзЮрЛица = Новый ТаблицаЗначений;
	тзЮрЛица.Колонки.Добавить("Код");
	тзЮрЛица.Колонки.Добавить("Наименование");
	
	// Контрагенты
	Если НЕ ВыгрузитьКонтрагентов(Адрес, тзКонтрагенты, тзАдресаДляТТ, тзЮрЛица) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	// Группы контрагентов (папки) 
	//Если НЕ ВыгрузитьГруппыКонтрагентов(Адрес,тзЮрЛица) Тогда 
	//	Возврат Ложь; 
	//КонецЕсли;
	
	Если (Платформа="Android") ИЛИ (Платформа="HTML") Тогда
		Если НЕ ВыгрузитьСегментыКонтрагентов(Адрес,тзКонтрагенты) Тогда
			Возврат Ложь; 
		КонецЕсли;
		Если НЕ ВыгрузитьНазначениеСегментовКонтрагентов(Адрес, тзКонтрагенты) Тогда
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;
	
	// подготовить таблицу договоров
    тзДоговоры = ПолучитьТаблицуДоговоров(
		спКонтрагентов,
		тзОрганизации, 
		ПараметрыАгента.ТипЦенПоУмолчанию, 
		ПараметрыАгента.ТипСоздаваемогоДокументаПокупка, 
		ПараметрыАгента.ТорговляСКолес, МВТДолги);
	
	// Договора   
	Если НЕ ВыгрузитьДоговоры(Адрес,тзДоговоры,тзАдресаДляТТ,Платформа) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	// Скидки
	Если НЕ ВыгрузитьСкидки(Адрес) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//подготовить таблицу типов цен	
	тзТиповЦен = ПолучитьТаблицуТиповЦен(тзДоговоры);	
	
	//Типы Цен
	Если НЕ ВыгрузитьТипыЦен(Адрес,тзТиповЦен) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Цены
	Если НЕ ВыгрузитьЦены(Адрес,тзНоменклатура,тзТиповЦен) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Единицы измерения 
	Если НЕ ВыгрузитьЕдиницы(Адрес,тзНоменклатура) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Агенты    
	Если НЕ ВыгрузитьАгентов(Адрес) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Организации
	Если НЕ ВыгрузитьОрганизации(Адрес,тзОрганизации) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	//Маршруты
	//03.03.14 Если в настроках агента снят флажок "Выгружать задания" то необходимо выгрузить 
	//начало секции заданий согласно протокола чтобы очистить список заданий на КПК
	Если ПараметрыАгента.ВыгружатьМаршруты Тогда
		Если НЕ ВыгрузитьМаршруты(Адрес, Платформа, ПараметрыАгента.ВыгружатьМаршруты, Истина, спКонтрагентов) Тогда 
			Возврат Ложь; 
		КонецЕсли;
		//Маршруты за сегодня
		Если ЗаданияВозможны Тогда
			ТаблМаршрутов = ПолучитьПланПосещений(ПараметрыАгента.Агент, ТекущаяДата(), Истина, спКонтрагентов);
		Иначе
			ТаблМаршрутов = Новый ТаблицаЗначений;
			ТаблМаршрутов.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		КонецЕсли;
	КонецЕсли;
	
	//Подсказки продаж
	Если ПараметрыАгента.ВыгружатьПодсказкиПродаж Тогда
		Если НЕ ВыгрузитьПодсказкиПродажПриПолнойЗагрузке(Адрес, тзКонтрагенты, тзНоменклатура) Тогда 
			Возврат Ложь; 
		КонецЕсли;
	Иначе
		Если ПараметрыАгента.ВыгружатьМаршруты Тогда
			Если НЕ ВыгрузитьПодсказкиПродажПриПолнойЗагрузке(Адрес, ТаблМаршрутов, тзНоменклатура) Тогда 
				Возврат Ложь; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//СвойстваОбъектов (КаналыСбыта)
	Если НЕ ВыгрузитьСвойстваОбъектов(Адрес, тзНоменклатура, спКонтрагентов, тзАдресаДляТТ, ПараметрыАгента.ВыгружатьКаналыСбыта) Тогда 
		Возврат Ложь; 
	КонецЕсли;

	Если (Платформа="Android") ИЛИ (Платформа="HTML") Тогда
		ВыгрузитьПечатныеФормы(Адрес);
	КонецЕсли;
	
	//сообщения	
	Если ПараметрыАгента.ВыгружатьСообщения Тогда
		Если НЕ ВыгрузитьСообщения(Адрес,"1,2,3", тзНоменклатура, спКонтрагентов, "Messages") Тогда 
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;

	//формы
	Если НЕ ВыгрузитьФормы(Адрес) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	Если (Платформа="Android") ИЛИ (Платформа="HTML") Тогда
		Если НЕ ВыгрузитьДопРеквизиты(Адрес) Тогда 
			Возврат Ложь; 
		КонецЕсли;
		
		Если НЕ ВыгрузитьЗначенияДопРеквизитов(Адрес, спКонтрагентов, тзОрганизации.ВыгрузитьКолонку("Организация")) Тогда 
			Возврат Ложь; 
		КонецЕсли;
		
		Если НЕ ВыгрузитьДокументыОснования(Адрес,тзОрганизации.ВыгрузитьКолонку("Организация"), спКонтрагентов, тзАдресаДляТТ, тзДоговоры, МВТДолги) Тогда 
			Возврат Ложь; 
		КонецЕсли;
		
		спЗадания = новый Массив;
		Если ТаблМаршрутов <> Неопределено Тогда
			спЗадания = ТаблМаршрутов.ВыгрузитьКолонку("Событие");
		КонецЕсли;
		Если НЕ ВыгрузитьИнформациюОФотографиях(Адрес, спКонтрагентов, спНоменклатура, спЗадания) Тогда 
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СерверПослатьОтвет(Адрес, РазделительСтрок, 1) Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

// Реагирует на запрос на обновление программы.
// Файл должен лежать в папке КаталогЛогФайлов\Update
// Адрес - идентификатор сессии обмена
// ИмяФайла - файл который нужно передать в КПК. Файл должен лежать в папке КаталогЛогФайлов\Update
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьФайл(Адрес, ИмяФайла, Платформа)
	Если НЕ ПорцияОбмена(Адрес,"OK","Отправляется файл "+ИмяФайла+"...") Тогда
		Возврат Ложь;
	КонецЕсли;
	//Запрет выгрузки файлов из папки кроме UpDates
	ИмяФайла= СтрЗаменить(ИмяФайла,":","");
	ИмяФайла= СтрЗаменить(ИмяФайла,"\","");
	ИмяФайла= СтрЗаменить(ИмяФайла,"/","");
	ИмяФайла= СтрЗаменить(ИмяФайла,"..","");
	ИмяФайла= СтрЗаменить(ИмяФайла,"*","");
	ИмяФайла= СтрЗаменить(ИмяФайла,"?","");
	
	КаталогОбновления =  ПолучитьКаталог("Updates");
	Если  Платформа = "WM" Тогда
	    КаталогОбновления = КаталогОбновления + "\WM"
	ИначеЕсли Платформа = "Android" Тогда
	    КаталогОбновления = КаталогОбновления + "\Android"
	ИначеЕсли Платформа = "HTML" Тогда
	    КаталогОбновления = КаталогОбновления + "\HTML"
	КонецЕсли;
	Файл=Новый Файл(КаталогОбновления);
	Если НЕ Файл.Существует() Тогда
		СоздатьКаталог(КаталогОбновления); 
	КонецЕсли;

	
	Файл=КаталогОбновления+"\"+ИмяФайла;
	Если НЕ Сервер.ПослатьФайл(Адрес,Файл) Тогда
		ДобавитьВЛогФайл("Ошибка при попытке отправить файл "+Файл,ПараметрыАгента.Агент,0);
	КонецЕсли;
	СерверПослатьОтвет(Адрес,"",1);
	Возврат Истина;
КонецФункции

// Загружает GPS-координаты агента
// Параметры
// Адрес - идентификатор сессии обмена
// Запрос - Текст полученный от КПК
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ЗагрузитьКоординаты(Адрес, Запрос)
	НачСтр = 5; //тело сообщения начинается с этой строки
	ДобавитьСообщение("Загружаются GPS-координаты агента... ");
	
	//если нет данных для загрузки то выходим
	КолСтр = СтрЧислоСтрок(Запрос);
	
	Если (КолСтр < НачСтр)  Тогда
		СерверПослатьОтвет(Адрес,"OK"+РазделительСтрок,1);
		Возврат Истина;    
	КонецЕсли;
	
	//проверить каталог GPS в папке пользователя
	КодАгента = СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код);
	Кат = ПолучитьКаталог("Agents\"+КодАгента+"\GPS");
	//Если Прав(Кат,1)="\" Тогда 
	//	Кат=Лев(Кат,СтрДлина(Кат)-1); 
	//КонецЕсли;
	СоздатьКаталог(Кат); 
	
	ЧасовойПояс=ПолучитьНастройку(ПараметрыАгента.Агент,"ЧасовойПояс",99);
	ТекущаяДатаДанных = Неопределено;
		
	Текст = Новый ЗаписьТекста;
	стр = Неопределено;
	
	чтТрек = новый ЧтениеТекста();
	стрТрек = "";
	ДатаДанныхСтр = "";
		
	Для Н = НачСтр По КолСтр Цикл
		стр = СтрПолучитьСтроку(Запрос,Н);
		ДатаДанныхСтр = СтрПолучитьСтроку(СтрЗаменить(стр,Таб,РазделительСтрок),1);
		ДатаДанных = ДатаИзСтрокиСКПК(ДатаДанныхСтр);
		ДатаДанных = КонвертироватьUTCВремяВЛокальное(ДатаДанных,ЧасовойПояс);
		ДатаДанных = НачалоДня(ДатаДанных);
		//Если в выгрузке встретим другую дату то нужно писать данные в другой файл
		Если ТекущаяДатаДанных <> ДатаДанных Тогда
			Если ТекущаяДатаДанных <> ДатаПустая() Тогда
				Текст.Закрыть();
			КонецЕсли; 
			ИмяGPSФайла=Кат + "\GPS_"+СокрЛП(Формат(ДатаДанных,"ДФ=""ггггММдд"""))+".txt";
			
			Если СуществуетФайл(ИмяGPSФайла) Тогда
				чтТрек.Открыть(ИмяGPSФайла);
				стрТрек = чтТрек.Прочитать();
				чтТрек.Закрыть();						
			Иначе
				стрТрек = "";
			КонецЕсли;						
			
			Текст = Новый ЗаписьТекста(ИмяGPSФайла, КодировкаТекста.ANSI,,Истина);
			ТекущаяДатаДанных = ДатаДанных;
		КонецЕсли;
				
		Если Найти(стрТрек, ДатаДанныхСтр) = 0 Тогда
			Текст.ЗаписатьСтроку(стр);
			стрТрек = стрТрек + "
			|" + стр;
		КонецЕсли;
	КонецЦикла;  
	Текст.Закрыть();
		
	Если стр = Неопределено Тогда
	Иначе		
		стр = СтрЗаменить(стр,Таб,РазделительСтрок);
		Время	= КонвертироватьUTCВремяВЛокальное(ДатаИзСтрокиСКПК(СтрПолучитьСтроку(стр,1)), ЧасовойПояс);
		Долгота	= СтрокуВЧисло(СтрПолучитьСтроку(стр,2));
		Широта	= СтрокуВЧисло(СтрПолучитьСтроку(стр,3));
		Скорость = СтрокуВЧисло(СтрПолучитьСтроку(стр,5));
		текДата = ТекущаяДатаСуточнаяКоррекция();
		ТекВремяC = текДата - 8 * 60 * 60;
		ТекВремяПО = ТекВремяC + 16 * 60 * 60;			
		
		Если ТекВремяC <= Время И Время <= ТекВремяПО Тогда
			ОбновитьТекКоординатыАгента(КодАгента, Время, Широта, Долгота, Скорость, "GPS");
			СохранитьТекущиеКоординатыАгентовВБазу();	
		КонецЕсли;
		
	КонецЕсли;
	
	
	
	//СерверПослатьОтвет(Адрес,"OK"+РазделительСтрок,1);
	СерверПослатьОтвет(Адрес,"OK",0);
	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
	Возврат Истина;
КонецФункции

// Загружает географические координаты контрагентов в свойство контрагента  ввиде Широта+Пробел+Долгота
// Параметры
// Адрес - идентификатор сессии обмена
// Запрос - Текст полученный от КПК
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ЗагрузитьКоординатыКонтрагентов(Адрес, ТелоЗапроса)
	НачСтр = 5;
	ДобавитьСообщение("Загружаются координаты контрагентов... ");
	КолСтр=СтрЧислоСтрок(ТелоЗапроса);
	Если  КолСтр < НачСтр  Тогда
		СерверПослатьОтвет(Адрес,"OK"+РазделительСтрок,1);
		Возврат Истина;    
	КонецЕсли;
	//ТаблКоординаты = ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"КоординатыКонтрагентов");
	//идем циклом по выгружаемым данным и задаем для Контрагентов параметр Координаты GPS
	Для Н=НачСтр По КолСтр Цикл
		стр = СтрПолучитьСтроку(ТелоЗапроса,Н);
		стр = СтрЗаменить(стр,Таб,РазделительСтрок);  
		КодКонтрагент = СокрЛП(СтрПолучитьСтроку(стр,1));
		Если ЗначениеЗаполнено(КодКонтрагент) Тогда
			Широта	= СтрЗаменить(СтрПолучитьСтроку(стр,2),",",".");
			Долгота	= СтрЗаменить(СтрПолучитьСтроку(стр,3),",",".");
			
			Если ЗначениеЗаполнено(Широта) и  ЗначениеЗаполнено(Долгота) Тогда
				Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагент);
				Если Контрагент.Пустая() Тогда
					ДобавитьСообщение(
						"Не найден контрагент с кодом "+КодКонтрагент + ", координаты (" + Широта + ", " + Долгота + ")");
				Иначе
					УстановитьКоординатыКонтрагента(Контрагент,Широта,Долгота);	
				КонецЕсли;				
			КонецЕсли; 
		КонецЕсли;	
	КонецЦикла;		
	
	СерверПослатьОтвет(Адрес,"OK",0);
	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
	//ЗаписатьВРегистрСохраненныеНастройки(МобиС,ТаблКоординаты,"КоординатыКонтрагентов");
	Возврат Истина;	
КонецФункции

//сохраняет в регистр сведений полученные координаты агентов
Процедура СохранитьТекущиеКоординатыАгентовВБазу()
//блокируем общий для обработок объект
    МобиСОбъект = МобиС.ПолучитьОбъект();
	Попытка 
		МобиСОбъект.Заблокировать();
	Исключение
		МобиСОбъект = Неопределено;
		ПодключитьОбработчикОжидания("СохранитьТекущиеКоординатыАгентовВБазу", 1, Истина); 
		Возврат;
	КонецПопытки;
	
	Если Истина Тогда
//если блокировка успешна - тогда
//считываем последние записанные в базу координаты
		таблКоординаты = ПрочитатьКоординатыАгентов();
//дополняем полученные координаты имевшимися ранее
		стрТЗ = Неопределено;	
		ТекВремяC = ТекущаяДатаСуточнаяКоррекция() - 8 * 60 * 60;
		ТекВремяПО = ТекВремяC + 16 * 60 * 60;		
		для каждого стр из таблКоординаты Цикл	    	
			Если ТекВремяC <= Стр.ДатаВремя 
				И Стр.ДатаВремя <= ТекВремяПО Тогда
				//если обрабатываемая координата корректна - +/- 8 часов от текущего времени
				стрТЗ = ТаблТекущиеКоординаты.НайтиСтроки(новый Структура("Код", стр.Код));
				Если стрТЗ.Количество() = 0 Тогда
				//если в актуальных координатах не нашли ранее сохраненную координату - её необходиом добавить
					стрТЗ = ТаблТекущиеКоординаты.Добавить();
					стрТЗ.Код = стр.Код;
					стрТЗ.ДатаВремя = стр.ДатаВремя;
					стрТЗ.Широта = стр.Широта;
					стрТЗ.Долгота = стр.Долгота;
					стрТЗ.Скорость = стр.Скорость;
					стрТЗ.Источник = стр.Источник;
				Иначе//если координата этого агента была сохранена, то надо проверить и выбрать самую свежую
					Если стрТЗ[0].ДатаВремя < стр.ДатаВремя
						ИЛИ (ТекВремяПО <= стрТЗ[0].ДатаВремя 
							ИЛИ стрТЗ[0].ДатаВремя <= ТекВремяC) Тогда
						//обрабатываемая координата новее запомненной или запомненная некорректна
						стрТЗ[0].ДатаВремя = стр.ДатаВремя;
						стрТЗ[0].Широта = стр.Широта;
						стрТЗ[0].Долгота = стр.Долгота;
						стрТЗ[0].Скорость = стр.Скорость;
						стрТЗ[0].Источник = стр.Источник;
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;				
//сохраняем данные в базу
		ЗаписатьВРегистрСохраненныеНастройки(МобиС, ТаблТекущиеКоординаты, "ТекущиеКоординатыАгентов");
	КонецЕсли;
//освобождаем захваченный объект	
	МобиСОбъект.Разблокировать();
	ТаблТекущиеКоординаты.Очистить();
	МобиСОбъект = Неопределено;
КонецПроцедуры

Процедура ОбновитьТекКоординатыАгента(КодАгента, ДатаВремя, Широта, Долгота, Скорость, Источник)
	
	стрТЗ = ТаблТекущиеКоординаты.Найти(КодАгента,"Код");
	Если стрТЗ = Неопределено Тогда
		//координаты агента не зафиксировано, обновляем		
		стрТЗ = ТаблТекущиеКоординаты.Добавить();
		стрТЗ.Код = КодАгента;
		стрТЗ.ДатаВремя =датаВремя;
		стрТЗ.Широта =  Широта;
		стрТЗ.Долгота = Долгота;
		стрТЗ.Скорость = Скорость;
		стрТЗ.Источник = Источник;
	Иначе
		//координата агента есть, необходимо проверить
		//которая новее и её использовать
		Если стрТЗ.ДатаВремя > ДатаВремя Тогда
		//координата в базе свежее рассматриваемой	
		Иначе
			стрТЗ.ДатаВремя =датаВремя;
			стрТЗ.Широта =  Широта;
			стрТЗ.Долгота = Долгота;
			стрТЗ.Скорость = Скорость;
			стрТЗ.Источник = Источник;
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

// Загружает текущие координат агентов
// Параметры
// Запрос - Текст полученный от КПК
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно
// сохраняем таблицу в настройках при закрытии обработки
Функция СохранитьТекущиеКоординатыАгентов(ТелоЗапроса)
//проблема
//если запущено несколько обработок то выгрузка координат в любую из запущенных затрет выгруженные ранее координаты	
//если запущено несколько обработок, то возможно что выгрузка координат в обработки из dll пройдет одновремено и в итоге будут потери координат
//
//схема следующая: 
//в обработках запоминаем пришедшые координаты и через отложенный вызов заносим их в базу 1С,
//при этом при занесении необходимо устанавливать блокировку на какой либо объект (например пользователь МобиС)
	НачСтр = 4;
	КолСтр=СтрЧислоСтрок(ТелоЗапроса);
	Если  КолСтр < НачСтр  Тогда
		Возврат Истина;    
	КонецЕсли;	
	
	текДата = ТекущаяДатаСуточнаяКоррекция();
	ТекВремяC = текДата - 8 * 60 * 60;
	ТекВремяПО = ТекВремяC + 16 * 60 * 60;			
	
	Для Н=НачСтр По КолСтр Цикл
		стр = СтрПолучитьСтроку(ТелоЗапроса,Н);
		стр = СтрЗаменить(стр,Таб,РазделительСтрок);  
		КодАгента 	= СокрЛП(СтрПолучитьСтроку(стр,1));
		
		СтрАгент=ПолучитьТаблицуАгентов().Найти(СокрЛП(КодАгента),"Код");
		Если СтрАгент=Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		ЧасовойПояс = ПолучитьНастройку(СтрАгент.Агент, "ЧасовойПояс", 99);
		
		ДатаВремя = ДатаИзСтрокиСКПК(СокрЛП(СтрПолучитьСтроку(стр,2)));
		Долгота = СтрЗаменить(СтрПолучитьСтроку(стр,3),",",".");
		Широта 	= СтрЗаменить(СтрПолучитьСтроку(стр,4),",",".");
		Скорость = СтрЗаменить(СтрПолучитьСтроку(стр,5),",",".");

		Если Долгота=0 или Широта=0 Тогда
			Продолжить;
		КонецЕсли;	
		
		датаВремя = КонвертироватьUTCВремяВЛокальное(ДатаВремя,ЧасовойПояс);
		Если ТекВремяПО <= датаВремя
				ИЛИ датаВремя <= ТекВремяC Тогда
			Продолжить;
		КонецЕсли;
		
		ОбновитьТекКоординатыАгента(КодАгента, ДатаВремя, Широта, Долгота, Скорость, "CP");
				
		// Отработаем ПоследнийОткликАгента
		ЗаписатьВРегистрСохраненныеНастройки(СтрАгент.Агент, текДата, "ПоследнийОткликАгента");
		
    КонецЦикла;	
	
	//сохранить данные - так сохранять нельзя тк будут потеряны данные, сохраненные другой обработкой 
	СохранитьТекущиеКоординатыАгентовВБазу();	
	Возврат Истина;	
КонецФункции

// Изменяет статус сообщений 
// Параметры
// Адрес - идентификатор сессии обмена
// Запрос - Текст полученный от КПК
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ИзменитьСтатусСообщений(Адрес,ТелоЗапроса)
	НачСтр = 5;
	ДобавитьСообщение("Загружается статус сообщений... "); 
	КолСтр=СтрЧислоСтрок(ТелоЗапроса);
	Если КолСтр < НачСтр  Тогда
		СерверПослатьОтвет(Адрес,"OK" + РазделительСтрок,1);
		Возврат Истина;    
	КонецЕсли;
	
	Блокировщик = Неопределено;
	БД = ОткрытьВнешнююБД(Блокировщик, истина);
	Если БД = Ложь Тогда
		Сообщить(ОшибкаНетДоступаКВнешнейБД, СтатусСообщения.Важное);
		СерверПослатьОтвет(Адрес,"OK" + РазделительСтрок,1);
		Возврат Истина;
	КонецЕсли;
	
	ПодгЗапрос = БДПодготовитьЗапрос(БД, "Update [messages] Set STATUS = ? Where CODE = ? AND STATUS < ?");
	
	Для Н = НачСтр По КолСтр Цикл
		стр = СтрПолучитьСтроку(ТелоЗапроса,Н);
		стр = СтрЗаменить(стр,Таб,РазделительСтрок);
		КодСообщения = ПолучитьЧислоИзСтроки(СокрЛП(СтрПолучитьСтроку(стр,1)));
		Статус       = СокрЛП(СтрПолучитьСтроку(стр,2));
		Если КодСообщения > 10000 Тогда
			КодСообщения = Цел(КодСообщения / 10000);
		КонецЕсли;
		
		БДУстановитьПараметр(ПодгЗапрос, 1, Статус);
		БДУстановитьПараметр(ПодгЗапрос, 2, КодСообщения);
		БДУстановитьПараметр(ПодгЗапрос, 3, Статус);

		БДСледующаяЗапись(ПодгЗапрос);
		БДСбросПодготовленногоЗапроса(ПодгЗапрос);
	КонецЦикла;		
	
	// удалить все строки с признаком "Удалить после прочтения" и статус >=3 (выполнено или прочитано)
	ПодгЗапрос=БДПодготовитьЗапрос(БД, "Delete From [messages] Where STATUS>=3 AND DEL=1");
	БДСледующаяЗапись(ПодгЗапрос);
	БДЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
	
	ЗакрытьВнешнююБД(БД, Блокировщик);	

	СерверПослатьОтвет(Адрес,"OK" + РазделительСтрок,1);
	Возврат Истина;
КонецФункции

