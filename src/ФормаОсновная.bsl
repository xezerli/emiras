Функция ПреобразоватьЦветВАбсолютный(ИсходныйЦвет)
	текТаблица = Новый ТабличныйДокумент;
	текТаблица.Область("R1C1").ЦветТекста = ИсходныйЦвет;
	ВремФайл=ПолучитьИмяВременногоФайла();
	текТаблица.Записать(ВремФайл, ТипФайлаТабличногоДокумента.MXL7); 
	текТаблица.Прочитать(ВремФайл);
	УдалитьФайлы(ВремФайл);
	Возврат текТаблица.Область("R1C1").ЦветТекста;
КонецФункции

Функция ВывестиСтатусОблачногоСервера(Статус = "")
	ЦветФона=ПреобразоватьЦветВАбсолютный(ЦветаСтиля.ЦветФонаФормы);
	ЦветФона=ЦветФона.Красный*256*256+ЦветФона.Зеленый*256+ЦветФона.Синий;
	Пока ЦветФона>0 Цикл
		Символ=ЦветФона%16;
		Если Символ>=10 Тогда
			Символ=Символ(55+Символ);
		Иначе
			Символ=Символ(48+Символ);
		КонецЕсли;
		Цвет16=Символ+Цвет16;
		
		ЦветФона=Цел(ЦветФона/16);
	КонецЦикла;
	Цвет16="#"+Прав("00000000"+Цвет16,6);
	
	ЦветФона=ПреобразоватьЦветВАбсолютный(ЦветаСтиля.ЦветФонаФормы);
	ЦветФона=ЦветФона.Красный*256*256+ЦветФона.Зеленый*256+ЦветФона.Синий;
	Пока ЦветФона>0 Цикл
		Символ=ЦветФона%16;
		Если Символ>=10 Тогда
			Символ=Символ(55+Символ);
		Иначе
			Символ=Символ(48+Символ);
		КонецЕсли;
		Цвет16=Символ+Цвет16;
		
		ЦветФона=Цел(ЦветФона/16);
	КонецЦикла;
	Цвет16="#"+Прав("00000000"+Цвет16,6);
