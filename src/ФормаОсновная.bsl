				КонецЕсли;
				Если Конфигурация = "БухКазахстан" Тогда		
					НовыйКонтрагент.ИдентификационныйКодЛичности = СтрШапки.ИНН;
					НовыйКонтрагент.РНН = СтрШапки.КПП;
					Почта = Справочники.ВидыКонтактнойИнформации.СлужебныйАдресЭлектроннойПочтыПользователя;
				Иначе				
					НовыйКонтрагент.ИНН = СтрШапки.ИНН;
					НовыйКонтрагент.КПП = СтрШапки.КПП;
					Почта = Справочники.ВидыКонтактнойИнформации.ДругаяИнформацияКонтрагента;
				КонецЕсли;
				
				Покупатель = ?(СтрШапки.Покупатель = "1", Истина, Ложь);
	   			Поставщик = ?(СтрШапки.Поставщик = "1", Истина, Ложь);
				// Если Агенты забыли поставить флажки - новый контрагент будет покупателем
				Если (Не Покупатель) И (Не Поставщик) Тогда
					Покупатель = Истина;
				КонецЕсли;
				
	            НовыйКонтрагент.Комментарий = СтрШапки.Комментарий;
	            НовыйКонтрагент.Родитель = ПараметрыАгента.ГруппаДляНовыхКонтрагентов;
				
				НовыйКонтрагент.УстановитьНовыйКод();
				НовыйКонтрагент.Записать();
				//Фактический адрес
				НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей(); 
				НаборЗаписей.Прочитать(); 
				РегСведКонтактнаяИнформация = НаборЗаписей.Добавить();                     
				РегСведКонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи(); 
				РегСведКонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
				РегСведКонтактнаяИнформация.Объект = НовыйКонтрагент.Ссылка;
				РегСведКонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
	            РегСведКонтактнаяИнформация.Поле2 = СтрШапки.ФактическийАдрес;
	            РегСведКонтактнаяИнформация.Представление = СтрШапки.ФактическийАдрес;
				РегСведКонтактнаяИнформация.Записать();
				//юридический адрес
				РегСведКонтактнаяИнформация = НаборЗаписей.Добавить();                     
				РегСведКонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи(); 
				РегСведКонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
				РегСведКонтактнаяИнформация.Объект = НовыйКонтрагент.Ссылка;
				РегСведКонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
	            РегСведКонтактнаяИнформация.Поле2 = СтрШапки.ЮридическийАдрес;
	            РегСведКонтактнаяИнформация.Представление = СтрШапки.ЮридическийАдрес;
				РегСведКонтактнаяИнформация.Записать();
				//телефон
				РегСведКонтактнаяИнформация = НаборЗаписей.Добавить();                     
				РегСведКонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи(); 
				РегСведКонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				РегСведКонтактнаяИнформация.Объект = НовыйКонтрагент.Ссылка;
				РегСведКонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	            РегСведКонтактнаяИнформация.Представление = СтрШапки.Телефон;
				РегСведКонтактнаяИнформация.Записать();
				//email
				РегСведКонтактнаяИнформация = НаборЗаписей.Добавить();                     
				РегСведКонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи(); 
				РегСведКонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				РегСведКонтактнаяИнформация.Объект = НовыйКонтрагент.Ссылка;
				РегСведКонтактнаяИнформация.Вид = Почта;
	            РегСведКонтактнаяИнформация.Представление = СтрШапки.Почта;
				РегСведКонтактнаяИнформация.Записать();
				//контактное лицо
				контактноеЛицоКонтрагента = Справочники.КонтактныеЛица.СоздатьЭлемент();
				контактноеЛицоКонтрагента.ОбъектВладелец = НовыйКонтрагент.Ссылка;
				контактноеЛицоКонтрагента.ВидКонтактногоЛица = ПеречислениЯ.ВидыКонтактныхЛиц.КонтактноеЛицоКонтрагента;
				контактноеЛицоКонтрагента.Наименование = СтрШапки.ФИО;
				контактноеЛицоКонтрагента.Записать();	
				
				//оформляем новому клиенту расчетный счет
				Если  СтрШапки.БИК <> "" Тогда
					//Ищем банк в справочнике Банки по БИК
					СпрБанки = Справочники.Банки;
					БанкКлиента = СпрБанки.НайтиПоКоду(СтрШапки.БИК);
					Если БанкКлиента = СпрБанки.ПустаяСсылка() Тогда
						//создаем новый банк
						БанкКлиента = СпрБанки.СоздатьЭлемент();
						БанкКлиента.Код = СтрШапки.БИК;
						БанкКлиента.Наименование = СтрШапки.Банк;
						БанкКлиента.Город = СтрШапки.ГородБанка;
						БанкКлиента.КоррСчет = СтрШапки.КорСчет;
						БанкКлиента.Записать();
						ДобавитьВЛогФайл("Создан новый банк с БИК - " + СтрШапки.БИК + ".", ПараметрыАгента.Агент, 0);
					КонецЕсли;
					//ищем счет клиента
					Попытка
						БанковскиеСчета = Справочники.БанковскиеСчета;
						БанковскийСчет = БанковскиеСчета.СоздатьЭлемент();
						БанковскийСчет.Наименование = "Р/С";
						БанковскийСчет.НомерСчета = СтрШапки.РСчет;
						БанковскийСчет.Банк = БанкКлиента.Ссылка;
						БанковскийСчет.Владелец = НовыйКонтрагент.ссылка;
						БанковскийСчет.ВалютаДенежныхСредств = мВалютаРегламентированногоУчета;
						БанковскийСчет.ВидСчета = "Расчетный";
						БанковскийСчет.Записать();
					Исключение
						глПоследняяОшибкаПроведения = "Указанный счет некорректен";
						ВызватьИсключение;
					КонецПопытки				
				КонецЕсли;
				// Договор
				Договор              = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			    Договор.Наименование = "Основной договор";
				//Договор.ВалютаВзаиморасчетов = ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяВалютаВзаиморасчетов");
				Договор.ВалютаВзаиморасчетов = ПолучитьЗначениеПоУмолчаниюПользователя(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяВалютаВзаиморасчетов");
				Если НЕ ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) Тогда
					Договор.ВалютаВзаиморасчетов = мВалютаРегламентированногоУчета;
				КонецЕсли;
				//Договор.Организация = ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяОрганизация");
	            Договор.Организация = ПолучитьЗначениеПоУмолчаниюПользователя(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяОрганизация");
				Если (НЕ ЗначениеЗаполнено(Договор.Организация)) И (ПараметрыАгента.Организации.Количество() > 0) Тогда
					Договор.Организация = ПараметрыАгента.Организации[0].Организация;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Договор.Организация) Тогда
					Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ Справочник.Организации");
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						Договор.Организация = Выборка.Ссылка;
					Иначе
						ДобавитьВЛогФайл("Не удалось записать основной договор контрагента (не найдена организация).", ПараметрыАгента.Агент, 0);
					КонецЕсли;
				КонецЕсли;
				Договор.Владелец = НовыйКонтрагент.Ссылка;
				
				Если Покупатель Тогда
					Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
					Договор.ТипЦен = ПолучитьЗначениеПоУмолчаниюПользователя(глЗначениеПеременной("глТекущийПользователь"), "ОсновнойТипЦенПродажи");
				ИначеЕсли Поставщик Тогда
					Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
					Договор.ТипЦен = ПолучитьЗначениеПоУмолчаниюПользователя(глЗначениеПеременной("глТекущийПользователь"), "ОсновнойТипЦенПокупки");
				Иначе
					Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее;
				КонецЕсли;
				
				Попытка
					Договор.Записать();
					НовыйКонтрагент.ОсновнойДоговорКонтрагента = Договор.Ссылка;
					НовыйКонтрагент.Записать();
	    		Исключение
		        	ДобавитьВЛогФайл(ОписаниеОшибки(), ПараметрыАгента.Агент, 0);
				КонецПопытки;
				
				//По заказу Амида Щахвердиева чтобы создавался документ назначение контрагентов для экспедитора
				
				НовДок = Документы.УстановкаСвязиЭкспедиторовСКонтрагентами.СоздатьДокумент();
				НовДок.Дата = ТекущаяДата();
				НовДок.Экспедитор = ПараметрыАгента.Экспедитор;
				НовДок.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				НовДок.Организация = Справочники.Организации.НайтиПоКоду("000000026");
				нс = НовДок.КонтрагентыЭкспедитора.Добавить();
				нс.Контрагент = НовыйКонтрагент.Ссылка;
				НовДок.Записать(РежимЗаписиДокумента.Проведение);
				
				
				//GPS координаты контрагентов
				Широта	= СтрЗаменить(СтрШапки.Широта, ",", ".");
				Долгота	= СтрЗаменить(СтрШапки.Долгота, ",", ".");
				Если ЗначениеЗаполнено(Широта) И ЗначениеЗаполнено(Долгота) Тогда
					УстановитьКоординатыКонтрагента(НовыйКонтрагент.Ссылка,Широта,Долгота);
				КонецЕсли; 

				НовСтр = ТаблКодов.Добавить();
				НовСтр.КодВКПК = СтрШапки.ИдДок;
				НовСтр.КодВ1С = НовыйКонтрагент.Код;
				ЗаписатьФотоДокумента(НовыйКонтрагент.Ссылка, СтрШапки.Фото, 29);
				ЗафиксироватьТранзакцию();
				ЗаписатьУникКодДокумента(НовыйКонтрагент, УникДок);
				
			Исключение
				Если глПоследняяОшибкаПроведения = "" Тогда
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
				ОтменитьТранзакцию();
				НовСтр = ТаблКодов.Добавить();
				НовСтр.КодВКПК = СтрШапки.ИдДок;
				НовСтр.КодВ1С = "";
				НовСтр.Сообщение = УбратьСпецСимволы(глПоследняяОшибкаПроведения);
			КонецПопытки
		КонецЕсли;	
	КонецЦикла;
	//отправить новые коды клиентов
	Для Каждого СтрКодов Из ТаблКодов Цикл
		глПоследняяОшибкаПроведения = ОписаниеОшибки();
		Ответ = Строка(СтрКодов.КодВКПК) + Таб + СокрЛП(СтрКодов.КодВ1С) + Таб + СтрКодов.Сообщение + РазделительСтрок;
		СерверПослатьОтвет(Адрес, Ответ, 0);
	КонецЦикла;
	СерверПослатьОтвет(Адрес, РазделительСтрок, 1);
	Возврат Истина;
КонецФункции	

