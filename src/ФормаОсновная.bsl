// Реагирует на поступление запроса от КПК
// Параметры
// Источник - строка, содержит слово "PocketServer", для проверки, что это событие вызвано именно КПК
// Заголовок - строка, содержит адрес сессии обмена
// ТелоСообщения - строка, сам полученный запрос 
Процедура ОбработкаВнешнегоСобытия(Источник, Заголовок, ТелоСообщения)
	Если Источник="PocketServer" Тогда 
		ОбработкаСобытияPocketServer(Источник,Заголовок,ТелоСообщения);
	ИначеЕсли Источник="SkyServer" Тогда 
		ОбработкаСобытияSkyServer(Источник,Заголовок,ТелоСообщения);
	Иначе
		Возврат; 
	КонецЕсли;
КонецПроцедуры

//Проверка блокировки порта
Функция ПроверитьБлокировкуПорта(ПутьКФайлБлокировки)
	ФС = Новый Файл(ПутьКФайлБлокировки);
	Если ФС.Существует() Тогда
		Попытка
			УдалитьФайлы(ПутьКФайлБлокировки); 
		Исключение
		КонецПопытки;
		ФС = Новый Файл(ПутьКФайлБлокировки);
		Если ФС.Существует()  Тогда
			Возврат Истина;
		Иначе 
			Возврат Ложь;
		КонецЕсли;	
	Иначе	
		Возврат Ложь; //Файла нет значит, порт НЕ заблокирован	
	КонецЕсли; 
	
КонецФункции
 
