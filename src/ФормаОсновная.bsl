								ПроданоЗаТриПоследнихПосещения = ПроданоЗаТриПоследнихПосещения + Выборка.Количество;
								МинимДатаПродажи = мин(МинимДатаПродажи,Выборка.ДатаПосещения);
							КонецЕсли;
						КонецЕсли;
						
						//Возврат
						Если Выборка.КоличествоВозврат < 0 Тогда
							Если КолвоПосещенийВозврат < МаксКолвоПосещенийВозврат Тогда
								КолвоПосещенийВозврат = КолвоПосещенийВозврат + 1;
								ИсторияВозвратов = ИсторияВозвратов 
								+ "  " + Формат(Выборка.ДатаПосещения, "ДФ=дд.ММ") + "=" + (-Выборка.КоличествоВозврат);   //цвет Gold
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					ИсторияПродаж = СтрЗаменить(СокрЛП(ИсторияПродаж), "  ", "&nbsp;&nbsp;");
					ИсторияВозвратов = СтрЗаменить(СокрЛП(ИсторияВозвратов), "  ", "&nbsp;&nbsp;");
					Если Не ПустаяСтрока(ИсторияПродаж + ИсторияВозвратов) Тогда //есть продажи или возвраты
						ИсторияПродаж = 
						?(ПустаяСтрока(ИсторияПродаж), 
