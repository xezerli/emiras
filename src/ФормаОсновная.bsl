// Выполняет поиск и, при необходимости, создание пользователя, у которого хранятся
// настройки обработки
// Возвращаемое значение:
// 		Истина - всегда.
Функция ЗагрузитьАгентов()
	ГруппаМобиС = Справочники.ГруппыПользователей.НайтиПоНаименованию("Mobi-C:Агенты");
	Если ГруппаМобиС.Пустая() Тогда
		НовЭлем=Справочники.ГруппыПользователей.СоздатьЭлемент();
		НовЭлем.Наименование="Mobi-C:Агенты";
		Попытка
			НовЭлем.Записать();
		Исключение
			запросМаксимальныйКод = новый Запрос;
			запросМаксимальныйКод.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ГруппыПользователей.Код КАК Код
			|ИЗ
			|	Справочник.ГруппыПользователей КАК ГруппыПользователей
			|
			|УПОРЯДОЧИТЬ ПО
			|	ГруппыПользователей.Ссылка";
			Выборка = запросМаксимальныйКод.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НовЭлем.Код = Формат(Число(СокрЛП(Выборка.Код)) + 1, "ЧН=0; ЧГ=0");
				НовЭлем.Записать();
			КонецЕсли;			
		КонецПопытки;
		ГруппаМобиС=НовЭлем.Ссылка;
	КонецЕсли;
	
	//Определим Основного пользователя Моби-с (в нем храним все основные параметры)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ Справочник.Пользователи ГДЕ Код = """ + РССохраненныеНастройкиИмяОбъекта + """");
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		спр = Справочники.Пользователи.СоздатьЭлемент();
		спр.Наименование = РССохраненныеНастройкиИмяОбъекта + ":(служебный)";
		спр.Код = РССохраненныеНастройкиИмяОбъекта;
		спр.Записать();
		МобиС=спр.Ссылка;
		Сообщить("Создан элемент справочника ""Пользователи"" с наименованием " + спр.Наименование);

		//имя должно быть с пробелами справа
		ИмяПользователя = Лев(спр.Код + "                                               ",50);
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательИБ.Имя = ИмяПользователя;
		ПользовательИБ.ПолноеИмя = спр.Наименование;
		ПользовательИБ.АутентификацияСтандартная 	= Истина;
		ПользовательИБ.ПоказыватьВСпискеВыбора 		= Ложь;
		Попытка
			ПользовательИБ.Записать();
		Исключение
			Сообщить("Ошибка при добавлении пользователя в список пользователей ИБ """ + ИмяПользователя + """");
			возврат Истина;
		КонецПопытки;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		МобиС = Выборка.Ссылка;
	КонецЕсли; 
	возврат Истина;
Конецфункции

