	Запрос.УстановитьПараметр("Табл",     	тзАдресовДоставки);
	Запрос.УстановитьПараметр("ТаблНоменклатуры", Номенклатура);
	Запрос.УстановитьПараметр("НЕСоздаватьТТпоАдресам", (СпособОрганизацииТТ=0));
	
