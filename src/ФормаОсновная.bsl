						стрТЗ.Номенклатура  = ВыборкаНоменклатура.Номенклатура;
						стрТЗ.План          = "";
						стрТЗ.ИсторияПродаж = ИсторияПродаж;
						стрТЗ.ПроданоЗаТриПоследнихПосещения = ПроданоЗаТриПоследнихПосещения;
						стрТЗ.КоличествоПосещений            = Мин(КолвоПосещенийПродажа,МаксКолвоПосещенийПродажа);
						стрТЗ.МинимДатаПродажи               = МинимДатаПродажи;
					КонецЕсли;  //есть история
				КонецЦикла;
			КонецЦикла; 
		КонецЦикла;
		
	ИначеЕсли ПараметрыАгента.ФорматОтображенияИсторииПродажНаКПК = 1 Тогда
