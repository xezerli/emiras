// Выполняет различные проверки структур и форматов баз данных, таблиц и прочего на
// 		предмет устаревания или отсутствия и приводит их к формату текущей версии обработки
Функция ПроверкаСтруктурСохраненныхЗначений(ТекПользователь, МобиСПользователиСервер)
	//Получаем папку Мои документы
	Shell=Новый COMОбъект("WScript.Shell");
	ПапкаПоУмолчанию=Shell.SpecialFolders.Item("MyDocuments")+"\MobiS";
	КаталогЛогФайлов  = ПолучитьНастройку(МобиС,"КаталогЛогФайлов",""); //папка где хранятся ЛОГ-файлы
	Если НЕ ЗначениеЗаполнено(КаталогЛогФайлов) Тогда
		КаталогЛогФайлов = ПапкаПоУмолчанию;
		Форма = ПолучитьФорму("ФормаВыбораКаталога");
		Форма.ОткрытьМодально();
		ЗаписатьВРегистрСохраненныеНастройки(МобиС,КаталогЛогФайлов,"КаталогЛогФайлов");
	КонецЕсли; 
	
	Попытка
		СоздатьКаталог(КаталогЛогФайлов);
	Исключение
		Предупредить(
			"Не удалось создать каталог " + Символы.ПС 
			+ Символы.ПС 
			+ КаталогЛогФайлов + Символы.ПС 
			+ Символы.ПС 
			+ "Значение будет заполнено по умолчанию.");
		КаталогЛогФайлов = ПапкаПоУмолчанию;
		СоздатьКаталог(КаталогЛогФайлов);
	КонецПопытки; 
	
	ФС = Новый Файл(КаталогЛогФайлов); 
	Если ФС.ПолучитьТолькоЧтение() Тогда
		Предупреждение("Отсутствуют права на запись в каталог "+КаталогЛогФайлов);
	КонецЕсли; 
	Попытка
		ВремФайл = КаталогЛогФайлов+"\ВремФайл.Txt";
		ВремФайл = Новый ЗаписьТекста(КаталогЛогФайлов+"\ВремФайл.Txt", КодировкаТекста.ANSI,,Истина);
		ВремФайл.ЗаписатьСтроку("Проверка записи");
		ВремФайл.Закрыть();
		УдалитьФайлы(ВремФайл);
	Исключение
		Предупреждение("Нет доступа на запись в каталог "+КаталогЛогФайлов);
	КонецПопытки; 
	
	ТабличноеПолеРегДанные = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "СписокКПК");
	Изменено = Ложь;
	Если ТипЗнЧ(ТабличноеПолеРегДанные) <> Тип("ТаблицаЗначений") Тогда
		ТабличноеПолеРегДанные = Новый ТаблицаЗначений;
		Изменено = Истина;
	КонецЕсли; 
	Если ТабличноеПолеРегДанные.Колонки.Найти("КодКПК") = Неопределено Тогда
		ТабличноеПолеРегДанные.Колонки.Добавить("КодКПК", Новый ОписаниеТипов("Строка"));
		Изменено = Истина;
	КонецЕсли; 	 
	Если ТабличноеПолеРегДанные.Колонки.Найти("Ключ") = Неопределено Тогда
		ТабличноеПолеРегДанные.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
		Изменено = Истина;
	КонецЕсли; 	 
	Если ТабличноеПолеРегДанные.Колонки.Найти("Рег") = Неопределено Тогда
		ТабличноеПолеРегДанные.Колонки.Добавить("Рег", Новый ОписаниеТипов("Строка"));
		Изменено = Истина;
	КонецЕсли;
	Если ТабличноеПолеРегДанные.Колонки.Найти("Комментарий") = Неопределено Тогда
		ТабличноеПолеРегДанные.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
		Изменено = Истина;
	КонецЕсли;
	Если Изменено Тогда
		ЗаписатьВРегистрСохраненныеНастройки(МобиС,ТабличноеПолеРегДанные,"СписокКПК");
	КонецЕсли;
	
	Каналы = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "КаналыСбыта");
	Изменено = Ложь;
	Если ТипЗнЧ(Каналы) <> Тип("ТаблицаЗначений") Тогда
		Каналы = Новый ТаблицаЗначений;
		Изменено = Истина;
	КонецЕсли; 
	Если Каналы.Колонки.Найти("Наименование") = Неопределено Тогда
		Каналы.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
		Изменено = Истина;
	КонецЕсли;
	Если Каналы.Колонки.Найти("КаналСбытаКонтрагенты") = Неопределено Тогда
		Каналы.Колонки.Добавить("КаналСбытаКонтрагенты", Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов"));
		Изменено = Истина;
	КонецЕсли;
	Если Каналы.Колонки.Найти("КаналСбытаНоменклатура") = Неопределено Тогда
		Если Конфигурация = "БухКазахстан" Тогда		
			Каналы.Колонки.Добавить("КаналСбытаНоменклатура", Новый ОписаниеТипов("СправочникСсылка.КатегорииОбъектов"));
		Иначе
			Каналы.Колонки.Добавить("КаналСбытаНоменклатура", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СвойстваОбъектов"));
		КонецЕсли;
		Изменено = Истина;
	КонецЕсли;
	Если Изменено Тогда
		ЗаписатьВРегистрСохраненныеНастройки(МобиС, Каналы, "КаналыСбыта");
	КонецЕсли;
// Исключено SQLite

//
	ТаблАгентов = ПолучитьТаблицуАгентов();
	Для Каждого Стр Из ТаблАгентов Цикл
		ТекАгент = Стр.Агент;
		Значение = ПрочитатьИзРегистраСохраненныеНастройки(ТекАгент,"КонтролироватьСозданиеДокументаПродажа");
		Если Значение <> Неопределено Тогда Прервать; КонецЕсли;
		КонтрольПоGPS = ПолучитьНастройку(ТекАгент,"КонтролироватьСозданиеДокументов", Ложь);
		
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеДокументаПродажа");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеДокументаЗаказ");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеДокументаПокупка");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеДокументаПКО");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеДокументаАнкета");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеДокументаИнвентаризация");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьСозданиеФотографий");
		ЗаписатьВРегистрСохраненныеНастройки(ТекАгент, КонтрольПоGPS, "КонтролироватьМестоВыполненияЗаданий");
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПолучитьPIDПроцесса()
	PID = -1;
	
	Попытка
		WSS=Новый COMОбъект("WScript.Shell");
		oExec=WSS.Exec("rundll32.exe kernel32,Sleep");
		PID=ПолучитьCOMОбъект(
			"winmgmts:{impersonationLevel=impersonate}!\\.\root\CIMV2:Win32_Process.Handle='"
			+ Формат(oExec.ProcessID,"ЧГ=0")+"'").ParentProcessID;
		oExec.Terminate();		
	Исключение
	КонецПопытки;	
	
	Возврат PID;
КонецФункции

Функция ПолучитьИдентификаторОбработки(начЗнч = -1)
	начальноеЗначение = начЗнч;
	Если начальноеЗначение = -1 Тогда
		ГУИД = Строка(новый УникальныйИдентификатор());
		ГУИД = СтрЗаменить(ГУИД, "-", "");
		начальноеЗначение = 0;
		для й = 1 по 32 Цикл
			начальноеЗначение = начальноеЗначение + КодСимвола(Сред(ГУИД, й, 1));
		КонецЦикла;
	КонецЕсли;	
	ГСЧ = Новый ГенераторСлучайныхЧисел(начальноеЗначение);
	Возврат Формат(ГСЧ.СлучайноеЧисло(0, 999999), "ЧЦ=6; ЧН=; ЧВН=; ЧГ=0");
КонецФункции

// Проверяет есть ли ПВХ.СвойстваОбъектов с указанным названием 
// Если такого нет, то создает его. 
// Возвращает ссылку на эту настройку
// Параметры
//	Наименование - Наименование искомого объекта
//	ТипЗнач - Тип значения характеристики (значения какого типа может принимать данное свойство)
//	НазначениеСвойства - Вид объекта к которому относится свойство
//
Функция ИнициализироватьСвойствоОбъекта(Наименование, ТипЗнач, НазначениеСвойства)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ ПланВидовХарактеристик.СвойстваОбъектов 
	|ГДЕ Наименование = &Наименование И НазначениеСвойства = &НазначениеСвойства");
	Запрос.УстановитьПараметр("Наименование",Наименование);
	Запрос.УстановитьПараметр("НазначениеСвойства",НазначениеСвойства);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ПВХ = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		ПВХ.НазначениеСвойства	= НазначениеСвойства;
		ПВХ.Наименование		= Наименование;
		//ПВХ.ТипЗначения			= ТипЗнач;
		Если ТипЗнач = Тип("Булево") Тогда
			ПВХ.Категория = Истина;
		КонецЕсли;
		ПВХ.Записать();
		Сообщить("Создан элемент плана видов характеристик ""СвойстваОбъектов"" с наименованием '" + Наименование + "' назначение " + НазначениеСвойства);
		возврат ПВХ.Ссылка;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий(); 
		возврат Выборка.Ссылка;
	КонецЕсли; 
КонецФункции //

Функция ОбновитьИнформациюПоКлючамДляСервера()
	
	//процедура загрузки регистрационных ключей
	ПутьКФайлуКлючей=КаталогЛогФайлов+"\lickeys_utf8.txt";
	Ф=Новый Файл(ПутьКФайлуКлючей);
	Если не ф.Существует() Тогда
		зт = новый ЗаписьТекста(ПутьКФайлуКлючей, КодировкаТекста.UTF8);
		зт.Записать("# Редактирование этого файла вручную запрещено." + Символы.ПС);
		зт.Закрыть();			
	КонецЕсли;		
	Если Ф.Существует() Тогда
		Сервер.УстановитьФайлКлючей(ПутьКФайлуКлючей);
	КонецЕсли;
	
	Статус = Сервер.ОбновитьФайлКлючей();
	Если Не ПустаяСтрока(Статус) Тогда
		Если Найти(Статус, "Ошибка запроса к серверу активации") > 0 Тогда
			ЗапуститьПриложение("https://mobi-c.ru/help/error7.htm");
		КонецЕсли;						
		Предупреждение(Статус);	
	КонецЕсли;
	
	ПутьКФайлуЧС=КаталогЛогФайлов+"\blacklist.bin";
	Статус=Сервер.УстановитьФайлЧерногоСписка(ПутьКФайлуЧС);
	Если Статус<>"" Тогда
		ДобавитьВЛогФайл(
			"Ошибка при проверке подлинности ключей: " + Статус + РазделительСтрок 
			+ "Обмен данными возможен только в Демо-режиме с одним КПК.",
			,
			0,
			СтатусСообщения.Важное);
	КонецЕсли;		
	
	Ключи=ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"СписокКПК");
	Если Ключи <> Неопределено Тогда
		Для Каждого СтрТабл Из Ключи Цикл
			СтрТабл.Рег = Сервер.ЗарегистрироватьКПК(СтрТабл.КодКПК, СтрТабл.Ключ);
		КонецЦикла;	
	КонецЕсли;	
	
КонецФункции

// Обработчик открытия формы
Процедура ПриОткрытии()
	
	ТребуетсяПерезапускСервера = Ложь;
	
	ВывестиСтатусОблачногоСервера();
	АвтономныйРежим = Истина;
	РежимРабочееМесто = Ложь;
	Модифицированность = Ложь;
	
	ЭлементыФормы.НадписьКонфигурация.Значение = "Конфигурация """ + Метаданные.Имя + """";

	ЗагрузитьАгентов();
	
	РежимОтладки = ПолучитьНастройку(МобиС, "РежимОтладки", Ложь);
	PID = -1;
	Если РежимОтладки Тогда
		PID = ПолучитьPIDПроцесса();
	КонецЕсли;
	ИдентификаторОбработки = ПолучитьИдентификаторОбработки();
	
