						//Продажа
						Если Выборка.Количество > 0 
							И КолвоПосещенийПродажа < МаксКолвоПосещенийПродажа Тогда
							колвоПродажаВозврат = колвоПродажаВозврат + 1;
							КолвоПосещенийПродажа = КолвоПосещенийПродажа + 1;
