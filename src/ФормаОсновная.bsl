//Для SQlite
Процедура СконвертироватьТаблицу(БД, СтараяБД, ИмяТаблицы, МассивПолей)
	Сообщить("Преобразование таблицы "+ИмяТаблицы+"...");
	Состояние("Преобразование таблицы "+ИмяТаблицы+"...");

	НаборЗаписей=Неопределено;
	Попытка
		НаборЗаписей=СтараяБД.Execute("SELECT * FROM ["+ИмяТаблицы+"]");
	Исключение
		Возврат;
	КонецПопытки;
	
	ПереченьПолей=""; ПереченьПараметров="";
	Первый=Истина;
	Для Каждого ИмяПоля Из МассивПолей Цикл
		Если Первый Тогда
			Первый=Ложь;
		Иначе
			ПереченьПолей=ПереченьПолей+",";
			ПереченьПараметров=ПереченьПараметров+",";
		КонецЕсли;
		
		ПереченьПолей=ПереченьПолей+"["+ИмяПоля+"]";
		ПереченьПараметров=ПереченьПараметров+"?";
	КонецЦикла;
	
	БДЗапросБезРезультата(БД, "PRAGMA journal_mode=MEMORY");
	БДЗапросБезРезультата(БД, "PRAGMA synchronous=OFF");
	
	ТекстЗапроса="
		|INSERT OR REPLACE INTO ["+ИмяТаблицы+"] ("+ПереченьПолей+")
		|    VALUES("+ПереченьПараметров+")
		|";
		
	ПодгЗапрос=БДПодготовитьЗапрос(БД, ТекстЗапроса);
	БДЗапросБезРезультата(БД, "BEGIN TRANSACTION");
	Счетчик=0;
	КолвоПолей=МассивПолей.Количество();
	Пока НЕ НаборЗаписей.EOF Цикл
		Для Н=0 По КолвоПолей-1 Цикл
			ИмяПоля=МассивПолей[Н];
			ЗначПоля=NULL;
			Попытка
				ЗначПоля=НаборЗаписей.Fields(ИмяПоля).Value;
				
				Если ТипЗнч(ЗначПоля)=Тип("Дата") Тогда
					ЗначПоля=ДатаДляSQLite(ЗначПоля);
				ИначеЕсли ТипЗнч(ЗначПоля)=Тип("Строка") Тогда
					ЗначПоля=СокрЛП(ЗначПоля);
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			БДУстановитьПараметр(ПодгЗапрос, Н+1, ЗначПоля);
		КонецЦикла;
		
		БДСледующаяЗапись(ПодгЗапрос);
		БДСбросПодготовленногоЗапроса(ПодгЗапрос);
		
		Если Счетчик%500=0 Тогда
			БДЗапросБезРезультата(БД, "COMMIT TRANSACTION");
			БДЗапросБезРезультата(БД, "BEGIN TRANSACTION");
			Состояние("Преобразование таблицы "+ИмяТаблицы+": "+Строка(Счетчик)+" записей выполнено");
		КонецЕсли;
		Счетчик=Счетчик+1;
		
		НаборЗаписей.MoveNext();
	КонецЦикла;
	НаборЗаписей.Close();
	
	БДЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
	БДЗапросБезРезультата(БД, "COMMIT TRANSACTION");
	
	БДЗапросБезРезультата(БД, "PRAGMA journal_mode=DELETE");
	БДЗапросБезРезультата(БД, "PRAGMA synchronous=FULL");
	
	Сообщить("Преобразование таблицы "+ИмяТаблицы+": "+Строка(Счетчик)+" записей выполнено");
	Состояние();
КонецПроцедуры

Процедура ПроверитьВнешнююБД()
	
	ПутьКФайлуБлокировки=КаталогЛогФайлов + "\mobi_s.lck";
	Если ПроверитьФайлБлокировки(ПутьКФайлуБлокировки) Тогда
		ТекстВопроса="В данный момент выполняется преобразование данных из старого формата в новый.
			|Необходимо дождаться завершения процедуры преобразования.";
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ОК, 10) = КодВозвратаДиалога.ОК Тогда
			ПроверитьВнешнююБД();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Результат = "";
	
	КонвертироватьСтаруюБД=Ложь;
	СтараяБД=Неопределено;
	ФайлБД=Новый Файл(КаталогЛогФайлов + "\mobi_s.sqlite3");
	Если НЕ ФайлБД.Существует() Тогда
		ФайлСтаройБД=Новый Файл(КаталогЛогФайлов + "\mobi_s.mdb");
		Если ФайлСтаройБД.Существует() Тогда
			Попытка
				СтараяБД = Новый COMОбъект("ADODB.Connection");
				СтараяБД.Mode = 3;
				СтараяБД.ConnectionTimeout = 30;
				СтараяБД.CommandTimeout = 300;
				СтараяБД.ConnectionString = "Provider=Microsoft.Jet.OLEDB.4.0; Data Source=" + ФайлСтаройБД.ПолноеИмя + ";";
				СтараяБД.Open();				
				КонвертироватьСтаруюБД=Истина;
				текст = "Для работы этой версии обработки Моби-С необходимо выполнить преобразование внешней базы данных Моби-С.
				|Преобразование может занять несколько минут";
				ДобавитьВЛогФайл("Преобразование базы mobi_s.mdb в SQLite формат");
				Предупреждение(текст, 20);				
				ОбработкаПрерыванияПользователя();
			Исключение
				текст = "";
				Если ЭтоСистема64 Тогда
					текст = "Для работы этой версии обработки Моби-С необходимо выполнить преобразование внешней базы данных 
					|Преобразование необходимо запустить на x86 (32 битной) версии платформы 1С
					|Без преобразования Вам будут недоступны данные Фотографии, Остатки, и старые сообщения агентам";
				Иначе
					текст = "Не удалось открыть старую базу mobi_s.mdb для преобразования в новый формат.
					|Без преобразования Вам будут недоступны данные Фотографии, Остатки, и старые сообщения агентам";
				КонецЕсли;
				ДобавитьВЛогФайл(текст);
				Предупреждение(текст);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Блокировщик = Неопределено;
	БД = ОткрытьВнешнююБД(Блокировщик, Истина);
	Если БД = Ложь Тогда
		Сообщить(ОшибкаНетДоступаКВнешнейБД, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;	
	
	ТекстЗапроса = "Create Table IF NOT EXISTS messages (
		|CODE decimal(7), 
		|DT char(20), 
		|AGENT text, 
		|OBJTYPE decimal(1), 
		|OBJKOD char(64), 
		|THEME char(250), 
		|BODY Text, 
		|STATUS decimal(1), 
		|DEL decimal(1),
		|TODO decimal(1), 
		|ACTUALLY date, 
		|ID char(40),
		|AUTHOR Text )";

		
	Если БДЗапросБезРезультата(БД, ТекстЗапроса) Тогда
		Если БДЗапросБезРезультата(БД, "SELECT AUTHOR FROM messages LIMIT 1") Тогда
		Иначе	
			БДЗапросБезРезультата(БД, "Alter Table messages add AUTHOR Text");
		КонецЕсли;		
		
		Если КонвертироватьСтаруюБД Тогда
			МассивПолей=Новый Массив();
			МассивПолей.Добавить("CODE");
			МассивПолей.Добавить("DT");
			МассивПолей.Добавить("AGENT");
			МассивПолей.Добавить("OBJTYPE");
			МассивПолей.Добавить("OBJKOD");
			МассивПолей.Добавить("THEME");
			МассивПолей.Добавить("BODY");
			МассивПолей.Добавить("STATUS");
			МассивПолей.Добавить("DEL");
			МассивПолей.Добавить("TODO");
			МассивПолей.Добавить("ACTUALLY");
			МассивПолей.Добавить("ID");
			МассивПолей.Добавить("AUTHOR");
			СконвертироватьТаблицу(БД, СтараяБД, "messages", МассивПолей);
		КонецЕсли;
	КонецЕсли;
		
	ТекстЗапроса = "Create Table IF NOT EXISTS OSTATKI (
		|NOMENKLATURA char(48), 
		|KONTRAGENT char(48), 
		|OSTATOK decimal(15,3), 
		|FACING decimal(15,3), 
		|AGENT text, 
		|DATA date)";	
	
	Если БДЗапросБезРезультата(БД, ТекстЗапроса) Тогда
		Если КонвертироватьСтаруюБД Тогда
			МассивПолей=Новый Массив();
			МассивПолей.Добавить("NOMENKLATURA");
			МассивПолей.Добавить("KONTRAGENT");
			МассивПолей.Добавить("OSTATOK");
			МассивПолей.Добавить("FACING");
			МассивПолей.Добавить("AGENT");
			МассивПолей.Добавить("DATA");
			СконвертироватьТаблицу(БД, СтараяБД, "OSTATKI", МассивПолей);
		КонецЕсли;
	КонецЕсли;;
	
	ТекстЗапроса = "CREATE TABLE IF NOT EXISTS Log (
		|[Agent] Text,
		|[DateTime] DateTime,
		|[Sequence] Integer4,
		|[Level] Integer4,
		|[Message] Text, 
		|Primary Key([Agent],[DateTime],[Sequence]))";
	
	Если БДЗапросБезРезультата(БД, ТекстЗапроса) Тогда
		Если Ложь И КонвертироватьСтаруюБД Тогда
			МассивПолей=Новый Массив();
			МассивПолей.Добавить("Agent");
			МассивПолей.Добавить("DateTime");
			МассивПолей.Добавить("Sequence");
			МассивПолей.Добавить("Level");
			МассивПолей.Добавить("Message");
			ДатаОчистки = ДобавитьМесяц(ТекущаяДатаСуточнаяКоррекция(), -2);
			ДатаAccess = "#"+Формат(Месяц(ДатаОчистки),"ЧЦ=2; ЧВН=") + "/"
						 + Формат(День(ДатаОчистки), "ЧЦ=2; ЧВН=") + "/"
			             + Формат(Год(ДатаОчистки), "ЧЦ=4; ЧВН=; ЧГ=") + " " 
						 + Формат(Час(ДатаОчистки), "ЧЦ=2; ЧН=; ЧВН=") + ":"
						 + Формат(Минута(ДатаОчистки), "ЧЦ=2; ЧН=; ЧВН=") + ":"
						 + Формат(Секунда(ДатаОчистки), "ЧЦ=2; ЧН=; ЧВН=") + "#";
			СтараяБД.Execute("DELETE FROM Log WHERE DateTime<"+ДатаAccess+"");
			СконвертироватьТаблицу(БД, СтараяБД, "Log", МассивПолей);
		КонецЕсли;		
	КонецЕсли;
	
	БДЗапросБезРезультата(БД, "CREATE INDEX IF NOT EXISTS IndexKONTRAGENT ON OSTATKI (KONTRAGENT)");
	
	БДЗапросБезРезультата(БД, "CREATE INDEX IF NOT EXISTS IndexKONTRAGENTDATA ON OSTATKI (KONTRAGENT,DATA)");
	
	ТекстЗапроса="Create Table IF NOT EXISTS IncomingPhotos (
		|    ObjectId char(50),
		|    MobiObjectType int,
		|    ObjectTypeName char(250),
		|    Filename Text,
		|    photoDate Date)
		|";

	Если БДЗапросБезРезультата(БД, ТекстЗапроса) Тогда
		Если КонвертироватьСтаруюБД Тогда
			МассивПолей=Новый Массив();
			МассивПолей.Добавить("ObjectId");
			МассивПолей.Добавить("MobiObjectType");
			МассивПолей.Добавить("ObjectTypeName");
			МассивПолей.Добавить("Filename");
			МассивПолей.Добавить("photoDate");
			СконвертироватьТаблицу(БД, СтараяБД, "IncomingPhotos", МассивПолей);
		КонецЕсли;
	КонецЕсли;
	
	БДЗапросБезРезультата(БД, "CREATE INDEX IF NOT EXISTS IndexObj ON IncomingPhotos (ObjectId)");
	
	ТекстЗапроса="CREATE TABLE IF NOT EXISTS PhotoMetadata ([FileName] Text,[Metadata] Text, Primary Key([FileName]))";
	Если БДЗапросБезРезультата(БД, ТекстЗапроса) Тогда
		Если КонвертироватьСтаруюБД Тогда
			МассивПолей=Новый Массив();
			МассивПолей.Добавить("FileName");
			МассивПолей.Добавить("Metadata");
			СконвертироватьТаблицу(БД, СтараяБД, "PhotoMetadata", МассивПолей);
		КонецЕсли;
	КонецЕсли;
	
	ДатаПоследнегоСжатияMDB = ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"ДатаПоследнегоСжатияMDB");
	Если Не ЗначениеЗаполнено(ДатаПоследнегоСжатияMDB) Тогда
		ДатаПоследнегоСжатияMDB = ДатаПустая();
	КонецЕсли;
	начДн = НачалоДня(ТекущаяДатаСуточнаяКоррекция());
	Если НачалоМесяца(ДатаПоследнегоСжатияMDB) <> НачалоМесяца(начДн) Тогда
		Состояние("Выполнение регламентых операций с базой данных.");
		ДатаПоследнегоСжатияMDB = начДн;
		ЗаписатьВРегистрСохраненныеНастройки(МобиС, ДатаПоследнегоСжатияMDB, "ДатаПоследнегоСжатияMDB");
		СжатьВнешнююБД(БД);
	КонецЕсли;	
	
	ЗакрытьВнешнююБД(БД, Блокировщик);
	
	Состояние("");	
КонецПроцедуры

Процедура КоманднаяПанель1ОбновитьМакетыОнлайнКарт(Кнопка)
	Если Вопрос("Заменить существующие макеты онлайн карт?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Попытка
			ВременныйФайлЗагрузчика = КаталогЛогФайлов + "\loader.txt"; // Для отладки
			ВременныйФайлЗагрузчика = ПолучитьИмяВременногоФайла();
			КопироватьФайл("http://mobi-c.ru/arc/loader.txt", ВременныйФайлЗагрузчика);
			чт = новый ЧтениеТекста(ВременныйФайлЗагрузчика,КодировкаТекста.UTF8);
			ОбщийТекст = чт.Прочитать();
			чт.Закрыть();
			УдалитьФайлы(ВременныйФайлЗагрузчика);
			
			// Загрузка макетов
			НачалоОбработки = Найти(ОбщийТекст, ":ut10");
			Если НачалоОбработки = 0 Тогда
				ВызватьИсключение "Ошибка доступа";
			КонецЕсли;
			ОбщийТекст = Сред(ОбщийТекст,  НачалоОбработки);
			СтрокаФайлы = СтрПолучитьСтроку(ОбщийТекст, 2);
			СтрокиФайлы = СтрЗаменить(СтрокаФайлы, ";", Символы.ПС);
			Для номерФайла =1 По СтрЧислоСтрок(СтрокиФайлы) Цикл
	    		именафайлов = СтрПолучитьСтроку(СтрокиФайлы, номерФайла);
				именафайлов = СтрЗаменить(именафайлов, "#", Символы.ПС);
				МакетНаСайте = СтрПолучитьСтроку(именафайлов, 1);
				МакетВОбработке = СтрПолучитьСтроку(именафайлов, 2);
				КопироватьФайл("http://mobi-c.ru/arc/" + МакетНаСайте + ".txt", КаталогЛогФайлов + "\Макет" + МакетВОбработке + ".html");
			КонецЦикла;
				
			// Загрузка текста загрузчика карт
		
			ТекстЗагрузчика = Сред(ОбщийТекст,  Найти(ОбщийТекст, "//НачалоБлокаЗагрузчика"));
			ТекстЗагрузчика = Сред(ТекстЗагрузчика, 1, Найти(ТекстЗагрузчика, "//КонецБлокаЗагрузчика") -1); 
			
			ЗаписьТекста=Новый ЗаписьТекста(КаталогЛогФайлов + "\ЗагрузчикМакетаНФ.txt",КодировкаТекста.UTF8);
			ЗаписьТекста.Записать(ТекстЗагрузчика);
			ЗаписьТекста.Закрыть();
			ИспользоватьВстроенныеМакетыКарт = Ложь;
			ЗаписатьВРегистрСохраненныеНастройки(МобиС, ИспользоватьВстроенныеМакетыКарт, "ИспользоватьВстроенныеМакетыКарт");
			Сообщить("Макеты карт успешно обновлены.");
			//
		Исключение
			ИспользоватьВстроенныеМакетыКарт = Истина;
			ЗаписатьВРегистрСохраненныеНастройки(МобиС, ИспользоватьВстроенныеМакетыКарт, "ИспользоватьВстроенныеМакетыКарт");
			Сообщить("Ошибка загрузки макетов карт. Будут использоваться встроенные макеты.");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

