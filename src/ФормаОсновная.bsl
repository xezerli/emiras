//СОЗДАНИЕ ДОКУМЕНТОВ

Процедура ОбработатьДопРеквизитыДокумента(Док, ДопРеквизитыСтрока, Документ, ВариантДокумента)
	
	стрИсключения = "";
	текстОшибки = "";
	
	//получаем таблицу настроенных дополнительных реквизитов
	ТЗДопРеквизиты = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ДополнительныеРеквизиты");
	Если ТипЗнч(ТЗДопРеквизиты) = Тип("ТаблицаЗначений") Тогда
		//выбираем используемые дополнительные реквизиты, допустимые для данного типа документа
		//по варианту документа пока не контролируем тк может быть либо тип документа, либо "все"
		ТЗДопРеквизиты = ТЗДопРеквизиты.Скопировать(ТЗДопРеквизиты.НайтиСтроки(
			новый Структура("Исп, Документ", Истина, Документ)));
		Если тзДопРеквизиты.Колонки.Найти("ТекстОбработкаДоукмента") = Неопределено Тогда
			тзДопРеквизиты.Колонки.Добавить("ТекстОбработкаДоукмента", новый ОписаниеТипов(("Строка")));
		КонецЕсли;
		
		ДопРеквизиты = СтрЗаменить(ДопРеквизитыСтрока, Символ(30), РазделительСтрок);
		Для Сч = 1 По СтрЧислоСтрок(ДопРеквизиты) Цикл
			РеквизитЗначение = СтрЗаменить(СтрПолучитьСтроку(ДопРеквизиты, Сч), Символ(31), РазделительСтрок);
			Если СтрЧислоСтрок(РеквизитЗначение) <> 2 Тогда 
				Продолжить; 
			КонецЕсли;
			Реквизит = СтрПолучитьСтроку(РеквизитЗначение, 1);
			Значение = СтрПолучитьСтроку(РеквизитЗначение, 2);
			
			стрДопРеквизит = ТЗДопРеквизиты.Найти(Реквизит, "КодРеквизита");
			Если стрДопРеквизит = Неопределено Тогда
				//данный ревизит не найден в списке доступных доп реквизитов 
			Иначе
				Если Документ = "37" И стрДопРеквизит.ВариантДокумента = "2" Тогда
					ВариантДокумента = "2";
				КонецЕсли;
				Если стрДопРеквизит.ВариантДокумента = ""
					ИЛИ стрДопРеквизит.ВариантДокумента = ВариантДокумента Тогда				
					Попытка
						Выполнить(стрДопРеквизит.ТекстОбработкаДоукмента);
					Исключение
						ИО = ИнформацияОбОшибке();
						ОО = ОписаниеОшибки();
						текстОшибки = ПолучитьОшибку(ИО, ОО);
						ДобавитьВЛогФайл("При обработке дополнительного реквизита " + Реквизит + " документа " + Док + " произошла ошибка: " + текстОшибки);				
						стрИсключения = стрИсключения + текстОшибки + Символы.ПС;
					КонецПопытки;					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;						
		
		Если стрИсключения = "" Тогда
		Иначе
			ВызватьИсключение стрИсключения;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, ДопРеквизитыСтрока, Документ, ВариантДокумента)
	
	стрИсключения = "";
	текстОшибки = "";
	
	//получаем таблицу настроенных дополнительных реквизитов
	ТЗДопРеквизиты = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ДополнительныеРеквизиты");
	Если ТипЗнч(ТЗДопРеквизиты) = Тип("ТаблицаЗначений") Тогда
		//выбираем используемые дополнительные реквизиты, допустимые для данного типа документа
		//по варианту документа пока не контролируем тк может быть либо тип документа, либо "все"
		ТЗДопРеквизиты = ТЗДопРеквизиты.Скопировать(ТЗДопРеквизиты.НайтиСтроки(
			новый Структура("Исп, Документ", Истина, Документ)));
		Если тзДопРеквизиты.Колонки.Найти("ТекстОбработкаДоукмента") = Неопределено Тогда
			тзДопРеквизиты.Колонки.Добавить("ТекстОбработкаДоукмента", новый ОписаниеТипов(("Строка")));
		КонецЕсли;
		ДопРеквизиты = СтрЗаменить(ДопРеквизитыСтрока, Символ(30), РазделительСтрок);
		Для Сч = 1 По СтрЧислоСтрок(ДопРеквизиты) Цикл
			РеквизитЗначение = СтрЗаменить(СтрПолучитьСтроку(ДопРеквизиты, Сч), Символ(31), РазделительСтрок);
			Если СтрЧислоСтрок(РеквизитЗначение) <> 2 Тогда 
				Продолжить; 
			КонецЕсли;
			Реквизит = СтрПолучитьСтроку(РеквизитЗначение, 1);
			Значение = СтрПолучитьСтроку(РеквизитЗначение, 2);
			
			стрДопРеквизит = ТЗДопРеквизиты.Найти(Реквизит, "КодРеквизита");
			Если стрДопРеквизит = Неопределено Тогда
				//данный ревизит не найден в списке доступных доп реквизитов 
			Иначе
				Если Документ = "38" И стрДопРеквизит.ВариантДокумента = "2" Тогда
					ВариантДокумента = "2";
				КонецЕсли;
				
				Если стрДопРеквизит.КодРеквизита = "СкидкаПроцент" Тогда
					СтрДок.ПроцентСкидки = Значение;
					ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧастиСУчетомСкидок(СтрДок, Док);
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, Док);
				КонецЕсли;
				
				Если стрДопРеквизит.КодРеквизита = "Депозит" Тогда
					СтрДок.Депозит = ?(Значение = "1", Истина, Ложь);
				КонецЕсли;

				
				Если стрДопРеквизит.ВариантДокумента = ""
					ИЛИ стрДопРеквизит.ВариантДокумента = ВариантДокумента Тогда				
					Попытка
						Выполнить(стрДопРеквизит.ТекстОбработкаДоукмента);
					Исключение
						ИО = ИнформацияОбОшибке();
						ОО = ОписаниеОшибки();
						текстОшибки = ПолучитьОшибку(ИО, ОО);
						ДобавитьВЛогФайл("При обработке дополнительного реквизита " + Реквизит + " строки документа " + Док + " произошла ошибка: " + текстОшибки);
						стрИсключения = стрИсключения + текстОшибки + Символы.ПС;	
					КонецПопытки;					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;						
		
		Если стрИсключения = "" Тогда
		Иначе
			ВызватьИсключение стрИсключения;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//функция возвращает ответ на запрос с КПК "выгрузка документов"
//ИдДок - внутренний идентификатор документа на КПК
//ДокументСсылка - ссылка на сформированный в 1С документ
//ошибка - ошибка, возникшая при проведении документа
функция ОтветПоВыгрузкеДокумента(ИдДок, ДокументСсылка = Неопределено, ошибка = "")
	Возврат ?(ДокументСсылка = Неопределено,
		ЦелоеВСтроку(ИдДок) + Таб 
		+ Таб 
		+ УбратьСпецСимволы(ошибка, Символы.ВТаб) + таб 
		+ "" + РазделительСтрок,
		ЦелоеВСтроку(ИдДок) + Таб 
		+ УникИдентификатор(ДокументСсылка) + таб 
		+ УбратьСпецСимволы(ошибка, Символы.ВТаб) + таб 
		+ УбратьСпецСимволы(СокрЛП(ДокументСсылка.Номер)) + РазделительСтрок);
КонецФункции

//проанализируем организацию и договор
Функция ПолучитьДоговораКонтрагента(Стр, Док)
	
	ТекстОшибки = "";
	//СоответствиеКонтрагента = 0 Контрагент - Клиент, Грузополучатель - Клиент, ДоговорКонтрагента - договор клиента
	//СоответствиеКонтрагента = 1 Контрагент - Холдинг, Грузополучатель - Клиент,ДоговорКонтрагента - договор холдинга 
	ВладелецДоговора = Док.Контрагент; 
	ВидДоговора = "ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";    
	ВидДоговораТекст = "'с покупателем'";
	ВидДоговораПеречисление = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Если ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ВидДоговора = "ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)";
		ВидДоговораТекст = "'с поставщиком'";
		ВидДоговораПеречисление = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.Договор) Тогда
		Если Стр.Договор.ВидДоговора = ВидДоговораПеречисление
			Или Стр.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее И Конфигурация = "БухКазахстан" Тогда
			Возврат Стр.Договор;
		Иначе
			Сообщить("Договор '" + Стр.Договор + "' НЕ может быть выбран, т.к. он '" + Стр.Договор.ВидДоговора 
				+ "', а нужен " + ВидДоговораТекст, СтатусСообщения.Внимание);
			Стр.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
			Возврат Стр.Договор;
		КонецЕсли;
	Иначе
		Сообщить("Договор не указан", СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если Конфигурация = "БухКазахстан" Тогда
		ВидДоговора = ВидДоговора + " ИЛИ ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.Прочее)";
	КонецЕсли;
	МВТ = Новый МенеджерВременныхТаблиц;
	ЗапросВсе = Новый Запрос;
	ЗапросВсе.МенеджерВременныхТаблиц = МВТ;
	ЗапросВсе.Текст =
	"ВЫБРАТЬ Ссылка ПОМЕСТИТЬ Договоры ИЗ Справочник.ДоговорыКонтрагентов ГДЕ
	|	Владелец = &Владелец
	|	И (ВидДоговора = " + ВидДоговора + ")
	|	И Организация В (&Организации)
	|	И НЕ ПометкаУдаления
	|	И ЭтоГруппа = ЛОЖЬ";
	ЗапросВсе.УстановитьПараметр("Владелец", ВладелецДоговора);
	ЗапросВсе.УстановитьПараметр("Организации", ПараметрыАгента.Организации);
	Результат = ЗапросВсе.Выполнить();
		
	// 1. Основной договор
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ Ссылка 
		|ИЗ Договоры 
		|ГДЕ
		|Ссылка.Владелец.ОсновнойДоговорКонтрагента = Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить("Выбран основной договор контрагента: " + Выборка.Ссылка
			+ " организация по договору: " + Стр.Организация, СтатусСообщения.Информация);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// 2. первый попавшийся из выбранной организации
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ Ссылка 
		|ИЗ Договоры 
		|ГДЕ 
		| Ссылка.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Стр.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить("Выбран договор контрагента: " + Выборка.Ссылка, СтатусСообщения.Информация);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// 3. первый попавшийся др. организация
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Договоры";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить("Выбран договор контрагента: " + Выборка.Ссылка
			+ " изменена организация по договору: " + Выборка.Ссылка.Организация, СтатусСообщения.Информация);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.Договор) Тогда
		ДобавитьОшибку("Загрузка накладной " + стр.ИдДок + ". Договор " + Стр.Договор 
			+ " не подходит. Не удалось подобрать нужный договор");
	Иначе
		ДобавитьОшибку("Загрузка накладной " + стр.ИдДок + ". Не удалось подобрать нужный договор");
	КонецЕсли;
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
КонецФункции

функция НайтиОбъектКатегория(Парам)
	Парам = Лев(Парам, СтрДлина(Парам) - 1);
	Если Конфигурация = "БухКазахстан" Тогда
		Возврат Справочники.КатегорииОбъектов.НайтиПоКоду(Парам);
	Иначе
		Возврат ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(Парам);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ПолучитьТаблицуКатегорий(ТаблКатегорий)
	ТаблКатегорий = Новый ТаблицаЗначений;
	ТаблКатегорий.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	Если Конфигурация = "БухКазахстан" Тогда
		ТаблКатегорий.Колонки.Добавить("Категория", Новый ОписаниеТипов("СправочникСсылка.КатегорииОбъектов"));
	Иначе
		ТаблКатегорий.Колонки.Добавить("Категория", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СвойстваОбъектов"));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьКатегорииДокумента(Док, ТаблКат)
	Если Конфигурация = "БухКазахстан" Тогда
		Для Каждого СтрСтрок Из ТаблКат Цикл  //по строкам списка категорий
			Набор = РегистрыСведений.КатегорииОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Док);
			Набор.Отбор.Категория.Установить(СтрСтрок.Категория);
			Запись = Набор.Добавить();
			Запись.Объект = Док;
			Запись.Категория = СтрСтрок.Категория;
			Набор.Записать();
		КонецЦикла;
	Иначе
		Для Каждого СтрСтрок Из ТаблКат Цикл
			Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Док);
			Набор.Отбор.Свойство.Установить(СтрСтрок.Категория);
			Запись = Набор.Добавить();                    
			Запись.Объект = Док;   
			Запись.Свойство = СтрСтрок.Категория;
			Запись.Значение = Истина;
			Набор.Записать();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Устанавливает дату оплаты документа в соответствии с договором, указанным в документе
// Параметры:
// 		ДокОбъект - ДокументОбъект, документ, в котором устанавливать дату оплаты
Процедура УстановитьДатуОплатыПоДоговору(ДокОбъект)

    ДоговорКонтрагента 	= ДокОбъект.ДоговорКонтрагента;
	ДатаДокумента 		= ДокОбъект.Дата;

	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	Если ДоговорКонтрагента.ДержатьРезервБезОплатыОграниченноеВремя Тогда
		ЧислоДнейДоОплаты = ДоговорКонтрагента.ЧислоДнейРезерваБезОплаты;
	Иначе
		ЧислоДнейДоОплаты = 0;
	КонецЕсли;
	ДатаОплатыНовая = ДатаДокумента;
	//Если НЕ ЧислоДнейДоОплаты = 0 Тогда
	//	ДатаОплатыНовая = ЗаполнениеДокументов.ОпределитьДату(ДатаДокумента, ЧислоДнейДоОплаты);
	//	Если ДатаОплатыНовая = Неопределено Тогда
	//		ДатаОплатыНовая = ДатаДокумента;
	//	КонецЕсли;	
	//КонецЕсли;
	ДокОбъект.ДатаОплаты = ДатаОплатыНовая;
КонецПроцедуры

Процедура ЗаписатьФотоДокумента(Док, Фото, типОбъекта)
	Если ПустаяСтрока(фото) Тогда 
		Возврат;
	КонецЕсли;
	
	Блокировщик = Неопределено;
	БД = ОткрытьВнешнююБД(Блокировщик, истина);
	Если БД = Ложь Тогда
		Сообщить(ОшибкаНетДоступаКВнешнейБД, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса=
		"INSERT INTO IncomingPhotos( [ObjectId], [MobiObjectType], [ObjectTypeName], [Filename], [photoDate]) " 
		+ "VALUES(?,?,?,?,?)";
	ПодгЗапрос=БДПодготовитьЗапрос(БД, ТекстЗапроса);
	БДУстановитьПараметр(ПодгЗапрос, 5, ДатаДляSQLite(ТекущаяДатаСуточнаяКоррекция()));
	
	БДУстановитьПараметр(ПодгЗапрос, 1, УникИдентификатор(Док));
	КаталогОтносительноОснКаталогаМобиС = 
		СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код) + "\Photo\" + ПолучитьИмяКаталогаПоТипуОбъекта(ТипОбъекта) + "\";
	БДУстановитьПараметр(ПодгЗапрос, 2, типОбъекта);
	БДУстановитьПараметр(ПодгЗапрос, 3, Док.Метаданные().Имя);
	
	Для Н=1 По СтрЧислоСтрок(Фото) Цикл
		ИмяФайла=СтрПолучитьСтроку(фото,Н);
		БДУстановитьПараметр(ПодгЗапрос, 4, КаталогОтносительноОснКаталогаМобиС + СтрПолучитьСтроку(Фото,Н));
		БДСледующаяЗапись(ПодгЗапрос);
		БДСбросПодготовленногоЗапроса(ПодгЗапрос);
	КонецЦикла;
		
	БДЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
	ЗакрытьВнешнююБД(БД, Блокировщик);
КонецПроцедуры

// Заполняет счета в строке табличной части.
//
Процедура ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(Док, СтрокаТЧ, ИмяТабЧасти, Заполнять = Истина) 
	
	МетаданныеДока = Док.Метаданные();
	СчетаУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрокаТЧ.Номенклатура, Док.Склад, Док.Дата,
		ОбщегоНазначения.ЕстьРеквизитДокумента("ДеятельностьНаПатенте", МетаданныеДока) И Док.ДеятельностьНаПатенте);
	Если Заполнять = Истина Тогда
		СтрокаТЧ.СчетУчета = СчетаУчета.СчетУчета;
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ПереданныеСчетУчета", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.ПереданныеСчетУчета = СчетаУчета.СчетПередачи;
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетДоходов", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.СчетДоходов  = СчетаУчета.СчетДоходов;
			СтрокаТЧ.СчетРасходов = СчетаУчета.СчетРасходов;
			Если СтрокаТЧ.СчетДоходов.ВидыСубконто.Количество() > 0 Тогда
				СтрокаТЧ.Субконто = Новый(СтрокаТЧ.СчетДоходов.ВидыСубконто[0].ВидСубконто.ТипЗначения.Типы()[0]);
				Если ТипЗнч(СтрокаТЧ.Субконто) = Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
					СтрокаТЧ.Субконто = СтрокаТЧ.Номенклатура.НоменклатурнаяГруппа;
				КонецЕсли;
			Иначе
				СтрокаТЧ.Субконто = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетУчетаНДСПоРеализации", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.СчетУчетаНДСПоРеализации = СчетаУчета.СчетУчетаНДСПродажи;
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетУчетаНДС", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.СчетУчетаНДС = СчетаУчета.СчетУчетаНДС;
		КонецЕсли;
	ИначеЕсли Заполнять = Ложь Тогда
		СтрокаТЧ.СчетУчета = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетДоходов", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.СчетДоходов  = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
			СтрокаТЧ.СчетРасходов = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетУчетаНДСПоРеализации", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетУчетаНДС", МетаданныеДока, ИмяТабЧасти) Тогда
			СтрокаТЧ.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ОтражениеВУСН", МетаданныеДока, ИмяТабЧасти) Тогда
		СтрокаТЧ.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
	КонецЕсли;
	
КонецПроцедуры
 
// создает таблицу со строками для загрузки документов
Функция СоздатьТаблицуСтрокРН()
	ТаблСтрок = Новый Таблицазначений;
	ТаблСтрок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ТаблСтрок.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблСтрок.Колонки.Добавить("Партия");
	ТаблСтрок.Колонки.Добавить("Колво", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблСтрок.Колонки.Добавить("Коэффициент", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблСтрок.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой))); //остаток в ТТ
	ТаблСтрок.Колонки.Добавить("Фейсинг", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой))); //количество на витрине
	ТаблСтрок.Колонки.Добавить("Форма", Новый ОписаниеТипов("Строка"));
	ТаблСтрок.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ТаблСтрок.Колонки.Добавить("Бонус", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	                           
	Возврат ТаблСтрок;
КонецФункции // СоздатьТаблицуСтрок()

// Пересчитывает цены, суммы, скидки и прочее в документе так, как если бы документ вводили вручную
// Параметры:
// 		Док - ДокументОбъект, документ, в котором выполнить пересчёт
Процедура ЗаполнитьРеализациюПоАлгоритмам1С(Док)
	СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры;
	СтруктураЗначений = Новый Структура;
	
	Если Конфигурация = "БухКазахстан" Тогда
		СтруктураЗначений.Вставить("НовыйУчитыватьАкциз"		, Док.УчитыватьАкциз);
		СтруктураЗначений.Вставить("ТекущийУчитыватьАкциз"		, Док.УчитыватьАкциз);
		СтруктураЗначений.Вставить("НовыйСуммаВключаетАкциз"	, Док.СуммаВключаетАкциз);
		СтруктураЗначений.Вставить("ТекущийСуммаВключаетАкциз"	, Док.СуммаВключаетАкциз);
		МодульЦены	= "УправлениеЦенообразованием";
		Модуль		= "УправлениеВзаиморасчетами";
	Иначе
		МодульЦены	= "Ценообразование";
		Модуль		= "ЗаполнениеДокументов";
	КонецЕсли;	

	СтруктураРеквизитовДокумента = Неопределено;
	Выполнить("СтруктураРеквизитовДокумента = " + МодульЦены + ".ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(Док)");

	СтруктураЗначений.Вставить("ТекущийТипЦен"					, Док.ТипЦен);
	СтруктураЗначений.Вставить("ТекущийВалютаДокумента"			, Док.ВалютаДокумента);
	СтруктураЗначений.Вставить("ТекущийВалютаВзаиморасчетов"	, Док.ВалютаДокумента);
	СтруктураЗначений.Вставить("ТекущийКурсДокумента"			, Док.КурсВзаиморасчетов);
	СтруктураЗначений.Вставить("ТекущийКурсВзаиморасчетов"		, Док.КурсВзаиморасчетов);
	СтруктураЗначений.Вставить("ТекущийУчитыватьНДС"			, Док.УчитыватьНДС);
	СтруктураЗначений.Вставить("ТекущийСуммаВключаетНДС"		, Док.СуммаВключаетНДС);
	СтруктураЗначений.Вставить("ПерезаполнитьЦеныПоТипу"		, Ложь);
	СтруктураЗначений.Вставить("НовыйТипЦен"					, Док.ТипЦен);
	СтруктураЗначений.Вставить("ПересчитатьЦеныПоВалюте"		, Истина);
	СтруктураЗначений.Вставить("НовыйВалютаДокумента"			, Док.ВалютаДокумента);
	СтруктураЗначений.Вставить("НовыйКурсДокумента"				, Док.КурсВзаиморасчетов);
	СтруктураЗначений.Вставить("НовыйКурсВзаиморасчетов"		, Док.КурсВзаиморасчетов);
	СтруктураЗначений.Вставить("НовыйУчитыватьНДС"				, Док.УчитыватьНДС);
	СтруктураЗначений.Вставить("НовыйСуммаВключаетНДС"			, Док.СуммаВключаетНДС);
	СтруктураЗначений.Вставить("ТекущийКратностьДокумента"		, Док.КратностьВзаиморасчетов);
	СтруктураЗначений.Вставить("НовыйКратностьДокумента"		, Док.КратностьВзаиморасчетов);
	СтруктураЗначений.Вставить("ТекущийКратностьВзаиморасчетов"	, Док.КратностьВзаиморасчетов);
	СтруктураЗначений.Вставить("НовыйКратностьВзаиморасчетов"	, Док.КратностьВзаиморасчетов);
	
	Выполнить("" + Модуль + ".ИзменитьЦеныВалюту(Док, СпособЗаполненияЦен, СтруктураРеквизитовДокумента, , ""Товары"", мВалютаРегламентированногоУчета, , СтруктураЗначений)");

КонецПроцедуры

// Заполняет все реквизиты документа РеализацияТоваровУслуг при его загрузке из КПК
// Параметры:
// 		Док - ДокументОбъект, загружаемый документ
// 		СтрШапки - ТаблицаЗначений, содержащая все реквизиты шапки в соответствии с протоколом обмена
// 		ТаблТовары - ТаблицаЗначений, содержащая все реквизиты таблицы документа в соответствии
// 			с протоколом обмена
Процедура ЗаполнитьРеализациюТоваровИУслуг(Док, СтрШапки, ТаблТовары)
		
	РасчитыватьЦены1С = ПараметрыАгента.РасчитыватьЦены1С;
	Док.Дата		= ДатаИзДатаИВремя(СтрШапки.Дата, ТекущаяДата());  //Время поставим текущее
	Док.ВидОперации	= Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
	Док.Склад		= ?(ЗначениеЗаполнено(СтрШапки.Склад), СтрШапки.Склад, ПараметрыАгента.Склады[0].Склад);

	Док.Комментарий = СокрЛП(
		?(ЗначениеЗаполнено(СтрШапки.ВремяДоставки),
			"Доставка заказана " + Формат(СтрШапки.ВремяДоставки, "ДЛФ=DD")
			+ " в " + Формат(СтрШапки.ВремяДоставки, "ДФ=ЧЧ:мм"),
			"")
		+ " " + СтрШапки.Комментарий);
	
	//Если СоответствиеКонтрагента = 0 Тогда //покупатель = грузополучатель
		Док.Грузополучатель			= СтрШапки.Контрагент;
		Док.Контрагент				= СтрШапки.Контрагент;
	//Иначе	//холдинг
	//	Док.Грузополучатель			= СтрШапки.Контрагент;
		//Док.Контрагент				= Док.Грузополучатель.ГоловнойКонтрагент;
	//КонецЕсли; 
	
	Если ЗначениеЗаполнено(СтрШапки.Договор) 
		И (СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		Или СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее И Конфигурация = "БухКазахстан") Тогда
		Док.ДоговорКонтрагента = СтрШапки.Договор;
	Иначе
		Док.ДоговорКонтрагента = ПолучитьДоговораКонтрагента(СтрШапки, Док);
	КонецЕсли;
	глПоследняяОшибкаПроведения = "";
	Если Не ЗначениеЗаполнено(Док.ДоговорКонтрагента) Тогда
		ВызовемИсключение = 1 / 0;
	КонецЕсли;
	
	Док.Организация		= Док.ДоговорКонтрагента.Организация;
	Док.ТипЦен			= ?(РасчитыватьЦены1С, ?(ЗначениеЗаполнено(Док.ДоговорКонтрагента.ТипЦен), Док.ДоговорКонтрагента.ТипЦен, СтрШапки.ТипЦены), СтрШапки.ТипЦены);
	Док.ВалютаДокумента	= Док.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	Док.УчитыватьНДС	= ОпределитьУчитыватьНДС(Док.Организация, Док.Дата);
	Док.СуммаВключаетНДС= Док.ТипЦен.ЦенаВключаетНДС;
	Док.АдресДоставки	= СтрШапки.АдресДоставки;
	КурсВалюты					= ПолучитьКурсВалюты(Док.ВалютаДокумента, Док.Дата);
	Док.КурсВзаиморасчетов		= КурсВалюты.Курс;
	Док.КратностьВзаиморасчетов	= КурсВалюты.Кратность;
	Док.Ответственный			= ПараметрыАгента.Агент;
	СчетаУчета = ПолучитьСчетаРасчетовСКонтрагентом(Док.Организация, Док.Контрагент, Док.ДоговорКонтрагента, Док.ВалютаДокумента);
	Док.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
	Док.СчетУчетаРасчетовПоАвансам     = СчетаУчета.СчетАвансовПокупателя;

	НДСВидОперацииРеализации = Неопределено;
	Если Конфигурация = "БухКазахстан" Тогда
		//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
		//	Док.Автор = ПараметрыАгента.Агент;
		//КонецЕсли;
		Попытка
			НДСВидОперацииРеализации = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнойВидОперацииРеализации");
		Исключение
		КонецПопытки;
		Если Не ЗначениеЗаполнено(НДСВидОперацииРеализации) Тогда
			НДСВидОперацииРеализации = Справочники.ВидыРеализации.РеализацияТМЗ;
		КонецЕсли;
		Док.УчитыватьКПН			= ОрганизацияПлательщикКПН(Док.Организация);
		Если Док.УчитыватьКПН Тогда
			Док.ВидУчетаНУ			= Справочники.ВидыУчетаНУ.НУ;
		КонецЕсли;
		Док.СуммаВключаетАкциз		= Док.ТипЦен.ЦенаВключаетАкциз;
	ИначеЕсли Конфигурация = "БухБеларусь" Тогда
		Док.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
		Док.ОтражатьВНалоговомУчете = Истина;
		Док.СчетУчетаРасчетовПоТаре	= СчетаУчета.СчетУчетаТарыПокупателя;
		//Процедура ЗаполнитьСчетаУчетаРасчетов(СчетаУчета = неопределено) Экспорт
		Док.ЗаполнитьСчетаУчетаРасчетов();
		Док.мУчетнаяПолитика = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПолучитьПоследнее(Док.Дата,Новый Структура("Организация",Док.Организация));//Минск+

	Иначе
		Док.СчетУчетаРасчетовПоТаре	= СчетаУчета.СчетУчетаТарыПокупателя;
		//Док.СпособЗачетаАвансов		= Перечисления.СпособыЗачетаАвансов.Автоматически;
	КонецЕсли;
	
	СтруктураВалютаКПК = Неопределено;
	Если ПараметрыАгента.ВалютаКПК <> Док.ВалютаДокумента Тогда
		СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
	КонецЕсли;
	
	СуммаДокумента = 0;
	ДополнительныеПараметры = Новый Структура();
	Для Каждого СтрСтрок Из ТаблТовары Цикл  //по строкам Табличной части
		Если СтрСтрок.Колво = 0 Тогда Продолжить; КонецЕсли;
		
		СтрДок = Неопределено;
		стрСумма = СтрСтрок.Сумма;
		Если СтруктураВалютаКПК <> Неопределено Тогда
			стрСумма = ПересчитатьИзВалютыВВалюту(СтрСтрок.Сумма,
				ПараметрыАгента.ВалютаКПК, Док.ВалютаДокумента,
				СтруктураВалютаКПК.Курс, Док.КурсВзаиморасчетов,
				СтруктураВалютаКПК.Кратность, Док.КратностьВзаиморасчетов);
		КонецЕсли;
		
		Если СтрСтрок.Номенклатура.Услуга Тогда
			СтрДок = Док.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДок, ДополнительныеПараметры);
			СтрДок.Содержание 				= "услуга";
			СтрДок.Количество				= СтрСтрок.Колво;
			СтрДок.Номенклатура				= СтрСтрок.Номенклатура;
			СтрДок.СтавкаНДС				= ?(ЗначениеЗаполнено(СтрДок.Номенклатура.СтавкаНДС), СтрДок.Номенклатура.СтавкаНДС, Перечисления.СтавкиНДС.БезНДС);
		Иначе
			СтрДок = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДок, ДополнительныеПараметры);
			//товары
			СтрДок.Номенклатура				= СтрСтрок.Номенклатура;
			Если Конфигурация = "БухБеларусь" И СтрСтрок.Партия <> ""  Тогда
				СтрДок.Партия				= СтрСтрок.Партия;
			КонецЕсли;
			СтрДок.СтавкаНДС				= ?(ЗначениеЗаполнено(СтрДок.Номенклатура.СтавкаНДС), СтрДок.Номенклатура.СтавкаНДС, Перечисления.СтавкиНДС.БезНДС);
			Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
				СтрДок.ЕдиницаИзмерения	    	= СтрСтрок.Единица;
				СтрДок.Количество				= СтрСтрок.Колво;
			КонецЕсли;
			СтрДок.Коэффициент				= СтрСтрок.Коэффициент;
			
			Если Конфигурация = "БухКазахстан" Тогда
				СтрДок.НДСВидОперацииРеализации	= НДСВидОперацииРеализации;
				Если Док.СуммаВключаетАкциз И Док.УчитыватьАкциз Тогда 
					СтрДок.СтавкаАкциза		= СтрДок.Номенклатура.СтавкаАкциза;
					ОбработкаТабличныхЧастей.РассчитатьСуммуАкцизаТабЧасти(СтрДок, Док);
				КонецЕсли;
			Иначе
				СтрДок.КоличествоМест 		= СтрСтрок.Колво;
				СтрДок.НомерГТД				= СтрДок.Номенклатура.НомерГТД;
				СтрДок.СтранаПроисхождения	= СтрДок.Номенклатура.СтранаПроисхождения;
				СтрДок.Себестоимость		= стрСумма; // Себестоимость в рублях
			КонецЕсли;
			ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "13", "0");	
			
		КонецЕсли;
		
		Если (РасчитыватьЦены1С) И НЕ((СтрСтрок.Бонус > 0) И (ПараметрыАгента.СпособПредоставленияБонусов = 0)) Тогда
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПродажиТабЧасти(СтрДок, Док, мВалютаРегламентированногоУчета); 
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрДок, Док);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧастиСУчетомСкидок(СтрДок, Док);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, Док);
		Иначе
			СтавкаНДС = ПолучитьСтавкуНДС(СтрДок.СтавкаНДС) / 100;
			СтрДок.Цена = ?(СтрДок.Количество > 0, ?(Док.УчитыватьНДС, ?(Док.СуммаВключаетНДС, СтрСумма, СтрСумма / (1 + СтавкаНДС)), СтрСумма) / СтрДок.Количество, 0);
			СуммаСоСкидкой	= СтрСумма - СтрСумма * СтрШапки.Скидка / 100;
			СтрДок.СуммаНДС = ?(Док.УчитыватьНДС, СуммаСоСкидкой - СуммаСоСкидкой / (1 + СтавкаНДС), 0);
			СтрДок.Сумма	= ?(Док.СуммаВключаетНДС, СуммаСоСкидкой, СуммаСоСкидкой - СтрДок.СуммаНДС);
		КонецЕсли;
		ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "13", "0");
		СуммаДокумента = СуммаДокумента + СтрДок.Сумма;
	КонецЦикла;
	
	Если Конфигурация = "БухКазахстан" Тогда
		Док.ЗаполнитьСчетаУчетаВТабЧасти(Док.Товары, "Товары", Истина, Док.УчитыватьКПН);
	Иначе
	//Если Конфигурация = "БухБеларусь" Тогда
		//Процедура ЗаполнитьСчетаУчетаВСтрокеТабЧасти(СтрокаТЧ, ИмяТабЧасти, ЗаполнятьБУ, ЗаполнятьНУ) Экспорт
		Док.ЗаполнитьСчетаУчетаВТабЧасти(Док.Товары, "Товары", Истина, Истина);
		Док.СуммаДокумента = СуммаДокумента;
	//Иначе
	//	Док.ЗаполнитьСчетаУчетаВТабЧасти(Док.Товары, "Товары", Истина);
	КонецЕсли;
	
	Если РасчитыватьЦены1С Тогда     
		ЗаполнитьРеализациюПоАлгоритмам1С(Док);//удаляет бонусы
	КонецЕсли;
	
	Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
		Док.УстановитьНовыйНомер(Док.Организация.Префикс);
	Иначе
		Док.Номер = СтрШапки.Номер;
	КонецЕсли;
	
	Док.Экспедитор = Док.Ответственный.ФизЛицо;
	
	//запускаем обработку дополнительных реквизитов			
	ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "12", "0");

КонецПроцедуры

// Создаёт документ реализация товаров и услуг на основе таблиц шапок и строк
// Параметры
// Адрес - идентификатор сессии обмена
// ТаблШапок - таблица значений с "шапками" документов
// ТаблСтрок - таблица значений с данными для табличной части Товары
// ТаблПользователей - Таблица значений с перечнем пользователей которых нужно оповещать о созданных документах
// ТаблКатегорий - Таблица категорий документа
Процедура СоздатьРеализациюТоваровИУслуг(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий)
	ДобавитьСообщение("Формируются накладные...");
	
	текДата = ТекущаяДата();
	ВремТабл = СоздатьТаблицуСтрокРН(); //временная таблица
	нетОшибок = Истина;
	Для Каждого СтрШапки Из ТаблШапок Цикл
		УникДок = СформироватьУникальныйКодДокумента("Реализация", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		
		СтруктПоиска = Новый Структура;
		СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
		ТаблТовары = ТаблСтрок.Скопировать(СтруктПоиска); //Таблица с товарами в накладной
		ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); //Таблица категорий
		ИтогКолво = ТаблТовары.Итог("Колво"); //проверим пустой документ
		Если ИтогКолво = 0 Тогда
			Ответ = Строка(СтрШапки.ИдДок) + Таб + УникИдентификатор(СсылкаДок) + РазделительСтрок;
			СерверПослатьОтвет(Адрес, Ответ, 0);
			Продолжить;
		КонецЕсли; 
		
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес, Ответ, 0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			нетОшибок = Истина;
			НачатьТранзакцию();
			Попытка
				Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
				ЗаполнитьРеализациюТоваровИУслуг(Док, СтрШапки, ТаблТовары);	///////////////////////////////////////////
							
				Если ПараметрыАгента.ПроводитьПродажа Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					Док.Записать();
				КонецЕсли;
										
				Если ПараметрыАгента.ПроводитьПродажа Тогда
					Если Док.Проведен Тогда
						ТекстСтатуса = " (проведен)";
						Если ПараметрыАгента.СоздаватьСчетФактуру Тогда
							//создать счет фактуру с тем же номером
							СоздатьСчетФактуру(Док);
						КонецЕсли;
					Иначе
						ТекстСтатуса = " (не проведен)";
					КонецЕсли;
				КонецЕсли;			
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
			
			Если нетОшибок Тогда
				ЗаписатьУникКодДокумента(Док, УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
	            //добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект   = Док.ссылка;
				МенеджерЗаписи.Свойство = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект   = Док.ссылка;
				МенеджерЗаписи.Свойство = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение = СтрШапки.Дата;
				МенеджерЗаписи.Записать(Истина);			
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки.Фото, 12);			
				ЗавершитьСобытие(Адрес, Платформа, "Реализация", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				ЗафиксироватьТранзакцию();
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				СерверПослатьОтвет(Адрес, Ответ, 0);			
			Иначе
				ОтменитьТранзакцию();
				//СообщениеАгентуОбОшибке = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности.";
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ продажа не создан"; 
					Если ПараметрыАгента.ПроводитьПродажа Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Для контрагента " + Док.Контрагент + " не найден договор с покупателем";
					СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				//ДобавитьВЛогФайл(СообщениеАгентуОбОшибке, ПараметрыАгента.Агент, 0);
				//Если СообщениеАгентуОбОшибке <> глПоследняяОшибкаПроведения Тогда 
					ДобавитьВЛогФайл("Ошибка создания документа Продажа: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
				//КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
	
КонецПроцедуры                      

// Оформляет документ СчетФактураВыданный на основании указанного документа
// Параметры:
// 		Документобъект - ДокументОбъект, на основании которого ввести Счёт-фактуру
Процедура СоздатьСчетФактуру(ДокументОбъект)
	глПоследняяОшибкаПроведения = "";
	ВидСчетаФактуры = "СчетФактураВыданный";
	Если (Не ДокументОбъект.Проведен) и (Не ДокументОбъект.ПометкаУдаления) Тогда
		Сообщить("Счет-фактуру нельзя вводить на основании НЕ проведенного документа!");
		Возврат;
	КонецЕсли;
	//Попытаемся найти счет-фактуру
	СчетФактура = Неопределено;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументОбъект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ Ссылка ИЗ Документ.СчетФактураВыданный.ДокументыОснования
	|ГДЕ ДокументОснование = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка.ПометкаУдаления,
	|	Ссылка.Проведен УБЫВ,
	|	Ссылка.Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СчетФактура = Выборка.Ссылка;
	КонецЕсли;
	ОбъектСчетаФактуры = Неопределено;
	глПоследняяОшибкаПроведения = "";
	//Если потерпели неудачу, то необходимо ввести новый документ 
	Если НЕ ЗначениеЗаполнено(СчетФактура) Тогда
		//Вводим новый документ на основании нашего
		ОбъектСчетаФактуры = Документы[ВидСчетаФактуры].ПолучитьФормуНовогоДокумента( , ЭтаФорма, Строка(ДокументОбъект));
		ОбъектСчетаФактуры.Заполнить(ДокументОбъект.Ссылка);
		Если ПараметрыАгента.ТорговляСКолес Тогда
			ОбъектСчетаФактуры.Номер = ДокументОбъект.Номер;
		Иначе
		КонецЕсли;
		ОбъектСчетаФактуры.Ответственный = ДокументОбъект.Ответственный;
		Если Конфигурация = "БухКазахстан" Тогда
			//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
			//	ОбъектСчетаФактуры.Автор = ПараметрыАгента.Агент;
			//КонецЕсли;
		Иначе 
			ОбъектСчетаФактуры.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию;
		КонецЕсли;
		Попытка
			ОбъектСчетаФактуры.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда
				глПоследняяОшибкаПроведения = ОписаниеОшибки();
			КонецЕсли;
			Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
				глПоследняяОшибкаПроведения = "Счет-фактура к документу не создан"; 
			КонецЕсли;
            ДобавитьВЛогФайл("Ошибка создания документа Счет-Фактура: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
		КонецПопытки;
	ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
		Сообщить("Для данного документа уже есть Счет-Фактура.");			
	Иначе
		Сообщить("На основании документов, помеченных на удаление, ввод счетов-фактур НЕ предусмотрен.");
	КонецЕсли;
КонецПроцедуры     

// Заполняет все реквизиты документа РеализацияТоваровУслуг при его загрузке из КПК
// Параметры:
// 		Док - ДокументОбъект, загружаемый документ
// 		СтрШапки - ТаблицаЗначений, содержащая все реквизиты шапки в соответствии с протоколом обмена
// 		ТаблТовары - ТаблицаЗначений, содержащая все реквизиты таблицы документа в соответствии
// 			с протоколом обмена
Процедура ЗаполнитьАктОбОказанииПроизводственныхУслуг(Док, СтрШапки, ТаблТовары)
	
	РасчитыватьЦены1С = ПараметрыАгента.РасчитыватьЦены1С;
	Док.Дата = ДатаИзДатаИВремя(СтрШапки.Дата, ТекущаяДата());  //Время поставим текущее
	//Док.Комментарий = "" + СтрШапки.ИдДок + " " + СтрШапки.Комментарий;
	Док.Комментарий = СтрШапки.Комментарий;
	Док.Контрагент = СтрШапки.Контрагент;
	
	Если ЗначениеЗаполнено(СтрШапки.Договор)
		И (СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		Или СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее И Конфигурация = "БухКазахстан") Тогда
		Док.ДоговорКонтрагента = СтрШапки.Договор;
	Иначе
		Док.ДоговорКонтрагента = ПолучитьДоговораКонтрагента(СтрШапки, Док);
	КонецЕсли;
	глПоследняяОшибкаПроведения = "";
	Если Не ЗначениеЗаполнено(Док.ДоговорКонтрагента) Тогда
		ВызовемИсключение = 1 / 0;
	КонецЕсли;
	
	Док.Организация		= Док.ДоговорКонтрагента.Организация;
	Док.ТипЦен			= ?(РасчитыватьЦены1С, ?(ЗначениеЗаполнено(Док.ДоговорКонтрагента.ТипЦен), Док.ДоговорКонтрагента.ТипЦен, СтрШапки.ТипЦены), СтрШапки.ТипЦены);
	Док.ВалютаДокумента	= Док.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	Док.УчитыватьНДС	= ОпределитьУчитыватьНДС(Док.Организация, Док.Дата);
	Док.СуммаВключаетНДС= Док.ТипЦен.ЦенаВключаетНДС;
	КурсВалюты					= ПолучитьКурсВалюты(Док.ВалютаДокумента, Док.Дата);
	Док.КурсВзаиморасчетов		= КурсВалюты.Курс;
	Док.КратностьВзаиморасчетов	= КурсВалюты.Кратность;
	Док.Ответственный			= ПараметрыАгента.Агент;
	СчетаУчета = ПолучитьСчетаРасчетовСКонтрагентом(Док.Организация, Док.Контрагент, Док.ДоговорКонтрагента, Док.ВалютаДокумента);
	Док.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
	Док.СчетУчетаРасчетовПоАвансам     = СчетаУчета.СчетАвансовПокупателя;

	НДСВидОперацииРеализации = Неопределено;
	Если Конфигурация = "БухКазахстан" Тогда
		//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
		//	Док.Автор = ПараметрыАгента.Агент;
		//КонецЕсли;
		Док.ПодразделениеОрганизации = ПараметрыАгента.Подразделение;
		Док.СчетЗатратБУ	= ПланыСчетов.Типовой.ОсновноеПроизводство;
		Док.АдресДоставки	= СтрШапки.АдресДоставки;
		Док.Грузополучатель = СтрШапки.Контрагент;
		Если СоответствиеКонтрагента = 1 Тогда //покупатель = грузополучатель
			Док.Контрагент = Док.Грузополучатель.ГоловнойКонтрагент;
		КонецЕсли; 
		Попытка
			НДСВидОперацииРеализации = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнойВидОперацииРеализации");
		Исключение
		КонецПопытки;
		Если Не ЗначениеЗаполнено(НДСВидОперацииРеализации) Тогда
			НДСВидОперацииРеализации = Справочники.ВидыРеализации.РеализацияТМЗ;
		КонецЕсли;
		Док.УчитыватьКПН		= ОрганизацияПлательщикКПН(Док.Организация);
		Если Док.УчитыватьКПН Тогда
			Док.ВидУчетаНУ		= Справочники.ВидыУчетаНУ.НУ;
			Док.СчетЗатратНУ	= ПланыСчетов.Налоговый.ОсновноеПроизводство;
		КонецЕсли;
	ИначеЕсли Конфигурация = "БухБеларусь" Тогда
		Док.СчетЗатрат			= СчетаУчета.СчетРасчетов; 
		Док.ПодразделениеОрганизации = ПараметрыАгента.Подразделение;
	Иначе
		Док.Исполнитель			= ПараметрыАгента.Агент.ФизЛицо;
		Док.СпособЗачетаАвансов	= Перечисления.СпособыЗачетаАвансов.Автоматически;
		Док.ПодразделениеЗатрат = ПараметрыАгента.Подразделение;
		Док.СчетЗатрат			= СчетаУчета.СчетРасчетов;
	КонецЕсли;
	
	СтруктураВалютаКПК = Неопределено;
	Если ПараметрыАгента.ВалютаКПК <> Док.ВалютаДокумента Тогда
		СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
	КонецЕсли;
	
	МетаданныеДока = Док.Метаданные();
	Для Каждого СтрСтрок Из ТаблТовары Цикл  //по строкам Табличной части
		Если СтрСтрок.Колво = 0 Тогда Продолжить; КонецЕсли;
		
		стрСумма = СтрСтрок.Сумма;
		Если СтруктураВалютаКПК <> Неопределено Тогда
			стрСумма = ПересчитатьИзВалютыВВалюту(СтрСтрок.Сумма,
				ПараметрыАгента.ВалютаКПК, Док.ВалютаДокумента,
				СтруктураВалютаКПК.Курс, Док.КурсВзаиморасчетов,
				СтруктураВалютаКПК.Кратность, Док.КратностьВзаиморасчетов);
		КонецЕсли;
		
		СтрДок = Док.Услуги.Добавить();
		СтрДок.Количество	= СтрСтрок.Колво;
		СтрДок.Номенклатура	= СтрСтрок.Номенклатура;
		СтрДок.СтавкаНДС	= СтрДок.Номенклатура.СтавкаНДС;
		СтрДок.НоменклатурнаяГруппа	= СтрДок.Номенклатура.НоменклатурнаяГруппа;
		Если Не ЗначениеЗаполнено(Док.НоменклатурнаяГруппа) Тогда
			Док.НоменклатурнаяГруппа = СтрДок.НоменклатурнаяГруппа;
		КонецЕсли;
		
		Если (РасчитыватьЦены1С) И НЕ((СтрСтрок.Бонус > 0) И (ПараметрыАгента.СпособПредоставленияБонусов = 0)) Тогда
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПродажиТабЧасти(СтрДок, Док, мВалютаРегламентированногоУчета); 
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрДок, Док);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, Док);
		Иначе
			СтавкаНДС = ПолучитьСтавкуНДС(СтрДок.СтавкаНДС) / 100;
			СтрДок.Цена = ?(СтрДок.Количество > 0, ?(Док.УчитыватьНДС, ?(Док.СуммаВключаетНДС, СтрСумма, СтрСумма / (1 + СтавкаНДС)), СтрСумма) / СтрДок.Количество, 0);
			СуммаСоСкидкой	= СтрСумма - СтрСумма * СтрШапки.Скидка / 100;
			СтрДок.СуммаНДС = ?(Док.УчитыватьНДС, СуммаСоСкидкой - СуммаСоСкидкой / (1 + СтавкаНДС), 0);
			СтрДок.Сумма	= ?(Док.СуммаВключаетНДС, СуммаСоСкидкой, СуммаСоСкидкой - СтрДок.СуммаНДС);
		КонецЕсли;
		
		СтрДок.СуммаПлановая = стрСумма;
		СтрДок.ПлановаяСтоимость = СтрДок.СуммаПлановая / СтрДок.Количество;
		
		СчетаНоменклатуры = Новый Структура;
		
		Если Конфигурация = "БухКазахстан" Тогда
			СтрДок.Коэффициент	= СтрСтрок.Коэффициент;
			СтрДок.НДСВидОперацииРеализации	= НДСВидОперацииРеализации;
			Выполнить("СчетаНоменклатуры = ПроцедурыБухгалтерскогоУчета.ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрДок.Номенклатура);");
			Док.ЗаполнитьСчетаБУ(СтрДок, "Услуги", СчетаНоменклатуры, Истина,  МетаданныеДока);
			
			// ЗаполнитьСчетаНУ
			Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетДоходовНУ", МетаданныеДока, "Услуги") Тогда
				СтрДок.СчетДоходовНУ = СчетаНоменклатуры.СчетДоходовОтРеализацииНУ;
				Выполнить("ПроцедурыБухгалтерскогоУчета.ЗаполнитьАналитикуСчетаТабличнойЧасти(СтрДок, СчетаНоменклатуры, ""СубконтоДоходовНУ"", ""СчетДоходовНУ"", ""СубконтоДоходовНУ"");");
				#Если Клиент Тогда
					РаботаСДиалогами.ЗаполнитьАналитикуПодразделениеСчетовДоходовЗатрат(СтрДок, СтрДок.СчетДоходовНУ, "СубконтоДоходовНУ", Док.ПодразделениеОрганизации);
				#КонецЕсли
			КонецЕсли;	
			Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СчетСписанияСебестоимостиНУ", МетаданныеДока, "Услуги") Тогда
				СтрДок.СчетСписанияСебестоимостиНУ = СчетаНоменклатуры.СчетСебестоимостиПриРеализацииНУ;
				Выполнить("ПроцедурыБухгалтерскогоУчета.ЗаполнитьАналитикуСчетаТабличнойЧасти(СтрДок, СчетаНоменклатуры, ""СубконтоСебестоимостиНУ"", ""СчетСписанияСебестоимостиНУ"", ""СубконтоСписанияСебестоимостиНУ"");");			
				#Если Клиент Тогда
					РаботаСДиалогами.ЗаполнитьАналитикуПодразделениеСчетовДоходовЗатрат(СтрДок, СтрДок.СчетСписанияСебестоимостиНУ, "СубконтоСписанияСебестоимостиНУ", Док.ПодразделениеОрганизации);
				#КонецЕсли
			КонецЕсли;			
		ИначеЕсли Конфигурация = "БухБеларусь" Тогда
			Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиУслуги(СтрДок, Истина, Истина);
		Иначе  // Россия
			Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиУслуги(СтрДок, Истина);
		КонецЕсли;
		ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "13", "1");	

	КонецЦикла;
	
	
	Если РасчитыватьЦены1С Тогда     
		//ЗаполнитьРеализациюПоАлгоритмам1С(Док);
	КонецЕсли;
	
	Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
		Док.УстановитьНовыйНомер(Док.Организация.Префикс);
	Иначе
		Док.Номер = СтрШапки.Номер;
	КонецЕсли;
	//запускаем обработку дополнительных реквизитов			
	ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "12", "1");

КонецПроцедуры

// Создаёт документ Акт об оказании производственных услуг на основе таблиц шапок и строк
// Параметры
// Адрес - идентификатор сессии обмена
// ТаблШапок - таблица значений с "шапками" документов
// ТаблСтрок - таблица значений с данными для табличной части Товары
// ТаблПользователей - Таблица значений с перечнем пользователей которых нужно оповещать о созданных документах
// ТаблКатегорий - Таблица категорий документа
Процедура СоздатьАктОбОказанииПроизводственныхУслуг(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий)
	ДобавитьСообщение("Формируются акты...");
	
	текДата = ТекущаяДата();
	ВремТабл = СоздатьТаблицуСтрокРН(); //временная таблица
	нетОшибок = Истина;
	Для Каждого СтрШапки Из ТаблШапок Цикл
		УникДок = СформироватьУникальныйКодДокумента("Реализация", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		
		СтруктПоиска = Новый Структура;
		СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
		ТаблТовары = ТаблСтрок.Скопировать(СтруктПоиска); //Таблица с товарами в накладной
		ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); //Таблица категорий
		ИтогКолво = ТаблТовары.Итог("Колво"); //проверим пустой документ
		Если ИтогКолво = 0 Тогда
			Ответ = Строка(СтрШапки.ИдДок) + Таб + УникИдентификатор(СсылкаДок) + РазделительСтрок;
			СерверПослатьОтвет(Адрес, Ответ, 0);
			Продолжить;
		КонецЕсли; 
		
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес, Ответ, 0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			нетОшибок = Истина;
			НачатьТранзакцию();
			Попытка
				Док = Документы.АктОбОказанииПроизводственныхУслуг.СоздатьДокумент();
				ЗаполнитьАктОбОказанииПроизводственныхУслуг(Док, СтрШапки, ТаблТовары);	
							
				Если ПараметрыАгента.ПроводитьПродажа Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					Док.Записать();
				КонецЕсли;
										
				Если ПараметрыАгента.ПроводитьПродажа Тогда
					Если Док.Проведен Тогда
						ТекстСтатуса = " (проведен)";
						Если ПараметрыАгента.СоздаватьСчетФактуру Тогда
							//создать счет фактуру с тем же номером
							СоздатьСчетФактуру(Док);
						КонецЕсли;
					Иначе
						ТекстСтатуса = " (не проведен)";
					КонецЕсли;
				КонецЕсли;			
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
			
			Если нетОшибок Тогда
				ЗаписатьУникКодДокумента(Док, УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
	            //добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект   = Док.ссылка;
				МенеджерЗаписи.Свойство = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект   = Док.ссылка;
				МенеджерЗаписи.Свойство = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение = СтрШапки.Дата;
				МенеджерЗаписи.Записать(Истина);			
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки.Фото, 12);			
				ЗавершитьСобытие(Адрес, Платформа, "Реализация", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				ЗафиксироватьТранзакцию();
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				СерверПослатьОтвет(Адрес, Ответ, 0);			
			Иначе
				ОтменитьТранзакцию();
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ продажа не создан"; 
					Если ПараметрыАгента.ПроводитьПродажа Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Для контрагента " + Док.Контрагент + " не найден договор с покупателем";
					СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл("Ошибка создания документа Продажа: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
	
КонецПроцедуры                      

// Создаёт документ Счет на оплату покупателю на основе таблиц шапок и строк
// Параметры
// Адрес - идентификатор сессии обмена
// ТаблШапок - таблица значений с "шапками" документов
// ТаблСтрок - таблица значений с данными для табличной части Товары
// ТаблПользователей - Таблица значений с перечнем пользователей которых нужно оповещать о созданных документах
// ТаблКатегорий - Таблица категорий документа
Процедура СоздатьСчетНаОплату(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий)
	ДобавитьСообщение("Формируются Счета на оплату...");
	
	текДата = ТекущаяДата();
	ВремТабл = СоздатьТаблицуСтрокРН(); //временная таблица
	нетОшибок = Истина;
	РасчитыватьЦены1С = ПараметрыАгента.РасчитыватьЦены1С;
	Для Каждого СтрШапки Из ТаблШапок Цикл
		УникДок = СформироватьУникальныйКодДокумента("Заказ", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		
		СтруктПоиска = Новый Структура;
		СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
		ТаблТовары = ТаблСтрок.Скопировать(СтруктПоиска); //Таблица с товарами в накладной
		ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); //Таблица категорий
		ИтогКолво = ТаблТовары.Итог("Колво"); //проверим пустой документ
		Если ИтогКолво = 0 Тогда
			Ответ = Строка(СтрШапки.ИдДок) + Таб + УникИдентификатор(СсылкаДок) + РазделительСтрок;
			СерверПослатьОтвет(Адрес, Ответ, 0);
			Продолжить;
		КонецЕсли; 
		
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес, Ответ, 0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			нетОшибок = Истина;
			НачатьТранзакцию();
			Попытка
				Док = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
				
				Док.Дата		= ДатаИзДатаИВремя(СтрШапки.Дата, ТекущаяДата());  //Время поставим текущее
				Док.Склад		= ?(ЗначениеЗаполнено(СтрШапки.Склад), СтрШапки.Склад, ПараметрыАгента.Склады[0].Склад);
				
				Док.Комментарий = СокрЛП(
					?(ЗначениеЗаполнено(СтрШапки.ВремяДоставки),
						"Доставка заказана " + Формат(СтрШапки.ВремяДоставки, "ДЛФ=DD")
						+ " в " + Формат(СтрШапки.ВремяДоставки, "ДФ=ЧЧ:мм"),
						"")
					+ " " + СтрШапки.Комментарий);
								
				Если СоответствиеКонтрагента = 0 Тогда //покупатель = грузополучатель
					Док.Контрагент = СтрШапки.Контрагент;
				Иначе	//холдинг
					Док.Контрагент = СтрШапки.Контрагент.ГоловнойКонтрагент;
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтрШапки.Договор) 
					И ((СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем)
					Или (СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее) И Конфигурация = "БухКазахстан") Тогда
					Док.ДоговорКонтрагента = СтрШапки.Договор;
				Иначе
					Док.ДоговорКонтрагента = ПолучитьДоговораКонтрагента(СтрШапки, Док);
				КонецЕсли;
				глПоследняяОшибкаПроведения = "";
				Если Не ЗначениеЗаполнено(Док.ДоговорКонтрагента) Тогда
					ВызовемИсключение = 1 / 0;
				КонецЕсли;
				
				Док.Организация		= Док.ДоговорКонтрагента.Организация;
				УправлениеДенежнымиСредствами.УстановитьБанковскийСчет(Док.СтруктурнаяЕдиница, Док.Организация, мВалютаРегламентированногоУчета);
				Док.ТипЦен	= ?(РасчитыватьЦены1С, ?(ЗначениеЗаполнено(Док.ДоговорКонтрагента.ТипЦен), Док.ДоговорКонтрагента.ТипЦен, СтрШапки.ТипЦены), СтрШапки.ТипЦены);
				Док.ВалютаДокумента			= Док.ДоговорКонтрагента.ВалютаВзаиморасчетов;
				Док.УчитыватьНДС			= ОпределитьУчитыватьНДС(Док.Организация, Док.Дата);
				Док.СуммаВключаетНДС		= Док.ТипЦен.ЦенаВключаетНДС;
				КурсВалюты					= ПолучитьКурсВалюты(Док.ВалютаДокумента,Док.Дата);
				Док.КурсВзаиморасчетов		= КурсВалюты.Курс;
				Док.КратностьВзаиморасчетов	= КурсВалюты.Кратность;
				Док.Ответственный			= ПараметрыАгента.Агент;
				Док.АдресДоставки			= СтрШапки.АдресДоставки;
				Если Конфигурация = "БухКазахстан" Тогда
					//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
					//	Док.Автор = ПараметрыАгента.Агент;
					//КонецЕсли;
					Док.СуммаВключаетАкциз = Док.ТипЦен.ЦенаВключаетАкциз;
				ИначеЕсли Конфигурация = "БухБеларусь" Тогда
				Иначе
					Док.ОрганизацияПолучатель = ?(ЗначениеЗаполнено(Док.СтруктурнаяЕдиница), Док.СтруктурнаяЕдиница.Владелец, Док.Организация);
				КонецЕсли;
				СчетаУчета = ПолучитьСчетаРасчетовСКонтрагентом(Док.Организация, Док.Контрагент, Док.ДоговорКонтрагента, Док.ВалютаДокумента);
				
				СтруктураВалютаКПК = Неопределено;
				Если ПараметрыАгента.ВалютаКПК <> Док.ВалютаДокумента Тогда
					СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
				КонецЕсли;
				
				ДополнительныеПараметры = Новый Структура();
				Для Каждого СтрСтрок Из ТаблТовары Цикл  //по строкам Табличной части
					Если СтрСтрок.Колво = 0 Тогда
						Продолжить;
					КонецЕсли;
					СтрДок = Неопределено;
					стрСумма = СтрСтрок.Сумма;
					Если СтруктураВалютаКПК <> Неопределено Тогда
						стрСумма = ПересчитатьИзВалютыВВалюту(СтрСтрок.Сумма,
							ПараметрыАгента.ВалютаКПК, Док.ВалютаДокумента,
							СтруктураВалютаКПК.Курс, Док.КурсВзаиморасчетов,
							СтруктураВалютаКПК.Кратность, Док.КратностьВзаиморасчетов);
					КонецЕсли;
			
					Если СтрСтрок.Номенклатура.Услуга Тогда
						СтрДок = Док.Услуги.Добавить();
						ЗаполнитьЗначенияСвойств(СтрДок, ДополнительныеПараметры);
						СтрДок.Содержание 	= "услуга";
						СтрДок.Номенклатура	= СтрСтрок.Номенклатура;
						СтрДок.СтавкаНДС	= СтрДок.Номенклатура.СтавкаНДС;
						СтрДок.Количество	= СтрСтрок.Колво;
					Иначе
						СтрДок = Док.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(СтрДок, ДополнительныеПараметры);
						//товары
						СтрДок.Номенклатура	= СтрСтрок.Номенклатура;
						СтрДок.СтавкаНДС	= СтрДок.Номенклатура.СтавкаНДС;
						СтрДок.Количество	= СтрСтрок.Колво;
						Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
							СтрДок.ЕдиницаИзмерения =  СтрСтрок.Единица;  //СтрДок.Номенклатура.БазоваяЕдиницаИзмерения; // ???
							СтрДок.Коэффициент	= СтрСтрок.Коэффициент;
						КонецЕсли;
						
						Если Конфигурация = "БухБеларусь" Тогда
							Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("Партия") <> Неопределено Тогда 
								СтрДок.Партия = СтрСтрок.Партия;
							КонецЕсли;
						КонецЕсли;
						Если Конфигурация = "БухКазахстан" Тогда
							Если Док.СуммаВключаетАкциз И Док.УчитыватьАкциз Тогда 
								СтрДок.СтавкаАкциза = СтрДок.Номенклатура.СтавкаАкциза;
								ОбработкаТабличныхЧастей.РассчитатьСуммуАкцизаТабЧасти(СтрДок, Док);
							КонецЕсли;
						КонецЕсли;
						ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "15", "0");	
					КонецЕсли;
					
					Если (СтрСтрок.Бонус > 0) И (ПараметрыАгента.СпособПредоставленияБонусов = 0) Тогда
						РасчитыватьЦены1С = Ложь;
					КонецЕсли;
					
					Если РасчитыватьЦены1С Тогда
						ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПродажиТабЧасти(СтрДок, Док, мВалютаРегламентированногоУчета); 
						ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрДок, Док);
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, Док);
					Иначе
						СтавкаНДС = ПолучитьСтавкуНДС(СтрДок.СтавкаНДС) / 100;
						СтрДок.Цена = ?(СтрДок.Количество > 0, ?(Док.УчитыватьНДС, ?(Док.СуммаВключаетНДС, СтрСумма, СтрСумма / (1 + СтавкаНДС)), СтрСумма) / СтрДок.Количество, 0);
						СуммаСоСкидкой	= СтрСумма - СтрСумма * СтрШапки.Скидка / 100;
						СтрДок.СуммаНДС = ?(Док.УчитыватьНДС, СуммаСоСкидкой - СуммаСоСкидкой / (1 + СтавкаНДС), 0);
						СтрДок.Сумма	= ?(Док.СуммаВключаетНДС, СуммаСоСкидкой, СуммаСоСкидкой - СтрДок.СуммаНДС);
					КонецЕсли;	
				КонецЦикла; 
				
				Если РасчитыватьЦены1С Тогда     
					ЗаполнитьРеализациюПоАлгоритмам1С(Док);//удаляет бонусы
				КонецЕсли;
				
				Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
					Док.УстановитьНовыйНомер(Док.Организация.Префикс);
				Иначе
					Док.Номер = СтрШапки.Номер;
				КонецЕсли;
				
				//запускаем обработку дополнительных реквизитов			
				ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "14", "0");
				
				Если ПараметрыАгента.ПроводитьЗаказ Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
					ТекстСтатуса = " (проведен)";
				Иначе
					Док.Записать();
					ТекстСтатуса = " (не проведен)";
				КонецЕсли;
				
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
			
			Если нетОшибок Тогда
				ЗаписатьУникКодДокумента(Док,УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
	            //добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение  = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение  = СтрШапки.ДатаСоздания;
				МенеджерЗаписи.Записать(Истина);			
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки.Фото, 14);			
				ЗавершитьСобытие(Адрес, Платформа, "Заказ", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				ЗафиксироватьТранзакцию();
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				СерверПослатьОтвет(Адрес, Ответ, 0);			
			Иначе
				ОтменитьТранзакцию();
				СообщениеАгентуОбОшибке = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности.";
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = "Неизвестная ошибка"; 
				КонецЕсли;
				Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Для контрагента " + Док.Контрагент + " не найден договор с покупателем";
					СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				КонецЕсли;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл(СообщениеАгентуОбОшибке, ПараметрыАгента.Агент, 0);
				Если СообщениеАгентуОбОшибке <> глПоследняяОшибкаПроведения Тогда 
					ДобавитьВЛогФайл("Ошибка создания документа Заказ: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СерверПослатьОтвет(Адрес, РазделительСтрок, 1);
	
КонецПроцедуры                      

Функция НайтиКассуДляПКО(Организация)
	Касса = Справочники.Кассы.ПустаяСсылка();
	стрОрганизация = ПараметрыАгента.Организации.Найти(Организация, "Организация");
	Если стрОрганизация <> Неопределено Тогда
		Касса = стрОрганизация.Касса;
	КонецЕсли;
	Если Касса.Пустая() Тогда
		ДобавитьОшибку("В настройках агента у организации " + Организация + " не указана Касса.");
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Кассы ГДЕ ВалютаДенежныхСредств = &Валюта И Владелец = &Организация");
		Запрос.УстановитьПараметр("Валюта", мВалютаРегламентированногоУчета);
		Запрос.УстановитьПараметр("Организация", Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Касса = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Касса;
КонецФункции

//создает документПКО с указанным набором параметров
//Параметры
//Дата - дата документа на КПК
//Контрагент - контрагент установленный в документе на КПК
//Договор - договор установленный в документе на КПК
//Организация - организация которую необходимо указать в документе
//ИдДок - идентификатор документа
//Комментарий - комментарий к документу из КПК
//Пр - флаг ПР из КПК
//СуммаПКО* - Оставшаяся сумма ПКО которую необходимо распределить в этом документа
//			  При формировании документа значение суммы будет изменяться в соответствии с документами основаниями
//Номер - номер документа в КПК
//ВремяРаботы - время работы над документом
//УникДок - уникальный код документа
//ДопРеквизиты - Дополнительные реквизиты к документу
//ТаблОснований - таблица Документов Оснований - содержит 3 колонки Договор, ДокументОснование и Организация
//ТаблКатегорий - таблица категорий для документа
//ТаблПользователей - таблица пользователей для механизма оповещения
//возвращает ссылку на созданный документ ПКО
Функция СоздатьДокументПКО(Адрес, СШ, СуммаПКО, УникДок, ТаблКатегорий, ТаблПользователей, ТаблОснований, НомераИз1С)
	
	Последний = ?(ТаблОснований.Количество() > 0, Ложь, Истина);
	Док = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	текДата = ТекущаяДата();
	
	Док.Дата			= ДатаИзДатаИВремя(СШ.Дата, текДата);
	Док.ВидОперации		= Перечисления.ВидыОперацийПКО.ОплатаПокупателя;
	Док.Ответственный   = ПараметрыАгента.Агент;
	Док.ВалютаДокумента	= мВалютаРегламентированногоУчета;
	Док.Контрагент		= СШ.Контрагент;
	Док.ПринятоОт		= Док.Контрагент.НаименованиеПолное;
	//Док.Комментарий		= "" + СШ.ИдДок + " " + СШ.Комментарий;
	Док.Комментарий		= СШ.Комментарий;
	Док.СтатьяДвиженияДенежныхСредств = ПараметрыАгента.СтатьяДвиженияДенежныхСредств;
	Док.СчетКасса = ПараметрыАгента.СчетУчетаДенежныхСредств;
	
	Док.СуммаДокумента = 0;
	Если Последний Тогда
		Док.ДоговорКонтрагента = ПолучитьДоговораКонтрагента(СШ, Док);
	Иначе	
		Док.ДоговорКонтрагента = ТаблОснований[0].Договор;
	КонецЕсли;
	Док.Организация	= Док.ДоговорКонтрагента.Организация;
	
	запросДолгПоДокументу = Новый Запрос(
	"ВЫБРАТЬ
	|	Долги.СуммаРазвернутыйОстатокДт - Долги.СуммаРазвернутыйОстатокКт КАК СуммаВзаиморасчетовОстаток
	|ИЗ
	|	РегистрБухгалтерии." + РегБух + ".Остатки(
	|			&Дата,
	|			НЕ Счет.Забалансовый
	|				И НЕ Счет В ИЕРАРХИИ (&ИсключенныеСчета),
	|			&ВидыСубконтоКД,
	|			Субконто2.ВидДоговора В (&ВидыДоговоров)		
	//|				И Субконто3 = &Документ
	|) КАК Долги
	|ГДЕ Долги.СуммаРазвернутыйОстатокДт - Долги.СуммаРазвернутыйОстатокКт > 0");
	запросДолгПоДокументу.УстановитьПараметр("ВидыСубконтоКД",	МассивыВидовСубконто[1]);
	запросДолгПоДокументу.УстановитьПараметр("ВидыДоговоров",	ПолучитьМассивВидовДоговоров());
	запросДолгПоДокументу.УстановитьПараметр("ИсключенныеСчета",СтандартныеОтчеты.ПолучитьСписокСчетовИсключаемыхИзРасчетаЗадолженности(1));
	запросДолгПоДокументу.УстановитьПараметр("Дата",			КонецДня(ТекущаяДата()) + 1);
		
	запросДолгПоДоговору = Новый Запрос(
	"ВЫБРАТЬ
	|	Долги.СуммаРазвернутыйОстатокДт - Долги.СуммаРазвернутыйОстатокКт КАК СуммаВзаиморасчетовОстаток
	|ИЗ
	|	РегистрБухгалтерии." + РегБух + ".Остатки(
	|			&Дата,
	|			НЕ Счет.Забалансовый
	|				И НЕ Счет В ИЕРАРХИИ (&ИсключенныеСчета),
	|			&ВидыСубконтоКД,
	|			Субконто2.ВидДоговора В (&ВидыДоговоров)
	|				И Субконто2 = &Договор) КАК Долги
	|ГДЕ Долги.СуммаРазвернутыйОстатокДт - Долги.СуммаРазвернутыйОстатокКт > 0");		
	запросДолгПоДоговору.УстановитьПараметр("ВидыСубконтоКД",	МассивыВидовСубконто[1]);
	запросДолгПоДоговору.УстановитьПараметр("ВидыДоговоров",	ПолучитьМассивВидовДоговоров());
	запросДолгПоДоговору.УстановитьПараметр("ИсключенныеСчета",	СтандартныеОтчеты.ПолучитьСписокСчетовИсключаемыхИзРасчетаЗадолженности(1));
	запросДолгПоДоговору.УстановитьПараметр("Дата",				КонецДня(ТекущаяДата()) + 1);
	
	СчетаУчета = ПолучитьСчетаРасчетовСКонтрагентом(Док.Организация, Док.Контрагент, Док.ДоговорКонтрагента, Док.ВалютаДокумента);
	
	Если Конфигурация = "БухКазахстан" Тогда
		//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
		//	Док.Автор = ПараметрыАгента.Агент;
		//КонецЕсли;
		Док.УчитыватьКПН		= ОрганизацияПлательщикКПН(Док.Организация);
		Если Док.УчитыватьКПН Тогда
			Док.ВидУчетаНУ		= Справочники.ВидыУчетаНУ.НУ;
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.БанковскиеСчета
		|ГДЕ НЕ ПометкаУдаления И Владелец = &Организация И ВалютаДенежныхСредств = &Валюта");
		Запрос.УстановитьПараметр("Организация", Док.Организация);
		Запрос.УстановитьПараметр("Валюта", Док.ВалютаДокумента);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Док.СчетОрганизации = Выборка.Ссылка;
		КонецЕсли;
		Док.Касса = НайтиКассуДляПКО(Док.Организация);
	ИначеЕсли Конфигурация = "БухБеларусь" Тогда
	Иначе
		Док.ПодразделениеОрганизации	= ПараметрыАгента.Подразделение;
	КонецЕсли;	
	
	СтруктПоиска = Новый Структура;
	СтруктПоиска.Вставить("ИдДок", СШ.ИдДок);
	ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); 	
	СуммаПлатежаПоСтроке = 0;
	КурсРегл = ПолучитьКурсВалюты(мВалютаРегламентированногоУчета, Док.Дата);
	Док.ВалютаДокумента = мВалютаРегламентированногоУчета;
	Док.КурсДокумента = КурсРегл.Курс;
	Док.КратностьДокумента = КурсРегл.Кратность;

	Для каждого ДО Из ТаблОснований Цикл
		Если СуммаПКО <= 0 Тогда 
			Прервать;
		КонецЕсли;
		
		Валюта = мВалютаРегламентированногоУчета;
		ДатаВалюты = текДата;
		
		Стр = Док.РасшифровкаПлатежа.Добавить();
		Если ЗначениеЗаполнено(ДО.Документ) Тогда
			КурсВалюты = ПолучитьКурсВалюты(ДО.Документ.ДоговорКонтрагента.ВалютаВзаиморасчетов, Док.Дата);
			запросДолгПоДокументу.УстановитьПараметр("Документ", ДО.Документ);   
			результатЗапроса = запросДолгПоДокументу.Выполнить().Выбрать();
			Если результатЗапроса.Следующий() Тогда
				СуммаДокумента = результатЗапроса.СуммаВзаиморасчетовОстаток;
			Иначе
				СуммаДокумента = ДО.Документ.СуммаДокумента;
				Попытка
					СуммаДокумента = ?(ДО.Документ.СуммаВключаетНДС, 
						ДО.Документ.СуммаДокумента, 
						ДО.Документ.СуммаДокумента + ДО.Документ.СуммаНДС);
				Исключение
				КонецПопытки;                    
			КонецЕсли;
			Валюта = ДО.Документ.ВалютаДокумента;
			ДатаВалюты = Док.Дата;
		Иначе
			запросДолгПоДоговору.УстановитьПараметр("Договор", ДО.Договор);
			Выборка = запросДолгПоДоговору.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СуммаДокумента = Выборка.СуммаВзаиморасчетовОстаток;
				Валюта = ДО.Договор.ВалютаВзаиморасчетов;
			Иначе
				//если по договору нет долга - списываем на него все
				СуммаПлатежаПоСтроке = СуммаПКО;				
			КонецЕсли;			
		КонецЕсли;
		КурсВалюты = ПолучитьКурсВалюты(Валюта, ДатаВалюты);
		СуммаПлатежаПоСтроке = ПересчитатьИзВалютыВВалюту(СуммаДокумента, Валюта, мВалютаРегламентированногоУчета,
			КурсВалюты.Курс, Док.КурсДокумента, КурсВалюты.Кратность, Док.КратностьДокумента);
		
		СуммаПлатежаПоСтроке = ?(СуммаПКО > СуммаПлатежаПоСтроке, СуммаПлатежаПоСтроке, СуммаПКО);
		Если Конфигурация = "БухКазахстан" Тогда
			Стр.СчетУчетаРасчетовСКонтрагентомБУ = СчетаУчета.СчетРасчетовПокупателя;
			//Стр.СчетУчетаРасчетовСКонтрагентомНУ = ;
		ИначеЕсли Конфигурация = "БухБеларусь" Тогда
			Стр.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
		Иначе
			Стр.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
			Стр.СпособПогашенияЗадолженности = ?(ЗначениеЗаполнено(Стр.Сделка), Перечисления.СпособыПогашенияЗадолженности.ПоДокументу, Перечисления.СпособыПогашенияЗадолженности.Автоматически);
		КонецЕсли;	
		Стр.СчетУчетаРасчетовПоАвансам		= СчетаУчета.СчетАвансовПокупателя;
		Стр.Сделка							= ДО.Документ;
		Стр.ДоговорКонтрагента				= ДО.Договор;
		Стр.КратностьВзаиморасчетов			= КурсВалюты.Кратность;
		Стр.КурсВзаиморасчетов				= КурсВалюты.Курс;
		Стр.СтатьяДвиженияДенежныхСредств	= Док.СтатьяДвиженияДенежныхСредств;
		Стр.СуммаПлатежа					= СуммаПлатежаПоСтроке;
		Док.СуммаДокумента					= Док.СуммаДокумента + СуммаПлатежаПоСтроке;
		Стр.СуммаВзаиморасчетов = ПересчитатьИзВалютыВВалюту(СуммаПлатежаПоСтроке, мВалютаРегламентированногоУчета, Валюта,
			Док.КурсДокумента, КурсВалюты.Курс, Док.КратностьДокумента, КурсВалюты.Кратность);
			
		СуммаПКО = СуммаПКО - СуммаПлатежаПоСтроке;
	КонецЦикла;
	
	Если Последний Тогда
		//Если оснований нет, то необходимо сформировать ПКО на организацию и договор указанные в шапке
		//или по удовлетворяещему договору
		КурсВалюты = ПолучитьКурсВалюты(Док.ДоговорКонтрагента.ВалютаВзаиморасчетов, Док.Дата);

		Стр = Док.РасшифровкаПлатежа.Добавить();
		Если Конфигурация = "БухКазахстан" Тогда
			Стр.СчетУчетаРасчетовСКонтрагентомБУ = СчетаУчета.СчетРасчетовПокупателя;
			//Стр.СчетУчетаРасчетовСКонтрагентомНУ = ;
		Иначе
			Стр.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
			//Стр.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
		КонецЕсли;	
		Стр.СчетУчетаРасчетовПоАвансам		= СчетаУчета.СчетАвансовПокупателя;
		Стр.ДоговорКонтрагента				= Док.ДоговорКонтрагента;
		Стр.КратностьВзаиморасчетов			= КурсВалюты.Кратность;
		Стр.КурсВзаиморасчетов				= КурсВалюты.Курс;
		Стр.СтатьяДвиженияДенежныхСредств	= Док.СтатьяДвиженияДенежныхСредств;
		Стр.СуммаПлатежа					= СуммаПКО;
		Док.СуммаДокумента					= Док.СуммаДокумента + Стр.СуммаПлатежа;
		Стр.СуммаВзаиморасчетов				= Окр(СуммаПКО * ?(КурсВалюты.Кратность = 0, 1, КурсВалюты.Кратность) / ?(КурсВалюты.Курс = 0, 1, КурсВалюты.Курс), 2);
		Стр.СуммаВзаиморасчетов = ПересчитатьИзВалютыВВалюту(СуммаПКО, мВалютаРегламентированногоУчета, Док.ДоговорКонтрагента.ВалютаВзаиморасчетов,
			Док.КурсДокумента, КурсВалюты.Курс, Док.КратностьДокумента, КурсВалюты.Кратность);
		СуммаПКО = 0;
	КонецЕсли;                                               

	Реквизиты=СтрЗаменить(СШ.ДопРеквизиты,Символ(30),РазделительСтрок);
	Для Н=1 По СтрЧислоСтрок(Реквизиты) Цикл
		РеквЗнач=СтрЗаменить(СтрПолучитьСтроку(Реквизиты,Н),Символ(31),РазделительСтрок);
		Если СтрЧислоСтрок(РеквЗнач) <> 2 Тогда Продолжить; КонецЕсли;
		
		Ид=СтрПолучитьСтроку(РеквЗнач, 1);
		Значение=СтрПолучитьСтроку(РеквЗнач, 2);
	КонецЦикла;
	
	Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда
		Док.УстановитьНовыйНомер(Док.Организация.Префикс);
	Иначе
		Если НомераИз1С Тогда
		Иначе
			Док.Номер = СШ.Номер;
		КонецЕсли;
	КонецЕсли;
	
	Док.Экспедитор = Док.Ответственный.ФизЛицо;
	
	//запускаем обработку дополнительных реквизитов			
	ОбработатьДопРеквизитыДокумента(Док, СШ.ДопРеквизиты, "18", "0");
	Док.Записать();
	
	Если НомераИз1С И (НЕ ПараметрыАгента.СпособНумерацииДокументов = 0) Тогда
		ДобавитьВЛогФайл("Для документа " + Док + " номер установлен автоматически, и не соответствует номеру с КПК", ТекущийАгент);
	КонецЕсли;
	
	ЗаписатьУникКодДокумента(Док, УникДок);
	//заполнить категории документа
	ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
	//добавить свойство Время работы с документом
	МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект    = Док.ссылка;
	МенеджерЗаписи.Свойство  = ПВХУВремяСозданияДокумента;
	МенеджерЗаписи.Значение  = Строка(СШ.ВремяРаботы);
	МенеджерЗаписи.Записать(Истина);			
	
	ЗаписатьФотоДокумента(Док.Ссылка, СШ.Фото, 18);
	
	МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект    = Док.ссылка;
	МенеджерЗаписи.Свойство  = ПВХФотоДокумента;
	МенеджерЗаписи.Значение  = СШ.Фото;
	МенеджерЗаписи.Записать(Истина);			
	МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект    = Док.ссылка;
	МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
	МенеджерЗаписи.Значение  = СШ.ДатаСоздания;
	МенеджерЗаписи.Записать(Истина);
	
	НомераИз1С = Истина;
	Возврат Док;
КонецФункции

//Разбирает запрос на загрузку ПКО и помещает данные в таблицу шапок
// Адрес - идентификатор сессии обмена
// ТекстЗапроса - строка полученная с КПК
// Агент - для кого выгружаем
Функция ЗагрузитьПКО(Адрес, Платформа, ТекстЗапроса)
	ДобавитьВЛогФайл("Загружаются ПКО", ПараметрыАгента.Агент, 1);
	
	СерверПослатьОтвет(Адрес, "OK" + РазделительСтрок, 0);
	
	ТаблШапок = Новый ТаблицаЗначений;
	ТаблШапок.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблШапок.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблШапок.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблШапок.Колонки.Добавить("ДокументОснование", Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблШапок.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Проводной", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("СуммаПКО", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)));
	ТаблШапок.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"));	
	ТаблШапок.Колонки.Добавить("ВремяРаботы", Новый ОписаниеТипов("Число"));//время работы с документом в минутах	
	ТаблШапок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Задание", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Фото", Новый ОписаниеТипов("Строка"));	
	ТаблШапок.Колонки.Добавить("РН", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	ТаблШапок.Колонки.Добавить("Время", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("АдресДоставки", Новый ОписаниеТипов("Строка"));
	
	ТаблКатегорий = Новый ТаблицаЗначений;
	ПолучитьТаблицуКатегорий(ТаблКатегорий);
	
	СпрОрганизации = Справочники.Организации;
	СпрКл = Справочники.Контрагенты;
	СпрДог = Справочники.ДоговорыКонтрагентов;
	
	Н = 5;
	КолСтр = СтрЧислоСтрок(ТекстЗапроса);
	Пока Н <= КолСтр Цикл
		ТекСтр=СтрПолучитьСтроку(ТекстЗапроса,Н);
		
		НовСтр=ТаблШапок.Добавить();
		ИДДок="";
		КолПарам = СтрЧислоВхождений(ТекСтр,Таб)+1;
		НомПарам = 1;
		Пока НомПарам<=КолПарам Цикл
			Парам="";
			ПозРазд=Найти(ТекСтр,Таб);
			Если ПозРазд<>0 Тогда
				Парам=Лев(ТекСтр,ПозРазд-1);
				ТекСтр=Сред(ТекСтр,ПозРазд+1);
			Иначе
				Парам=ТекСтр;
				ТекСтр="";
			КонецЕсли;
			
			Если НомПарам=1 Тогда
				ДатаВремя = ДатаИзСтрокиСКПК(Парам);
				НовСтр.Время = Сред(Парам,12); 
				НовСтр.Дата  = ДатаВремя;
			ИначеЕсли НомПарам=2 Тогда 
				ИДДок = Парам;
				НовСтр.ИдДок = Парам; 
			ИначеЕсли НомПарам=3 Тогда 
				НовСтр.Номер = Прав(Парам,11); 
			ИначеЕсли НомПарам=4 Тогда
				НайденныйОбъект = Справочники.Организации.НайтиПоКоду(Парам);
				Если НайденныйОбъект.Пустая() Тогда
					ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная организация с кодом " + Парам);
				Иначе	
					НовСтр.Организация = НайденныйОбъект;	
				КонецЕсли;
			ИначеЕсли НомПарам = 5 Тогда
				мКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
				мАдресДоставки = "";
				
				ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
				Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
					ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
					Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
						Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
							ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				
				ПолучитьКонтрагентаИАдресПоКоду(Парам, мКонтрагент, мАдресДоставки, ПапкаРодителя);
				Если мКонтрагент.Пустая() Тогда
					ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестный контрагент с кодом " + Парам);
				Иначе	
					НовСтр.Контрагент = мКонтрагент;	
				КонецЕсли;
			ИначеЕсли НомПарам = 6 Тогда  //договор
				Если ЗначениеЗаполнено(Парам) Тогда
					Договор = ?(ПустаяСтрока(Парам), 
						Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), 
						Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(Парам))));
					Если Договор.Пустая() Тогда
						ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестный договор с кодом " + Парам);
					Иначе	
						НовСтр.Договор = Договор;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НомПарам = 7 Тогда // Документ основание
				Рез=Новый ТаблицаЗначений;
				Рез.Колонки.Добавить("Документ");
				Рез.Колонки.Добавить("Договор");
				Рез.Колонки.Добавить("Организация");
				
				Если Не ПустаяСтрока(Парам) Тогда
					Ссылка=Неопределено;
					Основания=СтрЗаменить(Парам,Символ(31),РазделительСтрок);
					ТипыДокументов = Метаданные.Документы.ПриходныйКассовыйОрдер.ТабличныеЧасти.РасшифровкаПлатежа.Реквизиты.Сделка.Тип.Типы();
					ТипыДоговоров=Метаданные.Документы.ПриходныйКассовыйОрдер.ТабличныеЧасти.РасшифровкаПлатежа.Реквизиты.ДоговорКонтрагента.Тип.Типы();
					Для НомерОснования=1 По СтрЧислоСтрок(Основания) Цикл
						стрДокОснование = рез.Добавить();
						Основание=СтрПолучитьСтроку(Основания,НомерОснования);
						Части=СтрЗаменить(Основание,"_", РазделительСтрок);
						ОснованиеДокумент = СтрПолучитьСтроку(Части,1);
						ОснованиеДоговор = "";
						Если СтрЧислоСтрок(Части)=2 Тогда
							ОснованиеДоговор = СтрПолучитьСтроку(Части,2);
						КонецЕсли;
						стрДокОснование.Документ = Неопределено;
						ИдОсн=Новый УникальныйИдентификатор(ВернутьПробелыGUID(ОснованиеДокумент));
						Для Каждого Тип Из ТипыДокументов Цикл
							ИдТипаДок=Метаданные.НайтиПоТипу(Тип).Имя;
							Ссылка=Документы[ИдТипаДок].ПолучитьСсылку(ИдОсн);
							Если Ссылка.ПолучитьОбъект()=Неопределено Тогда 
								Продолжить; 
							КонецЕсли;
							стрДокОснование.Документ = Ссылка;
							Прервать;
						КонецЦикла;
						Если ЗначениеЗаполнено(стрДокОснование.Документ) Тогда
							Договор = стрДокОснование.Документ.ДоговорКонтрагента;
						КонецЕсли;
						стрДокОснование.Договор = ?(ЗначениеЗаполнено(Договор), Договор,
						?(ПустаяСтрока(ОснованиеДоговор), Справочники.ДоговорыКонтрагентов.ПустаяСсылка(),
						Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(ОснованиеДоговор)))));
						стрДокОснование.Организация = ?(стрДокОснование.Договор.Пустая(), 
							Справочники.Организации.ПустаяСсылка(), 
							стрДокОснование.Договор.Организация);
						Если стрДокОснование.Организация.Пустая() Или стрДокОснование.Договор.Пустая() Тогда
							рез.Удалить(стрДокОснование);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				НовСтр.ДокументОснование = Рез;
			ИначеЕсли НомПарам=8 Тогда
				НовСтр.Комментарий = Парам; 
			ИначеЕсли НомПарам=9 Тогда 
				НовСтр.Проводной = Число(Парам);
			ИначеЕсли НомПарам=10 Тогда 
				НовСтр.СуммаПКО = Число(Парам);
			ИначеЕсли НомПарам=11 Тогда 
				НовСтр.ДатаСоздания=ДатаИзСтрокиСКПК(Парам);
			ИначеЕсли НомПарам=12 Тогда 
				НовСтр.ВремяРаботы  = Число(Парам);
			ИначеЕсли НомПарам=13 Тогда 
				НовСтр.ДопРеквизиты = Парам;
			ИначеЕсли НомПарам=14 Тогда 
				НовСтр.Задание = Парам;
			ИначеЕсли НомПарам=15 Тогда 
				НовСтр.Фото = СтрЗаменить(Парам, Символ(31), РазделительСтрок);
			ИначеЕсли НомПарам=16 Тогда
//				ДобавитьВЛогФайл("Неверный формат шапки ПКО",ПараметрыАгента.Агент,0);
//				Возврат Ложь;
			КонецЕсли;
			
			НомПарам=НомПарам+1;
		КонецЦикла;
		//заполнить таблицу категорий
		Н = Н + 1;
		ТекСтр = СтрПолучитьСтроку(ТекстЗапроса,Н);
		Пока ТекСтр<>"" Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр,Таб);
			Если ПозРазд<>0 Тогда
				Парам  = Лев(ТекСтр,ПозРазд-1);
				ТекСтр = Сред(ТекСтр,ПозРазд+1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			НайденныйОбъект = НайтиОбъектКатегория(Парам);
			Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
				НовСтр = ТаблКатегорий.Добавить();
		        НовСтр.ИдДок = ИдДок;
    			НовСтр.Категория = НайденныйОбъект;
			КонецЕсли; 
		КонецЦикла;
		Н=Н+1;
	КонецЦикла;
	// Создаём Приходные кассовые ордера
	ТаблПользователей = ПрочитатьПользователейДляОповещения(ПараметрыАгента.Агент); //это Табл значений
	
	ДобавитьВЛогФайл("Формируются ПКО...", ПараметрыАгента.Агент, 1);
	
	СуммаПлатежаПоСтроке = 0;
	ТекДата = ТекущаяДата();
	НомераИз1С = Ложь;
	
	Для Каждого СтрШапки Из ТаблШапок Цикл
		Если СтрШапки.СуммаПКО <=0 Тогда 
			Продолжить; 
		КонецЕсли;
		УникДок = СформироватьУникальныйКодДокумента("ПКО", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес, Ответ, 0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		НомераИз1С = Ложь;
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			НачатьТранзакцию();
			глПоследняяОшибкаПроведения = "";
			нетОшибок = Истина;
			Попытка
				СуммаПКО = СтрШапки.СуммаПКО;
				Если ПараметрыАгента.ВалютаКПК <> мВалютаРегламентированногоУчета Тогда
					СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(
						ДатаИзДатаИВремя(СтрШапки.Дата, ТекущаяДата()), Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
					СуммаПКО = ПересчитатьИзВалютыВВалюту(СтрШапки.СуммаПКО,
						ПараметрыАгента.ВалютаКПК, мВалютаРегламентированногоУчета,
						СтруктураВалютаКПК.Курс, 1,
						СтруктураВалютаКПК.Кратность, 1);
					КонецЕсли;
					
				ТабДок = Новый ТаблицаЗначений;
				ТабДок.Колонки.Добавить("Док", Новый ОписаниеТипов("ДокументОбъект.ПриходныйКассовыйОрдер"));
				Док = Неопределено;
				
				СтрокиНаУдаление = СтрШапки.ДокументОснование.НайтиСтроки(Новый Структура("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка()));
				Для Каждого Стр Из СтрокиНаУдаление Цикл
					СтрШапки.ДокументОснование.Удалить(Стр);
				КонецЦикла;
				тзОрганизации = СтрШапки.ДокументОснование.Скопировать();
				тзОрганизации.Свернуть("Организация");
				Для каждого СтрОрганизация из тзОрганизации Цикл
					ТабОснования = СтрШапки.ДокументОснование.Скопировать(СтрШапки.ДокументОснование.НайтиСтроки(
						Новый Структура("Организация", СтрОрганизация.Организация)));
					Док = СоздатьДокументПКО(Адрес, СтрШапки, СуммаПКО, УникДок, ТаблКатегорий, ТаблПользователей, ТабОснования, НомераИз1С);
					СтрТабДок = ТабДок.Добавить();
					СтрТабДок.Док = Док;
				КонецЦикла;
				//здесь завершена обработка по организациям
				
				//Если осталось невостребованное ПКО, то оформим и его, если указан договор - то на договор иначе на основной по контрагенту								
				Если СуммаПКО > 0 Тогда
					Док = СоздатьДокументПКО(
						Адрес, СтрШапки, СуммаПКО, УникДок, ТаблКатегорий, ТаблПользователей, Новый ТаблицаЗначений(), НомераИз1С);
					Если Док.СуммаДокумента > 0 Тогда
						СтрТабДок = ТабДок.Добавить();
						СтрТабДок.Док = Док;
					КонецЕсли;
				КонецЕсли;
				
				ЗавершитьСобытие(Адрес, Платформа, "ПКО", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				
				Если ПараметрыАгента.ПроводитьПКО Тогда
					Для Каждого Стр Из ТабДок Цикл
						ТекстСтатуса = " (не проведен)";
						Стр.Док.Записать(РежимЗаписиДокумента.Проведение);
						ТекстСтатуса = " (проведен)";
					КонецЦикла;
				КонецЕсли;
				
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ЗафиксироватьТранзакцию();
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
			Если нетОшибок Тогда
			Иначе
				ОтменитьТранзакцию();
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ ПКО не создан"; 
					Если ПараметрыАгента.ПроводитьПКО Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Для контрагента " + Док.Контрагент + " не найден договор с покупателем";
					СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл("Ошибка создания документа ПКО: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СерверПослатьОтвет(Адрес, РазделительСтрок, 1);
	Возврат истина;
	
КонецФункции

// Создаёт таблицы шапок и строк документов, загружаемых с КПК
// Параметры:
// 		ТелоЗапроса - Строка, текст запроса, поступившего с КПК
// 		НачСтр - Число, номер строки, начиная с которой идут данные о документе
// 		ТаблШапок - ТаблицаЗначений, сюда возвращается таблица со всеми реквизитами шапок
// 			загруженных документов в соответствии с протоколом обмена
// 		ТаблСтрок - ТаблицаЗначений, сюда возвращается таблица со всеми реквизитами строк
// 			загруженных документов в соответствии с протоколом обмена
// 		ТаблКатегорий - ТаблицаЗначений, сюда возвращается таблица со всеми значениями категорий
// 			загруженных документов в соответствии с протоколом обмена
// Возвращаемое значение:
// 		Истина - успешная загрузка
// 		Ложь - ошибка
Функция ПолучитьТаблицыНакладных(ТелоЗапроса, НачСтр, ТаблШапок, ТаблСтрок, ТаблКатегорий)
	ТаблШапок = Новый ТаблицаЗначений;
	ТаблШапок.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ТаблШапок.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблШапок.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблШапок.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблШапок.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблШапок.Колонки.Добавить("Самовывоз", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ТипЦены", Новый ОписаниеТипов("СправочникСсылка.ТипыЦенНоменклатуры"));
	ТаблШапок.Колонки.Добавить("Проводной", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("СуммаПКО", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("ВремяДоставки", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("Скидка", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("РН", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	ТаблШапок.Колонки.Добавить("Время", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Форма", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата")); //Дата и время создания документа
	ТаблШапок.Колонки.Добавить("ВремяРаботы", Новый ОписаниеТипов("Число"));//время работы с документом в минутах
	ТаблШапок.Колонки.Добавить("Задание", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("АдресДоставки", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ИдКонтрагента", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(32, ДопустимаяДлина.Переменная)));
	ТаблШапок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Фото", Новый ОписаниеТипов("Строка"));
	
	ТаблСтрок = СоздатьТаблицуСтрокРН();
	//
	ВремТаблСтрок = ТаблСтрок.Скопировать();
	//
	ПолучитьТаблицуКатегорий(ТаблКатегорий);

	Н = НачСтр;
	КолСтр = СтрЧислоСтрок(ТелоЗапроса);
	Пока Н <= КолСтр Цикл
		ТекСтр=СтрПолучитьСтроку(ТелоЗапроса, Н);
		НовСтр	 = ТаблШапок.Добавить();
		ИДДок    = "";
		КолПарам = СтрЧислоВхождений(ТекСтр, Таб) + 1;
		НомПарам = 1;
		Пока НомПарам <= КолПарам Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр, Таб);
			Если ПозРазд <> 0 Тогда
				Парам  = Лев(ТекСтр,ПозРазд - 1);
				ТекСтр = Сред(ТекСтр,ПозРазд + 1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			
			Если НомПарам = 1 Тогда 
				ДатаВремя = ДатаИзСтрокиСКПК(Парам);
				НовСтр.Время = Сред(Парам, 12); 
				НовСтр.Дата  = ДатаВремя;
			ИначеЕсли НомПарам = 2 Тогда 
				ИдДок = Парам;
				НовСтр.ИдДок = Парам; 
			ИначеЕсли НомПарам = 3 Тогда 
				НовСтр.Номер = Прав(Парам, 11); 
			ИначеЕсли НомПарам = 4 Тогда  //организация
				НайденныйОбъект = Справочники.Организации.НайтиПоКоду(Парам);
				Если НайденныйОбъект.Пустая() Тогда
					ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная организация с кодом " + Парам);
				Иначе	
					НовСтр.Организация = НайденныйОбъект;	
				КонецЕсли;
			ИначеЕсли НомПарам = 5 Тогда //контрагент
				НовСтр.ИдКонтрагента = Парам; //уникальный код контрагента для хранения остатков
				мКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
				мАдресДоставки = "";
				
				ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
				Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
					ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
					Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
						Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
							ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				ПолучитьКонтрагентаИАдресПоКоду(Парам, мКонтрагент, мАдресДоставки, ПапкаРодителя);
				Если мКонтрагент.Пустая() Тогда
					ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестный контрагент с кодом " + Парам);
				Иначе	
					НовСтр.Контрагент		= мКонтрагент;
					НовСтр.АдресДоставки	= мАдресДоставки;
				КонецЕсли;
			ИначеЕсли НомПарам = 6 Тогда  //договор
				Если ЗначениеЗаполнено(Парам) Тогда
					Договор = ?(ПустаяСтрока(Парам), 
						Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), 
						Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(Парам))));
					Если Договор.Пустая() Тогда
						ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестный договор с кодом " + Парам);
					Иначе	
						НовСтр.Договор = Договор;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НомПарам = 7 Тогда  //Склад
				НайденныйОбъект = ПолучитьСсылкуПоGUID(Парам,"Склады");
				НовСтр.Склад = НайденныйОбъект;
				
			ИначеЕсли НомПарам = 8 Тогда  //Самовывоз
				НовСтр.Самовывоз = ПолучитьЧислоИзСтроки(Парам);
				
			ИначеЕсли НомПарам = 9 Тогда //комментарий
				НовСтр.Комментарий = Парам; 
				
			ИначеЕсли НомПарам = 10 Тогда  //тип цен 
				НайденныйОбъект = ПолучитьСсылкуПоGUID(Парам,"ТипыЦенНоменклатуры");
				Если НайденныйОбъект.Пустая() Тогда
					ДобавитьОшибку(
						"Загрузка накладной "+ИдДок+".Неизвестный тип цен с кодом "+Парам 
						+ ". Будет использован тип цен по умолчанию");
					НовСтр.ТипЦены = ПараметрыАгента.ТипЦенПоУмолчанию;
				Иначе
					НовСтр.ТипЦены = НайденныйОбъект;
				КонецЕсли;
				
			ИначеЕсли НомПарам = 11 Тогда //Проводной
				НовСтр.Проводной = ПолучитьЧислоИзСтроки(Парам);
				
			ИначеЕсли НомПарам = 12 Тогда //СуммаПКО
				НовСтр.СуммаПКО = ПолучитьЧислоИзСтроки(Парам);
				
			ИначеЕсли НомПарам = 13 Тогда  //ВремяДоставки
				Если НЕ ПустаяСтрока(Парам) Тогда
					НовСтр.ВремяДоставки = ДатаИзСтрокиСКПК(Парам);
				КонецЕсли;
			ИначеЕсли НомПарам = 14 Тогда //Скидка
				Если ПустаяСтрока(Парам) = 0 Тогда
					НовСтр.Скидка = Число(Парам);
				Иначе
					НовСтр.Скидка = 0;
				КонецЕсли;
			ИначеЕсли НомПарам = 15 Тогда //Форма
				НовСтр.Форма   = Парам;
			ИначеЕсли НомПарам = 16 Тогда //Ответ
				НовСтр.Ответ   = Парам;
			ИначеЕсли НомПарам = 17 Тогда //Дата создания документа
				НовСтр.ДатаСоздания = ДатаИзСтрокиСКПК(Парам);
			ИначеЕсли НомПарам = 18 Тогда //Время работы с документом
				НовСтр.ВремяРаботы = Окр(Число(Парам)/60,0,РежимОкругления.Окр15как20);
			ИначеЕсли НомПарам = 19 Тогда //Доп реквизиты
				НовСтр.ДопРеквизиты  = Парам;
			ИначеЕсли НомПарам = 20 Тогда //Задание
				НовСтр.Задание  = Парам;
			ИначеЕсли НомПарам = 21 Тогда //Фото
				НовСтр.Фото  = СтрЗаменить(Парам, Символ(31), РазделительСтрок);
			Иначе
				//ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неверный формат шапки накладной");
				//Возврат Ложь;
			КонецЕсли;
			
			НомПарам = НомПарам + 1;
		КонецЦикла;
		
		//заполнить таблицу категорий
		Н = Н + 1;
		ТекСтр = СтрПолучитьСтроку(ТелоЗапроса, Н);
		Пока ТекСтр <> "" Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр, Таб);
			Если ПозРазд <> 0 Тогда
				Парам  = Лев(ТекСтр, ПозРазд - 1);
				ТекСтр = Сред(ТекСтр, ПозРазд + 1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			НайденныйОбъект = НайтиОбъектКатегория(Парам);
			Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
				НовСтр = ТаблКатегорий.Добавить();
		        НовСтр.ИдДок = ИдДок;
    			НовСтр.Категория = НайденныйОбъект;
			КонецЕсли; 
        КонецЦикла;
			
		Пока Истина Цикл
			Н = Н + 1;
			Если Н > КолСтр Тогда 
				Прервать; 
			КонецЕсли;
			
			ТекСтр = СтрПолучитьСтроку(ТелоЗапроса, Н);
			Если ТекСтр = "" Тогда 
				Прервать; 
			КонецЕсли;
			
			НовСтр = ВремТаблСтрок.Добавить();
			НовСтр.ИдДок = ИдДок;
			ТекНоменклатура = "";
			КолПарам = СтрЧислоВхождений(ТекСтр, Таб) + 1;
			НомПарам = 1;
			Пока НомПарам <= КолПарам Цикл

				Парам = "";
				ПозицияТаб = Найти(ТекСтр, Таб);
				Если ПозицияТаб <> 0 Тогда
					Парам  = Лев(ТекСтр, ПозицияТаб - 1);
					ТекСтр = Сред(ТекСтр, ПозицияТаб + 1);
				Иначе
					Парам  = ТекСтр;
					ТекСтр = "";
				КонецЕсли;
				
				Если НомПарам = 1 Тогда   //Номенклатура
					НовСтр.Партия = "";
					Если Конфигурация = "БухБеларусь" Тогда
						ПарамНом = СтрЗаменить(Парам, "#", Символы.ПС);
						спрНом = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(ПарамНом,1), "Номенклатура");
						Если СтрЧислоСтрок(ПарамНом) =2 Тогда
							НовСтр.Партия = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(ПарамНом,2), "Партии");
							Если спрНом = Справочники.Партии.ПустаяСсылка() Тогда
								ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная партия номенклатуры с кодом " + СтрПолучитьСтроку(ПарамНом,2));
							КонецЕсли;
						КонецЕсли;
					Иначе
						спрНом = ПолучитьСсылкуПоGUID(Парам, "Номенклатура");
					КонецЕсли;
					Если спрНом = Справочники.Номенклатура.ПустаяСсылка() Тогда
						ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная номенклатура с кодом " + СтрПолучитьСтроку(ПарамНом,1));
					Иначе	
						НовСтр.Номенклатура = спрНом;
					КонецЕсли;
					ТекНоменклатура = Парам;
				ИначеЕсли НомПарам = 2 Тогда //количество
					НовСтр.Колво = ПолучитьЧислоИзСтроки(Парам);
					
				ИначеЕсли НомПарам = 3 Тогда  //Единица
					НайденныйОбъект = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(Парам);
					Если НайденныйОбъект.Пустая() Тогда
						ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная единица номенклатуры " + ТекНоменклатура + " с кодом ");
					Иначе	
						НовСтр.Единица = НайденныйОбъект;
					КонецЕсли;
					
				ИначеЕсли НомПарам = 4 Тогда  //Коэффициент
					НовСтр.Коэффициент = ПолучитьЧислоИзСтроки(Парам);
					
				ИначеЕсли НомПарам = 5 Тогда  //Склад
					НайденныйОбъект = ПолучитьСсылкуПоGUID(Парам,"Склады");
					НовСтр.Склад = НайденныйОбъект;
					
				ИначеЕсли НомПарам = 6 Тогда  //Цена
					НовСтр.Цена = ПолучитьЧислоИзСтроки(Парам);
					
				ИначеЕсли НомПарам = 7 Тогда  //Сумма
					НовСтр.Сумма = ПолучитьЧислоИзСтроки(Парам);
					
				ИначеЕсли НомПарам = 8 Тогда //Остаток
					Если ЗначениеЗаполнено(Парам) Тогда
					     НовСтр.Остаток = ПолучитьЧислоИзСтроки(Парам);
					Иначе
						 НовСтр.Остаток = -1; //не задан остаток 
					КонецЕсли; 
					
				ИначеЕсли НомПарам = 9 Тогда //Форма
					НовСтр.Форма   = Парам;
					
				ИначеЕсли НомПарам = 10 Тогда //Ответ
					НовСтр.Ответ   = Парам;
					
				ИначеЕсли НомПарам = 11 Тогда //Бонус
					НовСтр.Бонус   = Парам;
					
				ИначеЕсли НомПарам = 12 Тогда //Фейсинг
					Если ЗначениеЗаполнено(Парам) Тогда
					     НовСтр.Фейсинг = ПолучитьЧислоИзСтроки(Парам);
					Иначе
						 НовСтр.Фейсинг = -1; //не задан ;
					КонецЕсли; 
				ИначеЕсли НомПарам = 13 Тогда //Реквизиты
					НовСтр.ДопРеквизиты  = Парам;
				Иначе
					//ДобавитьОшибку("Неверный формат таблицы накладной");
					//Возврат Ложь;
				КонецЕсли;
				
				НомПарам = НомПарам + 1;
			КонецЦикла;

		КонецЦикла;
		
		Н = Н + 1;
	КонецЦикла;

	Для Каждого ТекСтр Из ВремТаблСтрок Цикл
		НовСтр = ТаблСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр);
		//Для бонусов текущую строку разобьем на 2 
		Если (ПараметрыАгента.СпособПредоставленияБонусов <> 2) И (ТекСтр.Бонус <> 0) Тогда
			НовСтр.Бонус = 0;
			НовСтр = ТаблСтрок.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр);
			НовСтр.Колво = ТекСтр.Бонус;
			НовСтр.Форма = "";
			НовСтр.Ответ = "";
			Если ПараметрыАгента.СпособПредоставленияБонусов = 0 Тогда  //по нулевой цене
				НовСтр.Цена = 0;
			КонецЕсли; 
			НовСтр.Сумма = НовСтр.Колво * НовСтр.Цена;
			НовСтр.Остаток = ТекСтр.Остаток;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Н;
КонецФункции

// Разбирает запрос на загрузку накладной и помещает данные в таблицы шапок и строк
// Адрес - идентификатор сессии обмена
// ТелоЗапроса - Текст полученный от КПК 
Функция ЗагрузитьРасходныеНакладные(Адрес, Платформа, ТелоЗапроса, ВидДок)
	ТекстДок = "Счет на оплату покупателю";
	Если ВидДок = 0 Тогда
		ТекстДок = ?(ПараметрыАгента.ТипСоздаваемогоДокумента = 0, "Реализация ТМЗ и услуг", "Акт об оказании производственных услуг");
	КонецЕсли;
	Если НЕ ПорцияОбмена(Адрес, "OK", "Загружается """ + ТекстДок + """...") Тогда
		Возврат ложь;
	КонецЕсли; 
	
	ТаблШапок=""; ТаблСтрок=""; ТаблКатегорий="";
	ПолучитьТаблицыНакладных(ТелоЗапроса, 5, ТаблШапок, ТаблСтрок, ТаблКатегорий);	
	
	//Проверим есть ли Остатки и загрузим их во внешнююБД
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ТаблКонтр.ИдКонтрагента КАК СТРОКА(32)) КАК ИдКонтрагента,
	|	ТаблКонтр.Дата КАК Дата,
	|	ВЫРАЗИТЬ(ТаблКонтр.Время КАК СТРОКА(8)) КАК Время,
	|	ВЫРАЗИТЬ(ТаблКонтр.ИдДок КАК ЧИСЛО(10, 0)) КАК ИдДок
	|ПОМЕСТИТЬ ВремКонтр
	|ИЗ
	|	&ТаблКонтр КАК ТаблКонтр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблНом.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТаблНом.Остаток * ТаблНом.Коэффициент КАК Остаток,
	|	ТаблНом.Фейсинг * ТаблНом.Коэффициент КАК Фейсинг,
	|	ВЫРАЗИТЬ(ТаблНом.ИдДок КАК ЧИСЛО(10, 0)) КАК ИдДок
	|ПОМЕСТИТЬ ВремНом
	|ИЗ
	|	&ТаблНом КАК ТаблНом
	|ГДЕ
	|	(ТаблНом.Остаток >= 0
	|			ИЛИ ТаблНом.Фейсинг >= 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремКонтр.ИдКонтрагента,
	|	ВремНом.Номенклатура,
	|	ВремКонтр.Дата,
	|	МИНИМУМ(ВремКонтр.Время) КАК Время,
	|	МИНИМУМ(ВремНом.Остаток) КАК Остаток,
	|	МИНИМУМ(ВремНом.Фейсинг) КАК Фейсинг
	|ИЗ
	|	ВремКонтр КАК ВремКонтр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремНом КАК ВремНом
	|		ПО ВремКонтр.ИдДок = ВремНом.ИдДок
	|
	|СГРУППИРОВАТЬ ПО
	|	ВремКонтр.ИдКонтрагента,
	|	ВремНом.Номенклатура,
	|	ВремКонтр.Дата,
	|	ВремКонтр.Время";
	Запрос.УстановитьПараметр("ТаблНом"  ,ТаблСтрок);
	Запрос.УстановитьПараметр("ТаблКонтр",ТаблШапок);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		Блокировщик = Неопределено;
		БД = ОткрытьВнешнююБД(Блокировщик, Истина);
		Если БД = Ложь Тогда
			Сообщить(ОшибкаНетДоступаКВнешнейБД, СтатусСообщения.Важное);
		Иначе
			ТекстЗапросаОбновить="
				|Update OSTATKI Set OSTATOK = ?, FACING = ?, AGENT = ?
				|where (KONTRAGENT = ? and NOMENKLATURA = ? and DATA = ?)
				|";
			ПодгЗапросОбновить=БДПодготовитьЗапрос(БД, ТекстЗапросаОбновить);
			
			ТекстЗапросаСчетчик="
				|SELECT changes()";
			ПодгЗапросСчетчик=БДПодготовитьЗапрос(БД, ТекстЗапросаСчетчик);
			
			ТекстЗапросаДобавить="
				|Insert into OSTATKI ([OSTATOK], [FACING], [Agent], [KONTRAGENT], [NOMENKLATURA], [DATA])
				|    Values(?, ?, ?, ?, ?, ?)";
			ПодгЗапросДобавить=БДПодготовитьЗапрос(БД, ТекстЗапросаДобавить);
			
			ИдАгента = СокрЛП(УникИдентификатор(ПараметрыАгента.Агент));			
			БДУстановитьПараметр(ПодгЗапросОбновить, 3, ИдАгента);
			БДУстановитьПараметр( ПодгЗапросДобавить, 3, ИдАгента);
			
			КолвоЗаписей = 0;
			ИдНом = "";
			
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
										
					ТекДата = НачалоДня(Выборка.Дата);
					
					Попытка            
						ИдНом = УникИдентификатор(Выборка.Номенклатура);
						
						БДУстановитьПараметр(ПодгЗапросОбновить, 1, Выборка.Остаток);
						БДУстановитьПараметр(ПодгЗапросОбновить, 2, Выборка.Фейсинг);
						БДУстановитьПараметр(ПодгЗапросОбновить, 4, СокрЛП(Выборка.ИдКонтрагента));
						БДУстановитьПараметр(ПодгЗапросОбновить, 5, ИдНом);
						БДУстановитьПараметр(ПодгЗапросОбновить, 6, ДатаДляSQLite(ТекДата));
						БДСледующаяЗапись(ПодгЗапросОбновить);
						БДСбросПодготовленногоЗапроса(ПодгЗапросОбновить);
						
						БДСледующаяЗапись(ПодгЗапросСчетчик);
						
						Если БДЗначениеВКолонке(ПодгЗапросСчетчик, 0)=0 Тогда //Не обновилось, тогда добавим
							БДУстановитьПараметр(ПодгЗапросДобавить, 1, Выборка.Остаток);
							БДУстановитьПараметр(ПодгЗапросДобавить, 2, Выборка.Фейсинг);
							БДУстановитьПараметр(ПодгЗапросДобавить, 4, СокрЛП(Выборка.ИдКонтрагента));
							БДУстановитьПараметр(ПодгЗапросДобавить, 5, ИдНом);
							БДУстановитьПараметр(ПодгЗапросДобавить, 6, ДатаДляSQLite(ТекДата));
							БДСледующаяЗапись(ПодгЗапросДобавить);
							БДСбросПодготовленногоЗапроса(ПодгЗапросДобавить);
						КонецЕсли; 
						БДСбросПодготовленногоЗапроса(ПодгЗапросСчетчик);

					Исключение
						Ошибка=ОписаниеОшибки();
						ДобавитьВЛогФайл(" Ошибка при записи остатков "+РазделительСтрок+Ошибка,0);
						Если ТехПоддержкаАвтоматическаяОтправка Тогда 
							ОтправитьОшибкуВТехподдержку(ПараметрыАгента.Агент, "Работа с остатками"+ РазделительСтрок + Ошибка); 
						КонецЕсли;
					КонецПопытки;
				КонецЕсли; 
			КонецЦикла; 
			
			БДЗакрытьПодготовленныйЗапрос(ПодгЗапросОбновить);
			БДЗакрытьПодготовленныйЗапрос(ПодгЗапросСчетчик);
			БДЗакрытьПодготовленныйЗапрос(ПодгЗапросДобавить);
			
			ЗакрытьВнешнююБД(БД, Блокировщик);
		КонецЕсли; 
	КонецЕсли; 
	
	ТаблПользователей = ПрочитатьПользователейДляОповещения(ПараметрыАгента.Агент); //это Табл значений
	Если ВидДок = 0 Тогда
		Если ПараметрыАгента.ТипСоздаваемогоДокумента = 0 Тогда
			СоздатьРеализациюТоваровИУслуг(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
		Иначе //Если ПараметрыАгента.ТипСоздаваемогоДокумента = 1 Тогда
			СоздатьАктОбОказанииПроизводственныхУслуг(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
		КонецЕсли;
	Иначе
		СоздатьСчетНаОплату(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Разбирает запрос на загрузку накладной и помещает данные в таблицы шапок и строк
// Адрес - идентификатор сессии обмена
// ТелоЗапроса - Текст полученный от КПК 
Функция ЗагрузитьПриходныеНакладные(Адрес, Платформа, ТелоЗапроса)
	Если НЕ ПорцияОбмена(Адрес,"OK","Загружаются покупки...") Тогда
		возврат ложь;
	КонецЕсли; 
	
	ТаблШапок = Новый ТаблицаЗначений;
	ТаблШапок.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблШапок.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблШапок.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблШапок.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблШапок.Колонки.Добавить("ТипЦены", Новый ОписаниеТипов("СправочникСсылка.ТипыЦенНоменклатуры"));
	ТаблШапок.Колонки.Добавить("Скидка", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Проводной", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("Докум", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваровУслуг"));
	ТаблШапок.Колонки.Добавить("Время", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ВремяРаботы", Новый ОписаниеТипов("Число"));//время работы с документом в минутах	
	ТаблШапок.Колонки.Добавить("Форма", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Задание", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Фото", Новый ОписаниеТипов("Строка"));
	
	ТаблСтрок = СоздатьТаблицуСтрокРН();
	
	ТаблКатегорий = Новый ТаблицаЗначений;
	ПолучитьТаблицуКатегорий(ТаблКатегорий);

	Н=5;
	КолСтр=СтрЧислоСтрок(ТелоЗапроса);	
	Пока Н <= КолСтр Цикл
		ТекСтр=СтрПолучитьСтроку(ТелоЗапроса,Н);
		НовСтр	 = ТаблШапок.Добавить();
		ИДДок    = "";
		КолПарам = СтрЧислоВхождений(ТекСтр,Таб)+1;
		НомПарам = 1;
		Пока НомПарам<=КолПарам Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр,Таб);
			Если ПозРазд<>0 Тогда
				Парам  = Лев(ТекСтр,ПозРазд-1);
				ТекСтр = Сред(ТекСтр,ПозРазд+1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			
			Если НомПарам = 1 Тогда  //Дата
				ДатаВремя = ДатаИзСтрокиСКПК(Парам);
				НовСтр.Время = Сред(Парам,12); 
				НовСтр.Дата  = ДатаВремя;
			ИначеЕсли НомПарам = 2 Тогда  //ИдДок-уникальный номер документа
				ИдДок = Парам;
				НовСтр.ИдДок = Парам; 
			ИначеЕсли НомПарам = 3 Тогда   //номерДокумента
				НовСтр.Номер = Прав(Парам,11); 
			ИначеЕсли НомПарам = 4 Тогда  //организация
				НайденныйОбъект = Справочники.Организации.НайтиПоКоду(Парам);
				Если НайденныйОбъект.Пустая() Тогда
					ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная организация с кодом " + Парам);
				Иначе	
					НовСтр.Организация = НайденныйОбъект;	
				КонецЕсли;
			ИначеЕсли НомПарам = 5 Тогда //контрагент
				мКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
				мАдресДоставки = "";
				
				ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
				Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
					ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
					Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
						Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
							ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				ПолучитьКонтрагентаИАдресПоКоду(Парам, мКонтрагент, мАдресДоставки, ПапкаРодителя);
				Если мКонтрагент.Пустая() Тогда
					ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестный контрагент с кодом " + Парам);
				Иначе	
					НовСтр.Контрагент = мКонтрагент;	
				КонецЕсли;
			ИначеЕсли НомПарам = 6 Тогда  //договор
				Если ЗначениеЗаполнено(Парам) Тогда
					Договор = ?(ПустаяСтрока(Парам), 
						Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), 
						Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(Парам))));
					Если Договор.Пустая() Тогда
						ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестный договор с кодом " + Парам);
					Иначе	
						НовСтр.Договор = Договор;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НомПарам = 7 Тогда  //Склад
				НайденныйОбъект = ПолучитьСсылкуПоGUID(Парам,"Склады");
				НовСтр.Склад = НайденныйОбъект;
			ИначеЕсли НомПарам = 8 Тогда  //тип цен 
				НайденныйОбъект = ПолучитьСсылкуПоGUID(Парам,"ТипыЦенНоменклатуры");
				Если НайденныйОбъект.Пустая() Тогда
					ДобавитьОшибку(
						"Загрузка накладной " + ИдДок + ".Неизвестный тип цен с кодом " + Парам + ". Будет использован тип цен по умолчанию");
					НовСтр.ТипЦены = ПараметрыАгента.ТипЦенПоУмолчанию;
				Иначе
					НовСтр.ТипЦены = НайденныйОбъект;
				КонецЕсли;
			ИначеЕсли НомПарам = 9 Тогда //комментарий
				НовСтр.Комментарий = Парам; 
			ИначеЕсли НомПарам = 10 Тогда //Проводной
				НовСтр.Проводной = ПолучитьЧислоИзСтроки(Парам);
			ИначеЕсли НомПарам = 11 Тогда
				НовСтр.ДатаСоздания = ДатаИзСтрокиСКПК(Парам);				
			ИначеЕсли НомПарам = 12 Тогда
				НовСтр.ВремяРаботы  = Число(Парам);
			ИначеЕсли НомПарам = 13 Тогда
				Если ПустаяСтрока(Парам)=0 Тогда
					НовСтр.Скидка   = Число(Парам);
				Иначе
					НовСтр.Скидка = 0;
				КонецЕсли;
			ИначеЕсли НомПарам = 14 Тогда
				НовСтр.Форма   = Парам;
			ИначеЕсли НомПарам = 15 Тогда
				НовСтр.Ответ   = Парам;
			ИначеЕсли НомПарам = 16 Тогда
				НовСтр.ДопРеквизиты   = Парам;
			ИначеЕсли НомПарам = 17 Тогда
				НовСтр.Задание = Парам;
			ИначеЕсли НомПарам = 18 Тогда
				НовСтр.Фото = СтрЗаменить(Парам,Символ(31),РазделительСтрок);
			Иначе
//				ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неверный формат шапки накладной");
//				Возврат Ложь;
			КонецЕсли;
			НомПарам = НомПарам + 1;
		КонецЦикла;
		//заполнить таблицу категорий
		Н = Н + 1;
		ТекСтр=СтрПолучитьСтроку(ТелоЗапроса,Н);
		Пока ТекСтр<>"" Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр,Таб);
			Если ПозРазд<>0 Тогда
				Парам  = Лев(ТекСтр,ПозРазд-1);
				ТекСтр = Сред(ТекСтр,ПозРазд+1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			НайденныйОбъект = НайтиОбъектКатегория(Парам);
			Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
				НовСтр = ТаблКатегорий.Добавить();
		        НовСтр.ИдДок = ИдДок;
    			НовСтр.Категория = НайденныйОбъект;
			КонецЕсли; 
		КонецЦикла;
		
		Пока Истина Цикл
			Н = Н + 1;
			Если Н > КолСтр Тогда 
				Прервать; 
			КонецЕсли;
			ТекСтр = СтрПолучитьСтроку(ТелоЗапроса,Н);
			Если ТекСтр = "" Тогда 
				Прервать; 
			КонецЕсли;
			
			НовСтр = ТаблСтрок.Добавить();
			НовСтр.ИдДок = ИдДок;
			ТекНоменклатура = "";
			КолПарам = СтрЧислоВхождений(ТекСтр,Таб)+1;
			НомПарам = 1;
			Пока НомПарам<=КолПарам Цикл
				Парам = "";
				ПозицияТаб = Найти(ТекСтр,Таб);
				Если ПозицияТаб <> 0 Тогда
					Парам  = Лев(ТекСтр,ПозицияТаб-1);
					ТекСтр = Сред(ТекСтр,ПозицияТаб+1);
				Иначе
					Парам  = ТекСтр;
					ТекСтр = "";
				КонецЕсли;
				Если НомПарам = 1 Тогда   //Номенклатура
					НовСтр.Партия = "";
					Если Конфигурация = "БухБеларусь" Тогда
						ПарамНом = СтрЗаменить(Парам, "#", Символы.ПС);
						спрНом = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(ПарамНом,1), "Номенклатура");
						Если СтрЧислоСтрок(ПарамНом) =2 Тогда
							НовСтр.Партия = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(ПарамНом,2), "Партии");
							Если спрНом = Справочники.Партии.ПустаяСсылка() Тогда
								ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная партия номенклатуры с кодом " + Парам);
							КонецЕсли;
						КонецЕсли;
					Иначе
						спрНом = ПолучитьСсылкуПоGUID(Парам, "Номенклатура");
					КонецЕсли;
					Если спрНом = Справочники.Номенклатура.ПустаяСсылка() Тогда
						ДобавитьОшибку("Загрузка накладной " + ИдДок + ".Неизвестная номенклатура с кодом " + Парам);
					Иначе	
						НовСтр.Номенклатура = спрНом;
					КонецЕсли;
					ТекНоменклатура = Парам;
				ИначеЕсли НомПарам = 2 Тогда //количество
					НовСтр.Колво = ПолучитьЧислоИзСтроки(Парам);
				ИначеЕсли НомПарам = 3 Тогда  //Единица
					НайденныйОбъект = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(Парам);
					Если НайденныйОбъект.Пустая() Тогда
						ДобавитьОшибку("Загрузка накладной "+ИдДок+". Неизвестная единица номенклатуры "+ТекНоменклатура+" с кодом ");
					Иначе	
						НовСтр.Единица = НайденныйОбъект;
					КонецЕсли;
				ИначеЕсли НомПарам = 4 Тогда  //Коэффициент
					НовСтр.Коэффициент = ПолучитьЧислоИзСтроки(Парам);
				ИначеЕсли НомПарам = 5 Тогда  //Склад
					НайденныйОбъект = ПолучитьСсылкуПоGUID(Парам ,"Склады");
					НовСтр.Склад = НайденныйОбъект;
				ИначеЕсли НомПарам = 6 Тогда  //Цена
					НовСтр.Цена = ПолучитьЧислоИзСтроки(Парам);
				ИначеЕсли НомПарам = 7 Тогда  //Сумма
					НовСтр.Сумма = ПолучитьЧислоИзСтроки(Парам);
				ИначеЕсли НомПарам = 8 Тогда  //ДопРеквизиты
					НовСтр.ДопРеквизиты = Парам;
				Иначе
					//ДобавитьОшибку("Неверный формат таблицы накладной");
					//Возврат Ложь;
				КонецЕсли;
				НомПарам = НомПарам + 1;
			КонецЦикла;
		КонецЦикла;
		Н = Н + 1;
	КонецЦикла;
	
	ТаблПользователей = ПрочитатьПользователейДляОповещения(ПараметрыАгента.Агент); //это Табл значений
	
	Если ПараметрыАгента.ТипСоздаваемогоДокументаПокупка = 0 Тогда //возврат
		СоздатьВозвратОтПокупателя(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
	ИначеЕсли ПараметрыАгента.ТипСоздаваемогоДокументаПокупка = 1 Тогда  //поступление
		СоздатьПоступлениеТоваровУслуг(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий); 		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

// Создаёт новый документ ПоступлениеТоваровУслуг при загрузке из КПК
// Параметры:
// 		Адрес - Строка, адрес КПК
// 		Платформа - идентификатор платформы КПК
// 		ТаблШапок - ТаблицаЗначений, таблица со всеми реквизитами шапок
// 			документов в соответствии с протоколом обмена
// 		ТаблСтрок - ТаблицаЗначений, таблица со всеми реквизитами строк
// 			документов в соответствии с протоколом обмена
// 		ТаблПользователей - ТаблицаЗначений, содержит в колонке "Пользователь" пользователей, которым
// 			отправить оповещение о загрузке документа
// 		ТаблКатегорий - ТаблицаЗначений, таблица со всеми значениями категорий
// 			документов в соответствии с протоколом обмена
Процедура СоздатьПоступлениеТоваровУслуг(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий)
	ДобавитьСообщение("Формируются приходные накладные...");	
	текДата = ТекущаяДата();
	Для Каждого СтрШапки Из ТаблШапок Цикл
		УникДок = СформироватьУникальныйКодДокумента("Поступление", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес,Ответ,0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			НачатьТранзакцию();
			Попытка
				
				Док = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
				Док.Дата						= ДатаИзДатаИВремя(СтрШапки.Дата, текДата);  //Время поставим текущее
		 		Док.НомерВходящегоДокумента		= СтрШапки.Номер;
		        Док.ДатаВходящегоДокумента		= Док.Дата;
				Док.Комментарий					= СтрШапки.Комментарий;
				Док.Склад = ?(ЗначениеЗаполнено(СтрШапки.Склад), СтрШапки.Склад, ПараметрыАгента.Склады[0].Склад);
				
				Если СоответствиеКонтрагента = 0 Тогда //покупатель = грузополучатель
					Док.Контрагент				= СтрШапки.Контрагент;
				Иначе	//холдинг
					Док.Контрагент				= Док.Грузоотправитель.ГоловнойКонтрагент;
				КонецЕсли;
				
				// Заполним ДоговорКонтрагента
				Если ЗначениеЗаполнено(СтрШапки.Договор)
					И (СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
					Или СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее И Конфигурация = "БухКазахстан") Тогда
					Док.ДоговорКонтрагента = СтрШапки.Договор;
				Иначе
					Док.ДоговорКонтрагента = ПолучитьДоговораКонтрагента(СтрШапки, Док);
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Док.ДоговорКонтрагента) Тогда
					ВызовемИсключение = 1 / 0;
				КонецЕсли;
				Док.Организация		= Док.ДоговорКонтрагента.Организация; //Организацию берем из Договора
				
				Док.ТипЦен			= ?(ЗначениеЗаполнено(СтрШапки.ТипЦены), СтрШапки.ТипЦены, Док.ДоговорКонтрагента.ТипЦен);
				Док.ВалютаДокумента	= Док.ДоговорКонтрагента.ВалютаВзаиморасчетов;
			    Док.СуммаВключаетНДС= Док.ТипЦен.ЦенаВключаетНДС;
				Док.УчитыватьНДС	= ОпределитьУчитыватьНДС(Док.Организация, Док.Дата);
				
				КурсВалюты = ПолучитьКурсВалюты(Док.ВалютаДокумента,Док.Дата);
				Док.КурсВзаиморасчетов		= КурсВалюты.Курс;
				Док.КратностьВзаиморасчетов	= КурсВалюты.Кратность;
				Док.Ответственный			= ПараметрыАгента.Агент;
		
				СчетаУчета = ПолучитьСчетаРасчетовСКонтрагентом(Док.Организация, Док.Контрагент, Док.ДоговорКонтрагента, Док.ВалютаДокумента);
				Док.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
				Док.СчетУчетаРасчетовПоАвансам     = СчетаУчета.СчетАвансовПокупателя;
		
				Если Конфигурация = "БухКазахстан" Тогда
					//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
					//	Док.Автор = ПараметрыАгента.Агент;
					//КонецЕсли;
					Док.ВидОперации				= Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомисия; // Казахстану можно "комисия" и с 1 буквой "с" писать
					Док.УчитыватьКПН			= ОрганизацияПлательщикКПН(Док.Организация);
					Если Док.УчитыватьКПН Тогда
						Док.ВидУчетаНУ			= Справочники.ВидыУчетаНУ.НУ;
					КонецЕсли;
				ИначеЕсли Конфигурация = "БухБеларусь" Тогда
					Док.ВидОперации				= Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
					Док.Грузополучатель			= Док.Организация;
					Док.Грузоотправитель		= СтрШапки.Контрагент;
					Док.СчетУчетаРасчетовПоТаре	= СчетаУчета.СчетУчетаТарыПокупателя;
					
					ЦенаВРозницеНужна = Ложь;		
					Если (Док.Склад.ВидСклада <> Перечисления.ВидыСкладов.Оптовый)
						И (ОбщегоНазначения.ПолучитьПараметрыУчетнойПолитики(Док.Дата, Ложь, Док.Организация).СпособОценкиТоваровВРознице = Перечисления.СпособыОценкиТоваровВРознице.ПоПродажнойСтоимости) Тогда
						ЦенаВРозницеНужна = Истина;
					КонецЕсли;
					БУ = ПланыСчетов.Хозрасчетный.ТоварыВРозничнойТорговлеВПродажныхЦенахНТТ.ПолучитьОбъект();
					РазделятьПоСтавкамНДС = ?(БУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтавкиНДС, "ВидСубконто") = Неопределено, Ложь, Истина);
				Иначе
					Док.ВидОперации				= Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
					Док.Грузополучатель			= Док.Организация;
					Док.Грузоотправитель		= СтрШапки.Контрагент;
					Док.СчетУчетаРасчетовПоТаре	= СчетаУчета.СчетУчетаТарыПокупателя;
					Док.СпособЗачетаАвансов		= Перечисления.СпособыЗачетаАвансов.Автоматически;
					
					ЦенаВРозницеНужна = Ложь;		
					Если (Док.Склад.ВидСклада <> Перечисления.ВидыСкладов.Оптовый)
						И (ОбщегоНазначения.ПолучитьПараметрыУчетнойПолитики(Док.Дата, Ложь, Док.Организация).СпособОценкиТоваровВРознице = Перечисления.СпособыОценкиТоваровВРознице.ПоПродажнойСтоимости) Тогда
						ЦенаВРозницеНужна = Истина;
					КонецЕсли;
					БУ = ПланыСчетов.Хозрасчетный.ТоварыВРозничнойТорговлеВПродажныхЦенахНТТ.ПолучитьОбъект();
					РазделятьПоСтавкамНДС = ?(БУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтавкиНДС, "ВидСубконто") = Неопределено, Ложь, Истина);
				КонецЕсли;
				
				СтруктПоиска = Новый Структура;
				СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
				ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска);
				МассивСтрок = ТаблСтрок.НайтиСтроки(СтруктПоиска);
				
				СтруктураВалютаКПК = Неопределено;
				Если ПараметрыАгента.ВалютаКПК <> Док.ВалютаДокумента Тогда
					СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
				КонецЕсли;
				
				Для Каждого СтрСтрок Из МассивСтрок Цикл
					Если СтрСтрок.Колво <= 0 Тогда 
						Продолжить; 
					КонецЕсли;
					Если СтрСтрок.Сумма <= 0 Тогда 
						Продолжить; 
					КонецЕсли;
					
					стрСумма = СтрСтрок.Сумма;
					Если СтруктураВалютаКПК <> Неопределено Тогда
						стрСумма = ПересчитатьИзВалютыВВалюту(СтрСтрок.Сумма,
							ПараметрыАгента.ВалютаКПК, Док.ВалютаДокумента,
							СтруктураВалютаКПК.Курс, Док.КурсВзаиморасчетов,
							СтруктураВалютаКПК.Кратность, Док.КратностьВзаиморасчетов);
					КонецЕсли;
					
					СтрДок = Док.Товары.Добавить();
					Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
						СтрДок.ЕдиницаИзмерения	= СтрСтрок.Единица;        
						СтрДок.Коэффициент		= СтрСтрок.Коэффициент;
					КонецЕсли;
					СтрДок.Количество		= СтрСтрок.Колво;
					СтрДок.Номенклатура		= СтрСтрок.Номенклатура;
					СтрДок.СтавкаНДС		= СтрДок.Номенклатура.СтавкаНДС;
							 
					СтрДок.СуммаНДС = ?(Док.УчитыватьНДС, СтрСумма - СтрСумма / (1 + ПолучитьСтавкуНДС(СтрДок.СтавкаНДС) / 100), 0);
					СтрДок.Сумма	= ?(Док.СуммаВключаетНДС, СтрСумма, СтрСумма - СтрДок.СуммаНДС);
					СтрДок.Цена		= ?(СтрДок.Количество > 0, СтрДок.Сумма / СтрДок.Количество, 0);
					
					Если Конфигурация = "БухКазахстан" Тогда
						ОбработкаТабличныхЧастей.ЗаполнитьНДСВидОборотаТабЧасти(СтрДок, Док);
						ОбработкаТабличныхЧастей.ЗаполнитьНДСВидПоступленияТабЧасти(СтрДок, Док, глЗначениеПеременной("глТекущийПользователь"));		
						Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрДок, "Товары", Истина, Док.УчитыватьКПН);
					ИначеЕсли Конфигурация = "БухБеларусь" Тогда
						СтрДок.НомерГТД	= СтрДок.Номенклатура.НомерГТД;
						СтрДок.СтранаПроисхождения = СтрДок.Номенклатура.СтранаПроисхождения;
						Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрДок, "Товары", Истина, Истина);
						Если ЦенаВРозницеНужна Тогда
							СтрДок.ЦенаВРознице = ПолучитьЦенуНоменклатуры(СтрДок.Номенклатура, Док.Склад.ТипЦенРозничнойТорговли, Док.Дата, Док.ВалютаДокумента, 1, 1);
							СтрДок.СуммаВРознице = СтрДок.Количество * СтрДок.ЦенаВРознице;
							Если РазделятьПоСтавкамНДС Тогда
								СчетаУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрДок.Номенклатура, Док.Склад, Док.Дата);
								ОтноситсяКДеятельностиЕНВД = ?(глЗначениеПеременной("глСчетаДоходовИРасходовЕНВД").Получить(СчетаУчета.СчетДоходов) = Неопределено, Ложь, Истина);
								СтрДок.СтавкаНДСВРознице = ?(ОтноситсяКДеятельностиЕНВД, Перечисления.СтавкиНДС.БезНДС, СтрДок.Номенклатура.СтавкаНДС);
							КонецЕсли;
						КонецЕсли;
					Иначе
						СтрДок.НомерГТД	= СтрДок.Номенклатура.НомерГТД;
						СтрДок.СтранаПроисхождения = СтрДок.Номенклатура.СтранаПроисхождения;
						//Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрДок, "Товары", Истина);
						ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(Док, СтрДок, "Товары");
						Если ЦенаВРозницеНужна Тогда
							СтрДок.ЦенаВРознице = ПолучитьЦенуНоменклатуры(СтрДок.Номенклатура, Док.Склад.ТипЦенРозничнойТорговли, Док.Дата, Док.ВалютаДокумента, 1, 1);
							СтрДок.СуммаВРознице = СтрДок.Количество * СтрДок.ЦенаВРознице;
							Если РазделятьПоСтавкамНДС Тогда
								СчетаУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрДок.Номенклатура, Док.Склад, Док.Дата);
								ОтноситсяКДеятельностиЕНВД = ?(глЗначениеПеременной("глСчетаДоходовИРасходовЕНВД").Получить(СчетаУчета.СчетДоходов) = Неопределено, Ложь, Истина);
								СтрДок.СтавкаНДСВРознице = ?(ОтноситсяКДеятельностиЕНВД, Перечисления.СтавкиНДС.БезНДС, СтрДок.Номенклатура.СтавкаНДС);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "17", "1");	
				КонецЦикла;
				
				Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
					Док.УстановитьНовыйНомер(Док.Организация.Префикс);
				Иначе
					Док.Номер = СтрШапки.Номер;
				КонецЕсли;
				
				//запускаем обработку дополнительных реквизитов			
				ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "16", "1");
				Док.Записать();
				ЗаписатьУникКодДокумента(Док, УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
				//добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение  = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение  = СтрШапки.ДатаСоздания;
				МенеджерЗаписи.Записать(Истина);
				ЗавершитьСобытие(Адрес, Платформа, "Покупка", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки. Фото, 16);
				Если ПараметрыАгента.ПроводитьПокупка Тогда
					Попытка
						Док.Записать(РежимЗаписиДокумента.Проведение);
						ТекстСтатуса = " (проведен)";
					Исключение
						Док.Записать();
						ТекстСтатуса = " (не проведен)";
					КонецПопытки;
				Иначе
					ТекстСтатуса = " (не проведен)"
				КонецЕсли;
				
				ЗафиксироватьТранзакцию();
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				СерверПослатьОтвет(Адрес,Ответ,0);
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
				ОтменитьТранзакцию();
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ покупка не создан"; 
					Если ПараметрыАгента.ПроводитьПродажа Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Для контрагента " + Док.Контрагент + " не найден договор с покупателем";
					СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл("Ошибка создания документа Покупка: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;	

	СерверПослатьОтвет(Адрес, РазделительСтрок, 1);
КонецПроцедуры

// Создаёт новый документ ВозвратТоваровОтПокупателя при загрузке из КПК
// Параметры:
// 		Адрес - Строка, адрес КПК
// 		Платформа - идентификатор платформы КПК
// 		ТаблШапок - ТаблицаЗначений, таблица со всеми реквизитами шапок
// 			документов в соответствии с протоколом обмена
// 		ТаблСтрок - ТаблицаЗначений, таблица со всеми реквизитами строк
// 			документов в соответствии с протоколом обмена
// 		ТаблПользователей - ТаблицаЗначений, содержит в колонке "Пользователь" пользователей, которым
// 			отправить оповещение о загрузке документа
// 		ТаблКатегорий - ТаблицаЗначений, таблица со всеми значениями категорий
// 			документов в соответствии с протоколом обмена
Процедура СоздатьВозвратОтПокупателя(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
	ДобавитьСообщение("Формируются возвраты от покупателя ...");
	
	текдата = ТекущаяДата();
	РасчитыватьЦены1С = ПараметрыАгента.РасчитыватьЦены1С;
	Для Каждого СтрШапки Из ТаблШапок Цикл
		УникДок = СформироватьУникальныйКодДокумента("Возврат",СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		Если СсылкаДок<>Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес,Ответ,0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			нетОшибок = Истина;
			НачатьТранзакцию();
			Попытка		
				Док = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
				Док.Дата			= ДатаИзДатаИВремя(СтрШапки.Дата, текдата);  //Время поставим текущее
				Док.Склад			= ?(ЗначениеЗаполнено(СтрШапки.Склад), СтрШапки.Склад, ПараметрыАгента.Склады[0].Склад);
				Если СоответствиеКонтрагента = 0 Тогда //покупатель = грузополучатель
					Док.Контрагент	= СтрШапки.Контрагент;
				Иначе	//холдинг
					Док.Контрагент	= СтрШапки.Контрагент.ГоловнойКонтрагент;
				КонецЕсли;
				// Заполним ДоговорКонтрагента
				Если ЗначениеЗаполнено(СтрШапки.Договор)
					И (СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
					Или СтрШапки.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее И Конфигурация = "БухКазахстан") Тогда
					Док.ДоговорКонтрагента = СтрШапки.Договор;
				Иначе
					Док.ДоговорКонтрагента = ПолучитьДоговораКонтрагента(СтрШапки, Док);
				КонецЕсли;
				
				Док.Организация		= Док.ДоговорКонтрагента.Организация; //Организацию берем из Договора
				Док.ТипЦен			= ?(РасчитыватьЦены1С, ?(ЗначениеЗаполнено(Док.ДоговорКонтрагента.ТипЦен), Док.ДоговорКонтрагента.ТипЦен, СтрШапки.ТипЦены), СтрШапки.ТипЦены);
				Док.ВалютаДокумента	= Док.ДоговорКонтрагента.ВалютаВзаиморасчетов;
				Док.СуммаВключаетНДС= Док.ТипЦен.ЦенаВключаетНДС;
				Док.УчитыватьНДС	= ОпределитьУчитыватьНДС(Док.Организация, Док.Дата);
				Док.Ответственный	= ПараметрыАгента.Агент;
				Док.Комментарий		= СтрШапки.Комментарий;

				КурсВалюты = ПолучитьКурсВалюты(Док.ВалютаДокумента, Док.Дата);
				Док.КурсВзаиморасчетов		= КурсВалюты.Курс;
				Док.КратностьВзаиморасчетов	= КурсВалюты.Кратность;
				СчетаУчета = ПолучитьСчетаРасчетовСКонтрагентом(Док.Организация, Док.Контрагент, Док.ДоговорКонтрагента, Док.ВалютаДокумента);
				Док.СчетУчетаРасчетовСКонтрагентом	= СчетаУчета.СчетРасчетовПокупателя;
				
				Если Конфигурация = "БухКазахстан" Тогда
					//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
					//	Док.Автор = ПараметрыАгента.Агент;
					//КонецЕсли;
					Док.УчитыватьКПН					= ОрганизацияПлательщикКПН(Док.Организация);
					Если Док.УчитыватьКПН Тогда
						Док.ВидУчетаНУ					= Справочники.ВидыУчетаНУ.НУ;
					КонецЕсли;
					Док.СуммаВключаетАкциз				= Док.ТипЦен.ЦенаВключаетАкциз;
					Док.СчетУчетаРасчетовПоВозвратам	= СчетаУчета.СчетВозвратовПокупателя;
				Иначе
					Док.ВидОперации						= Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ПродажаКомиссия;
					Док.СчетУчетаРасчетовПоТаре			= СчетаУчета.СчетУчетаТарыПокупателя;
					Док.СчетУчетаРасчетовПоАвансам		= СчетаУчета.СчетАвансовПокупателя;
				КонецЕсли;
				
				СтруктураВалютаКПК = Неопределено;
				Если ПараметрыАгента.ВалютаКПК <> Док.ВалютаДокумента Тогда
					СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
				КонецЕсли;
				
				СтруктПоиска = Новый Структура;
				СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
				МассивСтрок = ТаблСтрок.НайтиСтроки(СтруктПоиска);
				ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); 	
				Для Каждого СтрСтрок Из МассивСтрок Цикл
					Если СтрСтрок.Колво <= 0 Тогда 
						Продолжить; 
					КонецЕсли;
					Если СтрСтрок.Сумма <= 0 Тогда 
						Продолжить; 
					КонецЕсли;
					стрСумма = СтрСтрок.Сумма;
					Если СтруктураВалютаКПК <> Неопределено Тогда
						стрСумма = ПересчитатьИзВалютыВВалюту(СтрСтрок.Сумма,
							ПараметрыАгента.ВалютаКПК, Док.ВалютаДокумента,
							СтруктураВалютаКПК.Курс, Док.КурсВзаиморасчетов,
							СтруктураВалютаКПК.Кратность, Док.КратностьВзаиморасчетов);
					КонецЕсли;

					СтрДок = Док.Товары.Добавить();
					СтрДок.Количество	= СтрСтрок.Колво;
					СтрДок.Номенклатура	= СтрСтрок.Номенклатура;
					Если Конфигурация = "БухБеларусь" И СтрСтрок.Партия <> ""  Тогда
						СтрДок.Партия				= СтрСтрок.Партия;
					КонецЕсли;
					СтрДок.СтавкаНДС	= СтрДок.Номенклатура.СтавкаНДС;
					
					Если Конфигурация = "БухКазахстан" Тогда
						СтрДок.НДСВидОперацииРеализации	= Справочники.ВидыРеализации.ВозвратТМЗ;
						Если Док.СуммаВключаетАкциз И Док.УчитыватьАкциз Тогда 
							СтрДок.СтавкаАкциза		= СтрДок.Номенклатура.СтавкаАкциза;
							ОбработкаТабличныхЧастей.РассчитатьСуммуАкцизаТабЧасти(СтрДок, Док);
						КонецЕсли;
					Иначе
						СтрДок.НомерГТД				= СтрДок.Номенклатура.НомерГТД;
						СтрДок.СтранаПроисхождения	= СтрДок.Номенклатура.СтранаПроисхождения;
						СтрДок.Себестоимость		= стрСумма; // в рублях
					КонецЕсли;
					
					Если РасчитыватьЦены1С Тогда
						ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПродажиТабЧасти(СтрДок, Док, мВалютаРегламентированногоУчета);
						ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрДок, Док);
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, Док);
					Иначе
						СтавкаНДС		= ПолучитьСтавкуНДС(СтрДок.СтавкаНДС) / 100;
						СтрДок.Цена		= ?(СтрДок.Количество > 0, ?(Док.УчитыватьНДС, ?(Док.СуммаВключаетНДС, СтрСумма, СтрСумма / (1 + СтавкаНДС)), СтрСумма) / СтрДок.Количество, 0);
						СуммаСоСкидкой	= СтрСумма - СтрСумма * СтрШапки.Скидка / 100;
						СтрДок.СуммаНДС = ?(Док.УчитыватьНДС, СуммаСоСкидкой - СуммаСоСкидкой / (1 + СтавкаНДС), 0);
						СтрДок.Сумма	= ?(Док.СуммаВключаетНДС, СуммаСоСкидкой, СуммаСоСкидкой - СтрДок.СуммаНДС);
					КонецЕсли;
					
					Если Конфигурация = "БухКазахстан" Тогда
						Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрДок, "Товары", Истина, Док.УчитыватьКПН);
					ИначеЕсли Конфигурация = "БухБеларусь" Тогда
						Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрДок, "Товары", Истина, Истина);
					Иначе
						//Док.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрДок, "Товары", Истина);
						//СтрДок.СчетУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрДок.Номенклатура, Док.Склад, Док.Дата).СчетУчета;
						ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(Док, СтрДок, "Товары");
					КонецЕсли;
					ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "17", "0");	
					
				КонецЦикла;
				
				Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
					Док.УстановитьНовыйНомер(Док.Организация.Префикс);
				Иначе
					Док.Номер = СтрШапки.Номер;
				КонецЕсли;
			
				//запускаем обработку дополнительных реквизитов			
				ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "16", "0");
				
				Если ПараметрыАгента.ПроводитьПокупка Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
					ТекстСтатуса = " (проведен)";
				Иначе
					Док.Записать();
					ТекстСтатуса = " (не проведен)";
				КонецЕсли;
				
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
			
			Если нетОшибок Тогда
				ЗаписатьУникКодДокумента(Док, УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
	            //добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение  = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение  = СтрШапки.ДатаСоздания;
				МенеджерЗаписи.Записать(Истина);
				ЗавершитьСобытие(Адрес, Платформа, "Покупка", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки.Фото, 16);
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				ЗафиксироватьТранзакцию();
				СерверПослатьОтвет(Адрес, Ответ, 0);			
			Иначе
				ОтменитьТранзакцию();
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ Возврат не создан"; 
					Если ПараметрыАгента.ПроводитьПокупка Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл("Ошибка создания документа Возврат: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
	
КонецПроцедуры

// Разбирает запрос на загрузку Анкет и помещает данные в таблицу значений
// Адрес - идентификатор сессии обмена
// ТелоЗапроса - Запрос, в том виде, в каком он пришёл от КПК
Функция ЗагрузитьАнкеты(Адрес, Платформа, ТелоЗапроса)
	
	Если НЕ ПорцияОбмена(Адрес, "OK", "Загружаются анкеты...") Тогда
		Возврат ложь;
	КонецЕсли; 
	
	ТаблШапок = Новый ТаблицаЗначений;
	ТаблШапок.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число"));
	ТаблШапок.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Форма", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблШапок.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблШапок.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблШапок.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Время", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ВремяРаботы", Новый ОписаниеТипов("Число"));//время работы с документом в минутах
	ТаблШапок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Задание", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Фото", Новый ОписаниеТипов("Строка"));
	
	ТаблСтрок = Новый ТаблицаЗначений;
	ТаблСтрок.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	ТаблСтрок.Колонки.Добавить("ЗначениеПоля", Новый ОписаниеТипов("Строка"));
	ТаблСтрок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число"));
	
	ТаблКатегорий = Новый ТаблицаЗначений;
	ПолучитьТаблицуКатегорий(ТаблКатегорий);	
	Н = 5;
	КолСтр = СтрЧислоСтрок(ТелоЗапроса);
	Пока Н <= КолСтр Цикл
		ТекСтр = СтрПолучитьСтроку(ТелоЗапроса, Н);
		Если ТекСтр = "" Тогда Прервать; КонецЕсли;
		ТекСтр = СтрЗаменить(ТекСтр,Таб,РазделительСтрок);
		Если СтрЧислоСтрок(ТекСтр) > 13 Тогда
			//ДобавитьОшибку("Неверный формат шапки анкет");
			//Возврат Ложь;
		КонецЕсли;
		
		НовСтр = ТаблШапок.Добавить();
		НовСтр.Время = Сред(СтрПолучитьСтроку(ТекСтр,1),12);
		НовСтр.Дата = ДатаИзСтрокиСКПК(СтрПолучитьСтроку(ТекСтр,1));
		НовСтр.ИдДок = Число(СтрПолучитьСтроку(ТекСтр,2));
		ИДДок = НовСтр.ИдДок;
		НовСтр.Форма = СтрПолучитьСтроку(ТекСтр,3);
		
		Код = СтрПолучитьСтроку(ТекСтр,4);
		Организация = Справочники.Организации.НайтиПоКоду(Код);
		НовСтр.Организация = Организация;
		
		Код = СтрПолучитьСтроку(ТекСтр,5);
		Контрагент = Справочники.Контрагенты.НайтиПоКоду(Код);
		Если Контрагент.Пустая() Тогда
			ОтправитьОшибку(Адрес,Строка(ИдДок)+Таб+"Неизвестный контрагент с кодом "+Код+РазделительСтрок);
			ДобавитьОшибку("Ошибка при загрузке анкеты. Неизвестный контрагент с кодом "+Код);
		КонецЕсли;
		НовСтр.Контрагент = Контрагент;
		
		Код = СтрПолучитьСтроку(ТекСтр,6);
		Если ПустаяСтрока(Код) Тогда
			НовСтр.Договор=Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		Иначе
			Договор = ?(ПустаяСтрока(Код), 
			Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), 
			Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(Код))));
			Если Договор.Пустая() Тогда
				ОтправитьОшибку(Адрес,Строка(ИдДок)+Таб+"Неизвестный договор с кодом "+Код+РазделительСтрок);
				ДобавитьОшибку("Ошибка при загрузке анкеты. Неизвестный договор с кодом "+Код);
			КонецЕсли;
			НовСтр.Договор = Договор;
		КонецЕсли;
		
		НовСтр.Комментарий = СтрПолучитьСтроку(ТекСтр,7);
		НовСтр.Ответ = СтрПолучитьСтроку(ТекСтр,8);
		НовСтр.ДатаСоздания = ДатаИзСтрокиСКПК(СтрПолучитьСтроку(ТекСтр,9));
		НовСтр.ВремяРаботы = Число(СтрПолучитьСтроку(ТекСтр,10));
		НовСтр.ДопРеквизиты = СтрПолучитьСтроку(ТекСтр,11);
		НовСтр.Задание = СтрПолучитьСтроку(ТекСтр,12);
		НовСтр.Фото = СтрЗаменить(СтрПолучитьСтроку(ТекСтр,13),Символ(31),РазделительСтрок);
		
		Н=Н+1;
		//заполнить таблицу категорий
		ТекСтр=СтрПолучитьСтроку(ТелоЗапроса,Н);
		Пока ТекСтр<>"" Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр,Таб);
			Если ПозРазд<>0 Тогда
				Парам  = Лев(ТекСтр,ПозРазд-1);
				ТекСтр = Сред(ТекСтр,ПозРазд+1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			НайденныйОбъект = Справочники.КатегорииОбъектов.НайтиПоКоду(Парам);
			Если НайденныйОбъект.Пустая()=Ложь Тогда
				НовСтр = ТаблКатегорий.Добавить();
				НовСтр.ИдДок =  ИдДок;
				НовСтр.Категория = НайденныйОбъект;
			КонецЕсли; 
		КонецЦикла;
		
		Н=Н+1;
	КонецЦикла;
	
	Для Каждого СтрШапок Из ТаблШапок Цикл
		Если СтрШапок.форма = "Типовое задание 1С" Тогда
			
			Ответы = СтрЗаменить(СтрШапок.Ответ, Символ(30), РазделительСтрок);//разделитель вопросов RS 1E заменю на Разделитель Строк 
			
			КолВопросовОтветов = СтрЧислоСтрок(Ответы);
			Контрагент = СтрШапок.Контрагент;
			
			ВопросОтвет = СтрПолучитьСтроку(Ответы,1);
			ВопросОтвет = СтрЗаменить(ВопросОтвет,Символ(31),Символы.ПС);//разделитель вопросов US 1F заменю на Разделитель Строк 			
			ВопросОтвет = СтрЗаменить(СтрПолучитьСтроку(ВопросОтвет, 2), " #", Символы.ПС);
			Исполнитель = ПолучитьАгентаПоКоду(СтрПолучитьСтроку(ВопросОтвет, 2));
			
			ВопросОтвет = СтрПолучитьСтроку(Ответы,2);
			ВопросОтвет = СтрЗаменить(ВопросОтвет,Символ(31),Символы.ПС);//разделитель вопросов US 1F заменю на Разделитель Строк 			
			СрокВыполнения = Число(СтрПолучитьСтроку(ВопросОтвет, 2));
			
			ВопросОтвет = СтрПолучитьСтроку(Ответы,3);
			ВопросОтвет = СтрЗаменить(ВопросОтвет,Символ(31),Символы.ПС);//разделитель вопросов US 1F заменю на Разделитель Строк 			
			ВремяНачала = ДатаИзСтрокиСКПК("01.01.0001 " + СтрПолучитьСтроку(ВопросОтвет, 2) + ":00");
			
			ВопросОтвет = СтрПолучитьСтроку(Ответы,4);			
			ВопросОтвет = СтрЗаменить(ВопросОтвет,Символ(31),Символы.ПС);//разделитель вопросов US 1F заменю на Разделитель Строк 			
			ТипЗадания = СтрПолучитьСтроку(ВопросОтвет, 2);
			
			ВопросОтвет = СтрПолучитьСтроку(Ответы,5);			
			ВопросОтвет = СтрЗаменить(ВопросОтвет,Символ(31),Символы.ПС);//разделитель вопросов US 1F заменю на Разделитель Строк 			
			ВопросОтвет = СтрЗаменить(СтрПолучитьСтроку(ВопросОтвет, 2), " #", Символы.ПС);
			ГруппаЗадания = СтрПолучитьСтроку(ВопросОтвет, 2);
			
			ВопросОтвет = СтрПолучитьСтроку(Ответы,6);			
			ВопросОтвет = СтрЗаменить(ВопросОтвет,Символ(31),Символы.ПС);//разделитель вопросов US 1F заменю на Разделитель Строк 			
			Описание = СтрПолучитьСтроку(ВопросОтвет, 2);
			
			//проверяем наличие задания с такими же параметрами - Агент, Дата, ТипЗадания, ГруппаЗадания
			
			запросПоискЗадания = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Ссылка ИЗ Документ.Событие
			|ГДЕ
			|	НАЧАЛОПЕРИОДА(Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
			|	И Ответственный = &Ответственный
			|	И ГруппаСобытия = &ГруппаСобытия
			|	И ОписаниеСобытия ПОДОБНО &СодержаниеСобытия
			|	И Контрагент = &Контрагент");
			
			запросПоискЗадания.УстановитьПараметр("Дата", СтрШапок.Дата);
			запросПоискЗадания.УстановитьПараметр("Ответственный", Исполнитель);
			запросПоискЗадания.УстановитьПараметр("ГруппаСобытия", ГруппаЗадания);
			запросПоискЗадания.УстановитьПараметр("СодержаниеСобытия", ТипЗадания);
			запросПоискЗадания.УстановитьПараметр("Контрагент", Контрагент);
			
			существующиеЗадания = запросПоискЗадания.Выполнить().Выгрузить();
			
			Если существующиеЗадания.Количество() > 0 Тогда
				//задание с такими параметрами уже существует. надо что-то изменить
				СерверПослатьОтвет(Адрес, ОтветПоВыгрузкеДокумента("", , "Задание уже существует"), 0);
				ДобавитьОшибку("Задание уже существует");			
			Иначе
				СтатусПроведения = 0;
				Если ТранзакцияАктивна() Тогда
					Ответ = ОтветПоВыгрузкеДокумента(СтрШапок.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
					СерверПослатьОтвет(Адрес,Ответ,0);			
				Иначе		
					НачатьТранзакцию();
					Попытка
						Событие = Документы.Событие.СоздатьДокумент();
						Событие.СостояниеСобытия=Перечисления.СостоянияСобытий.Запланировано;
						Событие.Дата=СтрШапок.Дата;
						Событие.НачалоСобытия=НачалоДня(СтрШапок.Дата)+Час(ВремяНачала)*60*60+Минута(ВремяНачала)*60;
						Событие.ОкончаниеСобытия=Событие.НачалоСобытия+СрокВыполнения*24*60*60 + 60*ПолучитьВремяВыполненияДляЗадания(ТипЗадания);
						Событие.Ответственный=Исполнитель;
						Событие.Контрагент=Контрагент;
						Событие.ОписаниеСобытия=ТипЗадания;
						Событие.СодержаниеСобытия=Описание + Символы.ПС + СтрШапок.Комментарий;
						Событие.ГруппаСобытия=ГруппаЗадания;
						Событие.Записать();
						ЗафиксироватьТранзакцию();
						СтатусПроведения = 1;	
					Исключение				
						глПоследняяОшибкаПроведения = ОписаниеОшибки();
						СтатусПроведения = 0;
						Если ТранзакцияАктивна() Тогда
							ОтменитьТранзакцию();
						КонецЕсли;					
					КонецПопытки;
					
					Если СтатусПроведения = 1 Тогда
						ДобавитьСообщение("Сформировано задание агенту "+Событие.Номер);
						СерверПослатьОтвет(Адрес,ОтветПоВыгрузкеДокумента(СтрШапок.ИдДок, Событие.Ссылка),0)
					Иначе
						Если ПустаяСтрока(глПоследняяОшибкаПроведения)=1 Тогда 
							глПоследняяОшибкаПроведения = "Неизвестная ошибка"; 
						КонецЕсли;
						СерверПослатьОтвет(Адрес,ОтветПоВыгрузкеДокумента(СтрШапок.ИдДок, , глПоследняяОшибкаПроведения),0);
						ДобавитьОшибку("Ошибка при проведении задания агенту");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СерверПослатьОтвет(Адрес, РазделительСтрок, 1);
	
	Возврат Истина;
КонецФункции

// Создаёт таблицы шапок и строк документов, загружаемых с КПК
// Параметры:
// 		ТелоЗапроса - Строка, текст запроса, поступившего с КПК
// 		НачСтр - Число, номер строки, начиная с которой идут данные о документе
// 		ТаблШапок - ТаблицаЗначений, сюда возвращается таблица со всеми реквизитами шапок
// 			загруженных документов в соответствии с протоколом обмена
// 		ТаблСтрок - ТаблицаЗначений, сюда возвращается таблица со всеми реквизитами строк
// 			загруженных документов в соответствии с протоколом обмена
// 		ТаблКатегорий - ТаблицаЗначений, сюда возвращается таблица со всеми значениями категорий
// 			загруженных документов в соответствии с протоколом обмена
// Возвращаемое значение:
// 		Истина - успешная загрузка
// 		Ложь - ошибка
Функция ПолучитьТаблицыИнвентаризаций(ТелоЗапроса, НачСтр, ТаблШапок, ТаблСтрок, ТаблКатегорий)
	
	ТаблШапок = Новый ТаблицаЗначений;
	ТаблШапок.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ТаблШапок.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Фирма", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблШапок.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблШапок.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблШапок.Колонки.Добавить("ТипЦен", Новый ОписаниеТипов("СправочникСсылка.ТипыЦенНоменклатуры"));
	ТаблШапок.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Док", Новый ОписаниеТипов("ДокументСсылка.ИнвентаризацияТоваровНаСкладе"));
	ТаблШапок.Колонки.Добавить("Время", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Форма", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"));
	ТаблШапок.Колонки.Добавить("ВремяРаботы", Новый ОписаниеТипов("Число"));//время работы с документом в минутах
	ТаблШапок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Задание", Новый ОписаниеТипов("Строка"));
	ТаблШапок.Колонки.Добавить("Фото", Новый ОписаниеТипов("Строка"));

	ТаблСтрок = Новый Таблицазначений;
	ТаблСтрок.Колонки.Добавить("ИдДок", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ТаблСтрок.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблСтрок.Колонки.Добавить("Партия");
	ТаблСтрок.Колонки.Добавить("Колво", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблСтрок.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Коэффициент", Новый ОписаниеТипов("Число"));
	ТаблСтрок.Колонки.Добавить("Форма", Новый ОписаниеТипов("Строка"));
	ТаблСтрок.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ТаблСтрок.Колонки.Добавить("ДопРеквизиты", Новый ОписаниеТипов("Строка"));
	
	ПолучитьТаблицуКатегорий(ТаблКатегорий);
	
	спрНом = Справочники.Номенклатура.ПустаяСсылка();
	
	Н = НачСтр;
	КолСтр = СтрЧислоСтрок(ТелоЗапроса);
	Пока Н <= КолСтр Цикл
		ТекСтр = СтрПолучитьСтроку(ТелоЗапроса,Н);
		Параметры = СтрЗаменить(ТекСтр, Таб, РазделительСтрок);
		НовСтр = ТаблШапок.Добавить();
		
		ДатаВремя=СтрПолучитьСтроку(Параметры,1);
		ИдДок=СтрПолучитьСтроку(Параметры,2);
		НомерДок=СтрПолучитьСтроку(Параметры,3);
		Фирма=СтрПолучитьСтроку(Параметры,4);
		Склад=СтрПолучитьСтроку(Параметры,5);
		Клиент=СтрПолучитьСтроку(Параметры,6);
		ТипЦен=СтрПолучитьСтроку(Параметры,7);
		Комментарий=СтрПолучитьСтроку(Параметры,8);
		Ответ=СтрПолучитьСтроку(Параметры,10);
		ДатаСоздания=ДатаИзСтрокиСКПК(СтрПолучитьСтроку(Параметры,11));
		ВремяРаботы=ДатаИзСтрокиСКПК(СтрПолучитьСтроку(Параметры,12));
		ДопРеквизиты=СтрПолучитьСтроку(Параметры,13);
		Задание=СтрПолучитьСтроку(Параметры,14);
		Фото=СтрПолучитьСтроку(Параметры,15);
		
		дв = ДатаИзСтрокиСКПК(ДатаВремя);
		НовСтр.Время = Сред(ДатаВремя,12); 
		НовСтр.Дата  = дв;
		НовСтр.ИдДок=ИдДок;
		НовСтр.Номер=НомерДок;
		НовСтр.Фирма=Справочники.Организации.НайтиПоКоду(Фирма);
		Если НовСтр.Фирма=Неопределено Тогда 
			НовСтр.Фирма=Справочники.Организации.ПустаяСсылка(); 
		КонецЕсли;

		НовСтр.Склад = ПолучитьСсылкуПоGUID(Склад,"Склады");
		
		мКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		мАдресДоставки = "";
		
		ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
		Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
			ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
			Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
				Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
					ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		
		ПолучитьКонтрагентаИАдресПоКоду(Клиент,мКонтрагент,мАдресДоставки, ПапкаРодителя);
		НовСтр.Контрагент = мКонтрагент;
		НовСтр.ТипЦен = ПолучитьСсылкуПоGUID(ТипЦен,"ТипыЦенНоменклатуры");
		
		НовСтр.Комментарий = Комментарий;
		НовСтр.Ответ = Ответ;
		НовСтр.ВремяРаботы = ВремяРаботы;
		НовСтр.ДатаСоздания = ДатаСоздания;
		НовСтр.ДопРеквизиты = ДопРеквизиты;
		НовСтр.Задание = Задание;
		НовСтр.Фото = СтрЗаменить(Фото,Символ(31),РазделительСтрок);
		
		//заполнить таблицу категорий
		Н = Н + 1;
		ТекСтр = СтрПолучитьСтроку(ТелоЗапроса,Н);
		Пока ТекСтр <> "" Цикл
			Парам   = "";
			ПозРазд = Найти(ТекСтр,Таб);
			Если ПозРазд <> 0 Тогда
				Парам  = Лев(ТекСтр,ПозРазд-1);
				ТекСтр = Сред(ТекСтр,ПозРазд+1);
			Иначе
				Парам  = ТекСтр;
				ТекСтр = "";
			КонецЕсли;
			НайденныйОбъект = НайтиОбъектКатегория(Парам);
			Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
				НовСтр = ТаблКатегорий.Добавить();
		        НовСтр.ИдДок = ИдДок;
    			НовСтр.Категория = НайденныйОбъект;
			КонецЕсли; 
        КонецЦикла;
			
		Пока Истина Цикл
			Н = Н + 1;
			Если Н > КолСтр Тогда Прервать; КонецЕсли;
			
			ТекСтр = СтрПолучитьСтроку(ТелоЗапроса,Н);
			Если ТекСтр = "" Тогда Прервать; КонецЕсли;
			
			НовСтр = ТаблСтрок.Добавить();
			НовСтр.ИдДок = ИдДок;
			
			Параметры=СтрЗаменить(ТекСтр,Таб,РазделительСтрок);
			
			Товар=СтрПолучитьСтроку(Параметры,1);
			НовСтр.Партия = "";
			Если Конфигурация = "БухБеларусь" Тогда
				ПарамНом = СтрЗаменить(Товар, "#", Символы.ПС);
				спрНом = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(ПарамНом,1), "Номенклатура");
				Если СтрЧислоСтрок(ПарамНом) =2 Тогда
					НовСтр.Партия = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(ПарамНом,2), "Партии");
					Если спрНом = Справочники.Партии.ПустаяСсылка() Тогда
						ДобавитьОшибку("Загрузка инвентаризации " + ИдДок + ".Неизвестная партия номенклатуры с кодом " + СтрПолучитьСтроку(ПарамНом,2));
					КонецЕсли;
				КонецЕсли;
			Иначе
				спрНом = ПолучитьСсылкуПоGUID(Товар, "Номенклатура");
			КонецЕсли;
			Если спрНом = Справочники.Номенклатура.ПустаяСсылка() Тогда
				ДобавитьОшибку("Загрузка инвентаризации " + ИдДок + ".Неизвестная номенклатура с кодом " + СтрПолучитьСтроку(ПарамНом,1));
			Иначе	
				НовСтр.Номенклатура = спрНом;
			КонецЕсли;
			ТекНоменклатура = Парам;
			Колво=СтрПолучитьСтроку(Параметры,2);
			Единица=СтрПолучитьСтроку(Параметры,3);
			Коэффициент=СтрПолучитьСтроку(Параметры,4);
			Цена=СтрПолучитьСтроку(Параметры,5);
			Ответ=СтрПолучитьСтроку(Параметры,7);
			ДопРеквизиты = ?(СтрЧислоСтрок(Параметры) >= 8, СтрПолучитьСтроку(Параметры,8), "");
			спрНом = ПолучитьСсылкуПоGUID(Товар, "Номенклатура");
			НовСтр.Колво=ПолучитьЧислоИзСтроки(Колво);
			НайденныйОбъект = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(Единица);
			Если НайденныйОбъект.Пустая() Тогда
				ДобавитьОшибку(
					"Загрузка инвентаризации "+ИдДок+".Неизвестная единица номенклатуры "+НовСтр.Номенклатура+" с кодом "+Единица);
			Иначе	
				НовСтр.Единица = НайденныйОбъект;
			КонецЕсли;
			НовСтр.Коэффициент=ПолучитьЧислоИзСтроки(Коэффициент);
			НовСтр.Цена=ПолучитьЧислоИзСтроки(Цена);
			НовСтр.Ответ=Ответ;
			НовСтр.ДопРеквизиты=ДопРеквизиты;
		КонецЦикла;
		
		Н = Н + 1;
	КонецЦикла;

	Возврат Н;
КонецФункции

// Заполняет все реквизиты документа ИнвентаризацияТоваровНаСкладе при его загрузке из КПК
// Параметры:
// 		Док - ДокументОбъект, загружаемый документ
// 		СтрШапки - ТаблицаЗначений, содержащая все реквизиты шапки в соответствии с протоколом обмена
// 		ТаблТовары - ТаблицаЗначений, содержащая все реквизиты таблицы документа в соответствии
// 			с протоколом обмена
Процедура ЗаполнитьРеквизитыИнвентаризации(Док, СтрШапки, ТаблТовары)
	Док.Дата			= ДатаИзДатаИВремя(СтрШапки.Дата, ТекущаяДата());  //Время поставим текущее
	Док.Комментарий		= СтрШапки.Комментарий;
	Док.Склад			= ?(ЗначениеЗаполнено(СтрШапки.Склад), СтрШапки.Склад, ПараметрыАгента.Склады[0].Склад);
	Док.Ответственный	= ПараметрыАгента.Агент;
	
	Если ПараметрыАгента.Организации.Количество() > 0 Тогда
		Док.Организация = ПараметрыАгента.Организации[0].Организация;
	Иначе
		Выборка = Справочники.Организации.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПометкаУдаления Тогда Продолжить; КонецЕсли;
			Док.Организация = Выборка.Ссылка;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	МассивИсклСчетов = Новый Массив();         
	Если Конфигурация = "БухКазахстан" Тогда
		//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
		//	Док.Автор = ПараметрыАгента.Агент;
		//КонецЕсли;
	Иначе
		МассивИсклСчетов.Добавить(ПланыСчетов.Хозрасчетный.МатериальныеЦенностиВЭксплуатации);
		МассивИсклСчетов.Добавить(ПланыСчетов.Хозрасчетный.ТоварыВРозничнойТорговлеВПродажныхЦенахНТТ);
		МассивИсклСчетов.Добавить(ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ);
		МассивИсклСчетов.Добавить(ПланыСчетов.Хозрасчетный.ТорговаяНаценкаНТТ);
	КонецЕсли; 
	
	СтруктураВалютаКПК = Неопределено;
	Если ПараметрыАгента.ВалютаКПК <> мВалютаРегламентированногоУчета Тогда
		СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
	КонецЕсли;
	
	Док.ЗаполнитьПоОстаткамНаСкладе();
	
	Для Каждого СтрСтрок Из Док.Товары Цикл  //по строкам Табличной части
		СтрСтрок.Количество = 0;
		СтрСтрок.Сумма = 0;
	КонецЦикла;
	
	Для Каждого СтрСтрок Из ТаблТовары Цикл  //по строкам Табличной части
		Отбор = Новый Структура();
		Если Конфигурация = "БухБеларусь" Тогда
			Отбор.Вставить("Номенклатура,Партия", СтрСтрок.Номенклатура, СтрСтрок.Партия);
		Иначе
			Отбор.Вставить("Номенклатура", СтрСтрок.Номенклатура);
		КонецЕсли;
		СтрТов = Док.Товары.НайтиСтроки(Отбор);
		Если СтрТов.Количество() = 0 Тогда
			НовСтр = Док.Товары.Добавить();
			НовСтр.Номенклатура	= СтрСтрок.Номенклатура;
			НовСтр.Количество	= СтрСтрок.Колво;
			НовСтр.Цена = СтрСтрок.Цена;
			Если СтруктураВалютаКПК <> Неопределено Тогда
				НовСтр.Цена = ПересчитатьИзВалютыВВалюту(НовСтр.Цена,
				ПараметрыАгента.ВалютаКПК, мВалютаРегламентированногоУчета,
				СтруктураВалютаКПК.Курс, 1,
				СтруктураВалютаКПК.Кратность, 1);
			КонецЕсли;
			НовСтр.Сумма = НовСтр.Количество * НовСтр.Цена;
			Если Конфигурация = "БухКазахстан" Тогда
				НовСтр.ЕдиницаИзмерения	= НовСтр.Номенклатура.БазоваяЕдиницаИзмерения;
			ИначеЕсли Конфигурация = "БухБеларусь" Тогда
				НовСтр.СчетУчетаБУ = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, НовСтр.Номенклатура, Док.Склад, Док.Дата).СчетУчетаБУ;
			Иначе
				НовСтр.СчетУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, НовСтр.Номенклатура, Док.Склад, Док.Дата).СчетУчета;
			КонецЕсли;
			ОбработатьДопРеквизитыСтрокиТЧ(Док, НовСтр, СтрСтрок.ДопРеквизиты, "37", "0");	
			Продолжить;
		КонецЕсли;
		НовСтр = СтрТов[0];
		НовСтр.Количество	= СтрСтрок.Колво;
		НовСтр.Сумма = НовСтр.Количество * СтрСтрок.Цена;
		ОбработатьДопРеквизитыСтрокиТЧ(Док, НовСтр, СтрСтрок.ДопРеквизиты, "37", "0");	
	КонецЦикла;

	Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
		Док.УстановитьНовыйНомер(Док.Организация.Префикс);
	Иначе
		Док.Номер = СтрШапки.Номер;
	КонецЕсли;
	//запускаем обработку дополнительных реквизитов			
	ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "37", "0");
КонецПроцедуры

// Создаёт документ Инвентаризация на основе таблиц шапок и строк
// Параметры
// Адрес - идентификатор сессии обмена
// ТаблШапок - таблица значений с "шапками" документов
// ТаблСтрок - таблица значений с данными для табличной части Товары
// ТаблПользователей - Таблица значений с перечнем пользователей которых нужно оповещать о созданных документах
// ТаблКатегорий - Таблица категорий документа
Процедура СоздатьИнвентаризации(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий)
	
	ДобавитьСообщение("Формируются Инвентаризации...");
	
	ВремТабл = СоздатьТаблицуСтрокРН(); //временная таблица
	Для Каждого СтрШапки Из ТаблШапок Цикл
		СтруктПоиска = Новый Структура;
		СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
		ТаблТовары = ТаблСтрок.Скопировать(СтруктПоиска); //Таблица с товарами в накладной
		ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); //Таблица категорий
		
		УникДок = СформироватьУникальныйКодДокумента("Инвентар.", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес, Ответ, 0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			НачатьТранзакцию();
			Попытка
				Если НЕ ЗначениеЗаполнено(СтрШапки.Склад) Тогда
					ВызовемИсключение = 1 / 0;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТаблСтрок.Количество() = 0) Тогда
					ВызовемИсключение = 1 / 0;
				КонецЕсли;
				Док = Документы.ИнвентаризацияТоваровНаСкладе.СоздатьДокумент();
				ЗаполнитьРеквизитыИнвентаризации(Док, СтрШапки, ТаблТовары);
					
				//инвентаризации проводить нельзя, просто сохраняем документ
				Док.Записать();
				ЗаписатьУникКодДокумента(Док, УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
				//добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение  = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение  = СтрШапки.ДатаСоздания;
				МенеджерЗаписи.Записать(Истина);

				//событие завершим любым доступным документом
				ЗавершитьСобытие(Адрес, Платформа, "Наличие и цены", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				
				//фотографии запишем
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки.Фото, 37);
				ЗафиксироватьТранзакцию();
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				КонецЕсли;
				ОтменитьТранзакцию();
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ Инвентаризация не создан"; 
					Если ПараметрыАгента.ПроводитьПродажа Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Не выбран склад ИЛИ таблица товаров не заполнена";
					СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл("Ошибка создания документа Инвентаризация: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	СерверПослатьОтвет(Адрес, РазделительСтрок, 1);
КонецПроцедуры                      

// Создаёт новый документ ПеремещениеТоваров при загрузке из КПК
// Параметры:
// 		Адрес - Строка, адрес КПК
// 		Платформа - идентификатор платформы КПК
// 		ТаблШапок - ТаблицаЗначений, таблица со всеми реквизитами шапок
// 			документов в соответствии с протоколом обмена
// 		ТаблСтрок - ТаблицаЗначений, таблица со всеми реквизитами строк
// 			документов в соответствии с протоколом обмена
// 		ТаблПользователей - ТаблицаЗначений, содержит в колонке "Пользователь" пользователей, которым
// 			отправить оповещение о загрузке документа
// 		ТаблКатегорий - ТаблицаЗначений, таблица со всеми значениями категорий
// 			документов в соответствии с протоколом обмена
//		ТипСоздаваемогоДокумента - Строка, наименование документа на КПК, из которого создать перемещение
Процедура СоздатьПеремещениеТоваров(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий)
	ДобавитьСообщение("Формируются перемещение товаров...");
	
	текДата = ТекущаяДата();
	Для Каждого СтрШапки Из ТаблШапок Цикл
		УникДок = СформироватьУникальныйКодДокумента("Перемещение", СтрШапки);
		СсылкаДок = ЕстьДокумент(УникДок);
		Если СсылкаДок <> Неопределено Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, СсылкаДок);
			СерверПослатьОтвет(Адрес,Ответ,0);
			ДобавитьОшибку("Документ " + УникДок + " уже загружен ранее.");
			Продолжить;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Неопределено, ОшибкаВыгрузкаСАктивнойТранзакцией);
			СерверПослатьОтвет(Адрес,Ответ,0);			
		Иначе		
			глПоследняяОшибкаПроведения = "";
			нетОшибок = Истина;
			НачатьТранзакцию();
			Попытка
				Если НЕ ЗначениеЗаполнено(СтрШапки.Склад) Тогда
					ВызовемИсключение = 1 / 0;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТаблСтрок.Количество() = 0) Тогда
					ВызовемИсключение = 1 / 0;
				КонецЕсли;
				
				Док = Документы.ПеремещениеТоваров.СоздатьДокумент();
				Док.Дата = ДатаИзДатаИВремя(СтрШапки.Дата, текДата);  //Время поставим текущее
				Док.Комментарий = СтрШапки.Комментарий;		
				Док.СкладОтправитель = СтрШапки.Склад;		
				Док.СкладПолучатель = ПараметрыАгента.Склады[0].Склад;
				Док.Организация = ПараметрыАгента.Организации[0].Организация; //Организацию берем первую из настроек агента 
				Док.Ответственный = ПараметрыАгента.Агент;
				Если Конфигурация = "БухБеларусь" Тогда
					Док.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукция;
				КонецЕсли;
				Если Конфигурация = "БухКазахстан" Тогда
					//Если ПараметрыАгента.ЗаполнятьАвтораВДокументах Тогда
					//	Док.Автор = ПараметрыАгента.Агент;
					//КонецЕсли;
					Док.УчитыватьКПН = ОрганизацияПлательщикКПН(Док.Организация);
					Если Док.УчитыватьКПН Тогда
						Док.ВидУчетаНУ = Справочники.ВидыУчетаНУ.НУ;
					КонецЕсли;
				Иначе
					Док.НДСвСтоимостиТоваров = Перечисления.ДействиеНДСВСтоимостиТоваров.НеИзменять;
				КонецЕсли;
				
				СтруктПоиска = Новый Структура;
				СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
				МассивСтрок = ТаблСтрок.НайтиСтроки(СтруктПоиска);
				ТаблКат = ТаблКатегорий.Скопировать(СтруктПоиска); 	
				
				СтруктураВалютаКПК = Неопределено;
				Если ПараметрыАгента.ВалютаКПК <> мВалютаРегламентированногоУчета Тогда
					СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
				КонецЕсли;
		
				Для Каждого СтрСтрок Из МассивСтрок Цикл
					Если СтрСтрок.Колво <= 0 Тогда 
						Продолжить; 
					КонецЕсли;
					СтрДок = Док.Товары.Добавить();
					СтрДок.Номенклатура		= СтрСтрок.Номенклатура;
					Если Конфигурация = "БухБеларусь" И СтрСтрок.Партия <> ""  Тогда
						СтрДок.Партия				= СтрСтрок.Партия;
					КонецЕсли;
					Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
						СтрДок.ЕдиницаИзмерения	= СтрСтрок.Единица;
						СтрДок.Коэффициент		= СтрСтрок.Коэффициент;
					КонецЕсли;
					СтрДок.Количество		= СтрСтрок.Колво;
				    СчетаУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрДок.Номенклатура, Док.СкладОтправитель, Док.Дата);
					Если Конфигурация = "БухКазахстан" Тогда
						СтрДок.СчетУчетаБУ = СчетаУчета.СчетУчетаБУ;
						СтрДок.НовыйСчетУчетаБУ = СтрДок.СчетУчетаБУ;
						УправлениеПроизводством.ЗаполнитьСчетНалоговогоУчетаВСтрокеТабличногоПоля(СтрДок, "СчетУчетаБУ", "СчетУчетаНУ", Док.Дата);	
						СтрДок.НовыйСчетУчетаНУ = СтрДок.СчетУчетаНУ;
					ИначеЕсли Конфигурация = "БухБеларусь" Тогда
						СтрДок.Цена = СтрСтрок.Цена;
						Если СтруктураВалютаКПК <> Неопределено Тогда
							СтрДок.Цена = ПересчитатьИзВалютыВВалюту(СтрДок.Цена,
								ПараметрыАгента.ВалютаКПК, мВалютаРегламентированногоУчета,
								СтруктураВалютаКПК.Курс, 1,
								СтруктураВалютаКПК.Кратность, 1);
						КонецЕсли;
					Иначе
						СтрДок.Цена = СтрСтрок.Цена;
						Если СтруктураВалютаКПК <> Неопределено Тогда
							СтрДок.Цена = ПересчитатьИзВалютыВВалюту(СтрДок.Цена,
								ПараметрыАгента.ВалютаКПК, мВалютаРегламентированногоУчета,
								СтруктураВалютаКПК.Курс, 1,
								СтруктураВалютаКПК.Кратность, 1);
						КонецЕсли;
						СтрДок.СчетУчета = СчетаУчета.СчетУчета;
						СтрДок.НовыйСчетУчета = ПолучитьСчетаУчетаНоменклатуры(Док.Организация, СтрДок.Номенклатура, Док.СкладПолучатель, Док.Дата).СчетУчета;
					КонецЕсли;
					ОбработатьДопРеквизитыСтрокиТЧ(Док, СтрДок, СтрСтрок.ДопРеквизиты, "37", "1");	
					
				КонецЦикла;
				
				Если Конфигурация = "БухБеларусь" Тогда
					//Процедура ЗаполнитьСчетаУчетаВТабЧасти(ТабличнаяЧасть, ИмяТабЧасти, ЗаполнятьБУ, ЗаполнятьНУ) Экспорт
					Док.ЗаполнитьСчетаУчетаВТабЧасти(Док.Товары, "Товары", Истина, Истина);
				КонецЕсли;
				
				Если ПараметрыАгента.СпособНумерацииДокументов = 0 Тогда //Стандартная 
					Док.УстановитьНовыйНомер(Док.Организация.Префикс);
				Иначе
					Док.Номер = СтрШапки.Номер;
				КонецЕсли;
				
				//запускаем обработку дополнительных реквизитов			
				ОбработатьДопРеквизитыДокумента(Док, СтрШапки.ДопРеквизиты, "37", "1");
				
				Если ПараметрыАгента.ПроводитьНаличиеИЦены Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					Док.Записать();
				КонецЕсли;
				
			Исключение
				нетОшибок = Ложь;
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения = ОписаниеОшибки();
				ИначеЕсли Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
					глПоследняяОшибкаПроведения = "Не выбран склад ИЛИ таблица товаров не заполнена";
				КонецЕсли;
			КонецПопытки;
			
			Если нетОшибок Тогда
				ЗаписатьУникКодДокумента(Док, УникДок);
				//заполнить категории документа
				ЗаполнитьКатегорииДокумента(Док.Ссылка, ТаблКат);
				//добавить свойство Время работы с документом
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУВремяСозданияДокумента;
				МенеджерЗаписи.Значение  = Строка(СтрШапки.ВремяРаботы);
				МенеджерЗаписи.Записать(Истина);
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект    = Док.ссылка;
				МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
				МенеджерЗаписи.Значение  = СтрШапки.ДатаСоздания;
				МенеджерЗаписи.Записать(Истина);
				
				ЗавершитьСобытие(Адрес, Платформа, "Наличие и цены", Док.Дата, СтрШапки.Контрагент, Док.Ссылка, УникДок, Строка(СтрШапки.ВремяРаботы), СтрШапки.Задание);
				ЗаписатьФотоДокумента(Док.Ссылка, СтрШапки.Фото, 37);
				ЗафиксироватьТранзакцию();
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, Док.Ссылка);
				СерверПослатьОтвет(Адрес,Ответ,0);
			Иначе
				ОтменитьТранзакцию();
				Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
					глПоследняяОшибкаПроведения="Документ Перемещение не создан"; 
					Если ПараметрыАгента.ПроводитьНаличиеИЦены Тогда
						глПоследняяОшибкаПроведения = "Ошибка при проведении документа. Обратитесь в офис, чтобы узнать подробности";
					КонецЕсли;
				КонецЕсли;
				СообщениеАгентуОбОшибке = глПоследняяОшибкаПроведения;
				Ответ = ОтветПоВыгрузкеДокумента(СтрШапки.ИдДок, , СообщениеАгентуОбОшибке);
				СерверПослатьОтвет(Адрес, Ответ, 0);
				ДобавитьВЛогФайл("Ошибка создания документа Перемещение: " + глПоследняяОшибкаПроведения, ПараметрыАгента.Агент, 0);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;

	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
КонецПроцедуры

// Разбирает запрос на загрузку инвентаризации и помещает данные в таблицы шапок и строк
// Адрес - идентификатор сессии обмена
// ТелоЗапроса - Текст полученный от КПК 
Функция ЗагрузитьИнвентаризации(Адрес, Платформа,ТелоЗапроса)
	ТекстДок = ?(ПараметрыАгента.ТипСоздаваемогоДокументаИнвентаризация = 0, "инвентаризации", "перемещения товаров");
	Если НЕ ПорцияОбмена(Адрес,"OK","Загружаются " + ТекстДок + "...") Тогда
		возврат ложь;
	КонецЕсли; 
	
	ТаблШапок=""; ТаблСтрок=""; ТаблКатегорий="";
	ПолучитьТаблицыИнвентаризаций(ТелоЗапроса, 5, ТаблШапок, ТаблСтрок, ТаблКатегорий);
	
	ТаблПользователей = ПрочитатьПользователейДляОповещения(ПараметрыАгента.Агент); //это Табл значений
	ТипСоздаваемогоДок = ПараметрыАгента.ТипСоздаваемогоДокументаИнвентаризация;
	Если ТипСоздаваемогоДок = 0 Тогда
		СоздатьИнвентаризации(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
	ИначеЕсли ТипСоздаваемогоДок = 1 Тогда
		СоздатьПеремещениеТоваров(Адрес, Платформа, ТаблШапок, ТаблСтрок, ТаблПользователей, ТаблКатегорий);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Выполняет формирование строк, содержащих значения реквизитов документа после коррекции
// в соответствии с протоколом обмена
// Параметры:
// 		Док - ДокументОбъект, претерпевший изменения алгоритмом коррекции
// 		СтрШапки - ТаблицаЗначений, содержит все реквизиты шапок корректируемых документов
// 			в соответствии с протоколом обмена
//		ТаблТовары - ТаблицаЗначений, содержит все реквизиты строк корректируемых документов
// 			в соответствии с протоколом обмена
// 		Ответ - Строка, к которой добавляется ответ для КПК
Процедура ЭкспортироватьНакладную(Док, СтрШапки, ТаблТовары, Ответ)
	КонтрагентКод = СокрЛП(Док.Контрагент.Код);
	кодКонтрагента = КонтрагентКод;
	Если СпособОрганизацииТТ = 1 И НЕ Док.АдресДоставки = "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформация.Вид.Код КАК КодАдресаДоставки
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Контрагент
		|	И КонтактнаяИнформация.Представление ПОДОБНО &АдресДоставки
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
		|	И КонтактнаяИнформация.Вид В(&ВидыКИ)";		
		Запрос.УстановитьПараметр("Контрагент", Док.Контрагент);
		Запрос.УстановитьПараметр("АдресДоставки", Док.АдресДоставки);
		Запрос.УстановитьПараметр("ВидыКИ", АдресаДляТТ.ВыгрузитьКолонку("АдресДляТТ"));
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			//код составим из кода контрагента и кода адреса
			кодКонтрагента = УпаковатьКодКонтрагентаИКодАдреса(КонтрагентКод, Выборка.КодАдресаДоставки);
		КонецЦикла;
	КонецЕсли;
	
	Шапка=
		ДатаВремяВСтрокуДляКПК(СтрШапки.Дата)+Таб
		+ СтрШапки.ИдДок+Таб
		+ СтрШапки.Номер+Таб
		+ СокрЛП(Док.Организация.Код)+Таб
		+ кодКонтрагента+Таб
		+ УникИдентификатор(Док.ДоговорКонтрагента)+Таб
		+ УникИдентификатор(Док.Склад)+Таб
		+ СтрШапки.Самовывоз+Таб
		+ СтрШапки.Комментарий+Таб
		+ УникИдентификатор(Док.ТипЦен)+Таб
		+ ?(СтрШапки.Проводной,"1","0")+Таб
		+ "0"+Таб
		+ ДатаВремяВСтрокуДляКПК(СтрШапки.ВремяДоставки)+Таб
		+ "0"+Таб
		+ СтрШапки.Форма+Таб
		+ СтрШапки.Ответ+Таб
		+ ДатаВремяВСтрокуДляКПК(СтрШапки.Время)+Таб
		+ СтрШапки.ДопРеквизиты + РазделительСтрок;
	
	ТаблДок = Док.Товары.Выгрузить();
	Для Каждого СтрДок Из Док.Услуги Цикл
		НовСтр=ТаблДок.Добавить();
		НовСтр.Номенклатура=СтрДок.Номенклатура;
		НовСтр.Количество=СтрДок.Количество;
		НовСтр.Цена=СтрДок.Цена;
		НовСтр.Сумма=СтрДок.Сумма;
		Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
			НовСтр.ЕдиницаИзмерения=СтрДок.Номенклатура.БазоваяЕдиницаИзмерения;
			НовСтр.Коэффициент=НовСтр.ЕдиницаИзмерения.Коэффициент;
		КонецЕсли;
	КонецЦикла;
	
	Строки = "";
	Ссылка = Неопределено;
	Для Каждого СтрТов Из ТаблДок Цикл
		СтрокиТабл = ТаблТовары.НайтиСтроки(Новый Структура("Номенклатура", СтрТов.Номенклатура));
		Если СтрокиТабл.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрТабл = СтрокиТабл[0];
		
		Строки = Строки
			+ УникИдентификатор(СтрТов.Номенклатура)+Таб
			+ КоличествоВСтроку(СтрТов.Количество)+Таб
			+ СокрЛП(СтрТов.ЕдиницаИзмерения.Код)+Таб
			+ КоличествоВСтроку(СтрТов.Коэффициент)+Таб
			+ ""+Таб
			+ СуммаВСтроку(Окр(СтрТов.Сумма / СтрТов.Количество, 2))+Таб
			+ СуммаВСтроку(СтрТов.Сумма)+Таб
			+ ?(СтрТабл = Неопределено,
				"" + Таб
				+ "" + Таб
				+ "" + Таб
				+ "0" + Таб
				+ "" + Таб
				+ "",
				?(СтрТабл.Остаток = -1, 
					"", 
					КоличествоВСтроку(СтрТабл.Остаток)) + Таб
					+ СтрТабл.Форма + Таб
					+ СтрТабл.Ответ + Таб
					+ "0" + Таб
					+ ?(СтрТабл.Фейсинг = -1, 
						"", 
						КоличествоВСтроку(СтрТабл.Фейсинг)) + Таб
					+ СтрТабл.ДопРеквизиты) + РазделительСтрок;						
	КонецЦикла;
	
	//добавим из исходного документа товары для которых не указано количество, а собраны только остатки
	ТолькоОстатки = ТаблТовары.НайтиСтроки(новый Структура("Колво",0));
	отбор = новый Структура("Номенклатура");
	для каждого ост из ТолькоОстатки Цикл
		//если в табличной части документа нет данных по этой строке, то надо её выгрузить
		отбор.Номенклатура = ост.Номенклатура;
		Если ТаблДок.НайтиСтроки(отбор).Количество() = 0 Тогда
			Строки=Строки
				+ УникИдентификатор(ост.Номенклатура)+Таб
				+ КоличествоВСтроку(ост.Колво)+Таб
				+ СокрЛП(ост.Единица.Код)+Таб
				+ КоличествоВСтроку(ост.Коэффициент)+Таб
				+ СуммаВСтроку(ост.Цена)+Таб
				+ СуммаВСтроку(ост.Сумма)+Таб
				+ ?(ост.Остаток = -1, "", КоличествоВСтроку(ост.Остаток)) + Таб
				+ ост.Форма + Таб
				+ ост.Ответ + Таб
				+ "0" + Таб
				+ ?(ост.Фейсинг = -1, "", КоличествоВСтроку(ост.Фейсинг)) + Таб
				+ ост.ДопРеквизиты + РазделительСтрок;			
		КонецЕсли;
	КонецЦикла;
	
	Ответ=Ответ+Шапка+Строки+РазделительСтрок;
КонецПроцедуры

// Выполняет загрузку реквизитов документа, коррекцию, подготовку отчёта об изменениях
// 		и отправку ответа КПК
// Параметры:
// 		ТелоЗапроса - Строка, запрос с КПК
// 		Табл - ТабличныйДокумент, в который формируется отчёт об изменениях
// 		Макет - Макет, на основе которого формируется отчёт об изменениях
// 		НомСтр - Число, номер строки, начиная с которой в запросе идёт информация о документе
// 		Ответ - Строка, в которую помещается ответ для КПК
// Возвращаемое значение:
// 		Число, номер строки, до которой выполнен разбор запроса
Функция СкорректироватьНакладную(ТелоЗапроса, Табл, Макет, НомСтр, Ответ)
	ТаблШапок=""; ТаблСтрок=""; ТаблКатегорий="";
	НомСтр = ПолучитьТаблицыНакладных(ТелоЗапроса, НомСтр + 1, ТаблШапок, ТаблСтрок, ТаблКатегорий);
	глПоследняяОшибкаПроведения = "";
	
	Для Каждого СтрШапки Из ТаблШапок Цикл
		Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		СтруктПоиска = Новый Структура;
		СтруктПоиска.Вставить("ИдДок", СтрШапки.ИдДок);
		ТаблТовары = ТаблСтрок.Скопировать(СтруктПоиска); //Таблица с товарами в накладной
		Попытка
			ЗаполнитьРеализациюТоваровИУслуг(Док, СтрШапки, ТаблТовары);
		Исключение
			нетОшибок = Ложь;
			Если ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
				глПоследняяОшибкаПроведения = ОписаниеОшибки();
			КонецЕсли;
			Если Найти(глПоследняяОшибкаПроведения, "Деление на 0") > 0 Тогда
				глПоследняяОшибкаПроведения = "Для контрагента " + Док.Контрагент + " не найден договор с покупателем";
			КонецЕсли;
		КонецПопытки;
		
		//при свертке теряются данные по распределению строк документа по складам, 
		//проблема - неясно как отрабатывать ситуацию когда строка разбивается на несколько 
		//различными складами
		Док.Товары.Свернуть("Номенклатура, ЕдиницаИзмерения, Коэффициент", "Количество, Сумма, СуммаНДС");
		
		ОтчетОбИзмененииДокумента(Табл, Макет, Док, СтрШапки, ТаблТовары, глПоследняяОшибкаПроведения);
		ЭкспортироватьНакладную(Док, СтрШапки, ТаблТовары, Ответ);
	КонецЦикла;
	
	Возврат НомСтр;
КонецФункции

// Выполняет загрузку реквизитов документа, коррекцию, подготовку отчёта об изменениях
// 		и отправку ответа КПК
// Параметры:
// 		Адрес - Строка, адрес КПК
// 		ТелоЗапроса - Строка, запрос с КПК
// Возвращаемое значение:
// 		Истина, всегда
Функция СкорректироватьДокументы(Адрес, ТелоЗапроса)
	
	Табл = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ИзмененияДокумента");
	
	Ответ = "";
	ТекНомерСтр = 5;
	СтрокВЗапросе = СтрЧислоСтрок(ТелоЗапроса);
	Пока ТекНомерСтр <= СтрокВЗапросе Цикл
		ВидДок = СтрПолучитьСтроку(ТелоЗапроса,ТекНомерСтр);
		Если ВидДок = "Invoice" Или ВидДок = "Request" Тогда
			ТекНомерСтр = СкорректироватьНакладную(ТелоЗапроса, Табл, Макет, ТекНомерСтр, Ответ);
		Иначе
			Ответ = "CorrectionNotImplemented" + РазделительСтрок;
			Прервать;
		КонецЕсли;
		
		ТекНомерСтр = ТекНомерСтр + 1;
	КонецЦикла;
	
	СерверПослатьОтвет(Адрес, Ответ, 0);
	Ответ = "";
	
	Если Табл.ВысотаТаблицы=0 Тогда
		Секция = Макет.ПолучитьОбласть("НетИзменений");
		Секция.Параметры.Реквизит = "Никаких изменений НЕ предлагается";
		Табл.Вывести(Секция);
	КонецЕсли;
	
	ВремФайл = ПолучитьИмяВременногоФайла(".htm");
	//Табл.Показать();
	Табл.Записать(ВремФайл,ТипФайлаТабличногоДокумента[ПараметрыАгента.HTML]);
	Файл=Новый ЧтениеТекста;
	Файл.Открыть(ВремФайл,КодировкаТекста.UTF8);
	Ответ="";
	Счетчик=0;
	Пока Истина Цикл
		Стр=Файл.ПрочитатьСтроку();
		Если Стр=Неопределено Тогда 
			Прервать; 
		КонецЕсли;
		
		Ответ=Ответ +Стр+РазделительСтрок;
		
		Счетчик=Счетчик+1;
		Если Счетчик%100=0 Тогда
			СерверПослатьОтвет(Адрес,Ответ,0);
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	Если Счетчик > 0 Тогда
		СерверПослатьОтвет(Адрес,Ответ,0);
		Ответ="";
	КонецЕсли;
	СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,1);
		
	Возврат Истина;
КонецФункции

//Формирует HTML-ку - отчет по последним трём продажам за последние 2 месяца
//Адрес - идентификатор сессии обмена
//Контрагенты - параметры, переданные КПК. На сегодня - код Контрагента
Процедура ОтчетПродажи(табДок, Контрагент, Договор, ДатаНачала, ДатаОкончания)	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Продажи.Ссылка КАК Документ,
	|	Продажи.Номенклатура КАК Номенклатура,
	|	СУММА(Продажи.Количество) КАК Колво
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Продажи
	|ГДЕ
	|	Продажи.Ссылка.Дата >= &ДатаНачала
	|	И Продажи.Ссылка.Дата <= &ДатаКонца
	|	И Продажи.Ссылка.Проведен" + ?(Договор.Пустая(), "", "
	|	И (Продажи.Ссылка.ДоговорКонтрагента = &Договор)") + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.Ссылка,
	|	Продажи.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продажи.Ссылка.Дата УБЫВ";
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Если СпособОрганизацииТТ = 0 Тогда  //по холдингам
		Запрос.УстановитьПараметр("Контрагент", Контрагент.ГоловнойКонтрагент);
	Иначе
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	КонецЕсли; 
	Запрос.УстановитьПараметр("Договор"		, Договор);
	Запрос.УстановитьПараметр("ДатаНачала"	, ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца"	, ДатаОкончания);
	продажа = Запрос.Выполнить().Выбрать();
	
	ТекДок = Неопределено;
	
	отчет = ПолучитьМакет("ОтчетПродажи");
	область = отчет.ПолучитьОбласть("ШапкаОтчета");
	область.Параметры.Период = "с " + Формат(ДатаНачала, "ДЛФ=D") + " по " + Формат(ДатаОкончания, "ДЛФ=D");
	область.Параметры.КонтаргентДоговор = "Контрагента " + Строка(Контрагент) + " по договору " + Строка(Договор);	
	табДок.Вывести(область);
	
	Пока продажа.Следующий() Цикл
		Если ТекДок <> продажа.Документ Тогда
			область = отчет.ПолучитьОбласть("СтрокаДокумент");
			область.Параметры.Документ = Строка(продажа.Документ);
			табДок.Вывести(область);
			ТекДок = продажа.Документ;
		КонецЕсли;	
		область = отчет.ПолучитьОбласть("СтрокаНоменклатура");
		область.Параметры.Номенклатура = 
			продажа.Номенклатура.Наименование + ", " + продажа.Номенклатура.БазоваяЕдиницаИзмерения;
		область.Параметры.Количество = Формат(продажа.Колво, "ЧДЦ=3");
		табДок.Вывести(область);		
	КонецЦикла;	
КонецПроцедуры

// Формирует отчёт, построенный на базе Системы компоновки данных
// Параметры
// Табл - Табличный документ, в эту переменную будет помещен результат отчета
// стрОтчет - Строка таблицы СписокОтчетов
// 			из таблицы закладки Отчёты настроек агента
// ПарамАгент - агент для которого формируется отчет
// ПарамКонтрагент - контрагент для которого формируется Отчет
// ПарамДоговор - договор для которого формируется Отчет
// ПарамНоменклатура - номенклатура для которого формируется Отчет
// ПарамОтветственный - Агент для которого формируется Отчет
// НачальнаяДата - дата начала для отчета
// КонечнаяДата - дата окончания для отчета
Функция СформироватьОтчетСКД(
		Табл,
		Отчет,
		СохраненнаяНастройка,
		стрОтчет,
		ПарамКонтрагент=Неопределено,
		ПарамДоговор=Неопределено,
		ПарамНоменклатура=Неопределено,
		ПарамОтветственный=Неопределено,
		НачальнаяДата=Неопределено,
		КонечнаяДата=Неопределено)
	Если Отчет.СхемаКомпоновкиДанных=Неопределено Тогда 
		Возврат Ложь; 
	КонецЕсли;
	
	Если СохраненнаяНастройка=Неопределено Тогда
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		Попытка
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(СохраненнаяНастройка));
		Исключение
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КонецПопытки;
	КонецЕсли;
	Отчет.КомпоновщикНастроек.Восстановить();
	
	Если стрОтчет.ПараметрыИзКПК=Истина Тогда
		ЭлемКонтрагент = Неопределено;
		ЭлемДоговор    = Неопределено;
		ЭлемОтветственный 	= Неопределено;
		ЭлемНоменклатура    = Неопределено;
		
		Отбор=Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы;
		Для каждого ЭлемОтбора Из Отбор Цикл
			Если Строка(ЭлемОтбора.ЛевоеЗначение)=стрОтчет.ОтборПоКонтрагенту Тогда
				ЭлемКонтрагент = ЭлемОтбора;
			ИначеЕсли Строка(ЭлемОтбора.ЛевоеЗначение)=стрОтчет.ОтборПоДоговору Тогда
				ЭлемДоговор = ЭлемОтбора;
			ИначеЕсли Строка(ЭлемОтбора.ЛевоеЗначение) = стрОтчет.ОтборПоОтветственному Тогда
				ЭлемОтветственный = ЭлемОтбора;
			ИначеЕсли Строка(ЭлемОтбора.ЛевоеЗначение) = стрОтчет.ОтборПоНоменклатуре Тогда
				ЭлемНоменклатура = ЭлемОтбора;
			КонецЕсли; 
		КонецЦикла;
		
		// Если в настройках отчета нет отбора по полю контрагента, а контрагент выбран на КПК, - добавим отбор.
		// Если контрагент на КПК не выбран, отбор не устанавливается и отчет формируется по всем контрагентам
		Если ЗначениеЗаполнено(ПарамКонтрагент) И (ЭлемКонтрагент = Неопределено) Тогда
			ЭлемКонтрагент = ДобавитьЭлементОтбораПоПолю(
				Отчет.КомпоновщикНастроек.Настройки.Отбор, стрОтчет.ОтборПоКонтрагенту, Отчет.СхемаКомпоновкиДанных);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПарамКонтрагент) и (ЭлемКонтрагент  <> Неопределено) Тогда
			ЭлемКонтрагент.ПравоеЗначение	 = ПарамКонтрагент;
			ЭлемКонтрагент.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлемКонтрагент.Использование  = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПарамДоговор) И (ЭлемДоговор <> Неопределено) Тогда
			ЭлемДоговор.ПравоеЗначение	= ПарамДоговор;
			ЭлемДоговор.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
			ЭлемДоговор.Использование	= Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПарамОтветственный) И (ЭлемОтветственный <> Неопределено) Тогда
			ЭлемОтветственный.ПравоеЗначение = ПарамОтветственный;
			ЭлемОтветственный.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлемОтветственный.Использование  = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПарамНоменклатура) И (ЭлемНоменклатура <> Неопределено) Тогда
			ЭлемНоменклатура.ПравоеЗначение	= ПарамНоменклатура;
			ЭлемНоменклатура.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлемНоменклатура.Использование  = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Период=Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
	Новый параметрКомпоновкиДанных("Период"));
	Если Период<>Неопределено Тогда
		Попытка
			Период.Значение.Вариант=ВариантСтандартногоПериода.ПроизвольныйПериод;
			Период.Использование = Истина;
			//Если ((НачальнаяДата=Неопределено) ИЛИ (КонечнаяДата=Неопределено)) ИЛИ НЕ стрОтчет.ЗапрашиватьПериод Тогда
			//	ДатаНач=ТекущаяДата();
			//	ДатаКон=ТекущаяДата();
			//	ПолучитьИнтервалОтчета(стрОтчет,ДатаНач,ДатаКон);
			//	Период.Значение.ДатаНачала=НачалоДня(ДатаНач);
			//	Период.Значение.ДатаОкончания=КонецДня(ДатаКон);
			//Иначе
			//	Период.Значение.ДатаНачала=НачалоДня(НачальнаяДата);
			//	Период.Значение.ДатаОкончания=КонецДня(КонечнаяДата);
			//КонецЕсли;
			Период.Значение.ДатаНачала=НачалоДня(НачальнаяДата);
			Период.Значение.ДатаОкончания=КонецДня(КонечнаяДата);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Попытка		
		Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", НачалоДня(НачальнаяДата));
	Исключение
	КонецПопытки;
	
	Попытка		
		Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", КонецДня(КонечнаяДата));
	Исключение
	КонецПопытки;

	
	
	Попытка
		Если ПараметрыАгента <> Неопределено Тогда
			Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Склад", ПараметрыАгента.Склады);
			Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПоВсемСкладам", (ПараметрыАгента.Склады.Количество()=0));
		Иначе
			Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПоВсемСкладам", Истина);
		КонецЕсли;
		
		
	Исключение
	КонецПопытки;
	
	
	ПараметрАгент = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый параметрКомпоновкиДанных("Ответственный"));
	Если ПараметрАгент <> Неопределено Тогда
		ПараметрАгент.Значение = ТекущийАгент;
		ПараметрАгент.Использование = Истина;
	КонецЕсли;
	
	Отчет.СформироватьОтчет(Табл);
КонецФункции

// Добавляет в отбор настроек отчета элемент отбора по полю, заданному в настройках отчета для КПК
// Параметры
//	Отбор - ОтборКомпоновкиДанных, отбор настроек отчета
//	ИмяПоля - Строка, путь к полю отчета или его заголовок
//	Схема - СхемаКомпоновкиДанных отчета, используется, если компоновщик настроек отчета не инициализирован
// Возвращаемое значение
//	ЭлементОтбораКомпоновкиДанных - добавленный элемент отбора, 
//	Неопределено - если поле не найдено среди доступных полей отбора
//
Функция ДобавитьЭлементОтбораПоПолю(Отбор, ИмяПоля, Схема = Неопределено)
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДоступноеПоле = Неопределено;
	Попытка
		ДоступноеПоле = Отбор.ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных(ИмяПоля));
	Исключение
	КонецПопытки;
	
	Если ДоступноеПоле = Неопределено Тогда
		// в настройках могло быть сохранено не имя поля, а его заголовок
		Для Каждого Поле Из Отбор.ДоступныеПоляОтбора.Элементы Цикл
			Если НЕ Поле.Папка И Поле.Заголовок = ИмяПоля Тогда
				ДоступноеПоле = Поле;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ДоступноеПоле <> Неопределено Тогда
		ПолеОтбора = ДоступноеПоле.Поле;
	Иначе
		// компоновщик настроек отчета может быть не инициализирован схемой (например, во внешних отчетах
		// инициализация выполняется только при открытии формы), тогда ищем поле в наборах данных схемы
		ПутьКДанным = НайтиПутьКПолюВСхеме(Схема, ИмяПоля);
		Если ПутьКДанным = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПолеОтбора = Новый ПолеКомпоновкиДанных(ПутьКДанным);
	КонецЕсли;
	
	ЭлемОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлемОтбора.ЛевоеЗначение = ПолеОтбора;
	ЭлемОтбора.Использование = Ложь;
	Возврат ЭлемОтбора;
КонецФункции

// Ищет поле в наборах данных схемы компоновки по пути к данным или заголовку
// Параметры
//	Схема - СхемаКомпоновкиДанных
//	ИмяПоля - Строка, путь к полю или его заголовок
// Возвращаемое значение
//	Строка - путь к данным найденного поля, Неопределено - если поле не найдено
//
Функция НайтиПутьКПолюВСхеме(Схема, ИмяПоля)
	Если Схема = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого НаборДанных Из Схема.НаборыДанных Цикл
		Для Каждого Поле Из НаборДанных.Поля Цикл
			Попытка
				Если Поле.ПутьКДанным = ИмяПоля ИЛИ Поле.Заголовок = ИмяПоля Тогда
					Возврат Поле.ПутьКДанным;
				КонецЕсли;
			Исключение
				// папки полей не содержат пути к данным
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Формирует Табличный документ с отчетом для передачи в КПК  
// Параметры
// Табл - Табличный документ, в эту переменную будет помещен результат отчета
// стрОтчет - Строка таблицы СписокОтчетов
// ПарамАгент - агент для которого формируется отчет
// ПарамКонтрагент - контрагент для которого формируется Отчет
// ПарамДоговор - договор для которого формируется Отчет
// ПарамНоменклатура - номенклатура для которого формируется Отчет
// ПарамОтветственный - Агент для которого формируется Отчет
// НачальнаяДата - дата начала для отчета
// КонечнаяДата - дата окончания для отчета
Процедура СформироватьОтчет(
		Табл,
		Агент,
		стрОтчет,
		ПарамКонтрагент=Неопределено,
		ПарамДоговор=Неопределено,
		ПарамНоменклатура=Неопределено,
		НачальнаяДата=Неопределено,
		КонечнаяДата=Неопределено) Экспорт
		
	Если стрОтчет.ТипОтчета = "Встроенный" Тогда
		ОтчетПродажи(Табл, ПарамКонтрагент, ПарамДоговор, НачальнаяДата, КонечнаяДата);		
	Иначе	
		Если НЕ ЗначениеЗаполнено(стрОтчет.ИмяОтчета) Тогда
			Сообщить("Не задано поле 'ИмяОтчета' для отчета "+стрОтчет.НазваниеОтчета);
		КонецЕсли;
		Если стрОтчет.ТипОтчета="Из конфигурации" Тогда //из конфигурации
			Попытка
				Отчет=Отчеты[стрОтчет.ИмяОтчета].Создать();  //попробуем создать отчет
			Исключение
				Сообщить("Не удалось найти в конфигурации отчет "+стрОтчет.ИмяОтчета);
				Возврат;
			КонецПопытки; 
		ИначеЕсли стрОтчет.ТипОтчета="Внешний отчет" Тогда //внешний 
			Попытка
				Отчет = ВнешниеОтчеты.Создать(стрОтчет.ИмяОтчета);
			Исключение
				Сообщить("Не удалось найти отчет "+стрОтчет.ИмяОтчета);
				Возврат;
			КонецПопытки; 
		КонецЕсли;
		
		текДата = ТекущаяДата();
		Если НачальнаяДата = Неопределено ИЛИ КонечнаяДата = Неопределено Тогда
			Если НЕ стрОтчет.ЗапрашиватьПериод Тогда
				НачальнаяДата=текДата;
				КонечнаяДата=текДата;
				ПолучитьИнтервалОтчета(стрОтчет,НачальнаяДата,КонечнаяДата);
			Иначе
				НачальнаяДата = НачалоДня(ДобавитьМесяц(текДата, -2));
				КонечнаяДата = КонецДня(текДата)
			КонецЕсли;
		КонецЕсли;
		
		//читаем настройки для этого отчета
		СохраненнаяНастройка = ПрочитатьИзРегистраСохраненныеНастройки(Агент, стрОтчет.КодОтчета);
		СформироватьОтчетСКД(
			Табл,
			Отчет,
			СохраненнаяНастройка,
			стрОтчет,
			ПарамКонтрагент,
			ПарамДоговор,
			ПарамНоменклатура, 
			Агент, 
			НачальнаяДата, 
			КонечнаяДата);
	КонецЕсли;
КонецПроцедуры

// Рассчитывает дату начала и окончания периода для формирования отчёта
// Параметры:
// 		стрОтчет - строка Таблицы значений, содержит параметры отчёта
// 			из таблицы закладки Отчёты настроек агента
// 		ДатаНач - Дата, сюда возвращается дата начала
// 		ДатаКон - Дата, сюда возвращается дата конца
Процедура ПолучитьИнтервалОтчета(стрОтчет,ДатаНач,ДатаКон);
	
	Если СокрЛП(стрОтчет.ЗначениеКонечнойДаты)="Сегодня" Тогда
		ДатаКон=ТекущаяДата();
	ИначеЕсли СокрЛП(стрОтчет.ЗначениеКонечнойДаты)="Конец пред.месяца" Тогда
		ДатаКон=ТекущаяДата();
        ДатаКон=ДобавитьМесяц(ДатаКон,-1);
		ДатаКон=КонецМесяца(ДатаКон);
	Иначе //не заполнен параметр	 
		ДатаКон=ТекущаяДата();
	КонецЕсли; 
	
	Если СокрЛП(стрОтчет.ТипСмещенияНачальнойДаты)="Месяц" Тогда
		ДатаНач=ДобавитьМесяц(ДатаКон,-1*стрОтчет.СмещениеНачальнойДаты);
		
	ИначеЕсли СокрЛП(стрОтчет.ТипСмещенияНачальнойДаты)="С начала месяца" Тогда
		ДатаНач=ДобавитьМесяц(ДатаКон,-1*стрОтчет.СмещениеНачальнойДаты);
		ДатаНач=НачалоМесяца(ДатаНач);

	ИначеЕсли СокрЛП(стрОтчет.ТипСмещенияНачальнойДаты)="День" Тогда
		ДатаНач=НачалоДня(ДатаКон - стрОтчет.СмещениеНачальнойДаты*24*60*60);
		
	Иначе // НЕ задан тип смещения берем 2 месяца назад
		ДатаНач=ДобавитьМесяц(ДатаКон,-2);
	КонецЕсли; 
	
	ДатаНач = НачалоДня(ДатаНач);
	ДатаКон = КонецДня(ДатаКон);
	
КонецПроцедуры

// Прочитать таблицу с отчетами
// Если таблицы НЕ существует то создаем новую и грузим текущее содержимое Табличной части Отчеты
Функция ПрочитатьОтчеты(Агент)
	ТЗ = ПрочитатьИзРегистраСохраненныеНастройки(Агент,"Отчеты"); //это Табл значений
	Если ТипЗнч(ТЗ) <> Тип("ТаблицаЗначений") Тогда
		ТЗ = Новый ТаблицаЗначений;
	КонецЕсли;
	Если ТЗ.Колонки.Найти("КодОтчета")= Неопределено Тогда
		ТЗ.Колонки.Добавить("КодОтчета", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(12, ДопустимаяДлина.Переменная)));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("ТипОтчета")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ТипОтчета", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(15, ДопустимаяДлина.Переменная)));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("ИмяОтчета")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ИмяОтчета", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	КонецЕсли; 	 
    Если ТЗ.Колонки.Найти("НазваниеОтчета")= Неопределено Тогда
		 ТЗ.Колонки.Добавить("НазваниеОтчета", 
		 	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("ТипСмещенияНачальнойДаты")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ТипСмещенияНачальнойДаты", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(20, ДопустимаяДлина.Переменная)));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("ЗначениеКонечнойДаты")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ЗначениеКонечнойДаты", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная)));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("Загружать")= Неопределено Тогда
		ТЗ.Колонки.Добавить("Загружать", 
			Новый ОписаниеТипов("Булево"));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("ПараметрыИзКПК")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ПараметрыИзКПК", 
			Новый ОписаниеТипов("Булево"));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("ЗапрашиватьПериод")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ЗапрашиватьПериод", 
			Новый ОписаниеТипов("Булево"));
	КонецЕсли; 	 
	Если ТЗ.Колонки.Найти("СмещениеНачальнойДаты")= Неопределено Тогда
		ТЗ.Колонки.Добавить("СмещениеНачальнойДаты",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный))); 
	КонецЕсли;
	Если ТЗ.Колонки.Найти("ОтборПоКонтрагенту")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ОтборПоКонтрагенту", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	КонецЕсли;  
	Если ТЗ.Колонки.Найти("ОтборПоДоговору")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ОтборПоДоговору", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	КонецЕсли;      
	Если ТЗ.Колонки.Найти("ОтборПоНоменклатуре")= Неопределено Тогда
		ТЗ.Колонки.Добавить("ОтборПоНоменклатуре", 
			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	КонецЕсли;      
	Если ТЗ.Колонки.Найти("ОтборПоОтветственному")= Неопределено Тогда
		 ТЗ.Колонки.Добавить("ОтборПоОтветственному", 
		 	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	КонецЕсли;      
	Если ТипЗнЧ(ТЗ) = Тип(Новый ТаблицаЗначений) Тогда
		Для каждого стрТЗ Из ТЗ Цикл
			Если НЕ ЗначениеЗаполнено(стрТЗ.ТипСмещенияНачальнойДаты) Тогда
				стрТЗ.ПараметрыИзКПК=Истина;
				стрТЗ.ЗапрашиватьПериод=Истина;
				стрТЗ.СмещениеНачальнойДаты=2;
				стрТЗ.ТипСмещенияНачальнойДаты="Месяц";
				стрТЗ.ЗначениеКонечнойДаты="Сегодня";
			КонецЕсли; 
		КонецЦикла; 
		возврат ТЗ
	Иначе  //Отчетов нет 
	КонецЕсли; 
	возврат ТЗ;
КонецФункции //

// Новые версии Моби-С будут присылать отчёты об ошибках с описанием ошибки и дампом стека
// НачСтр - строка Запроса, с которой начинается отчёт
// Адрес - идентификатор сессии обмена
// Агент - для кого выгружаем
Функция ЗагрузитьОтчетОбОшибках(Адрес,Запрос)
	ДобавитьВЛогФайл("Загружается отчёт об ошибках",ПараметрыАгента.Агент,1);
	
	Буфер=Запрос;
	Для Н=1 По 4 Цикл
		Поз=Найти(Буфер,Символы.ПС);
		Если Поз=0 Тогда Прервать; КонецЕсли;
		
		Буфер=Сред(Буфер,Поз+1);
	КонецЦикла;
	
	Текст=Новый ЗаписьТекста;
	Текст.Открыть(ПолучитьКаталог("Logs") 
		+ "\ErrorLog_"+СокрЛП(УдалитьЗапрещенныеСимволыИмени(ПараметрыАгента.Агент.Код))+".txt",,,Истина);
	Текст.Записать(Буфер);
	Текст.Закрыть();	
		
	КолвоЗаписей = СтрЧислоСтрок(Запрос);
	Дата = Неопределено;
	Если КолвоЗаписей >= 5 Тогда
		Блокировщик = Неопределено;
		БД = ОткрытьВнешнююБД(Блокировщик, Истина);
		
		БДЗапросБезРезультата(БД, "PRAGMA journal_mode=MEMORY");
		БДЗапросБезРезультата(БД, "PRAGMA synchronous=OFF");		
		
		Если БД = Ложь Тогда
			Сообщить("Не удалось получить доступ к файлу внешней базы данных mobi_s.sqlite3!", СтатусСообщения.Важное);
			Возврат Ложь;
		КонецЕсли;			
		Попытка
			ТекстЗапроса="
				|CREATE TABLE IF NOT EXISTS Log (
				|    [Agent] TEXT PRIMARY KEY,
				|    [DateTime] DateTime PRIMARY KEY,
				|    [Sequence] Intege4 PRIMARY KEY,
				|    [Level] Integer4,
				|    [Message] Text,
				|    Primary Key([Agent],[DateTime],[Sequence]))
				|";

			БДЗапросБезРезультата(БД, ТекстЗапроса);
		Исключение
			ОписаниеОшибки=ОписаниеОшибки();
			ДобавитьВЛогФайл(ОписаниеОшибки,ПараметрыАгента.Агент);
		КонецПопытки;
		
		ПодгЗапрос=БДПодготовитьЗапрос(БД, "INSERT OR IGNORE INTO Log([Agent],[DateTime],[Sequence],[Level],[Message]) VALUES(?,?,?,?,?)");
		
		БДУстановитьПараметр(ПодгЗапрос, 1, Строка(ПараметрыАгента.Агент.ФизЛицо.Код));
		
		ОшибкаОтправки = "";
		
		Для Н=5 По КолвоЗаписей Цикл
			Запись = СтрЗаменить(СтрПолучитьСтроку(Запрос, Н), Таб, РазделительСтрок);
			Если СтрЧислоСтрок(Запись) = 4 Тогда
				Попытка //При повторной загрузке вылетит Primary Key
					Попытка
						ДатаВремя = ДатаИзСтрокиСКПК(СтрПолучитьСтроку(Запись,1));
					Исключение
						ДатаВремя = ТекущаяДатаСуточнаяКоррекция();
					КонецПопытки;
					Индекс=СтрокуВЧисло(СтрПолучитьСтроку(Запись,2));
					Уровень=СтрокуВЧисло(СтрПолучитьСтроку(Запись,3));
					Сообщение=СтрПолучитьСтроку(Запись,4);
					Сообщение=СтрЗаменить(Сообщение,Символ(14),Таб);
					Сообщение=СтрЗаменить(Сообщение,Символ(15),РазделительСтрок);
					
					БДУстановитьПараметр(ПодгЗапрос, 2, ДатаДляSQLite(ДатаВремя));
					БДУстановитьПараметр(ПодгЗапрос, 3, Индекс);
					БДУстановитьПараметр(ПодгЗапрос, 4, Уровень);
					БДУстановитьПараметр(ПодгЗапрос, 5, Сообщение);
					БДСледующаяЗапись(ПодгЗапрос);
					БДСбросПодготовленногоЗапроса(ПодгЗапрос);
				Исключение
					ОшибкаОтправки = ОшибкаОтправки + "Ошибка при записи лога агента "+РазделительСтрок
									  + ОписаниеОшибки() + РазделительСтрок
									  + "Агент = " + ПараметрыАгента.Агент + РазделительСтрок
									  + "ДатаВремя = " + ДатаВремяВСтрокуДляКПК(ДатаВремя) + РазделительСтрок
									  + "Индекс = " + Индекс + РазделительСтрок
									  + "Уровень = " + Уровень + РазделительСтрок
									  + "Сообщение = " + Сообщение + РазделительСтрок;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		Если ОшибкаОтправки = "" Тогда
		Иначе
			ДобавитьВЛогФайл(ОшибкаОтправки, ПараметрыАгента.Агент);
			//Если ТехПоддержкаАвтоматическаяОтправка Тогда 
			//	ОтправитьОшибкуВТехподдержку(ПараметрыАгента.Агент, "Запись лога агента" + РазделительСтрок + ОшибкаОтправки); 
			//КонецЕсли;
		КонецЕсли;		
		
		БДЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
		
		БДЗапросБезРезультата(БД, "PRAGMA journal_mode=DELETE");
		БДЗапросБезРезультата(БД, "PRAGMA synchronous=FULL");
		
		ЗакрытьВнешнююБД(БД, Блокировщик);
	КонецЕсли;	
		
	СерверПослатьОтвет(Адрес,"OK"+РазделительСтрок,1);
	
	Возврат Истина;
КонецФункции

// Находит событие для заданного документа, устанавливает у события статус завершения
// 		и связывает событие с документом
// Параметры:
// 		Адрес - Строка, адрес КПК
// 		Платформа - Строка, идентификатор платформы КПК
// 		ВидСобытия - Строка, указывает вид задания (Заказ, Продажа, ПКО и др.)
// 		Дата - Дата, дата документа
// 		Контрагент - ссылка на элем. спр. Контрагенты, контрагент, по которому завершать событие
// 		Документ - ДокументСсылка, документ, который был загружен
// 		УникДок - Строка, уникальный код документа, сформированный
// 			функцией СформироватьУникальныйКодДокумента
// 		ВремяОформления - Число, время, затраченное агентом на оформление документа на КПК
// Возвращаемое значение:
// 		Истина, всегда
Функция ЗавершитьСобытие(Адрес, Платформа, ВидСобытия, Дата, Контрагент, Документ, УникДок, ВремяОформления, КодЗадания)
	Если ЗаданияВозможны Тогда
		стрGUID = ВернутьПробелыGUID(КодЗадания); //вернем на место символы "-" (минус)
		Попытка
			GUID = Новый УникальныйИдентификатор(стрGUID); //получили уникальный код объекта
		Исключение
			Возврат Истина;
		КонецПопытки;		
		Событие = Документы.Событие.ПолучитьСсылку(GUID);
		Если Не ЗначениеЗаполнено(Событие) Тогда 
			Возврат Истина; 
		КонецЕсли;
		Событие = Событие.ПолучитьОбъект();
		
		Если Событие = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Если Событие.Контрагент <> Контрагент Тогда
			Возврат Истина;
		КонецЕсли;
		
		Событие.СостояниеСобытия = Перечисления.СостоянияСобытий.Завершено;
		Событие.Записать();
		
		Запись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		Запись.Объект = Документ;
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Задание");
		Запись.Значение = Событие.Номер;
		Запись.Записать();
		
		Запись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		Запись.Объект    = Событие.Ссылка;
		Запись.Свойство  = ПВХУникКодДокумента;
		Запись.Значение  = УникДок;
		Запись.Записать(Истина);
		
		Запись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		Запись.Объект    = Событие.Ссылка;
		Запись.Свойство  = ПВХУВремяСозданияДокумента;
		Запись.Значение  = ВремяОформления;
		Запись.Записать(Истина);
		
		МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект    = событие.ссылка;
		МенеджерЗаписи.Свойство  = ПВХУДатаСозданияДокумента;
		МенеджерЗаписи.Значение  = Событие.Дата;
		МенеджерЗаписи.Записать(Истина);
		
		ДобавитьВЛогФайл("Завершено событие " + Событие.Номер, ПараметрыАгента.Агент, 0);
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

// Выполняет загрузку отчёта о выполнении произвольного задания с КПК
// Параметры:
// Адрес - Строка, адрес КПК
// Запрос - Строка, запрос с КПК, в соответствии с протоколом обмена
// Возвращаемое значение:
// 		Истина, всегда
Функция ЗагрузитьОтчетОВыполнении(Адрес,Запрос)
	ДобавитьВЛогФайл("Загружаются отчёты о выполнении",ПараметрыАгента.Агент,1);
	
	СерверПослатьОтвет(Адрес,"OK"+РазделительСтрок,0);
	
	Для НомерСтрокиЗапроса=5 По СтрЧислоСтрок(Запрос) Цикл
		Попытка
			НачатьТранзакцию();
				
			СтрокаДок=СтрПолучитьСтроку(Запрос,НомерСтрокиЗапроса);
			
			Параметры=СтрЗаменить(СтрокаДок,Таб,РазделительСтрок);
			ДатаДок=ДатаИзСтрокиСКПК(СтрПолучитьСтроку(Параметры,1));
			ВремяДок = Сред(СтрПолучитьСтроку(Параметры,1),12); 
			ИдДок=СтрПолучитьСтроку(Параметры,2);
			ИдСобытия=СтрПолучитьСтроку(Параметры,4);
			Статус=СтрПолучитьСтроку(Параметры,5);
			Отчет=СтрПолучитьСтроку(Параметры,6);
			Фото=СтрЗаменить(СтрПолучитьСтроку(Параметры,7),Символ(31),РазделительСтрок);
			ДатаСоздания=ДатаИзСтрокиСКПК(СтрПолучитьСтроку(Параметры,8));
			ВремяРаботы=Число(СтрПолучитьСтроку(Параметры,9));
			
			ИдСобытия=ВернутьПробелыGUID(ИдСобытия);
			Событие=Документы.Событие.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСобытия));
			Если Событие.Пустая() Тогда
				ДобавитьВЛогФайл("Событие с Ид "+ИдСобытия+" НЕ найдено",ПараметрыАгента.Агент,1);
				
				Ответ=Строка(ИдДок)+таб+таб+РазделительСтрок;
				СерверПослатьОтвет(Адрес,Ответ,0);
				
				Продолжить;
			КонецЕсли;
			
			Событие=Событие.ПолучитьОбъект();
			Если Событие = Неопределено Тогда
				ДобавитьВЛогФайл("Событие с Ид "+ИдСобытия+" не найдено",ПараметрыАгента.Агент,1);
				
				Ответ=Строка(ИдДок)+таб+таб+РазделительСтрок;
				СерверПослатьОтвет(Адрес,Ответ,0);
				
				Продолжить;
			КонецЕсли;
			Событие.СостояниеСобытия=?(Статус="1",
				Перечисления.СостоянияСобытий.Завершено,
				Перечисления.СостоянияСобытий.Отменено);
			Событие.Комментарий=Отчет;
			Если НЕ ПустаяСтрока(Фото) Тогда
				Событие.Комментарий=Событие.Комментарий+" Фото:"+Фото;
			КонецЕсли;
			Событие.Записать();
			
			СтрШапки=Новый Структура("ИдДок,Дата,Время",ИдДок,ДатаДок,ВремяДок);
			УникДок = СформироватьУникальныйКодДокумента("Событие",СтрШапки);
			ЗаписатьУникКодДокумента(Событие,УникДок);
			
			МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = Событие.Ссылка;
			МенеджерЗаписи.Свойство = ПВХУДатаСозданияДокумента;
			МенеджерЗаписи.Значение = Строка(ДатаСоздания);
			МенеджерЗаписи.Записать(Истина);
			
			МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = Событие.Ссылка;
			МенеджерЗаписи.Свойство = ПВХУВремяСозданияДокумента;
			МенеджерЗаписи.Значение = Строка(ВремяРаботы);
			МенеджерЗаписи.Записать(Истина);
			
			ЗафиксироватьТранзакцию();
			
			Ответ=Строка(ИдДок)+Таб+Таб+РазделительСтрок;
			СерверПослатьОтвет(Адрес, Ответ, 0);
			
			ДобавитьВЛогФайл("Завершено событие "+Событие.Номер,ПараметрыАгента.Агент,0);				
			
			ЗаписатьФотоДокумента(Событие.Ссылка, Фото, 35);
		Исключение
			ОтменитьТранзакцию();
			Ответ = Строка(ИдДок) + Таб + Таб + УбратьСпецСимволы(ОписаниеОшибки()) + РазделительСтрок;
			СерверПослатьОтвет(Адрес,Ответ,0);
			ДобавитьВЛогФайл("Ошибка выгрузки события " + ИдДок + " - " + ОписаниеОшибки(), ПараметрыАгента.Агент, 0);				
			
		КонецПопытки;
	КонецЦикла;
	
	СерверПослатьОтвет(Адрес,РазделительСтрок,1);
	Возврат Истина;
КонецФункции

// Формирует отчёт об изменении документа алгоритмом коррекции путём
// сравнения того, что было с тем, что стало
// Параметры:
// 		Табл - ТабличныйДокумент, таблица отчёта об изменениях
// 		Макет - Макет, по которому формируется отчёт
// 		Док - ДокументОбъект, претерпевший изменения алгоритмом коррекции
// 		СтрШапки - ТаблицаЗначений, содержит все реквизиты шапок корректируемых документов
// 			в соответствии с протоколом обмена
//		ТаблТовары - ТаблицаЗначений, содержит все реквизиты строк корректируемых документов
// 			в соответствии с протоколом обмена
Процедура ОтчетОбИзмененииДокумента(Табл, Макет, Док, СтрШапки, ТаблТовары, глПоследняяОшибкаПроведения)
	
	Если Не ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда
		Секция = Макет.ПолучитьОбласть("НетИзменений");
		Секция.Параметры.Реквизит = глПоследняяОшибкаПроведения;
		Табл.Вывести(Секция);
		Секция.Параметры.Реквизит = "Нажмите ОТКЛОНИТЬ ИЗМЕНЕНИЯ!";
		Табл.Вывести(Секция);
		Возврат;
	КонецЕсли;
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Организация","Организация","Организация"));
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Контрагент","Контрагент","Контрагент"));
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Договор","ДоговорКонтрагента","Договор"));
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Тип цены","ТипЦен","ТипЦены"));
	
	ВывелиШапкуШапки = Ложь;
	Для Каждого Рекв Из Реквизиты Цикл
		ЗначРеквТабл = СтрШапки[Рекв.РеквизитТабл];
		ЗначРеквДок = Док[Рекв.РеквизитДок];
		
		Если ЗначРеквТабл = ЗначРеквДок Тогда Продолжить; КонецЕсли;
		
		Если НЕ ВывелиШапкуШапки Тогда
			Секция = Макет.ПолучитьОбласть("РеквизитыШапки");
			Табл.Вывести(Секция);
			ВывелиШапкуШапки = Истина;
		КонецЕсли;
		Секция = Макет.ПолучитьОбласть("Изменение");
		Секция.Параметры.Реквизит = Рекв.Наименование;
		Секция.Параметры.СтароеЗначение = ЗначРеквТабл;
		Секция.Параметры.НовоеЗначение = ЗначРеквДок;
		Табл.Вывести(Секция);
	КонецЦикла;
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Количество","Количество","Колво"));
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Бонус","Бонус","Бонус"));
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Цена","Цена","Цена"));
	Реквизиты.Добавить(Новый Структура("Наименование,РеквизитДок,РеквизитТабл", "Сумма","Сумма","Сумма"));
	
	Док.Товары.Свернуть("Номенклатура, ЕдиницаИзмерения, Коэффициент", "Количество, Сумма, СуммаНДС");
	Если Док.УчитыватьНДС И Не Док.СуммаВключаетНДС Тогда
		Для Каждого СтрДок Из Док.Товары Цикл
			СтрДок.Сумма = Окр((СтрДок.Сумма + СтрДок.СуммаНДС) / СтрДок.Количество, 2) * СтрДок.Количество;
		КонецЦикла;
	КонецЕсли;
	
	Если ПараметрыАгента.ВалютаКПК <> Док.ВалютаДокумента Тогда
		СтруктураВалютаКПК = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Док.Дата, Новый Структура("Валюта", ПараметрыАгента.ВалютаКПК));
		Для Каждого СтрДок Из Док.Товары Цикл
			СтрДок.Сумма = ПересчитатьИзВалютыВВалюту(СтрДок.Сумма,
				Док.ВалютаДокумента, ПараметрыАгента.ВалютаКПК,
				Док.КурсВзаиморасчетов, СтруктураВалютаКПК.Курс,
				Док.КратностьВзаиморасчетов, СтруктураВалютаКПК.Кратность);
		КонецЦикла;
		Для Каждого СтрДок Из Док.Услуги Цикл
			СтрДок.Сумма = ПересчитатьИзВалютыВВалюту(СтрДок.Сумма,
				Док.ВалютаДокумента, ПараметрыАгента.ВалютаКПК,
				Док.КурсВзаиморасчетов, СтруктураВалютаКПК.Курс,
				Док.КратностьВзаиморасчетов, СтруктураВалютаКПК.Кратность);
		КонецЦикла;
	КонецЕсли;
	
	ТаблДок = Док.Товары.Выгрузить();
	
	Для Каждого СтрДок Из Док.Услуги Цикл
		НовСтр = ТаблДок.Добавить();
		НовСтр.Номенклатура=СтрДок.Номенклатура;
		НовСтр.Количество=СтрДок.Количество;
		НовСтр.Цена=СтрДок.Цена;
		НовСтр.Сумма=СтрДок.Сумма;
		НовСтр.ЕдиницаИзмерения=СтрДок.Номенклатура.БазоваяЕдиницаИзмерения;
		НовСтр.Коэффициент=НовСтр.ЕдиницаИзмерения.Коэффициент;
	КонецЦикла;
		
	ЦенаВключаетНДС = Док.ТипЦен.ЦенаВключаетНДС;
	
	Для Каждого СтрДок Из ТаблДок Цикл
		ТекТовар = "";
		СтрокиТабл = ТаблТовары.НайтиСтроки(Новый Структура("Номенклатура", СтрДок.Номенклатура));
		Если СтрокиТабл.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрТабл = СтрокиТабл[0];
		
		Для Каждого Рекв Из Реквизиты Цикл
			Если Рекв.Наименование = "Бонус" Тогда
				ЗначРеквТабл = СтрТабл[Рекв.РеквизитТабл];
				ЗначРеквДок = 0;
			ИначеЕсли Рекв.Наименование = "Цена" Тогда
				ЗначРеквТабл = СтрТабл[Рекв.РеквизитТабл];
				ЗначРеквДок = Окр(СтрДок.Сумма / СтрДок.Количество, 2);
			ИначеЕсли Рекв.Наименование = "Сумма" Тогда
				ЗначРеквТабл = Окр(СтрТабл[Рекв.РеквизитТабл], 2);
				ЗначРеквДок = СтрДок.Сумма;
			Иначе
				ЗначРеквТабл = СтрТабл[Рекв.РеквизитТабл];
				ЗначРеквДок = СтрДок[Рекв.РеквизитДок];
			КонецЕсли;
			Если ЗначРеквТабл <> ЗначРеквДок Тогда
				Если ТекТовар <> СтрДок.Номенклатура Тогда
					Секция = Макет.ПолучитьОбласть("РеквизитыСтроки");
					Секция.Параметры.ИдСтроки = СтрДок.Номенклатура;
					Табл.Вывести(Секция);
					ТекТовар = СтрДок.Номенклатура;
				КонецЕсли;
				Секция = Макет.ПолучитьОбласть("Изменение");
				Секция.Параметры.Реквизит = Рекв.Наименование;
				Секция.Параметры.СтароеЗначение = ЗначРеквТабл;
				Секция.Параметры.НовоеЗначение = ЗначРеквДок;
				Табл.Вывести(Секция);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Табл.ВысотаТаблицы = 0 Тогда
		Секция = Макет.ПолучитьОбласть("НетИзменений");
		Секция.Параметры.Реквизит = "Никаких изменений НЕ предлагается";
		Табл.Вывести(Секция);
	КонецЕсли;
КонецПроцедуры

// Выполняет расчёт маршрута между двумя клиентами и отправку ответа КПК
// Параметры:
// 		Адрес - Строка, адрес КПК
// 		ТелоЗапроса - Строка, запрос с КПК
// Возвращаемое значение:
// 		Истина, всегда
Функция СформироватьМаршрут(Адрес, ТелоЗапроса)
	КонтрагентОткуда=Справочники.Контрагенты.ПустаяСсылка();
	КонтрагентКуда=Справочники.Контрагенты.ПустаяСсылка();
	мАдресДоставки= "";
	НачШирота=0; НачДолгота=0;
	
	Точки=СтрЗаменить(СтрПолучитьСтроку(ТелоЗапроса,5),Таб,РазделительСтрок);
	НачШирота=Число(СтрПолучитьСтроку(Точки,1));
	НачДолгота=Число(СтрПолучитьСтроку(Точки,2));
	
	Точки=СтрЗаменить(СтрПолучитьСтроку(ТелоЗапроса,6),Таб,РазделительСтрок);
	
	ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
	Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
		ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
		Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
			Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
				ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	
	ПолучитьКонтрагентаИАдресПоКоду(СтрПолучитьСтроку(Точки,1),КонтрагентОткуда,мАдресДоставки, ПапкаРодителя);
	ПолучитьКонтрагентаИАдресПоКоду(СтрПолучитьСтроку(Точки,2),КонтрагентКуда,мАдресДоставки, ПапкаРодителя);
	
	Форма=ПолучитьФорму("ПрокладкаМаршрутов",ЭтаФорма);
	
	Широты=""; Долготы=""; ДлинаПути=0; ВремяПути=0;
	КонШирота=0;КонДолгота=0;
	Статус=Форма.ПроложитьПуть(
		ПараметрыАгента.Агент, 
		КонтрагентОткуда, 
		КонтрагентКуда,
		НачШирота,
		НачДолгота,
		КонШирота,
		КонДолгота, 
		Широты, 
		Долготы,
		ДлинаПути,
		ВремяПути);
	Если Статус<>"" Тогда
		Ответ=Статус+РазделительСтрок;
		СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,1);
		
		Возврат Истина;
	КонецЕсли;
	
	Ответ = "OK"+РазделительСтрок 
		+ КоординатаВСтроку(НачШирота) + Таб 
		+ КоординатаВСтроку(НачДолгота) + Таб 
		+ КоординатаВСтроку(КонШирота) + Таб
		+ КоординатаВСтроку(КонДолгота) + РазделительСтрок;
	КолТочек=Широты.Количество();
	Для Н=0 По КолТочек-1 Цикл
		Ответ=Ответ
			+КоординатаВСтроку(Широты[Н])+Таб
			+КоординатаВСтроку(Долготы[Н])+РазделительСтрок;
	КонецЦикла;
	
	СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,1);
	
	Возврат Истина;
КонецФункции

//Отправляет на мобильное устройство параметры связи с учётной системой
Функция ВыгрузитьНастройкиУстройства(Адрес, ТелоЗапроса)
	Ответ="OK"+РазделительСтрок;
	
	КодыУстройства=Новый Массив;
	Для Н=5 По СтрЧислоСтрок(ТелоЗапроса) Цикл
		Стр=СтрПолучитьСтроку(ТелоЗапроса,Н);
		
		Если Лев(Стр,15)="КодыУстройства"+Таб Тогда
			СтрКоды=СтрЗаменить(Сред(Стр,16),Таб,РазделительСтрок);
			Для НомерКода=1 По СтрЧислоСтрок(СтрКоды) Цикл
				КодыУстройства.Добавить(СтрПолучитьСтроку(СтрКоды,НомерКода));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Ответ=Ответ
		+"Название"+Таб
		+ИмяКомпьютера()+": "+ПолучитьЗаголовокСистемы()+" - "+ИмяПользователя()+РазделительСтрок
		+"Версия"+Таб
		+ВерсияПротокола+РазделительСтрок
		+"КодАгента"+Таб
		+СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код)+РазделительСтрок
		+"ИмяАгента"+Таб
		+УбратьСпецСимволы(Строка(ПараметрыАгента.Агент))+РазделительСтрок;
	НайденныйКод="";
	ВозможенДемоРежим=Истина;
	Если СтрЧислоСтрок(КодыУстройства)>0 Тогда
		ТаблКлючей=ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"СписокКПК");
		Для Каждого СтрКлюч Из ТаблКлючей Цикл
			Если НЕ ПустаяСтрока(НайденныйКод) Тогда Прервать; КонецЕсли;
			
			ВозможенДемоРежим=Ложь;
			Для Каждого КодУстройства Из КодыУстройства Цикл
				Если СокрЛП(СтрКлюч.КодКПК)<>СокрЛП(КодУстройства) Тогда Продолжить; КонецЕсли;
				
				НайденныйКод=КодУстройства;
				ДобавитьВЛогФайл(
					"Для активации устройства будет использован следующий ключ активации с привязкой к устройству с кодом: " 
					+ СтрКлюч.КодКПК,ПараметрыАгента.Агент,0);
				Прервать;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Если НайденныйКод="" Тогда
		ФормаКлючи=ПолучитьФорму("Ключи");
		ТаблКлючей=Новый ТаблицаЗначений;
		ТаблКлючей.Колонки.Добавить("КодАктивации");
		ТаблКлючей.Колонки.Добавить("Агент");
		ТаблКлючей.Колонки.Добавить("Ключ");
		ТаблКлючей.Колонки.Добавить("Активация");
		ТаблКлючей.Колонки.Добавить("Версия");
		ТаблКлючей.Колонки.Добавить("Комментарий");
		ТаблКлючей.Колонки.Добавить("КодАгента");
		ТаблКлючей.Колонки.Добавить("КодВерсии");
		ФормаКлючи.ЗаполнитьТаблицуКлючейИзФайла(ТаблКлючей);
		ИсхТаблКлючей=ТаблКлючей.Скопировать();
		ЕстьСвободныйИнтернетКлюч=Ложь;
		Для Каждого Стр Из ТаблКлючей Цикл
			ВозможенДемоРежим=Ложь;
			Если ПустаяСтрока(Стр.КодАгента) Тогда
				ЕстьСвободныйИнтернетКлюч=Истина;
			КонецЕсли;
			Если СокрЛП(Стр.КодАгента)=СокрЛП(ПараметрыАгента.Агент.ФизЛицо.Код) Тогда
				НайденныйКод="АктивацияЧерезИнтернет";
				ДобавитьВЛогФайл(
					"Для активации устройства будет использован следующий ключ активации через Интернет: "+Стр.КодАктивации,
					ПараметрыАгента.Агент,0);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПустаяСтрока(НайденныйКод) И ЕстьСвободныйИнтернетКлюч Тогда
			Для Каждого Стр Из ТаблКлючей Цикл
				Если НЕ ПустаяСтрока(Стр.КодАгента) Тогда Продолжить; КонецЕсли;
				
				Стр.Агент=ПараметрыАгента.Агент;
				Стр.КодАгента=ПараметрыАгента.Агент.ФизЛицо.Код;
				Если ФормаКлючи.СохранитьOnLineКлючи(ИсхТаблКлючей,ТаблКлючей) Тогда
					ДобавитьВЛогФайл(
						"Для активации устройства будет использован следующий ключ активации через Интернет: "+Стр.КодАктивации,
						ПараметрыАгента.Агент,0);
					НайденныйКод="АктивацияЧерезИнтернет";
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ВозможенДемоРежим Тогда
		ДобавитьВЛогФайл("Мобильное устройство будет работать в Демо-режиме",ПараметрыАгента.Агент,0);
		Ответ=Ответ
			+"КодУстройства"+Таб
			+"Демо"+РазделительСтрок;
	ИначеЕсли НЕ ПустаяСтрока(НайденныйКод) Тогда
		Ответ=Ответ
			+"КодУстройства"+Таб
			+НайденныйКод+РазделительСтрок;
	Иначе
		ДобавитьВЛогФайл("Не удалось найти свободный ключ активации для устройства",ПараметрыАгента.Агент,0);
	КонецЕсли;
	
	ИспользоватьСерверМобиС=ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"ИспользоватьСерверМобиС");
	Если ЗначениеЗаполнено(НастройкиУстройстваЛокальныйАдрес) Тогда
		Ответ=Ответ
			+"Сервер"+Таб
			+"Внутри офиса"+Таб
			+НастройкиУстройстваЛокальныйАдрес+Таб
			+ЧислоВСтроку(Порт)+РазделительСтрок;
	КонецЕсли;
	Если ЗначениеЗаполнено(НастройкиУстройстваВнешнийАдрес) Тогда
		Ответ=Ответ
			+"Сервер"+Таб
			+"Внешний"+Таб
			+НастройкиУстройстваВнешнийАдрес+Таб
			+ЧислоВСтроку(Порт)+РазделительСтрок;
	КонецЕсли;
	Если ИспользоватьСерверМобиС=Истина Тогда
		КодУчетнойСистемы=ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"КодУчетнойСистемы");
		ПарольУчетнойСистемы=ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"ПарольУчетнойСистемы");
		Ответ=Ответ
			+"ОблачныйСервер"+Таб
			+КодУчетнойСистемы+Таб
			+ПарольУчетнойСистемы+РазделительСтрок;
	КонецЕсли;
	
	СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,1);
	
	Возврат Истина;
КонецФункции

//устанавливает признак необходимости обновить ключи на других обработках
Процедура УстановитьПризнакНеобходимостиОбновленияКлючейДляСервера() Экспорт
	актОбработки = ПолучитьАктивныеОбработкиСуществующихСеансов();	
	Для каждого обработка из актОбработки Цикл
		Если обработка.ГУИД = ГУИДЭкземпляра Тогда
		//на себя обновления не регистрируем	
		Иначе
			Попытка
				стрОбновитьКлючи = РегистрыСведений.СохраненныеНастройки.СоздатьМенеджерЗаписи();		
				стрОбновитьКлючи.Пользователь = МобиС;
				стрОбновитьКлючи.ИмяОбъекта = обработка.ГУИД;
				стрОбновитьКлючи.НаименованиеНастройки = "ОбновитьКлючи";
				стрОбновитьКлючи.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Определяет вид запроса и вызывает соответствующий обработчик
// Адрес - идентификатор сессии обмена
// ПараметрыАгента - Структура, со всеми параметрами агента 
// ИмяЗапроса - Строка, имя полученного запроса
// ТелоСообщения - Строка, текст полученного запроса
Процедура ОбработкаЗапроса(Адрес, ИмяЗапроса, ТелоЗапроса, Платформа)
	
	Статус = Ложь;
	
	//Отчёт*******************************************************************************
	Если ИмяЗапроса = "Report" Тогда
		СерверПослатьОтвет(Адрес,"OK"+РазделительСтрок,0);
		
		тзОтчеты = ПрочитатьОтчеты(ПараметрыАгента.Агент); //прочитаем все отчеты 
		
		КодОтчета=СокрП(СтрПолучитьСтроку(ТелоЗапроса,5));
		СтрПарам=СокрП(СтрПолучитьСтроку(ТелоЗапроса,6));
		//параметры передаются с 6 строки в виде КодКонтрагента +Таб+ КодДоговора
		КолСтр = СтрЧислоСтрок(ТелоЗапроса);
		КодКонтрагента = "";
		КодДоговора = "";
		Для Н = 6 По КолСтр Цикл
			ТекСтр=СтрПолучитьСтроку(ТелоЗапроса,Н);
			СтрПарам=СтрЗаменить(ТекСтр,Таб,РазделительСтрок);
			//получить Контрагента, АдресДоставки, Договор и Номенклатуру
			//контрагент
			КодКонтрагента = СокрЛП(СтрПолучитьСтроку(СтрПарам,1));   
			Контрагент  = Справочники.Контрагенты.ПустаяСсылка();
			АдресДоставки="";
			
			ПапкаРодителя = Справочники.Контрагенты.ПустаяСсылка();
			Если ПараметрыАгента.ОтборПапокКлиентов.Количество() > 0 Тогда
				ЗнПапкаРодителя = ПараметрыАгента.ОтборПапокКлиентов.Получить(0);
				Если ТипЗнч(ЗнПапкаРодителя.Значение) = Тип("СписокЗначений") Тогда
					Если ЗнПапкаРодителя.Значение.Количество() > 0 Тогда
						ПапкаРодителя = ЗнПапкаРодителя.Значение[0].Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			
			ПолучитьКонтрагентаИАдресПоКоду(КодКонтрагента,Контрагент,АдресДоставки, ПапкаРодителя);
			//Договор
			КодДоговора = СокрЛП(СтрПолучитьСтроку(СтрПарам,2));    
			Договор = ?(ПустаяСтрока(КодДоговора), 
					Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), 
					Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВернутьПробелыGUID(КодДоговора))));
			// номенклатура
			//КодНоменклатуры = СокрЛП(СтрПолучитьСтроку(СтрПарам,3));
			КодыНоменклатуры = СтрПолучитьСтроку(СтрПарам,3);
			Номенклатура = Новый Массив;
			СтрокиКодовНоменклатуры=СтрЗаменить(КодыНоменклатуры,Символ(30),РазделительСтрок);
			Если ПустаяСтрока(СтрокиКодовНоменклатуры) Тогда
			Иначе
				КолвоКодов=СтрЧислоСтрок(СтрокиКодовНоменклатуры);
				Для НомерКода=1 По КолвоКодов Цикл
					спрНом = ПолучитьСсылкуПоGUID(СтрПолучитьСтроку(СтрокиКодовНоменклатуры,НомерКода), "Номенклатура");
					Номенклатура.Добавить(спрНом);
				КонецЦикла;
			КонецЕсли;
				
			стрОтчет = тзОтчеты.Найти(КодОтчета,"КодОтчета");
			Если стрОтчет <> Неопределено Тогда //Нашел отчет
				//доработка - задание периода отчета на КПК
				НачальнаяДата = ТекущаяДата();
				КонечнаяДата = НачальнаяДата;
				Если стрОтчет.ЗапрашиватьПериод 
					И СокрЛП(СтрПолучитьСтроку(СтрПарам,4))<>"" 
					И СокрЛП(СтрПолучитьСтроку(СтрПарам,5))<>"" Тогда
					НачальнаяДата = НачалоДня(ДатаИзСтрокиСКПК(СтрПолучитьСтроку(СтрПарам,4))); 
					КонечнаяДата =  КонецДня(ДатаИзСтрокиСКПК(СтрПолучитьСтроку(СтрПарам,5))); 
				Иначе
					ПолучитьИнтервалОтчета(стрОтчет,НачальнаяДата,КонечнаяДата);
				КонецЕсли;
				//доработка - задание периода отчета на КПК				
				Если НачальнаяДата <= КонечнаяДата Тогда
					ДобавитьВЛогФайл(
						"Выполняется запрос 'Отчет' " + стрОтчет.НазваниеОтчета + "(" + КодОтчета + ") по контрагенту "
						+ Контрагент + "(" + КодКонтрагента + ")", ПараметрыАгента.Агент, 0);
					ВремФайл = ПолучитьИмяВременногоФайла(".htm");
					Табл = новый ТабличныйДокумент;
					//заполнить таблицу отчета
					СформироватьОтчет(
						Табл, ПараметрыАгента.Агент, стрОтчет, Контрагент, Договор, Номенклатура, НачальнаяДата, КонечнаяДата);
					//сохранить таблицу с данными отчета в файл
					Табл.Записать(ВремФайл,ТипФайлаТабличногоДокумента[ПараметрыАгента.HTML]);
					//отослать на КПК параметры отчета
					СерверПослатьОтвет(Адрес,СокрЛП(КодКонтрагента)+Таб+КодДоговора+Таб+"UTF8"+РазделительСтрок,0);
					//отослать на КПК тело запроса
					Файл=Новый ЧтениеТекста;
					Файл.Открыть(ВремФайл,КодировкаТекста.UTF8);
					Ответ="";
					Счетчик=0;
					Пока Истина Цикл
						Стр=Файл.ПрочитатьСтроку();
						Если Стр=Неопределено Тогда 
							Прервать; 
						КонецЕсли;							
						Ответ=Ответ
							+Стр+РазделительСтрок;							
						Счетчик=Счетчик+1;
						Если Счетчик%100=0 Тогда
							СерверПослатьОтвет(Адрес,Ответ,0);
							Ответ="";
						КонецЕсли;
					КонецЦикла;
					Если Счетчик > 0 Тогда
						СерверПослатьОтвет(Адрес,Ответ,0);
						Ответ="";
					КонецЕсли;
					СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,0);
				Иначе
					СерверПослатьОтвет(Адрес,СокрЛП(КодКонтрагента)+Таб+КодДоговора+Таб+"Windows-1251"+РазделительСтрок,0);					
					Ответ=
					"<!DOCTYPE html PUBLIC ""-//W3C//DTD XHTML 1.0 Transitional//EN"" ""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"">
					|<html xmlns=""http://www.w3.org/1999/xhtml"">
					|<head>
					|  <title>Неизвестный отчёт</title>
					|  <meta http-equiv=""Content-Type"" content=""text/html; charset=Windows-1251"" />
					|</head>
					|<body style=""font-family:Arial;"">
					|  <p style=""text-align: center"">
					|    Запрошен отчёт на некорректный период.
					|  </p>
					|</body>
					|</html>";					
					СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,0);
				КонецЕсли;
			Иначе  //нет такого отчета
				СерверПослатьОтвет(Адрес,СокрЛП(КодКонтрагента)+Таб+КодДоговора+Таб+"Windows-1251"+РазделительСтрок,0);
				
				Ответ=
				"<!DOCTYPE html PUBLIC ""-//W3C//DTD XHTML 1.0 Transitional//EN"" ""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"">
				|<html xmlns=""http://www.w3.org/1999/xhtml"">
				|<head>
				|  <title>Неизвестный отчёт</title>
				|  <meta http-equiv=""Content-Type"" content=""text/html; charset=Windows-1251"" />
				|</head>
				|<body style=""font-family:Arial;"">
				|  <p style=""text-align: center"">
				|    Запрошен неизвестный вид отчёта '" + КодОтчета + "'.<br/>
				|	Обратитесь к ответственному за настройку Моби-С в Вашей организации.<br/>
				|	После произведите Полный обмен!
				|  </p>
				|</body>
				|</html>";
				
				СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,0);
			КонецЕсли;
			
		КонецЦикла;
		СерверПослатьОтвет(Адрес,РазделительСтрок,1);
		ДобавитьВЛогФайл("Запрос '"+ИмяЗапроса+"' успешно обработан",ПараметрыАгента.Агент,0);
		Сервер.ЗапросОбработан();
		
		//Загрузка файла (обновление программы)******************************************
	ИначеЕсли ИмяЗапроса="FileLoad" Тогда
		Попытка
			ИмяФайла=СтрПолучитьСтроку(ТелоЗапроса,СтрЧислоСтрок(ТелоЗапроса));
			Статус=ВыгрузитьФайл(Адрес,ИмяФайла,Платформа);
		Исключение
			Ошибка=ОписаниеОшибки();
			Сообщить(Ошибка);
			ДобавитьВЛогФайл(
				"Исключительная ситуация при обработке FileLoad " + ИмяФайла + " " + Ошибка + Символы.ПС 
				+ "Принятые с КПК данные" + Символы.ПС 
				+ ТелоЗапроса,ПараметрыАгента.Агент,0);
			ПерезапускСервера();
			Если ТехПоддержкаАвтоматическаяОтправка Тогда 
				ОтправитьОшибкуВТехподдержку(ПараметрыАгента.Агент, ИмяЗапроса + РазделительСтрок + Ошибка); 
			КонецЕсли;
		КонецПопытки;
		
		ЗапросОбработан(ПараметрыАгента.Агент,ИмяЗапроса,Статус);
		
	Иначе
		Попытка
			//Полная загрузка*********************************************************************
			Если ИмяЗапроса="FullLoad" Тогда
				Статус = ВыгрузитьДанные(Адрес, Платформа);
			//Загрузка Документов Продажа в компьютер ********************************************
			ИначеЕсли ИмяЗапроса="Invoice" Тогда
				Статус = ЗагрузитьРасходныеНакладные(Адрес, Платформа, ТелоЗапроса, 0);
			//Загрузка Документов Заявка в компьютер *********************************************
			ИначеЕсли ИмяЗапроса="Request" Тогда
				Статус = ЗагрузитьРасходныеНакладные(Адрес, Платформа, ТелоЗапроса, 1);
			//Загрузка Документов Инвентаризация
			ИначеЕсли ИмяЗапроса="Inventory" Тогда
				Статус = ЗагрузитьИнвентаризации(Адрес, Платформа, ТелоЗапроса);
			//Загрузка Документов Покупка в компьютер ********************************************
			ИначеЕсли ИмяЗапроса="ReceiptInvoice" Тогда
				Статус = ЗагрузитьПриходныеНакладные(Адрес, Платформа, ТелоЗапроса);
			//Загрузка данных о новом клиенте ****************************************************
			ИначеЕсли ИмяЗапроса="NewClient" Тогда
				Статус = ЗагрузитьНовыхКлиентов(Адрес, ТелоЗапроса);
			//Загрузка лога событий произошедших на КПК ******************************************
			ИначеЕсли ИмяЗапроса="ErrorLog" Тогда 
				Статус = ЗагрузитьОтчетОбОшибках(Адрес, ТелоЗапроса);
			//Обновить остатки********************************************************************
			ИначеЕсли ИмяЗапроса="Rests" Тогда
				Статус = ВыгрузитьОстатки(Адрес, Платформа);
			//Быстрые остатки*********************************************************************
			ИначеЕсли ИмяЗапроса="FastRests" Тогда
				Статус = ВыгрузитьБыстрыеОстатки(Адрес);
				СерверПослатьОтвет(Адрес,"",1); //передаем пустую строку		
			//Подсказки по продажам **************************************************************
			ИначеЕсли ИмяЗапроса="SalesHelp" Тогда
				Статус = ВыгрузитьПодсказкиПродажПоЗапросу(Адрес, ТелоЗапроса,5);
			//Документ ПКО************************************************************************
			ИначеЕсли ИмяЗапроса="PKO" Тогда
				Статус = ЗагрузитьПКО(Адрес, Платформа, ТелоЗапроса);
			//Документ Анкета*********************************************************************
			ИначеЕсли ИмяЗапроса="Anketa" Тогда
				Статус = ЗагрузитьАнкеты(Адрес, Платформа, ТелоЗапроса);
			//GPS-координаты агента **************************************************************
			ИначеЕсли ИмяЗапроса="GPS" Тогда
				Статус = ЗагрузитьКоординаты(Адрес, ТелоЗапроса);
			//GPS-координаты Контрагентов*********************************************************
			ИначеЕсли ИмяЗапроса="GPSClient" Тогда
				Статус = ЗагрузитьКоординатыКонтрагентов(Адрес, ТелоЗапроса);
			//обновление программы****************************************************************
			ИначеЕсли ИмяЗапроса="GetUpdate" Тогда
				Статус = ВыгрузитьСписокФайловДляОбновления(Адрес, Платформа);
			//Изменение статуса сообщения*********************************************************
			ИначеЕсли ИмяЗапроса="MSGStatus" Тогда
				Статус = ИзменитьСтатусСообщений(Адрес, ТелоЗапроса);
			//Запрос на загрузку сообщений********************************************************
			ИначеЕсли ИмяЗапроса="Messages" Тогда
				Статус = ВыгрузитьСообщенияПоЗапросу(Адрес, "1,2,3");	
			//Выгрузка отчета о выполнении заданий************************************************
			ИначеЕсли ИмяЗапроса="TaskReport" Тогда
				Статус = ЗагрузитьОтчетОВыполнении(Адрес, ТелоЗапроса);
			//Запрос на выгрузку данных о маршруте агента ****************************************
			ИначеЕсли ИмяЗапроса="FastTasks" Тогда
				Статус = ВыгрузитьМаршруты(Адрес, Платформа, ПараметрыАгента.ВыгружатьМаршруты, Ложь, Неопределено);
			//Запрос на коррекцию документа ******************************************************
			ИначеЕсли ИмяЗапроса="ImproveDocuments" Тогда
				Статус = СкорректироватьДокументы(Адрес, ТелоЗапроса);
			ИначеЕсли ИмяЗапроса="Route" Тогда
				Статус = СформироватьМаршрут(Адрес, ТелоЗапроса);
			ИначеЕсли ИмяЗапроса="GetDeviceSettings" Тогда
				Статус = ВыгрузитьНастройкиУстройства(Адрес, ТелоЗапроса);
			ИначеЕсли ИмяЗапроса="ClientPrices" Тогда
				Статус = ВыгрузитьЦеныКонтрагента(Адрес, ТелоЗапроса);
			Иначе
			//Кто-то чужой к нам лезет************************************************************
				ДобавитьВЛогФайл("Неизвестный запрос '"+ИмяЗапроса+"'",ПараметрыАгента.Агент,0);
				ОтправитьОшибку(Адрес,"FORMAT_ERROR");
				Сервер.ЗапросОбработан();
				Возврат;
			КонецЕсли;
		Исключение
			Ошибка=ОписаниеОшибки();
			Сообщить(Ошибка);
			Ошибка=Ошибка+РазделительСтрок+"Тело запроса:"+РазделительСтрок+ТелоЗапроса;
			ДобавитьВЛогФайл("Исключительная ситуация при обработке "+ИмяЗапроса+" "+Ошибка,ПараметрыАгента.Агент,0);
			ПерезапускСервера();
			Если ТехПоддержкаАвтоматическаяОтправка Тогда 
				ОтправитьОшибкуВТехподдержку(ПараметрыАгента.Агент, ИмяЗапроса + РазделительСтрок + Ошибка); 
			КонецЕсли;			
		КонецПопытки;
		
		ЗапросОбработан(ПараметрыАгента.Агент,ИмяЗапроса,Статус);
		
		//если это был запрос настроек с КПК, то необходимо обновить файл ключей
		Если ИмяЗапроса = "GetDeviceSettings" Тогда
			ПутьКФайлуКлючей=КаталогЛогФайлов+"\lickeys_utf8.txt";
			файлКлючи = новый Файл(ПутьКФайлуКлючей);
			Если файлКлючи.Существует() Тогда
				Состояние("Обновление лицензионных ключей");
				
				Статус = Сервер.ОбновитьФайлКлючей();
				Если Не ПустаяСтрока(Статус) Тогда
					Если Найти(Статус, "Ошибка запроса к серверу активации") > 0 Тогда
						ЗапуститьПриложение("https://mobi-c.ru/help/error7.htm");
					КонецЕсли;						
					Предупреждение(Статус);	
				КонецЕсли;				
				
				УстановитьПризнакНеобходимостиОбновленияКлючейДляСервера();
				
				Состояние("");
			Иначе
				Сообщить("Файл ключей не найден.");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаСобытияPocketServer(Источник, Заголовок, ТелоСообщения)
	Если РежимОтладки Тогда
		ДобавитьВЛогФайл(ТелоСообщения);
	КонецЕсли;
	
	Адрес = Заголовок;
	
	КолСтрок=СтрЧислоСтрок(ТелоСообщения);
	Если КолСтрок < 3 Тогда  //Тело сообщения должно содержать минимум 3 строки
		Сообщить(Адрес+": неверный формат запроса");
		ОтправитьОшибку(Адрес,"Неверный формат запроса");
		ДобавитьВЛогФайл("Неверный формат запроса "+ТелоСообщения);
		Сервер.ЗапросОбработан();
		Возврат;
	КонецЕсли;	
	
	Версия=ПолучитьСтрокуБез13(ТелоСообщения,1);
	Платформа =ПолучитьСтрокуБез13(ТелоСообщения,2);
	ИмяЗапроса = "";
	Если Найти("|Android|WM|HTML|","|"+Платформа+"|")=0 Тогда
		//Версия 4.8 или ранее
		КодАгента=ПолучитьСтрокуБез13(ТелоСообщения,2);
		ИмяЗапроса=ПолучитьСтрокуБез13(ТелоСообщения,3);
		Если НЕ ИмяЗапроса="CurrentPosition" Тогда
			Платформа="WM";
		КонецЕсли;
	Иначе
		//Версия 4.9 или позднее
		ИмяЗапроса=ПолучитьСтрокуБез13(ТелоСообщения,4);
		Если ИмяЗапроса="GetDeviceSettings" Тогда
			КодАгента=НастройкиУстройстваКодАгента;
			Если ПустаяСтрока(КодАгента) Тогда
				//СерверПослатьОтвет(Адрес, "Сначала нужно в обработке обмена данными в 1С зайти в настройки агента и нажать кнопку 'Настроить устройство'"+РазделительСтрок+РазделительСтрок,1);
				СерверПослатьОтвет(Адрес, 
					"На мобильном устройстве активировано 'Подключение к учетной системе'.
					|Для загрузки настроек Агента в устройство, откройте в модуле интеграции Моби-С 
					|Справочники / Агенты, в настройках Агента нажмите кнопку 'Настроить мобильное устройство'"
					+ РазделительСтрок + РазделительСтрок,1);
				Возврат;
			КонецЕсли;
		Иначе
			КодАгента=ПолучитьСтрокуБез13(ТелоСообщения,3);
		КонецЕсли;
	КонецЕсли;
	
	КодАгента = СтрЗаменить(КодАгента, Символ(30), РазделительСтрок);
	ПарольНаОбменДанными = "";
	Если СтрЧислоСтрок(КодАгента)>=2 Тогда
		ПарольНаОбменДанными=СтрПолучитьСтроку(КодАгента, 2);
	КонецЕсли;
	КодАгента = СтрПолучитьСтроку(КодАгента, 1);
	агент = ПолучитьАгентаПоКоду(КодАгента);
	ЗаписатьВРегистрСохраненныеНастройки(агент, ТекущаяДата(), "ПоследнийОткликАгента");
		
	ДобавитьВЛогФайл("Получен запрос: "+Версия+Таб+КодАгента+Таб+Платформа+Таб+ИмяЗапроса);
	
	Если ИмяЗапроса="CurrentPosition" Тогда
		Если КодАгента<>"" Тогда
			Сообщить(Адрес+": неверный формат запроса");
			ОтправитьОшибку(Адрес,"Неверный формат запроса");
			ДобавитьВЛогФайл("Неверный формат запроса "+ТелоСообщения);
			Сервер.ЗапросОбработан();
			Возврат;
		КонецЕсли;
		
		СохранитьТекущиеКоординатыАгентов(ТелоСообщения);
		Сервер.ЗапросОбработан();
		Возврат;
	КонецЕсли;

	Если (Версия<>ВерсияПротокола) 
		И (ИмяЗапроса<>"FileLoad") 
		И (ИмяЗапроса<>"GetUpdate") 
		И (ИмяЗапроса<>"GetDeviceSettings") 
		Тогда  
		//Пора обновлять программу на КПК
		ДобавитьВЛогФайл("Версия  ("+Версия+") НЕ поддерживается",,,СтатусСообщения.Важное);
		ОтправитьОшибку(Адрес,"INCORRECT_VERSION" + РазделительСтрок);
		Сервер.ЗапросОбработан();
		Возврат;
	КонецЕсли;
	
	//ПараметраАгента - структура со всеми персональными настройками агента 
	//(отбор Номенклатуры, Контрагентов, склад и др.)
	ПараметрыАгента = ПолучитьВсеНастройкиАгента(КодАгента);
	Если (ПараметрыАгента = Неопределено)  или (ПараметрыАгента.Агент = Неопределено) Тогда
		ДобавитьВЛогФайл("Агент с кодом '"+КодАгента+"' НЕ найден в справочнике пользователей",,,СтатусСообщения.Важное);
		ОтправитьОшибку(Адрес,"Агент с кодом '"+КодАгента+"' НЕ найден в справочнике пользователей");
		Сервер.ЗапросОбработан();
		Возврат;
	КонецЕсли;
	ТекущийАгент = ПараметрыАгента.Агент;
	
	ОбработкаЗапроса(Адрес,ИмяЗапроса,ТелоСообщения,Платформа);
КонецПроцедуры

Процедура ОбработкаСобытияSkyServer(Источник, Заголовок, ТелоСообщения)
	ТребуетсяПерезапускСервера = Ложь;
	Если Заголовок = "Ping" Тогда
		Сервер.Pong();
	Иначе
		Если ТелоСообщения="SKY_SERVER_DISCONNECTED" Тогда
			ЭлементыФормы.КнопкаОблачныйСерверПодключен.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверНеПодключен.Видимость=Истина;
			ЭлементыФормы.КнопкаОблачныйСерверПревышенЛимитПодключений.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверОшибка.Видимость=Ложь;
			ИспользоватьСерверМобиС=ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ИспользоватьСерверМобиС");
			Если ИспользоватьСерверМобиС Тогда
				ВывестиСтатусОблачногоСервера(				
					"Потеряна связь с сервером Моби-С <br>
					|1. Проверьте соединение с интернет<br>
					|2. Перезапустите модуль интеграции");
				ДобавитьВЛогФайл("Потеряна связь с сервером Моби-С");
			Иначе
				Сообщение = "Облачный сервер не подключен";
				ВывестиСтатусОблачногоСервера(Сообщение);
				ДобавитьВЛогФайл(Сообщение);
			КонецЕсли;
		ИначеЕсли ТелоСообщения="SKY_SERVER_CONNECTED" Тогда
			ЭлементыФормы.КнопкаОблачныйСерверПодключен.Видимость=Истина;
			ЭлементыФормы.КнопкаОблачныйСерверНеПодключен.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверПревышенЛимитПодключений.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверОшибка.Видимость=Ложь;
			ДобавитьВЛогФайл("Установлено соединение с сервером Моби-С");
			ОбновитьСтатусУчетнойСистемы();		
		ИначеЕсли ТелоСообщения="UNKNOWN_ACC_SYSTEM" Тогда
			ЭлементыФормы.КнопкаОблачныйСерверПодключен.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверНеПодключен.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверПревышенЛимитПодключений.Видимость=Ложь;
			ЭлементыФормы.КнопкаОблачныйСерверОшибка.Видимость=Истина;
			Сообщение = "Ошибка соединения с облачным сервером Моби-С. В настройках Модуля интеграции указан неверный код базы";
			ВывестиСтатусОблачногоСервера(Сообщение);
			ДобавитьВЛогФайл(Сообщение);
		//ИначеЕсли Лев(ТелоСообщения,37)="ACC_SYSTEM_CONNECTION_LIMIT_EXCEEDED"+Таб Тогда
		//	ЭлементыФормы.КнопкаОблачныйСерверПодключен.Видимость=Ложь;
		//	ЭлементыФормы.КнопкаОблачныйСерверНеПодключен.Видимость=Ложь;
		//	ЭлементыФормы.КнопкаОблачныйСерверПревышенЛимитПодключений.Видимость=Истина;
		//	ЭлементыФормы.КнопкаОблачныйСерверОшибка.Видимость=Ложь;
		//	Сообщение=
		//		"Превышено разрешённое количество подключений к серверу Моби-С.
