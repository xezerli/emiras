		НовСтр.КодВладельца=12;
		НовСтр.ФайлФормы="form2_3kz.xml";
		
		НовСтр=ТаблПечФорм.Добавить();
		НовСтр.Наименование="Форма 2-3";
		НовСтр.КодВладельца=14;
