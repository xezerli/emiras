//ОБМЕН С КПК                       

// Передать строку в КПК 
// Параметры 
//    Адрес - идентификатор сессии обмена
//    ТекстСообщения - Строка с сообщением
//    ПризнакОкончанияДанных - Число  =1
// Возвращаемое значение - Булево , Истина когда передача прошла успешно, Ложь - передача НЕ удалась
Функция СерверПослатьОтвет(Адрес, ТекстСообщения, ПризнакОкончанияДанных)
	Если РежимОтладки Тогда
		ответ = ""+ТекущаяДата()+":"+Адрес+">"+Символы.ПС+ТекстСообщения;
		ДобавитьСообщение(ответ);
	КонецЕсли; 
		
	Если АвтономныйРежим Тогда
		возврат Истина;
	Иначе	
		Статус = Сервер.ПослатьОтвет(Адрес,ТекстСообщения,ПризнакОкончанияДанных);
		Если Статус=1 Тогда
			возврат Истина;
		Иначе
			возврат Ложь;
		КонецЕсли; 
	КонецЕсли; 
КонецФункции // СерверПослатьОтвет()

// Закончить отправку ответа на КПК 
// Параметры
// Агент - Справочник.Пользователи, агент для которого был передан ответ
// НазвЗапроса - строка , название запроса
// Статус
Процедура ЗапросОбработан(Агент, НазвЗапроса, Статус)
	Если Статус Тогда
		ДобавитьВЛогФайл("Запрос '"+НазвЗапроса+"' успешно обработан",Агент);
	Иначе
		ДобавитьВЛогФайл("Запрос '"+НазвЗапроса+"' НЕ обработан",Агент,0,СтатусСообщения.Важное);
	КонецЕсли;
	Если НЕ АвтономныйРежим Тогда
		Сервер.ЗапросОбработан();
	КонецЕсли;
	
Конецпроцедуры

// Добавляет Информационное сообщение в Лог-файл
// Параметры
//    ТекстСообщения - Строка с сообщением
Процедура ДобавитьСообщение(ТекстСообщения)
	Попытка
		ДобавитьВЛогФайл(ТекстСообщения, ПараметрыАгента.Агент, 0 ,СтатусСообщения.Обычное)   
	Исключение
		ДобавитьВЛогФайл(ТекстСообщения, , 0 ,СтатусСообщения.Обычное)   
	КонецПопытки; 	
КонецПроцедуры

// Добавляет сообщение об Ошибке в Лог-файл
// Параметры
//    ТекстСообщения - Строка с сообщением
Процедура ДобавитьОшибку(ТекстСообщения)
	ДобавитьВЛогФайл(ТекстСообщения, ПараметрыАгента.Агент, 0 ,СтатусСообщения.Важное)
КонецПроцедуры

// Выгрузка в КПК порции обмена
// Параметры
// 		Адрес - идентификатор сессии обмена
// 		Ответ - строка, сообщение для передачи в КПК
// 		ТекстСообщенияУдача - Строка, сообщение помещаемое в лог файл в случае удачной выгрузки
// 		ТекстСообщенияОшибка - Строка, сообщение помещаемое в лог файл в случае ошибки
//		ФлагЗавершенияОбмена - число, 1 - признак что выгружаемые данные являются последними, иначе - 0
// Возвращаемое значение:
//   	Булево - Истина - если выгружено удачно; ЛОЖЬ - если была ошибка
Функция ПорцияОбмена(Адрес, Ответ, ТекстСообщенияУдача, ТекстСообщенияОшибка = "", ФлагЗавершенияОбмена = 0)
	
	ОтветОтКПК = СерверПослатьОтвет(Адрес,Ответ+РазделительСтрок,ФлагЗавершенияОбмена);
	
	Если ОтветОтКПК Тогда
		ДобавитьСообщение(ТекстСообщенияУдача);
	Иначе	
		Если ТекстСообщенияОшибка="" Тогда
			ТекстСообщенияОшибка = "Ошибка:"+ТекстСообщенияУдача;
		КонецЕсли; 
		ДобавитьОшибку(ТекстСообщенияОшибка);
	КонецЕсли;
	Возврат ОтветОтКПК;   
КонецФункции //ПорцияОбмена()

//Выполняет перезапуск сервера при возникновении ошибок обмена
Процедура ПерезапускСервера()
	ДобавитьВЛогФайл("Перезапуск сервера...");
	
	Если НЕ АвтономныйРежим Тогда
		Если Сервер<>Неопределено Тогда
			Сервер.Завершить();
		КонецЕсли;
		Сервер="";
		Сервер=Новый(ИмяСервера);
		Сервер.Инициализация(Порт);
		
		ОбновитьИнформациюПоКлючамДляСервера();
		
		ИспользоватьСерверМобиС=ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ИспользоватьСерверМобиС");
		Если ИспользоватьСерверМобиС=Истина Тогда
			ЭлементыФормы.ПанельОблако.Видимость=Истина;
			ЭтаФорма.ПодключитьОбработчикОжидания("ОбновитьСтатусУчетнойСистемы",60*60,Ложь);
			//ЭтаФорма.ПодключитьОбработчикОжидания("ПроверитьСвязьССервером",60,Ложь);
			Если ПерезапускСервераМинут > 0 Тогда
				ПодключитьОбработчикОжидания("ПерезапускСервера",ПерезапускСервераМинут * 60, Истина);
			КонецЕсли;
			ОбновитьСтатусУчетнойСистемы();
			КодУчетнойСистемы=ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "КодУчетнойСистемы");
			ПарольУчетнойСистемы=ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "ПарольУчетнойСистемы");
			Сервер.СоединениеСОблаком(КодУчетнойСистемы, ПарольУчетнойСистемы, ИмяКомпьютера()+"-"+ИмяПользователя(), "WebSocket");
		Иначе
			ВывестиСтатусОблачногоСервера("Облачный сервер не подключен");
		КонецЕсли;
		
		ТаблАгентов=ПолучитьТаблицуАгентов();
		Для Каждого Стр Из ТаблАгентов Цикл
			ЗадатьПапкиНаСервере(Стр.Код);
		КонецЦикла;
	КонецЕсли; 
	
	ДобавитьВЛогФайл("Сервер запущен");
КонецПроцедуры

// Отправляет на КПК сообщение об ошибке
// Параметры:
// 		Адрес - Строка, адрес КПК.
// 		КодОшибки - Строка, код ошибки.
Процедура ОтправитьОшибку(Адрес, КодОшибки)
	СерверПослатьОтвет(Адрес,КодОшибки+РазделительСтрок,1)
КонецПроцедуры

// Формирует таблицу с Номенклатурой для агента, с которым идет сеанс связи
// Возвращает ТаблицуЗначений
Процедура ПолучитьСписокНоменклатуры(ТаблТоваров, ТаблОстатков = Неопределено)
	СформироватьПостроительОтчетаНоменклатура(
					ПараметрыАгента.Агент,
					ПараметрыАгента.ВыгружатьВсюНоменклатуру,
					ПараметрыАгента.ВыбКатИзмЦен,
					ПараметрыАгента.ВыделятьОранжевымЦветом,
					ПараметрыАгента.Склады,
					ПараметрыАгента.ОграничиватьОстатокПоСкладу,
					ПараметрыАгента.МаксимальныйОстатокПоСкладу,
					ТаблТоваров,
					ТаблОстатков);
КонецПроцедуры

// Выгружает на КПК номенклатуру Goods 
// Параметры
//    Адрес - идентификатор сессии обмена
//    ТаблТов - Таблица с номенклатурой
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьНоменклатуру(Адрес, ТаблНоменклатура)
	Если НЕ ПорцияОбмена(Адрес, "Goods", "Выгружается номенклатура...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыАгента.ДобавлятьАртикул < 0 Тогда
		ТаблНоменклатура.Сортировать("Артикул Возр, Номенклатура Возр");
	КонецЕсли;;
	
	Счетчик = 0; 
	Ответ = ""; 
	Порядок = 0;
	ЕстьВерсияДанных = ЕстьВерсияДанных();
	
	Если Конфигурация = "БухКазахстан" Тогда
		ЗапросФото = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ Объект КАК Номенклатура, Ссылка КАК ХранилищеФото";
		Если ЕстьВерсияДанных Тогда
			ТекстЗапроса = ТекстЗапроса + ", ВерсияДанных КАК ВерсияФото";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + " ИЗ Справочник.ХранилищеДополнительнойИнформации
		|ГДЕ ПометкаУдаления = Ложь И ВидДанных = &Изображение И Объект В (&МассивНоменклатуры)
		|УПОРЯДОЧИТЬ ПО Объект";
		ЗапросФото.Текст = ТекстЗапроса;
		ЗапросФото.Параметры.Вставить("МассивНоменклатуры", ТаблНоменклатура.ВыгрузитьКолонку("Номенклатура"));
		ЗапросФото.Параметры.Вставить("Изображение", Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение);
		ТаблФото = ЗапросФото.Выполнить().Выгрузить();
		ТаблФото.Индексы.Добавить("Номенклатура");
	КонецЕсли;
	
	Для Каждого стрТабл Из ТаблНоменклатура Цикл
		Наименование = стрТабл.НоменклатураНаим;
		НаименованиеПолное = стрТабл.НаименованиеПолное;
		УнКод = УникИдентификатор(стрТабл.Номенклатура);
		
		Если НЕ ПустаяСтрока(стрТабл.Артикул) Тогда		
			Если ПараметрыАгента.ДобавлятьАртикул > 0 Тогда
				Наименование = Наименование + " (" + стрТабл.Артикул + ")";
				НаименованиеПолное = НаименованиеПолное + " (" + стрТабл.Артикул + ")";
			ИначеЕсли ПараметрыАгента.ДобавлятьАртикул < 0 Тогда
				Наименование = "(" + стрТабл.Артикул + ") " + Наименование;
				НаименованиеПолное = "(" + стрТабл.Артикул + ") " + НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;
		
		Если Конфигурация = "БухБеларусь" И стрТабл.Партия <> "" Тогда
			УнКод = УнКод + "#" + УникИдентификатор(стрТабл.Партия);
			Наименование = "" + Наименование + " (парт. " +  стрТабл.Партия + ")";
			НаименованиеПолное = "" + НаименованиеПолное+ " (парт. " +  стрТабл.Партия + ")";
		КонецЕсли;
		АнкетаНаименование = ""; // не используется
		Изображение = "";
		
		Если Конфигурация = "БухКазахстан" Тогда
			СтрокиФото = ТаблФото.НайтиСтроки(Новый Структура("Номенклатура", стрТабл.Номенклатура));
			Для Каждого СтрФото Из СтрокиФото Цикл
				ИмяФайла = "Номенклатура";
				УникИд = Строка(СтрФото.ХранилищеФото.УникальныйИдентификатор());
				Если ЕстьВерсияДанных Тогда 
					УникИд = УникИд + ЗаменитьНедопустимыеСимволыВВерсииДанных(СтрФото.ВерсияФото); 
				КонецЕсли;
				ИмяФайла = ИмяФайла+"-"+УникИд+"_"+Строка(стрТабл.Номенклатура.УникальныйИдентификатор())+"_4";
				Картинка = СтрФото.ХранилищеФото.Хранилище.Получить();
				Если ТипЗнч(картинка) = Тип("Картинка") Тогда
					Попытка
						расширение = картинка.Формат();
					Исключение
						расширение = ФорматКартинки.НеизвестныйФормат;
						Сообщить("Удалите картинку у номенклатуры " + стрТабл.Номенклатура
						+ " - код " + стрТабл.Номенклатура.Код, СтатусСообщения.ОченьВажное);
					КонецПопытки;
					Если расширение = ФорматКартинки.НеизвестныйФормат Тогда 
					Иначе	
						ИмяФайла = ИмяФайла+"."+НРег(Строка(расширение));
						Если Изображение <> "" Тогда 
							Изображение = Изображение+Символ(31); 
						КонецЕсли;
						Изображение = Изображение + ИмяФайла;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Ответ = Ответ
			+УнКод+Таб                            //уникальный код товара
			+ЦелоеВСтроку(Порядок)+Таб
			+Наименование+Таб
			+НаименованиеПолное+Таб
			+стрТабл.Весовой+Таб
			+стрТабл.МенятьЦены+Таб
			+стрТабл.СтавкаНДС+Таб
			+Изображение+Таб
			+стрТабл.Цвет+Таб
			+УбратьСпецСимволы(стрТабл.Страна)+Таб
			+УбратьСпецСимволы(стрТабл.ГТД)+ Таб
			+АнкетаНаименование+Таб
			+УбратьСпецСимволы(НРег(стрТабл.Код+" "+стрТабл.Артикул+" "+Наименование))+Таб
			+УбратьСпецСимволы(СтрЗаменить(стрТабл.ДополнительноеОписаниеНоменклатуры,Символы.ПС,Символ(15)),Символ(15))+Таб
			+стрТабл.КодСтраны+РазделительСтрок;
		
		Порядок=Порядок+1;
		
		Счетчик=Счетчик+1;
		Если Счетчик%50=0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка при выгрузке номенклатуры");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Номенклатура выгружена "+Счетчик+" записей", "Ошибка при выгрузке номенклатуры");
КонецФункции

// Выгружает на КПК остатки товаров 
// Параметры
//    Адрес - идентификатор сессии обмена
//    ТаблНоменклатура - Таблица с номенклатурой
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьОстаткиНоменклатуры(Адрес, ТаблОстатки)
	Если НЕ ПорцияОбмена(Адрес,"GoodRests","Выгружаются остатки товаров...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Счетчик = 0; 
	Ответ = ""; 
	СкладОсновной = УникИдентификатор(ПараметрыАгента.Склады[0].Склад);
	
	Для Каждого стрТабл Из ТаблОстатки Цикл
		Если стрТабл.Остаток = 0 Тогда Продолжить; КонецЕсли;
		
		УнКодТовара = УникИдентификатор(стрТабл.Номенклатура);
		Если   Конфигурация = "БухБеларусь" И стрТабл.Партия <> "" Тогда
			УнКодТовара = УнКодТовара + "#" + УникИдентификатор(стрТабл.Партия);
		КонецЕсли;
		УнКодСклада = ?(НомерСубконтоСклад > 0, УникИдентификатор(стрТабл.Склад), СкладОсновной);
		
		Ответ = Ответ
			+УнКодТовара+Таб                            //уникальный код товара
			+УнКодСклада+Таб
			+?(ПараметрыАгента.ПоказыватьОстаткиТовараВМобильномПриложении,
			+КоличествоВСтроку(Окр(стрТабл.Остаток ,3,1)), "")
			+РазделительСтрок;
		
		Счетчик=Счетчик+1;
		Если Счетчик%50=0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка при выгрузке остатков товаров");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Остатки товаров выгружены "+Счетчик+" записей", "Ошибка при выгрузке остатков товаров");
КонецФункции

// Выгружает на КПК группы Номенклатуры
// Параметры
//    Адрес - идентификатор сессии обмена
//    ТаблНоменклатуры - Таблица с Номенклатурой
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьГруппыНоменклатуры(Адрес, ТаблНоменклатуры)
	Если НЕ ПорцияОбмена(Адрес, "GoodGroups", "Выгружаются группы номенклатуры...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МВТ = новый МенеджерВременныхТаблиц();
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ ТаблНоменклатуры.Номенклатура
	|ПОМЕСТИТЬ Номенклатуры
	|ИЗ &ТаблНоменклатуры КАК ТаблНоменклатуры;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ Номенклатуры.Номенклатура, ИСТИНА КАК ЭтоЭлемент
	|ИЗ Номенклатуры	
	|УПОРЯДОЧИТЬ ПО Номенклатура
	|ИТОГИ ПО Номенклатура ТОЛЬКО ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";	
		
	Запрос.Параметры.Вставить("ТаблНоменклатуры", ТаблНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Счетчик = 0;
	Ответ = "";
	Пока Выборка.Следующий() Цикл
		Если Выборка.Номенклатура.Пустая() Тогда Продолжить; КонецЕсли;
		Если Выборка.ЭтоЭлемент = Истина Тогда Продолжить; КонецЕсли;
		Попытка
			Если Выборка.Уровень() <> Выборка.Номенклатура.Уровень() Тогда Продолжить; КонецЕсли;
		Исключение
			Продолжить; // Битая ссылка
		КонецПопытки;
		
		НазваниеГруппы = СокрЛП(УбратьСпецСимволы(Строка(Выборка.Номенклатура)));
		Ответ = Ответ
			+ УникИдентификатор(Выборка.Номенклатура)+Таб
			+ ЦелоеВСтроку(Счетчик)+Таб
			+ НазваниеГруппы+Таб
			+ ?(ЗначениеЗаполнено(Выборка.Номенклатура.Родитель),
				УникИдентификатор(Выборка.Номенклатура.Родитель),
				"")+РазделительСтрок;
				
		Счетчик=Счетчик+1;
		Если Счетчик%50=0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка выгрузки групп номенклатуры");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	
	//выгружаем иерархию согласно номенклатурных групп
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ Номенклатуры.Номенклатура.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа, ИСТИНА КАК ЭтоЭлемент
	|ИЗ Номенклатуры КАК Номенклатуры
	|ГДЕ Номенклатуры.Номенклатура.НоменклатурнаяГруппа <> &НоменклатурнаяГруппаПустая
	|	И НЕ Номенклатуры.Номенклатура.НоменклатурнаяГруппа ЕСТЬ NULL 
	|ИТОГИ ПО НоменклатурнаяГруппа ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.Параметры.Вставить("НоменклатурнаяГруппаПустая", Справочники.НоменклатурныеГруппы.ПустаяСсылка());
	Выборка=Запрос.Выполнить().Выбрать();
	
	ВывестиШапку = Истина;
	
	Пока Выборка.Следующий() Цикл		
		Если Выборка.НоменклатурнаяГруппа.Пустая() Тогда Продолжить; КонецЕсли;
		Если Выборка.ЭтоЭлемент = Истина Тогда Продолжить; КонецЕсли;
		Попытка
			Если Выборка.Уровень() <> Выборка.НоменклатурнаяГруппа.Уровень() Тогда Продолжить; КонецЕсли;
		Исключение
			Продолжить; // Битая ссылка
		КонецПопытки;
		
		Если ВывестиШапку Тогда
			ВывестиШапку = Ложь;
			Ответ = Ответ
				+ "нг_НоменклатурныеГруппы" + Таб
				+ ЦелоеВСтроку(Счетчик) + Таб
				+ "Номенклатурные группы" + Таб
				+ "" + РазделительСтрок;
			Счетчик=Счетчик+1;		
		КонецЕсли;
		
		НазваниеГруппы = СокрЛП(УбратьСпецСимволы(Строка(Выборка.НоменклатурнаяГруппа)));
		Ответ=Ответ
			+ "нг_" + УникИдентификатор(Выборка.НоменклатурнаяГруппа)+Таб
			+ ЦелоеВСтроку(Счетчик)+Таб
			+ НазваниеГруппы+Таб
			+ ?(ЗначениеЗаполнено(Выборка.НоменклатурнаяГруппа.Родитель),
				"нг_"+УникИдентификатор(Выборка.НоменклатурнаяГруппа.Родитель),
				"нг_НоменклатурныеГруппы")+РазделительСтрок;
				
				Счетчик=Счетчик+1;
		Если Счетчик%50=0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка выгрузки групп номенклатуры");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Группы номенклатуры выгружены "+Счетчик+" записей","Ошибка выгрузки групп номенклатуры");
	
КонецФункции

// Выгружает на КПК группы Номенклатуры
// Параметры
//    Адрес - идентификатор сессии обмена
//    ТаблНоменклатуры - Таблица с Номенклатурой
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСоставГруппНоменклатуры(Адрес, ТаблНоменклатуры)
	Если НЕ ПорцияОбмена(Адрес, "GoodGroupAssign", "Выгружается состав групп номенклатуры...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Группа = Неопределено;
	номГруппа = Неопределено;
	УнКодГруппа = "";
	УнКодНомГруппа = "";
	Ответ = "";
	Счетчик = 0;
	Для Каждого стрТабл Из ТаблНоменклатуры Цикл
		УнКод = УникИдентификатор(стрТабл.Номенклатура);

		Если Группа = стрТабл.Группа Тогда
		//если группа не изменилась, то заново вычислять УнКодГруппа нет необходимости
		Иначе
			УнКодГруппа = УникИдентификатор(стрТабл.Группа);
			Группа = стрТабл.Группа;
		КонецЕсли;
		Ответ=Ответ
			+УнКод+Таб                            //уникальный код товара
			+УнКодГруппа+РазделительСтрок;           //уникальный код группы
		
		Счетчик=Счетчик+1;
				
		Если номГруппа = стрТабл.НоменклатурнаяГруппа Тогда
		//если группа не изменилась, то заново вычислять УнКодГруппа нет необходимости
		Иначе
			УнКодНомГруппа = "нг_"+УникИдентификатор(стрТабл.НоменклатурнаяГруппа);
			номГруппа = стрТабл.НоменклатурнаяГруппа;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(номГруппа) Тогда
			Ответ=Ответ
				+УнКод+Таб                            //уникальный код товара
				+УнКодНомГруппа+РазделительСтрок;           //уникальный код группы
			
			Счетчик=Счетчик+1;
		КонецЕсли;
			
		Если Счетчик%50 > 47 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка при выгрузке состава групп номенклатуры");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПорцияОбмена(
		Адрес,Ответ,"Состав групп номенклатуры выгружен "+Счетчик+" записей","Ошибка выгрузки состава групп номенклатуры");
	
КонецФункции

// Выгружает на КПК склады
// Параметры
//    Адрес - идентификатор сессии обмена
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьСклады(Адрес)
	Если НЕ ПорцияОбмена(Адрес,"Storages","Выгружаются склады...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Счетчик=0;
	Ответ="";

	Если НомерСубконтоСклад > 0 Тогда
		Для Каждого Стр Из ПараметрыАгента.Склады Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Склад) Тогда 
				Продолжить; 
			КонецЕсли;
			Счетчик = Счетчик + 1;
			Ответ = Ответ
				+ УникИдентификатор(Стр.Склад)+Таб
				+ ЦелоеВСтроку(Счетчик)+Таб
				+ УбратьСпецСимволы(Стр.Склад.Наименование)+РазделительСтрок;
			
			Если Счетчик%50=0 Тогда
				Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
					ДобавитьОшибку("Ошибка выгрузки складов");
					Возврат Ложь;
				КонецЕсли;
				Ответ = "";
			КонецЕсли;
		КонецЦикла;
	Иначе
		Счетчик = 1;
		Склад = ПараметрыАгента.Склады[0].Склад;
		Ответ = УникИдентификатор(Склад) + Таб + "1" + Таб + УбратьСпецСимволы(Склад.Наименование) + РазделительСтрок;
	КонецЕсли;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Склады выгружены "+Счетчик+" записей","Ошибка выгрузки складов");
КонецФункции

// Выгружает единицы измерения номенклатуры, имеющихся в таблице ТаблНоменклатуры
// Параметры
//    Адрес - идентификатор сессии обмена
//    ТаблНоменклатуры - Таблица с номенклатурой
// Возвращаемое значение Булево ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьЕдиницы(Адрес,ТаблНоменклатуры)
	Если НЕ ПорцияОбмена(Адрес,"Units","Выгружаются единицы измерения номенклатуры...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Счетчик = 0;
	Ответ = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Табл",ТаблНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ТаблНом
	|ИЗ
	|	&Табл КАК ТАБЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблНом.Номенклатура КАК Номенклатура,
	|	ТаблНом.Номенклатура.БазоваяЕдиницаИзмерения.Наименование КАК Наименование,
	|	ТаблНом.Номенклатура.БазоваяЕдиницаИзмерения.Код КАК КодЕдиницыПоКлассификатору
	|ИЗ
	|	ТаблНом КАК ТаблНом
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	
	Если Конфигурация = "БухБеларусь" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(ТАБЛ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		               |	ТАБЛ.Партия КАК Партия
		               |ПОМЕСТИТЬ ТаблНом
		               |ИЗ
		               |	&Табл КАК ТАБЛ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблНом.Номенклатура КАК Номенклатура,
		               |	ТаблНом.Партия КАК Партия,
		               |	ТаблНом.Номенклатура.БазоваяЕдиницаИзмерения.Наименование КАК Наименование,
		               |	ТаблНом.Номенклатура.БазоваяЕдиницаИзмерения.Код КАК КодЕдиницыПоКлассификатору
		               |ИЗ
		               |	ТаблНом КАК ТаблНом
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Номенклатура";
		КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодНоменклатуры = УникИдентификатор(Выборка.Номенклатура);
		Если Конфигурация = "БухБеларусь" И Выборка.Партия <> "" Тогда
			КодНоменклатуры = КодНоменклатуры + "#" + УникИдентификатор(Выборка.Партия);
		КонецЕсли;
		Ответ=Ответ+
		СокрЛП(Выборка.КодЕдиницыПоКлассификатору)+Таб+  // КодЕдиницы
		КодНоменклатуры + Таб+
		УбратьСпецСимволы(Выборка.Наименование)+Таб+
		"3"+Таб+ // Тип
		"1"+Таб+ // Коэффициент
		""+Таб+  // Штрихкод
		"1"+Таб+ // Вес
		СокрЛП(Выборка.КодЕдиницыПоКлассификатору)+РазделительСтрок;
		
		Счетчик=Счетчик+1; 
		Если Счетчик%50=0 Тогда
			Если НЕ СерверПослатьОтвет(Адрес,Ответ,0) Тогда
				ДобавитьОшибку("Ошибка выгрузки единиц измерения");
				Возврат Ложь;
			КонецЕсли;
			Ответ="";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПорцияОбмена(Адрес,Ответ,"Единицы измерения выгружены "+Счетчик+" записей","Ошибка выгрузки единиц измерения");
	
КонецФункции

// Добавляет строку с параметрами контрагента в выгрузку
Функция ДобавитьВыгрузкуКонтрагента(
		КодКонтрагента,НаименованиеКонтрагента,КодЮрЛица,стрТабл,СтрПлат,Порядок,ПочтАдрес,ЮрАдрес,
		Телефон,ТекстДоговора,ТипЦенКод,Коммент,Цвет,Метка,СкидкаДляКонтрагента,АнкетаНаименование,
		Широта,Долгота,ЭтоГруппа,Описание,Изображение)
	наимПолное = УбратьСпецСимволы(стрТабл.НаименованиеПолное);
	стрОтвета=""
	    + СокрЛП(КодКонтрагента)+Таб                                   //код Контрагента
		+ ЦелоеВСтроку(Порядок)+Таб                            //номер п/п
		+ УбратьСпецСимволы(НаименованиеКонтрагента)+Таб       //название
		+ КодЮрЛица+Таб                                        //Код группы (название юр лица)
		+ УбратьСпецСимволы(ПочтАдрес)+Таб                     //почтовый адрес
		+ ТекстДоговора+Таб              					  //долг
		+ ТипЦенКод+Таб                                        //Тип цен для Контрагента
		+ Коммент+Таб										  //Строка про кредит	
		+ наимПолное+Таб    //полное наименование
		+ наимПолное+Таб    //грузополучатель
		+ УбратьСпецСимволы(СтрПлат)+Таб                       //Банковские реквизиты
		+ УбратьСпецСимволы(ЮрАдрес)+Таб                       //юр. адрес
		+ стрТабл.ИНН+Таб                                      //ИНН
		+ стрТабл.КПП+Таб                                      //КПП
		+ ЦелоеВСтроку(Цвет)+Таб                          //цвет (Красный для Должников)
		+ Метка+Таб                                            //?Метка="0"
		+ СкидкаДляКонтрагента+Таб                             //Код скидки  для Контрагента
		+ УбратьСпецСимволы(стрТабл.ОсновнаяОрганизация)+Таб   //Организация для Контрагента
		+ стрТабл.ЗапретитьИзменятьТипЦен+Таб                  //Запрет изменять тип цен
		+ 1+Таб	              								//Запрет изменять Скидку
		+ УбратьСпецСимволы(Телефон)+Таб                       //телефоны   
		+ стрТабл.КодПоОКПО+Таб                                 //ОКПО
		+ АнкетаНаименование+Таб	        	                  //Анкета
		+ Широта+Таб
		+ Долгота+Таб
		+ ЭтоГруппа+Таб
		+ УбратьСпецСимволы(НРег(НаименованиеКонтрагента+" "+ПочтАдрес))+Таб
		+ УбратьСпецСимволы(СтрЗаменить(Описание,Символы.ПС,Символ(15)),Символ(15))+Таб
		+ Изображение+РазделительСтрок;

	возврат стрОтвета

КонецФункции // ДобавитьВыгрузкуКонтрагента()
 
// Формирует строку с параметрами привязки контрагентов к сегментам контрагентов
// 		в соответствии с протоколом обмена
// Параметры:
// 		КодКлиента - Строка, уникальный код контрагента, входящего в сегмент
// 		КодСегмента - Строка, уникальный код сегмента, в который входит контрагент
// Возвращаемое значение:
// 		Строка, строка параметров привязки контрагента к сегменту в соответствии с протоколом обмена
Функция ДобавитьВыгрузкуНазначенияСегментаКонтрагента(КодКлиента, КодСегмента)
    возврат ""
	    + КодКлиента+Таб
		+ КодСегмента+РазделительСтрок;

КонецФункции

// Выгружает контрагентов Clients
// Параметры
// Адрес - идентификатор сессии обмена
// тзКонтрагенты - Таблица Контрагентов
// спКонтрагентов - список контрагентов
// тзЮрЛица - в эту ТЗ передаются все группы(Юридические лица) для организации торговых точек (ТТ)
// ТТ организуются по вхождению в холдинг и/или по типам адресов заданным в настройках 
// Возвращаемое значение Булево: ИСТИНА - если выгрузка прошла удачно, ЛОЖЬ- если были ошибки
Функция ВыгрузитьКонтрагентов(Адрес, тзКонтрагенты, тзАдресаДляТТ, тзЮрЛица)
	Если НЕ ПорцияОбмена(Адрес, "Clients", "Выгружаются контрагенты...") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоэффПересчета = 1;
	Если ПараметрыАгента.ВалютаКПК <> мВалютаРегламентированногоУчета Тогда
		Структура = ПолучитьКурсВалюты(мВалютаРегламентированногоУчета, ТекущаяДата());
		СтруктураВалютаКПК = ПолучитьКурсВалюты(ПараметрыАгента.ВалютаКПК, ТекущаяДата());
		
		КоэффПересчета = Структура.Курс * СтруктураВалютаКПК.Кратность
			/ (?(СтруктураВалютаКПК.Курс = 0, 1, СтруктураВалютаКПК.Курс) * ?(Структура.Кратность = 0, 1, Структура.Кратность));
	КонецЕсли;
	
	ЕстьТТпоАдресам = (тзАдресаДляТТ<>Неопределено);  //точки НЕ нужны
	ЕстьВерсияДанных = ЕстьВерсияДанных();
	
	Счетчик = 0; 
	Ответ = ""; 
	Порядок = 0;
	НазваниеВалюты = ПараметрыАгента.ВалютаКПК.Наименование; 
    //тзКонтрагенты.Сортировать("Сортировка1,Сортировка2");
	Группа = "";
	ТаблКоординаты = ПолучитьКоординатыКонтрагентов();
	ДолгПросрочен = Ложь;
	найденныеСтроки = Новый массив();
	
	Если Конфигурация = "БухКазахстан" Тогда
		ЗапросФото = Новый Запрос;
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Объект КАК Контрагент,
		|	Ссылка КАК ХранилищеФото";
		Если ЕстьВерсияДанных Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	,ВерсияДанных КАК ВерсияФото";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|	Справочник.ХранилищеДополнительнойИнформации
		|ГДЕ
		|	ПометкаУдаления = Ложь
		|	И ВидДанных = &Изображение
		|	И Объект В (&МассивКлиентов)
		|УПОРЯДОЧИТЬ ПО Объект";
		
		ЗапросФото.Текст = ТекстЗапроса;
		ЗапросФото.Параметры.Вставить("МассивКлиентов", тзКонтрагенты.ВыгрузитьКолонку("Контрагент"));
		ЗапросФото.Параметры.Вставить("Изображение", Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение);
		ТаблФото = ЗапросФото.Выполнить().Выгрузить();
		ТаблФото.Индексы.Добавить("Контрагент");
	КонецЕсли;
	
	// Телефоны
	Текст =	"ВЫБРАТЬ Объект КАК Контрагент, Вид, Представление КАК Телефон ИЗ РегистрСведений.КонтактнаяИнформация
			|ГДЕ Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) И Объект В (&МассивКонтрагентов)";
	Запрос = Новый Запрос(Текст);
	Запрос.Параметры.Вставить("МассивКонтрагентов", тзКонтрагенты.ВыгрузитьКолонку("Контрагент"));
	ТаблТелефонов = Запрос.Выполнить().Выгрузить();
	ТаблТелефонов.Индексы.Добавить("Контрагент");
	//
    Для Каждого стрТабл Из тзКонтрагенты Цикл
		Коммент = ""; 
		Цвет = стрТабл.Цвет;
		ДолгПросрочен = Ложь;
		Если стрТабл.ДолгПросрочен > 0 Тогда
			ДолгПросрочен = стрТабл.ДолгПросрочен > 0; //Ложь;
			Коммент=?(ПустаяСтрока(Коммент), "", Коммент + "; ") + "Превышен срок оплаты кредита";
			Цвет= 255*256*256; //Красный;
			ДолгПросрочен = Истина;
		КонецЕсли;
		
		Долг = Окр(стрТабл.Долг * КоэффПересчета, 2);
		Просрочено = Окр(стрТабл.ДолгПросрочен * КоэффПересчета, 2);
		Аванс = Окр(стрТабл.Аванс * КоэффПересчета, 2);
			
		//Коммент="Превышена сумма кредита по договору "+стрТабл.ОсновнойДоговорКонтрагента.Наименование;
		//Цвет= 255*256*256; //Красный;
		//ДолгПросрочен = Истина;

		//Если стрТабл.ДнейПросрочки > 0 Тогда
		//	Коммент=?(ПустаяСтрока(Коммент), "", Коммент + "; ") + "Превышен срок оплаты кредита";
		//	Цвет= 255*256*256; //Красный;
		//	ДолгПросрочен = Истина;
		//КонецЕсли;
		
		ТипЦен = стрТабл.ТипЦен;
		Если ТипЦен = Неопределено Тогда 
			ТипЦен = ПараметрыАгента.ТипЦенПоУмолчанию; 
		КонецЕсли;
		Если ТипЦен = NULL Тогда 
			ТипЦен = ПараметрыАгента.ТипЦенПоУмолчанию; 
		КонецЕсли;
		Если ТипЦен = Справочники.ТипыЦенНоменклатуры.ПустаяСсылка() Тогда 
			ТипЦен = ПараметрыАгента.ТипЦенПоУмолчанию; 
		КонецЕсли;
		
		ТипЦенКод = УникИдентификатор(ТипЦен);
		СтрПлат = "";
		
		Если ЗначениеЗаполнено(стрТабл.РасчетныйСчет) Тогда
			СтрПлат=СтрПлат
				+"р/с " + стрТабл.РасчетныйСчет_НомерСчета+","+Символ(160)
				+"в " +СокрП(стрТабл.РасчетныйСчет_Банк_Наименование)
					+" в "+СокрП(стрТабл.РасчетныйСчет_Банк_Город)+","+Символ(160)
				+ "БИК " + стрТабл.РасчетныйСчет_Банк_Код+","+Символ(160)
				+ "корр.сч. " + стрТабл.РасчетныйСчет_Банк_КоррСчет;
