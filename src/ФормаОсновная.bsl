			//ПрочитатьИзРегистраСохраненныеНастройки возвращает Неопределено
			Если ПробросПорта = Истина Тогда
				АдресСервераПробросаПорта=ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "АдресСервераПробросаПорта");
				Статус=Сервер.ПроброситьПорт(АдресСервераПробросаПорта);
				Если Статус<>"" Тогда
					Предупреждение(Статус);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ЭлементыФормы.НадписьПорт.Заголовок=Строка(Порт);
		ЭлементыФормы.НадписьВерсияДистирибутива.Заголовок=ВерсияДистрибутива;

		ТаблАгентов=ПолучитьТаблицуАгентов();
		Для Каждого Стр Из ТаблАгентов Цикл
			ЗадатьПапкиНаСервере(Стр.Код);
		КонецЦикла;
	КонецЕсли;
	
	ЭлементыФормы.КоманднаяПанель1.Кнопки.Сервис.Кнопки.ОбновитьСтруктуруВнешнейБД.Доступность = РежимОтладки;
	
	ДобавитьВАктивныеОбработки();
КонецПроцедуры

// Выполняет обновление данных при переходе на новую версию обработки
Процедура ПроверитьВерсиюОбработки()
	НомерВерсии = ПолучитьНастройку(МобиС, "НомерВерсии", 0);
	ТекВерсия = Число(СтрЗаменить(ВерсияОбработки, ".", "")); //уберем точки из номера версии
	Если НомерВерсии < 461 Тогда //Нужно перенести Координаты 
		Сообщить("Переход на версию 4.6.1...");
		//маршруты агентов
		Сообщить("Преобразуем маршруты агентов...");
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СохраненныеНастройки.Пользователь,
		|	СохраненныеНастройки.ИмяОбъекта,
		|	СохраненныеНастройки.НаименованиеНастройки,
		|	СохраненныеНастройки.СохраненнаяНастройка
		|ИЗ
		|	РегистрСведений.СохраненныеНастройки КАК СохраненныеНастройки
		|ГДЕ
		|	СохраненныеНастройки.НаименованиеНастройки ПОДОБНО ""%Маршрут.%""";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
		     КонтрагентыМаршрута = ПрочитатьИзРегистраСохраненныеНастройки(Выборка.Пользователь, Выборка.НаименованиеНастройки); //это Табл значений
			 Если ТипЗнЧ(КонтрагентыМаршрута) <> Тип(Новый ТаблицаЗначений) Тогда
				 КонтрагентыМаршрута = Новый ТаблицаЗначений;
			 КонецЕсли; 
			 ЕстьКолонкаКлиент = (КонтрагентыМаршрута.Колонки.Найти("Клиент") <> Неопределено);
				 
			 Если КонтрагентыМаршрута.Колонки.Найти("Контрагент") = Неопределено Тогда
				 КонтрагентыМаршрута.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
			 КонецЕсли; 	 
			 Если КонтрагентыМаршрута.Колонки.Найти("Код") = Неопределено Тогда
				 КонтрагентыМаршрута.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));
			 КонецЕсли; 	 
			 Если КонтрагентыМаршрута.Колонки.Найти("Наименование") = Неопределено Тогда
				 КонтрагентыМаршрута.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
			 КонецЕсли; 	 
			 Если КонтрагентыМаршрута.Колонки.Найти("Широта") = Неопределено Тогда
				 КонтрагентыМаршрута.Колонки.Добавить("Широта", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 8)));
			 КонецЕсли; 	 			 
			 Если КонтрагентыМаршрута.Колонки.Найти("Долгота") = Неопределено Тогда
				 КонтрагентыМаршрута.Колонки.Добавить("Долгота", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 8)));
			 КонецЕсли; 	 
			 Для каждого стрТЗ Из КонтрагентыМаршрута Цикл
				 Если НЕ ЗначениеЗаполнено(СтрТЗ.Код) Тогда  //когда код НЕ задан
					 Если НЕ ЗначениеЗаполнено(СтрТЗ.Контрагент) И ЕстьКолонкаКлиент Тогда //когда контрагент НЕ заполнен но есть колонка Клиент (старое название)
						 СтрТЗ.Контрагент = СтрТЗ.Клиент;  
					 КонецЕсли; 
					 СтрТЗ.Наименование = СтрТЗ.Контрагент.Наименование;
					 СтрТЗ.Код          = СтрТЗ.Контрагент.Код;
				 КонецЕсли; 
			 КонецЦикла; 
			 ЗаписатьВРегистрСохраненныеНастройки(Выборка.Пользователь, КонтрагентыМаршрута, Выборка.НаименованиеНастройки);
		КонецЦикла;
		Сообщить("Переход на версию 4.6.1 завершен.");
	КонецЕсли; 
	
	Если НомерВерсии < 500 Тогда 
		ТаблКоординаты = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "КоординатыКонтрагентов");
		Если ТаблКоординаты <> Неопределено Тогда
			Для Каждого Стр Из ТаблКоординаты Цикл
				Контрагент = Справочники.Контрагенты.НайтиПоКоду(Стр.Код);
				Если Контрагент.Пустая() Тогда Продолжить; КонецЕсли;
				УстановитьКоординатыКонтрагента(Контрагент, Стр.Широта, Стр.Долгота);
			КонецЦикла;
		КонецЕсли;
		Сообщить("Переход на версию 5.0 завершен.");
	КонецЕсли;

	Если НомерВерсии < 553 Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ Пользователь, СохраненнаяНастройка
		|ИЗ РегистрСведений.СохраненныеНастройки
		|ГДЕ НаименованиеНастройки = ""ПроводитьДокументы""";
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Пользователь) Тогда
				ПроводитьДокументы = ПолучитьНастройку(Выборка.Пользователь, "ПроводитьДокументы", Ложь);
				ЗаписатьВРегистрСохраненныеНастройки(Выборка.Пользователь,
					(ПроводитьДокументы И ПолучитьНастройку(Выборка.Пользователь, "РазрешитьПродажу", Истина)), "ПроводитьПродажа");
				ЗаписатьВРегистрСохраненныеНастройки(Выборка.Пользователь,
					(ПроводитьДокументы И ПолучитьНастройку(Выборка.Пользователь, "РазрешитьЗаявку", Истина)), "ПроводитьЗаказ");
				ЗаписатьВРегистрСохраненныеНастройки(Выборка.Пользователь,
					(ПроводитьДокументы И ПолучитьНастройку(Выборка.Пользователь, "РазрешитьПокупку", Истина)), "ПроводитьПокупка");
				ЗаписатьВРегистрСохраненныеНастройки(Выборка.Пользователь,
					(ПроводитьДокументы И ПолучитьНастройку(Выборка.Пользователь, "РазрешитьПКО", Истина)), "ПроводитьПКО");
				ЗаписатьВРегистрСохраненныеНастройки(Выборка.Пользователь,
					(ПроводитьДокументы И ПолучитьНастройку(Выборка.Пользователь, "РазрешитьИнвентаризацию", Истина)), "ПроводитьНаличиеИЦены");
			КонецЕсли;
		КонецЦикла;
		Сообщить("Переход на версию 5.5.3 завершен.");
	КонецЕсли;
	
	Если НомерВерсии < 5514 Тогда
		
		массивАгентов = ПолучитьТаблицуАгентов();
		поУмолчанию = Неопределено;
		Если Конфигурация = "БухКазахстан" Тогда
			поУмолчанию	= Справочники.КатегорииОбъектов.ПустаяСсылка();
		Иначе
			поУмолчанию	= ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
		КонецЕсли;	
		флаг = Ложь;
		
		Для каждого стрАгент из массивАгентов Цикл			
			флаг = ЗначениеЗаполнено(ПолучитьНастройку(стрАгент.Агент,"ВыбКатИзмЦен", поУмолчанию));			
			ЗаписатьВРегистрСохраненныеНастройки(
				стрАгент.Агент, флаг, "РедактироватьЦену");
			ЗаписатьВРегистрСохраненныеНастройки(
				стрАгент.Агент, флаг, "ВыбиратьТипЦены");
			ЗаписатьВРегистрСохраненныеНастройки(
				стрАгент.Агент, флаг, "ВыбиратьТипСкидки");						
		КонецЦикла;
		
		Сообщить("Переход на версию 5.5.14 завершен.");
	КонецЕсли;	
	
	Если ТекВерсия > НомерВерсии Тогда
   		ЗаписатьВРегистрСохраненныеНастройки(МобиС, ТекВерсия, "НомерВерсии");
	КонецЕсли;
	
	Если ТекВерсия<>НомерВерсии Тогда
		ИспользоватьВстроенныеМакетыКарт = Истина;
   		ЗаписатьВРегистрСохраненныеНастройки(МобиС,ИспользоватьВстроенныеМакетыКарт,"ИспользоватьВстроенныеМакетыКарт");
	Иначе
		ИспользоватьВстроенныеМакетыКарт = ПолучитьНастройку(МобиС, "ИспользоватьВстроенныеМакетыКарт", Истина);
	КонецЕсли
	
КонецПроцедуры
 
// Обработчик закрытия формы
Процедура ПриЗакрытии()
	текстСообщения = "Завершение работы:";
	Если НЕ АвтономныйРежим И НЕ РежимРабочееМесто Тогда		
		текстСообщения = текстСообщения + " порт - " + ЦелоеВСтроку(Порт) + ";";
		Если Сервер<>Неопределено Тогда
			ДобавитьВЛогФайл("Входящий трафик (" + ЦелоеВСтроку(Порт) + "): "+Окр(Сервер.ВходящийТрафик()/1024,0)+" Кбайт");
			ДобавитьВЛогФайл("Исходящий трафик (" + ЦелоеВСтроку(Порт) + "): "+Окр(Сервер.ИсходящийТрафик()/1024,0)+" Кбайт");
			Сервер.Завершить();
			АдресСервераПробросаПорта=ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "АдресСервераПробросаПорта");
			Если ЗначениеЗаполнено(АдресСервераПробросаПорта) Тогда
				Сервер.ОтменитьПробросПорта();
			КонецЕсли;
			Сервер="";
		КонецЕсли; 
	КонецЕсли;
	ДобавитьВЛогФайл(текстСообщения + " обработка - " + ПолучитьРасположениеОбработки() + РазделительСтрок);
	
	УдалитьИзАктивныеОбработки();
КонецПроцедуры

// Вызывается перед закрытием формы
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если НЕ АвтономныйРежим И НЕ РежимРабочееМесто Тогда
		Если Вопрос("Если Вы закроете эту обработку, то прервётся связь с КПК. Закрыть обработку?", РежимДиалогаВопрос.ДаНет)
			= КодВозвратаДиалога.Нет  Тогда
			Отказ = Истина;
			СтандартнаяОбработка =ЛОЖЬ;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

// Считывает глобальные настройки обработки обмена
Процедура ПрочитатьПараметрыПрограммы()
	
	РасстояниеОтКонтрагента     = ПолучитьНастройку(МобиС, "РасстояниеОтКонтрагента", 200);
	ВремяПребыванияУКонтрагента = ПолучитьНастройку(МобиС, "ВремяПребыванияУКонтрагента", 120);
	СпособОрганизацииТТ     	= ПолучитьНастройку(МобиС, "СпособОрганизацииТТ", 0);    //как обычно
	СоответствиеКонтрагента		= ПолучитьНастройку(МобиС, "СоответствиеКонтрагента", 0);    //покупатель
		
	ТекПользователь = глЗначениеПеременной("глТекущийПользователь");
	ТехПоддержкаКонтактноеЛицо = ПолучитьНастройку(МобиС, "ТехПоддержкаКонтактноеЛицо", "");  
	Если НЕ ЗначениеЗаполнено(ТехПоддержкаКонтактноеЛицо) Тогда
	     ТехПоддержкаКонтактноеЛицо = "" + ТекПользователь;
		 ЗаписатьВРегистрСохраненныеНастройки(МобиС, ТехПоддержкаКонтактноеЛицо, "ТехПоддержкаКонтактноеЛицо");	
	КонецЕсли; 
	
	ТехПоддержкаОрганизация = ПолучитьНастройку(МобиС, "ТехПоддержкаОрганизация", "");  
	Если НЕ ЗначениеЗаполнено(ТехПоддержкаОрганизация) Тогда
		ОсновнаяОрганизация = ПолучитьНастройкуПользователя(ТекПользователь, ПланыВидовХарактеристик.НастройкиПользователей.ОсновнаяОрганизация, Справочники.Организации.ПустаяСсылка());
		ТехПоддержкаОрганизация = "" + ОсновнаяОрганизация;
		ЗаписатьВРегистрСохраненныеНастройки(МобиС, ТехПоддержкаОрганизация, "ТехПоддержкаОрганизация");	
	КонецЕсли; 
	
	ТехПоддержкаПочта					= ПолучитьНастройку(МобиС,"ТехПоддержкаПочта","");  
	ТехПоддержкаТелефон					= ПолучитьНастройку(МобиС,"ТехПоддержкаТелефон","");  
	ТехПоддержкаЛогинНаСайте			= ПолучитьНастройку(МобиС,"ТехПоддержкаЛогинНаСайте","");  
	ТехПоддержкаАвтоматическаяОтправка	= ПолучитьНастройку(МобиС,"ТехПоддержкаАвтоматическаяОтправка", Истина);  
	ТехПоддержкаДобавитьЛог				= ПолучитьНастройку(МобиС,"ТехПоддержкаДобавитьЛог", Истина);  
	ТехПоддержкаКонфигурацияИзменена	= ПолучитьНастройку(МобиС,"ТехПоддержкаКонфигурацияИзменена", Ложь);  
	ТехПоддержкаМодульИнтеграцииИзменен	= ПолучитьНастройку(МобиС,"ТехПоддержкаМодульИнтеграцииИзменен", Ложь);  
		
	//Координаты контрагентов
	Если Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Географическая широта").Пустая() Тогда
		НовЭлем = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
		НовЭлем.Тип = Перечисления.ТипыКонтактнойИнформации.Другое;
		НовЭлем.ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты;
		НовЭлем.Наименование = "Географическая широта";
		НовЭлем.Записать();
	КонецЕсли;
	Если Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Географическая долгота").Пустая() Тогда
		НовЭлем = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
		НовЭлем.Тип = Перечисления.ТипыКонтактнойИнформации.Другое;
		НовЭлем.ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты;
		НовЭлем.Наименование = "Географическая долгота";
		НовЭлем.Записать();
	КонецЕсли;
	ТаблТекущиеКоординаты = ПрочитатьКоординатыАгентов(Истина);
	
	//прочитаем адреса для торговых точек
	ТаблЗнач = ПрочитатьИзРегистраСохраненныеНастройки(МобиС, "АдресаДляТТ"); //это Табл значений
	Если ТипЗнч(ТаблЗнач) = Тип("ТаблицаЗначений") Тогда
		АдресаДляТТ.Загрузить(ТаблЗнач);
	КонецЕсли; 

КонецПроцедуры

// Обработчик обновления отображения формы
Процедура ОбновлениеОтображения()
	// Если нет агентов, то вкладку с агентам Запретить
	ЕстьАгент = (ТекущийАгент <> Неопределено) И ЗначениеЗаполнено(ТекущийАгент.ФизЛицо);
	
	ЭлементыФормы.НадписьКаталогЛогов.Заголовок 	= ПолучитьКаталог("Logs");
	ЭлементыФормы.НадписьКаталогОбновлений.Заголовок= ПолучитьКаталог("Updates");
	ЭлементыФормы.НадписьКаталогАгентов.Заголовок	= ПолучитьКаталог("Agents");
	ДанныеОСервере = "";
	Если Сервер <> Неопределено Тогда
		ДанныеОСервере="Дата сборки: "+Сервер.ПолучитьДатуСборки()+". Путь: "+Сервер.ПолучитьПутьМодуля();
	КонецЕсли;
	ЭлементыФормы.НадписьКаталогPocketServer.Заголовок = ДанныеОСервере;
КонецПроцедуры

// Обрабатывает нажатие на надпись "Каталог pocketserver"
Процедура НадписьКаталогPocketServerНажатие(Элемент)
	Путь = СтрЗаменить(Элемент.Заголовок, "Путь: ", РазделительСтрок);
	Если СтрЧислоСтрок(Путь) <> 2 Тогда Возврат; КонецЕсли;
	Путь = СтрПолучитьСтроку(Путь,2);
	Файл = Новый Файл(Путь);
	Путь = Файл.Путь;
	
	ОтветНаВопрос = Вопрос("Если вы будете обновлять " + СервернаяКомпонента + ", то нужно закрыть 1С. Закрыть ее сейчас?", РежимДиалогаВопрос.ДаНет);
	ЗапуститьПриложение(Путь);
    Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ЗавершитьРаботуСистемы(Истина);
	КонецЕсли; 
КонецПроцедуры

// Отправляет по e-mail-у сообщение в техподдержку компании Моби-С
// Параметры:
// 		ТекстОшибки - Строка, содержит описание ошибки
// Возвращаемое значение:
// 		Истина всегда
Функция ОтправитьОшибкуВТехподдержку(Агент, ТекстОшибки)
	//в качестве темы используем е-mail или текущего пользователя
	СисИнфо = Новый СистемнаяИнформация;
	Тема= "1C" + Лев(СисИнфо.ВерсияПриложения, 3) + ": (" + ВерсияПротокола + ") " + ТехПоддержкаПочта;
	
	текДата = ТекущаяДата();
	ТехПоддержкаСообщение = ЗаголовокПисьма(Агент, текДата, Формат(текДата, "ДФ=HH:mm:ss"), ТекстОшибки);
	//сообщение отправляется в HTML, поэтому заменяем все переходы на новую строку на тег <br/>
	ТехПоддержкаСообщение = СтрЗаменить(ТехПоддержкаСообщение,РазделительСтрок,"<br/>");
	ТехПоддержкаСообщение = СтрЗаменить(ТехПоддержкаСообщение,Символы.ПС,"<br/>");
	
	//добавляем к сообщению лог файл
	Файлы = ЛогФайлыПоУмолчанию(Агент, текДата);
	
	СоздатьСообщениеВТехподдержку(Тема, ТехПоддержкаСообщение, Файлы);
	Письмо = КаталогЛогФайлов + "\email.xml";
	ФайлПисьмо = Новый Файл(Письмо);
	
	ПроверитьEmailer();
	
	Если ФайлПисьмо.Существует() Тогда
		Почтальон = КаталогЛогФайлов + "\Emailer.exe";
	    ФайлПочтальон = Новый Файл(Почтальон);
		файлЛогОтправки = ПолучитьИмяВременногоФайла();		
		Если ФайлПочтальон.Существует() =1  Тогда 	
			Рез = 0;
			Пер = """" + Почтальон + """ """ + Письмо + """ """ + файлЛогОтправки + """";
			Попытка
				ЗапуститьПриложение(Пер, , Истина);
				файлРезультат = новый ЧтениеТекста(файлЛогОтправки);
				результатОтправки = файлРезультат.Прочитать();
				файлРезультат.Закрыть();				
				УдалитьФайлы(файлЛогОтправки);
				УдалитьФайлы(Письмо);
				Если результатОтправки = "Сообщение отправлено." Тогда
					Сообщить(
					"Сообщение отправлено.");
				Иначе
					Если результатОтправки = "Couldn't connect to server" Тогда
						результатОтправки = "Невозможно соединиться с почтовым сервером"
					ИначеЕсли результатОтправки = "Failed sending data to the peer" Тогда
						результатОтправки = "Ошибка отправки данных на почтовый сервер"
					ИначеЕсли результатОтправки = "Couldn't resolve host name" Тогда
						результатОтправки = "Не найден почтовый сервер, возможно отсутствует доступ в Интернет"
					КонецЕсли;					
					Сообщить("Ошибка отправки:" + Символы.ПС + результатОтправки);
					ДобавитьВЛогФайл("Ошибка отправки сообщения в техподдержку:" + Символы.ПС + результатОтправки);						
				КонецЕсли;
			Исключение
				стр = ОписаниеОшибки();
				Сообщить(стр);
				ДобавитьВЛогФайл(стр);
			КонецПопытки;                            			
		КонецЕсли;		
	КонецЕсли;	
	Возврат Истина;
КонецФункции	

