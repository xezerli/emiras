//Инициализирует ПостроительОтчета для отбора контрагентов
Процедура ИнициализироватьПостроительЗапросаКонтрагенты() Экспорт

	БланкПостроителяОтчетаКонтрагенты = Новый ПостроительОтчета; 
	БланкПостроителяОтчетаКонтрагенты.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Контрагенты.ГоловнойКонтрагент КАК ГоловнойКонтрагент,
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ЭтоГруппа = ЛОЖЬ
	|{ГДЕ
	|	Контрагенты.Ссылка.* КАК Контрагент}
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГоловнойКонтрагент ИЕРАРХИЯ,
	|	Контрагент
	|АВТОУПОРЯДОЧИВАНИЕ";

	БланкПостроителяОтчетаКонтрагенты.ЗаполнитьНастройки();
	ПостроительОтчетаКонтрагенты = Новый ПостроительОтчета;
	ЗаполнитьЗначенияСвойств(ПостроительОтчетаКонтрагенты, БланкПостроителяОтчетаКонтрагенты);
	ПостроительОтчетаКонтрагенты.ЗаполнитьНастройки();
	
КонецПроцедуры

// Возвращает ПостроительОтчета Номенклатура с заполненными параметрами
// Параметры
// ПарамАгент - Агент для которого формируется построитель
// ВыгружатьВсюНоменклатуру - Булево, признак выгрузки номенклатуры:  Истина - всю номенклатуру, 
// Ложь - только ту которая есть на остатке
// ПарамВыбКатИзмЦен - Справочник.КатегорииОбъектов, категория номенклатуры, для которой  разрешено менять цены
// ПарамВыделятьОранжевымЦветом - Справочник.КатегорииОбъектов, номенклатура с этой категорией будет 
// выделена на КПК оранжевым цветом
// ПарамСклад - Справочник.Склады, склад по которому будут определяться остатки
// Возвращаемое значение типа ПостроительОтчета с результатами 
Процедура СформироватьПостроительОтчетаНоменклатура(ПарамАгент, ВыгружатьВсюНоменклатуру, ПарамВыбКатИзмЦен, ПарамВыделятьОранжевымЦветом,
		ПарамСклады, ОграничиватьОстатокПоСкладу, МаксимальныйОстатокПоСкладу,ТаблТоваров, ТаблОстатков) Экспорт
		
	Построитель = Новый ПостроительОтчета;
	ТаблСОтбором = ПрочитатьОтбор(ПарамАгент, "Номенклатура"); //прочитаем из регистра отбор
	
	Если ВыгружатьВсюНоменклатуру Тогда //Чтобы выгружать всю номенклатуру, отключим использование отбора с Остатками
		Для каждого стр Из ТаблСОтбором Цикл
			Если Стр.ПутьКДанным = "КонтролироватьОстаток" Тогда
				Стр.Использование = Ложь;
			КонецЕсли; 
		КонецЦикла; 
	Иначе //Если нужно контролировать выгрузку товаров по остаткам,
		//то добавим отбор по полю КонтролироватьОстаток > 0
		//при такой выгрузке на КПК будут выгружены наборы, услуги и тд
		Нов = ТаблСОтбором.Добавить();
		Нов.ПутьКДанным 	= "КонтролироватьОстаток";
		Нов.Имя 			= "";
		Нов.Представление 	= "КонтролироватьОстаток";
		Нов.ВидСравнения	= ВидСравнения.Больше;
		Нов.Значение		= 0;
		Нов.ЗначениеПо		= 0;                                           
		Нов.ЗначениеС		= 0;
		Нов.Использование 	= Истина;
	КонецЕсли;
	
	ЗаполнитьОтборПостроителя(ТаблСОтбором, Построитель, БланкПостроителяОтчетаНоменклатура);
	
	Если Конфигурация = "БухКазахстан" Тогда
	ИначеЕсли Конфигурация = "БухБеларусь" Тогда
		СписокСчетов = Новый СписокЗначений;
		СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.СырьеИМатериалы);		//10.01
		//Если Константы.ЕстьРозничнаяТорговля.Получить() Тогда
			СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.Товары);				//41
		//КонецЕсли;
		//Если Константы.ЕстьПроизводственнаяДеятельность.Получить() Тогда
			СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукция);	//43
		//КонецЕсли;
		Построитель.Параметры.Вставить("СписокСчетовУчетаТоваров", СписокСчетов);
	Иначе
		// Счета номенклатуры
		СписокСчетов = Новый СписокЗначений;
		СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.СырьеИМатериалы);		//10.01
		//Если Константы.ЕстьРозничнаяТорговля.Получить() Тогда
			СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.Товары);				//41
		//КонецЕсли;
		//СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01"));				//41
		//Если Константы.ЕстьПроизводственнаяДеятельность.Получить() Тогда
			СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукция);	//43
		//КонецЕсли;
		Построитель.Параметры.Вставить("СписокСчетовУчетаТоваров", СписокСчетов);
	КонецЕсли;
	//Построитель.Параметры.Вставить("Склад", ?(ПарамСклады.Количество() > 0, ПарамСклады[0].Склад, Справочники.Склады.ПустаяСсылка()));
	Построитель.Параметры.Вставить("Склады", ПарамСклады.ВыгрузитьКолонку("Склад"));
	Построитель.Параметры.Вставить("КатегорияМенятьЦены", ПарамВыбКатИзмЦен);
	Построитель.Параметры.Вставить("ВыделятьОранжевымЦветом", ПарамВыделятьОранжевымЦветом);
	Цвет = ПолучитьНастройку(ПарамАгент, "ЦветКатегории", Новый Цвет(255, 165, 0));
	Построитель.Параметры.Вставить("ЦветКатегории", ЦелоеВСтроку(ЦветВЧисло(Цвет)));
	Построитель.Параметры.Вставить("ОграничиватьОстаток", ОграничиватьОстатокПоСкладу);
	Построитель.Параметры.Вставить("МаксимальныйОстаток", МаксимальныйОстатокПоСкладу);
	
	ВариантСменыЦен = ЦелоеВСтроку(
		0
		+ ?(ПолучитьНастройку(ПарамАгент, "РедактироватьЦену", Истина), 2, 0)
		+ ?(ПолучитьНастройку(ПарамАгент, "ВыбиратьТипЦены", Ложь), 4, 0)
		//+ ?(ПолучитьНастройку(ПарамАгент, "ВыбиратьТипСкидки", Ложь), 8, 0)
		);
	Построитель.Параметры.Вставить("ВариантСменыЦен", ЦелоеВСтроку(ВариантСменыЦен));
	
	ТаблВес = ПрочитатьИзРегистраСохраненныеНастройки(МобиС,"ЕдиницыВесовоогоТовара"); //это Табл значений
	Если ТипЗнч(ТаблВес) <> Тип("ТаблицаЗначений") Тогда
		ТаблВес = Новый ТаблицаЗначений;
		ТаблВес.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	КонецЕсли; 
	Построитель.Параметры.Вставить("Весовые", ТаблВес.ВыгрузитьКолонку("ЕдИзм"));
	
	Пакет = Построитель.ПолучитьЗапрос().ВыполнитьПакет();
	ТаблТоваров = ?(ТаблТоваров = Неопределено, Неопределено, Пакет[Пакет.Количество() - 2].Выгрузить());
	ТаблОстатков = ?(ТаблОстатков = Неопределено, Неопределено, Пакет[Пакет.Количество() - 1].Выгрузить());
	
КонецПроцедуры

//Инициализирует ПостроительОтчета для отбора номенклатуры
Процедура ИнициализироватьПостроительЗапросаНоменклатура() Экспорт
	
	БланкПостроителяОтчетаНоменклатура = Новый ПостроительОтчета;
	Если Конфигурация = "БухКазахстан" Тогда
		Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТиповойОстатки.Субконто1 КАК Номенклатура,
		|	" + ?(НомерСубконтоСклад > 0, "ТиповойОстатки.Субконто" + НомерСубконтоСклад, "NUll") + " КАК Склад,
		|	ТиповойОстатки.КоличествоОстатокДт КАК Остаток
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрБухгалтерии.Типовой.Остатки(, , , " + ?(НомерСубконтоСклад > 0,  "Субконто" + НомерСубконтоСклад + " В (&Склады)", "") + ") КАК ТиповойОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СпрНоменклатура.Ссылка.Код КАК Код,
		|	СпрНоменклатура.Ссылка.Артикул КАК Артикул,
		|	СпрНоменклатура.Ссылка КАК Номенклатура,
		|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(200)) КАК НаименованиеПолное,
		|	"""" КАК Партия,
		|	ЕСТЬNULL(Остатки.Остаток, 0) КАК Остаток,
		|	ВЫБОР КОГДА СпрНоменклатура.Ссылка.Услуга = ЛОЖЬ ТОГДА ЕСТЬNULL(Остатки.Остаток, 0) ИНАЧЕ 1 КОНЕЦ КАК КонтролироватьОстаток,
		|	Остатки.Склад КАК Склад,
		|	СпрНоменклатура.Ссылка.Родитель КАК Группа,
		|	СпрНоменклатура.Ссылка.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	СпрНоменклатура.Ссылка.Наименование КАК НоменклатураНаим,
		|	СпрНоменклатура.СтавкаНДС.Ставка КАК СтавкаНДС,
		|	ЕСТЬNULL(МожноМенятьЦены.МенятьЦены, ""0"") КАК МенятьЦены,
		|	ЕСТЬNULL(ОранжевыйЦвет.Оранжевый, ""0"") КАК Цвет,
		|	ВЫРАЗИТЬ(СпрНоменклатура.Комментарий КАК СТРОКА(200)) КАК ДополнительноеОписаниеНоменклатуры,
		|	ВЫБОР
		|		КОГДА СпрНоменклатура.БазоваяЕдиницаИзмерения В (&Весовые)
		|			ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК Весовой,
		|	"""" КАК ГТД,
		|	"""" КАК Страна,
		|	"""" КАК КодСтраны,
		|	"""" КАК ОсновноеИзображение
		|ПОМЕСТИТЬ ТаблРезультат
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
