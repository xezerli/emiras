//мутекс на доступ на запись к внешней базе данных
//возврат из функции будет выполнен только как освободится база данных
Функция ЗаблокироватьВнешнююБД(НаЗапись = Ложь) Экспорт	
	
	ИмяОбъекта = КаталогЛогФайлов + "\sqlite.block";
	Блокировщик = Неопределено;
	
	Пока ЗаблокироватьОбъект(Блокировщик, ИмяОбъекта, НаЗапись) = Ложь Цикл
		Сервер.Пауза(100);
		Сообщить("Ждем освобождения внешней БД...");
	КонецЦикла;	
	
	Возврат Блокировщик;
КонецФункции

Процедура РазблокироватьВнешнююБД(Блокировщик) Экспорт
	РазблокироватьОбъект(Блокировщик);	
КонецПроцедуры	
	
//процедура выполняет сжатие внешней базы данных
//при отсутствии внешней базы данных будет создана пустая база данных
Процедура СжатьВнешнююБД(Соединение) Экспорт
	Если БДЗапросБезРезультата(Соединение, "DELETE FROM Log WHERE DateTime<'"+ДатаДляSQLite(ДобавитьМесяц(ТекущаяДатаСуточнаяКоррекция(), -2))+"'")
		И БДЗапросБезРезультата(Соединение, "VACUUM") Тогда		
		ДобавитьВЛогФайл("Выполнено сжатие внешней базы данных.");
	Иначе
		Ошибка = ОписаниеОшибки();
		ДобавитьВЛогФайл("Не удалось сжать файл с внешними данными." + РазделительСтрок + Ошибка);
	КонецЕсли;
КонецПроцедуры

//Функция выполняет открытие внешней базы данных
//возвращает объект для доступа к базе данных
Функция ОткрытьВнешнююБД(Блокировщик, ОткрытьНаЗапись) Экспорт
	
	Блокировщик = ЗаблокироватьВнешнююБД(ОткрытьНаЗапись);		
	
	ПутьКБД = КаталогЛогФайлов + "\mobi_s.sqlite3";
	
	Попытка
		Соединение=Сервер.БазаДанныхОткрыть(ПутьКБД);
		Возврат Соединение;
	Исключение
		Ошибка = ОписаниеОшибки();
		текстОшибки = "Не удалось создать файл "+ПутьКБД+" для работы с внешними данными."+РазделительСтрок+Ошибка;
		Сообщить(текстОшибки);
		ДобавитьВЛогФайл(текстОшибки, "Моби-С");
		РазблокироватьВнешнююБД(Блокировщик);
		возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция БДЗапросБезРезультата(Соединение, ТекстЗапроса) Экспорт
	ПодгЗапрос=Неопределено;
	Попытка
		ПодгЗапрос=Сервер.БазаДанныхПодготовитьЗапрос(Соединение, ТекстЗапроса);
		Сервер.БазаДанныхСледующаяЗапись(ПодгЗапрос);
		Сервер.БазаДанныхЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
		Возврат Истина;
	Исключение
		Ошибка = ОписаниеОшибки();
		ДобавитьВЛогФайл(Ошибка, "Моби-С");
		Если ПодгЗапрос<>Неопределено Тогда
			Сервер.БазаДанныхЗакрытьПодготовленныйЗапрос(ПодгЗапрос);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция БДПодготовитьЗапрос(БД, ТекстЗапроса) Экспорт
	Попытка
		пз = Сервер.БазаДанныхПодготовитьЗапрос(БД, ТекстЗапроса);
		Возврат пз
	Исключение
		ИО = ИнформацияОбОшибке();
		ОО = ОписаниеОшибки();
		стр = ПолучитьОшибку(ИО, ОО);
		стр = стр + символы.ПС + "Текст запроса:" + символы.ПС + ТекстЗапроса;		
		Попытка 
			а = 5;
			б = 0;
			в = а / б;
		Исключение
			ИО = ИнформацияОбОшибке();
			ОО = ОписаниеОшибки();
			стр2 = ПолучитьОшибку(ИО, ОО);
			стр = стр + символы.ПС + стр2;		
		КонецПопытки;
		ДобавитьВЛогФайл(стр);	
		Возврат Ложь;
	КонецПопытки;		
КонецФункции

