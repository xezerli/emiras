// преобразует дату в формат SQLite
// Параметры
//	ДатаВремя - преобразуемая дата и время
// возвращает строку с датой в формате SQLite
Функция ДатаДляSQLite(ДатаВремя) Экспорт
	Возврат Формат(ДатаВремя, "ДФ='yyyy-MM-dd HH:mm:ss'");
КонецФункции //ПолучитьВсеНастройкиАгента(КодАгента)

// преобразует дату из формата SQLite
// Параметры
//	ДатаВремя - преобразуемая дата и время
// возвращает дату и время
Функция ДатаИзSQLite(ДатаВремя) Экспорт
	Стр=СтрЗаменить(ДатаВремя, "-", "");
	Стр=СтрЗаменить(Стр, ":", "");
	Стр=СтрЗаменить(Стр, " ", "");
	Попытка
		Возврат Дата(Стр);
	Исключение
		Возврат ДатаПустая();
	КонецПопытки;
КонецФункции //ПолучитьВсеНастройкиАгента(КодАгента)

