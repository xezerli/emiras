		КонецЕсли;		
		записьРегистра =  РегистрыСведений.СохраненныеНастройки.СоздатьМенеджерЗаписи();
		записьРегистра.Пользователь = МобиС;
		записьРегистра.ИмяОбъекта = стр.ГУИД;
		записьРегистра.НаименованиеНастройки = "ОбновитьКаталоги";
		записьРегистра.Прочитать();
		Если записьРегистра.Выбран() Тогда
			записьРегистра.Удалить();
