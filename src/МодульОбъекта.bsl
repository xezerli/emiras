Функция СформироватьОписаниеОшибки(Ошибка, Уровень = 0)
	Если Ошибка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	описание = Ошибка.Описание 
				+ ?(ПустаяСтрока(Ошибка.ИмяМодуля) И ПустаяСтрока(Ошибка.ИсходнаяСтрока), "", " в" + Символы.ПС 
			   	+ ?(ПустаяСтрока(Ошибка.ИмяМодуля), "", Ошибка.ИмяМодуля + " (" + Ошибка.НомерСтроки + ")" + Символы.ПС) 
			   	+ ?(ПустаяСтрока(Ошибка.ИсходнаяСтрока), "", "в " + СокрЛП(Ошибка.ИсходнаяСтрока) + Символы.ПС));
	Если Уровень < 10 Тогда
		причина = СформироватьОписаниеОшибки(Ошибка.Причина, Уровень + 1);
		Если Не ПустаяСтрока(причина) Тогда
			описание = описание + " по причине " + Символы.ПС + причина;
		КонецЕсли;
	КонецЕсли;
	Возврат описание;
КонецФункции

Функция ПолучитьОшибку(ИО, ОО) Экспорт
	текстОшибки = СформироватьОписаниеОшибки(ИО);
	глПоследняяОшибкаПроведения = ?(текстОшибки = "", ОО, текстОшибки);
	Если НЕ ПустаяСтрока(глПоследняяОшибкаПроведения) Тогда 
