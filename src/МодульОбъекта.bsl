// Убирает из строки символы с кодами 0-31 (до кода пробела), чтобы исключить запрещенные символы в базе данных на КПК
Процедура УбратьСпецСимволыВСтроке(ИсхСтр, Кроме="") Экспорт
	Если ТипЗнч(ИсхСтр)<>ТипЗнч("") Тогда
		ИсхСтр="";
		Возврат;
	КонецЕсли;
	
//при работе на Windows 2008 не изменяется длина строки и в конце могут появиться символы NULL
//для всех систем используем работу по алгоритмам 8.1
	//Если ВерсияПлатформы = 81 Тогда
		ВремСтр = СокрП(ИсхСтр);
		ДлСтр   = СтрДлина(ВремСтр);
		НовСтр  = "";
		Для Н=1 По ДлСтр Цикл
			Символ = Сред(ВремСтр,Н,1);
			КодСимвола=КодСимвола(Символ);
			//Символ<>Кроме
			Если КодСимвола<32 И (Найти(Кроме, Символ) = 0) Тогда 
				Продолжить; 
			КонецЕсли;
			НовСтр = НовСтр + Символ;
		КонецЦикла;		
		ИсхСтр = СокрЛП(НовСтр);		
	//Иначе
	//	Сервер.УбратьСлужебныеСимволыВСтроке(ИсхСтр,Кроме);
	//КонецЕсли;
КонецПроцедуры

