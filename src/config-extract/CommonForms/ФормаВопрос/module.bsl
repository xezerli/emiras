КонецПроцедуры
Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	МаксСтрДлина=0;
	Для  Счетчик=1  по  СтрЧислоСтрок(вопрос) Цикл
		 МаксСтрДлина=макс(МаксСтрДлина,стрдлина(СтрПолучитьСтроку(вопрос, Счетчик))); 
	КонецЦикла; 
	//элементыформы.Надпись1.Заголовок=вопрос;
	Размершрифт=элементыформы.Надпись1.Шрифт.Размер;
	Надпись1Ширина =МаксСтрДлина*(Размершрифт);
	Надпись1Высота=СтрЧислоСтрок(Вопрос)*Размершрифт*2;
	формаВысота=Надпись1Высота+40+МинВысотаКнопки;
	формаШирина=Надпись1Ширина+20;
	элементыформы.Надпись1.Ширина=Надпись1Ширина;
	элементыформы.Надпись1.Высота =Надпись1Высота;
	Если формаВысота>минВысота Тогда
		этаформа.Высота=формаВысота;
	КонецЕсли; 
	Если формаШирина>МинШирина Тогда
		этаформа.Ширина=формаШирина;
	КонецЕсли; 
	формаШирина=этаформа.Ширина;
	
	элементыформы.Кнопка1.Верх=этаформа.Высота-МинВысотаКнопки-10;
	элементыформы.Кнопка2.Верх=этаформа.Высота-МинВысотаКнопки-10;
	элементыформы.Кнопка1.Лево=(формаШирина-МинШиринаКнопки*2-20)/2;
	элементыформы.Кнопка2.Лево=элементыформы.Кнопка1.Лево+элементыформы.Кнопка1.Ширина+20;
	
	Если КнопкаПоУмолчанию=КодВозвратаДиалога.Нет Тогда
		элементыформы.Кнопка2.КнопкаПоУмолчанию=Истина;
	КонецЕсли; 
КонецПроцедуры


Процедура ОбновлениеОтображения()
КонецПроцедуры

минВысота=этаформа.Высота;
МинШирина=этаформа.Ширина;
