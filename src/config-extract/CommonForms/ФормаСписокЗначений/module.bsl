
Процедура ПриОткрытии()
	если Типзнч(ТипС)=Тип("СписокЗначений") тогда
		элементыформы.КоманднаяПанель1.Кнопки.кнПодбор.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю;
		для каждого зн из ТипС цикл
			имя=стрзаменить(зн.значение,".","_");
			элементыформы.КоманднаяПанель1.Кнопки.кнПодбор.Кнопки.Добавить(имя,ТипКнопкиКоманднойПанели .Действие,зн.Представление ,новый Действие("КоманднаяПанель1кнПодборМ"));
		Конеццикла;
	Конецесли;
	
КонецПроцедуры

Процедура КоманднаяПанель1кнПодбор(Кнопка)
	
	Если ТипС="Дата" Тогда
		зн="";
		Если ВвестиДату(зн, "Tarix daxil edin!",ЧастиДаты .Дата) Тогда
			Если ПолеСписка.НайтиПоЗначению(зн)=неопределено Тогда
				ПолеСписка.Добавить(зн);
			КонецЕсли; 
		КонецЕсли; 
	ИначеЕсли ТипС="Число" Тогда
		зн="";
		Если ВвестиЧисло(зн, "Ədəd daxil edin!",,3) Тогда
			Если ПолеСписка.НайтиПоЗначению(зн)=неопределено Тогда
				ПолеСписка.Добавить(зн);
			КонецЕсли; 
		КонецЕсли; 
	Иначе
		формаПодбора=Справочники[ТипС].ПолучитьФормуВыбора(,этаформа);
		//формаПодбора=Справочники.Номенклатура.ПолучитьФормуВыбора();
		формаПодбора.ЗакрыватьПриВыборе=Ложь;
		формаПодбора.РежимВыбора=Истина;
		формаПодбора.Открыть();
		
	КонецЕсли; 
КонецПроцедуры
Процедура КоманднаяПанель1кнПодборМ(Кнопка)
	
	если найти(кнопка.имя ,"Справочник")<>0 тогда
	формаПодбора=Вычислить(стрзаменить(кнопка.имя,"_",".")).ПолучитьФормуВыбора(,этаформа);
	//формаПодбора=Справочники.Номенклатура.ПолучитьФормуВыбора();
	формаПодбора.ЗакрыватьПриВыборе=Ложь;
	формаПодбора.РежимВыбора=Истина;
	формаПодбора.Открыть();
		
	КонецЕсли; 
КонецПроцедуры

Процедура ОбработкаВыбора(ЗначениеВыбора, Источник)
	// Вставить содержимое обработчика.
	Если ПолеСписка.НайтиПоЗначению(ЗначениеВыбора)=неопределено Тогда
	     ПолеСписка.Добавить(ЗначениеВыбора);
	КонецЕсли; 
КонецПроцедуры

Процедура КнОКНажатие(Элемент)
	Закрыть(ПолеСписка);
КонецПроцедуры

Процедура КнОтменаНажатие(Элемент)
	Закрыть();
КонецПроцедуры

Процедура КоманднаяПанель1кнХ(Кнопка)
	Если ПолеСписка.количество()>0 Тогда
	    ПолеСписка.Удалить(элементыформы.ПолеСписка.ТекущаяСтрока);
	КонецЕсли; 
КонецПроцедуры

Процедура КоманднаяПанель1кнХХ(Кнопка)
	ПолеСписка.Очистить();
КонецПроцедуры


