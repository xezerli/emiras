Процедура МФСписокНачалоВыбора(Элемент, СтандартнаяОбработка)
	
	стр=элементыформы.МФ.ТекущиеДанные;
	Если стр.Тип="Дата"  Тогда
		если  стр.ТипВыбора=НСтр("az = 'İnterval'; ru = 'Интервал'")  Тогда

			зн=ПолучитьОбщуюФорму("ФормаВводИнтервал").ОткрытьМодально();
			Если ТипЗнч(зн)=Тип("Структура") Тогда
				Если не значениезаполнено(зн.начдата)и не значениезаполнено(зн.кондата) Тогда
					возврат;
				КонецЕсли; 
				сп=новый списокзначений;
				сп.Добавить(зн.начдата);
				сп.Добавить(зн.кондата);
				элементыформы.МФ.ТекущиеДанные.Список=сп;
			КонецЕсли; 
		Иначе
			зн=0;
			если ВвестиДату (зн, НСтр("az = 'Tarix daxil edin'; ru = 'Введите дату'"),ЧастиДаты .Дата) тогда
				сп=новый списокзначений;
				сп.Добавить(зн);
				элементыформы.МФ.ТекущиеДанные.Список=сп;
			Конецесли;
		Конецесли;
	
		СтандартнаяОбработка=ложь;
		
	ИначеЕсли стр.Тип="Число"   Тогда
		если    стр.ТипВыбора=НСтр("az = 'İnterval'; ru = 'Интервал'") тогда
			зн=ПолучитьОбщуюФорму("ФормаВводИнтервалЧисло").ОткрытьМодально();
			Если ТипЗнч(зн)=Тип("Структура") Тогда
				сп=новый списокзначений;
				сп.Добавить(зн.начИнтервал);
				сп.Добавить(зн.конИнтервал);
				элементыформы.МФ.ТекущиеДанные.Список=сп;
			КонецЕсли; 
		Иначе
			 зн=0;
			 если ВвестиЧисло(зн, НСтр("az = 'Ədəd daxil edin'; ru = 'Введите количество'"),, 3) тогда
				сп=новый списокзначений;
				сп.Добавить(зн);
				элементыформы.МФ.ТекущиеДанные.Список=сп;
			 Конецесли;
			 
				 
		Конецесли;
		СтандартнаяОбработка=ложь;
	Иначе
		ТипПодбор=неопределено;
		если  ТипЗнч(стр.тип)=Тип("Строка") тогда
			ТипПодбор=стр.тип;
			формаПодбора=Справочники[ТипПодбор].ПолучитьФормуВыбора(,элементыформы.МФ.Колонки.Список.ЭлементУправления);
		ИначеЕсли  ТипЗнч(стр.тип)=Тип("СписокЗначений") тогда
			ТипПодбор=стр.тип.ВыбратьЭлемент("");
			если  ТипПодбор=неопределено тогда
				СтандартнаяОбработка=ложь;
				возврат;
			Конецесли;
			
			формаПодбора=Вычислить(ТипПодбор.Значение).ПолучитьФормуВыбора(,элементыформы.МФ.Колонки.Список.ЭлементУправления);
		Конецесли;
				//формаПодбора=Справочники.Номенклатура.ПолучитьФормуВыбора();
		формаПодбора.ЗакрыватьПриВыборе=истина;
		формаПодбора.РежимВыбора=Истина;
		рез=формаПодбора.открытьМодально();
		если рез<> неопределено тогда
			сп=новый списокзначений;
			сп.Добавить(рез);
			элементыформы.МФ.ТекущиеДанные.Список=сп;
		Конецесли;
	
		//
	КонецЕсли; 
	Если не значениезаполнено(элементыформы.МФ.ТекущиеДанные.Список) Тогда
		элементыформы.МФ.ТекущиеДанные.вкл=ложь;
	Иначе
		элементыформы.МФ.ТекущиеДанные.вкл=Истина;
	КонецЕсли; 
КонецПроцедуры

