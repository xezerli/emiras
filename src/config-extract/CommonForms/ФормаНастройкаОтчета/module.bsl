Процедура ПриОткрытии()
	ИндексРегистратор=0;
	стр=ПоляГруппировки.Найти("Регистратор","имяГруппировка");
	если стр<> неопределено тогда
		ИндексРегистратор=ПоляГруппировки.Индекс(стр);
		шаг=ПоляГруппировки.Количество()-1-ИндексРегистратор;
		если шаг>0 тогда
			ПоляГруппировки.Сдвинуть(стр,шаг);
			ИндексРегистратор=ПоляГруппировки.Количество()-1;
		Конецесли;
	Конецесли;
КонецПроцедуры

Процедура КоманднаяПанель1Действие(Кнопка)
	если элементыформы.ПоляГруппировки.ТекущаяСтрока=неопределено тогда
		возврат;
	конецесли;
	если  элементыформы.ПоляГруппировки.ТекущаяСтрока.имяГруппировка="Регистратор" тогда
		Возврат;
	Конецесли;
	
	текиндекс=ПоляГруппировки.индекс(элементыформы.ПоляГруппировки.ТекущаяСтрока);
	если текиндекс-1>-1 тогда
		ПоляГруппировки.Сдвинуть(элементыформы.ПоляГруппировки.ТекущаяСтрока,-1);
	Конецесли;
КонецПроцедуры

Процедура КоманднаяПанель1Действие1(Кнопка)
	если элементыформы.ПоляГруппировки.ТекущаяСтрока=неопределено тогда
		возврат;
	конецесли;
	текиндекс=ПоляГруппировки.индекс(элементыформы.ПоляГруппировки.ТекущаяСтрока);
	конИндекс=?(ИндексРегистратор=0,ПоляГруппировки.Количество()-1,ИндексРегистратор);
	если текиндекс+1<конИндекс тогда
		ПоляГруппировки.Сдвинуть(элементыформы.ПоляГруппировки.ТекущаяСтрока,1);
	Конецесли;
КонецПроцедуры

Процедура КоманднаяПанель2Действие(Кнопка)
	если элементыформы.ПоляПорядок.ТекущаяСтрока=неопределено тогда
		возврат;
	конецесли;
	
	текиндекс=ПоляПорядок.индекс(элементыформы.ПоляПорядок.ТекущаяСтрока);
	если текиндекс-1>-1 тогда
		ПоляПорядок.Сдвинуть(элементыформы.ПоляПорядок.ТекущаяСтрока,-1);
	Конецесли;
КонецПроцедуры

Процедура КоманднаяПанель2Действие1(Кнопка)
	если элементыформы.ПоляПорядок.ТекущаяСтрока=неопределено тогда
		возврат;
	конецесли;
	текиндекс=ПоляПорядок.индекс(элементыформы.ПоляПорядок.ТекущаяСтрока);
	конИндекс=ПоляПорядок.Количество()-1;
	если текиндекс+1<конИндекс тогда
		ПоляПорядок.Сдвинуть(элементыформы.ПоляПорядок.ТекущаяСтрока,1);
	Конецесли;
КонецПроцедуры


Процедура МФПриАктивизацииСтроки(Элемент)
		стр=элементыформы.МФ.ТекущиеДанные;
	Если стр=неопределено Тогда
	   возврат;
	КонецЕсли; 
	если  стр.Тип="Дата" тогда
		ЭлементыФормы.МФ.Колонки.ТипВыбора.ЭлементУправления.СписокВыбора=мСписокТипВыбораДата;
	Иначеесли  стр.Тип="Число" тогда
		ЭлементыФормы.МФ.Колонки.ТипВыбора.ЭлементУправления.СписокВыбора=мСписокТипВыбораЧисло;
	Иначе
		ЭлементыФормы.МФ.Колонки.ТипВыбора.ЭлементУправления.СписокВыбора=мСписокТипВыбора;
	Конецесли;

КонецПроцедуры

Процедура ВыбранныеПоляПриИзмененииФлажка(Элемент)
	текСтрока=элементыформы.ВыбранныеПоля.ТекущаяСтрока;
	если текСтрока<>неопределено тогда
		стрПорядок=ПоляПорядок.Найти(текСтрока.значение,"имяРеквизит");
		если текСтрока.Пометка тогда
			если найти(РеквизитыСортировки,текСтрока.значение)= 0 тогда 
				Возврат;
			Конецесли;
			если стрПорядок=неопределено тогда
				стр=ПоляПорядок.Добавить();
				стр.имяРеквизит= текСтрока.значение;
				стр.вкл=ложь;
				стр.имяРеквизитАзе= текСтрока.Представление ;
			Конецесли;
			
		Иначе
			если стрПорядок<>неопределено тогда
				 ПоляПорядок.Удалить( стрПорядок);
			Конецесли;
		Конецесли;
		
	Конецесли;
	
	
КонецПроцедуры

Процедура ПоляГруппировкиПриИзмененииФлажка(Элемент, Колонка)
	текСтрока=элементыформы.ПоляГруппировки.ТекущаяСтрока;
	если текСтрока<>неопределено тогда
		имяРеквизит= ?(текСтрока.ИмяГруппировка="Регистратор","Регистратор.Дата",текСтрока.ИмяГруппировка);
		стрПорядок=ПоляПорядок.Найти(имяРеквизит,"имяРеквизит");
		если текСтрока.Вкл тогда
			если найти(РеквизитыСортировки,текСтрока.имяГруппировка)= 0 тогда 
				Возврат;
			Конецесли;
			если стрПорядок=неопределено тогда
				стр=ПоляПорядок.Добавить();
				стр.имяРеквизит=имяРеквизит;
				стр.имяРеквизитАзе= текСтрока.имяГруппировкаАзе ;
			Конецесли;
		Иначе
			если стрПорядок<>неопределено тогда
				ПоляПорядок.Удалить( стрПорядок);
			Конецесли;
		Конецесли;
	Конецесли;
КонецПроцедуры

Процедура МФСписокНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка=ложь;
	РаботаСДиалогами.СписокЗн(элементыформы.МФ.ТекущиеДанные.Список,элементыформы.МФ.ТекущиеДанные.Тип,СтандартнаяОбработка,Элемент);
	Если не значениезаполнено(элементыформы.МФ.ТекущиеДанные.Список) Тогда
		элементыформы.МФ.ТекущиеДанные.вкл=ложь;
	Иначе
		элементыформы.МФ.ТекущиеДанные.вкл=Истина;
	КонецЕсли; 
КонецПроцедуры

