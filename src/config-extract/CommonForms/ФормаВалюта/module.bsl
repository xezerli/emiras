  перем ДокОбъект экспорт;


  Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	  Валюта=ДокОбъект.Валюта;
	  Курс=ДокОбъект.Курс;
  КонецПроцедуры

  Процедура ОсновныеДействияФормыкнОК(Кнопка)
	  Если не ЗначениеЗаполнено(Валюта)  Тогда
	      ОбщегоНазначения.Хебердарлыг("Valyuta seçilməyib!");
	  	  Возврат;
	  КонецЕсли; 
	  Если не ЗначениеЗаполнено(Курс)  Тогда
	      ОбщегоНазначения.Хебердарлыг("Məzənnə təyin olubmayıb!");
	  	  Возврат;
	  КонецЕсли; 
	  преж_валюта=ДокОбъект.валюта;
	  преж_курс=ДокОбъект.курс;
	  ДокОбъект.Валюта=Валюта;
	  ДокОбъект.Курс=Курс;
	  ДокОбъект.сумма=МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ДокОбъект.сумма,преж_валюта,Валюта,преж_курс,курс);
	  закрыть();
  КонецПроцедуры

  Процедура ВалютаПриИзменении(Элемент)
	  курс=МодульВалютногоУчета.ПолучитьКурсВалюты(Валюта, ДокОбъект.Дата).курс;

  КонецПроцедуры
