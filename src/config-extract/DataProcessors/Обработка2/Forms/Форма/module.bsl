		Новрас.Предос=Услуги;
		ДокИстПроведен =ДокИст.Проведен ;

		ДокИст.УстановитьПометкуУдаления(Истина);
		ДокИст.Записать(РежимЗаписиДокумента.Запись);
				Попытка
			
			Если  ДокИстПроведен Тогда
				ДокНов.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			ИНаче
				ДокНов.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Исключение
			Предупреждение("Невозможно провести документ! "+ ОписаниеОшибки());
			Прервать;
		КонецПопытки;
		Сообщить("Новый документ: "+ДокНов);
		ДокИст.УстановитьПометкуУдаления(Истина);
		ДокИст.Записать(РежимЗаписиДокумента.Запись);
		

		
	
	КонецЦикла;
	
	
	
КонецПроцедуры

