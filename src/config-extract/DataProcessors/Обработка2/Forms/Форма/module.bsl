

Процедура ПеремещениеВПокупкиНажатие(Элемент)
	
	 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваров.Ссылка
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
		|ГДЕ
		|	ПеремещениеТоваров.ПометкаУдаления = ЛОЖЬ
		|	И ПеремещениеТоваров.СкладПолучатель В (&СкладПолучатель)
		|	И ПеремещениеТоваров.Склад НЕ В(&СкладПолучатель)";
	
	Запрос.УстановитьПараметр("СкладПолучатель", Склады);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	    ДокИст=Выборка.Ссылка.ПолучитьОбъект();
		Если ДокИст.Товары.Итог("Количество")=0 Тогда 
			Продолжить;
		КонецЕсли;
		Сообщить(ДокИст);
		ДокНов=Документы.ПоступлениеТоваров.СоздатьДокумент();
		ДокНов.ИнстализацияДокумента();
		ДокНов.Дата=ДокИст.Дата;
		ДокНов.Комментарий=""+ДокИст+"; Qəbul edən:"+ДокИст.Получатель+"; "+ДокИст.Комментарий;
		ДокНов.Склад=ДокИст.СкладПолучатель;
		ДокНов.Автор=ДокИст.Автор;
		ДокНов.Валюта=ДокИст.Валюта;
		ДокНов.Курс=ДокИст.Курс;
		ДокНов.ОновлениеЦены=Истина;
		ДокНовТовары=ДокНов.Товары;
		
		Для Каждого стрДокОснование из ДокИст.Товары Цикл
			Стр=ДокНовТовары.Добавить();
			стр.Товар= стрДокОснование. Товар;
			стр.Единица= стрДокОснование.Единица;
			стр.Коэффициент=стрДокОснование.Коэффициент;
			
			РаботаСТЧДокумента.ИзмЕдин(Докнов,стр);
			
			стр.Количество=стрДокОснование.Количество;
			//стр.цена=стрДокОснование.цена;
			
			РаботаСТЧДокумента.Выч_Суммы_ТЧ(Докнов,стр);
			
			стр.Штрихкод=  стр.Единица.Штрихкод;			
			стр.Марка=  стр.Товар.Марка;
			стр.ТипНоменклатуры=  стр.Товар.ТипНоменклатуры;
			стр.Пол=  стр.Товар.Пол;
			стр.Цвет= стр.Товар.Цвет;
			стр.Сезон=  стр.Товар.Сезон;
			стр.Размер= стр.Товар.Размер;
			стр.Артикул= стр.Товар.Артикул;
		КонецЦикла;
		ИтогСуммы=ДокНовТовары.Итог("Сумма");
		 
		ИтогСРасходами=ДокИст.СуммаДокумента;
		 		
		Услуги=ИтогСРасходами-ИтогСуммы;
		ДокНовДопРасходы=ДокНов.ДопРасходы;		
		НовРас=ДокНовДопРасходы.Добавить();
		Новрас.Контрагент=Справочники.Контрагенты.НайтиПоКоду(5);
		Новрас.Предос=Услуги;
		ДокИстПроведен =ДокИст.Проведен ;

		ДокИст.УстановитьПометкуУдаления(Истина);
		ДокИст.Записать(РежимЗаписиДокумента.Запись);
				Попытка
			
			Если  ДокИстПроведен Тогда
				ДокНов.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			ИНаче
				ДокНов.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Исключение
			Предупреждение("Невозможно провести документ");
			Прервать;
		КонецПопытки;
		Сообщить("Новый документ: "+ДокНов);
		ДокИст.УстановитьПометкуУдаления(Истина);
		ДокИст.Записать(РежимЗаписиДокумента.Запись);
		

		

		
	
	КонецЦикла;
	
 	
	
КонецПроцедуры

