перем Inv;

Процедура РаботаСТаблицейМФ(Кнопка) 
	
	Перем ТекПоз;
	Перем ТекЭлемент;
	Перем ФормаПодбора;
	Перем ВидЗначенияПодбора;
	Перем СправочникПодбора; 
	КнопкаИмя=Кнопка.Имя;
	Если (КнопкаИмя="дДобавитьК")или(КнопкаИмя="дДобавитьНесколькоК") Тогда
		СправочникПодбора = Справочники.Контрагенты;
		формаСписка=СправочникПодбора.ПолучитьФормуВыбора(,этаформа);
		формаСписка.РежимВыбора=Истина;
		формаСписка.ЗакрыватьПриВыборе=не(КнопкаИмя="дДобавитьНесколькоК");
		формаСписка.МножественныйВыбор=(КнопкаИмя="дДобавитьНесколькоК");
		формаСписка.Открыть();
		возврат;
	КонецЕсли; 
	Если (КнопкаИмя="дХК") Тогда
		текЗн=элементыформы.ПолеСпискаКонтрагенты.ТекущаяСтрока	; 
		Если текЗн<>неопределено Тогда
			ПолеСпискаКонтрагенты.Удалить(текЗн);
		КонецЕсли; 
		возврат;
	КонецЕсли;
	Если (КнопкаИмя="дХХК") Тогда
			ПолеСпискаКонтрагенты.Очистить();
			возврат;
	КонецЕсли;
	Если (КнопкаИмя="дДобавитьН")или(КнопкаИмя="дДобавитьНесколькоН") Тогда
		СправочникПодбора = Справочники.Номенклатура;
		формаСписка=СправочникПодбора.ПолучитьФормуВыбора(,этаформа);
		формаСписка.РежимВыбора=Истина;
		формаСписка.ЗакрыватьПриВыборе=не(КнопкаИмя="дДобавитьНесколькоН");
		формаСписка.МножественныйВыбор=(КнопкаИмя="дДобавитьНесколькоН");
		формаСписка.Открыть();
		возврат;
	КонецЕсли; 
	Если (КнопкаИмя="дХН") Тогда
		текЗн=элементыформы.ПолеСпискаКонтрагенты.ТекущаяСтрока	; 
		Если текЗн<>неопределено Тогда
			ПолеСпискаНоменклатуры.Удалить(текЗн);
		КонецЕсли; 
	КонецЕсли;
	Если (КнопкаИмя="дХХН") Тогда
			ПолеСпискаНоменклатуры.Очистить();
	КонецЕсли;
	
	
КонецПроцедуры	// глРаботаСТаблицейМФ() 



Процедура ОбработкаВыбора(ЗначениеВыбора, Источник)
	Если ТипЗнч(ЗначениеВыбора)=Тип("Массив") Тогда
		Для каждого эл Из ЗначениеВыбора Цикл
			Если ТипЗнч(эл)=Тип("СправочникСсылка.Контрагенты") Тогда
				Если  ПолеСпискаКонтрагенты.НайтиПоЗначению(эл)=неопределено Тогда
					ПолеСпискаКонтрагенты.Добавить(эл);
				КонецЕсли; 
			ИначеЕсли ТипЗнч(эл)=Тип("СправочникСсылка.Номенклатура") Тогда
				Если  ПолеСпискаНоменклатуры.НайтиПоЗначению(эл)=неопределено Тогда
					ПолеСпискаНоменклатуры.Добавить(эл);
				КонецЕсли; 
			КонецЕсли;  
		КонецЦикла; 
	Иначе
		Если ТипЗнч(ЗначениеВыбора)=Тип("СправочникСсылка.Контрагенты") Тогда
			Если  ПолеСпискаКонтрагенты.НайтиПоЗначению(ЗначениеВыбора)=неопределено Тогда
				ПолеСпискаКонтрагенты.Добавить(ЗначениеВыбора);
			КонецЕсли; 
		ИначеЕсли ТипЗнч(ЗначениеВыбора)=Тип("СправочникСсылка.Номенклатура") Тогда
			Если  ПолеСпискаНоменклатуры.НайтиПоЗначению(ЗначениеВыбора)=неопределено Тогда
				ПолеСпискаНоменклатуры.Добавить(ЗначениеВыбора);
			КонецЕсли; 
		КонецЕсли;  
		
		
	КонецЕсли; 
	
КонецПроцедуры

