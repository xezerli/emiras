Перем Lang;
Перем Заглавные;

 
Процедура Заполнитьраскладку()
	Если Lang=0 Тогда 
		Если Заглавные Тогда
			ТекРаскладка = "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ. 1234567890";
		Иначе
			ТекРаскладка = "йцукенгшщзхъфывапролджэячсмитьбю. 1234567890";
		КонецЕсли;
	Иначе                      
		Если Заглавные Тогда
			ТекРаскладка = "QWERTYUIOP[]ASDFGHJKL;'ZXCVBNM,./ 1234567890";
		Иначе
			ТекРаскладка = "qwertyuiop[]asdfghjkl;'zxcvbnm,./ 1234567890";
		КонецЕсли;
	КонецЕсли;
	Для I=1 По 44 Цикл  
		ЭлементыФормы["К"+I].Заголовок = Сред(ТекРаскладка,I,1);
	КонецЦикла; 
КонецПроцедуры

Процедура Раскладка(Элемент)
	Lang = ?(Lang=1,0,1);
	Заполнитьраскладку()
КонецПроцедуры //Раскладка()

Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	Надпись   = Надпись;
	Lang      = 0;
	Заглавные =Ложь;
	Раскладка("");  
КонецПроцедуры

Процедура Нажатие(Элемент)
	Если Элемент.Заголовок = "Esc" Тогда
		ЭтаФорма.Закрыть(Неопределено);
		Возврат;
	КонецЕсли;
	Если Элемент.Заголовок = "Enter" Тогда
		ЭтаФорма.Закрыть(элементыформы.ПолеВвода1.Значение);
		Возврат;
	КонецЕсли;
	Если Элемент.Имя = "Уд" Тогда
		
		элементыформы.ПолеВвода1.Значение =Лев(элементыформы.ПолеВвода1.Значение,СтрДлина(элементыформы.ПолеВвода1.Значение)-1);

	Иначе
	 	элементыформы.ПолеВвода1.Значение =элементыформы.ПолеВвода1.Значение+Элемент.Заголовок;
	
	КонецЕсли;
	Если Заглавные Тогда
		Заглавные = Ложь;
		Заполнитьраскладку();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаглавныеНажатие(Элемент)
	Заглавные = НЕ Заглавные;
	Заполнитьраскладку();
КонецПроцедуры

