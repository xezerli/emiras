перем Excel;
перем КнигаЭкселя;
перем ЛистЭкселя;
Процедура КнопкаВыполнитьНажатие(Кнопка)
	//Excel.Sheets(СтраницаЭкселя).Select();
	//ЛистЭкселя =  КнигаЭкселя.ActiveSheet;
	ДокументПоступления = Документы.ПоступлениеТоваров.СоздатьДокумент();
	ДокументПоступления.Дата = ДатаЗагрузки;
	ДокументПоступления.Склад = Склад;
	ДокументПоступления.Контрагент = Контрагент;
	//ДокументПоступления.Валюта = Справочники.Валюты.НайтиПоНаименованию("AZN");
	ДокументПоступления.Валюта = Валюта;
	СтруктураКурсаВалютыНаДату = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаЗагрузки, Новый Структура("Валюта", Валюта));
	ДокументПоступления.Курс = СтруктураКурсаВалютыНаДату.Курс;
	//ДокументПоступления.ТипЦен = Справочники.ТипыЦен.НайтиПоНаименованию("Satış qiyməti");
	ДокументПоступления.ТипЦен = Справочники.ТипыЦен.НайтиПоНаименованию("Alış qiyməti");
	ДокументПоступления.Автор = глперем.ТекущийПользователь;

	//ДокументПоступления.ОновлениеЦены = Истина;
	Для нс = НомерПервойСтроки по КоличествоСтрок Цикл
		текНаименование = ЛистЭкселя.Cells(нс, НомерКолонкиНаименования).Value;
		текКод = ЛистЭкселя.Cells(нс, НомерКолонкиКода).Value;
		текБаркод = ЛистЭкселя.Cells(нс, НомерКолонкиБаркода).Text;
		текПол = ЛистЭкселя.Cells(нс, НомерКолонкиПола).Value;
		текРазмер = ЛистЭкселя.Cells(нс, НомерКолонкиРазмера).Value;
		текСезон = ЛистЭкселя.Cells(нс, НомерКолонкиСезона).Value;
		текКоличество = ЛистЭкселя.Cells(нс, НомерКолонкиКоличества).Value;
		текЦена = ЛистЭкселя.Cells(нс, НомерКолонкиЦены).Value;
		текРознЦена = ЛистЭкселя.Cells(нс, НомерКолонкиРознЦены).Value;

		НайденнаяНоменклатураПоБаркоду = Справочники.Номенклатура.НайтиПоРеквизиту("Штрихкод", текБаркод);
		Если НайденнаяНоменклатураПоБаркоду.Пустая() Тогда
			//müvəqqəti xəta çıxardıram, sonra isə yazaram ki, yenisi yaradılsın
			Сообщить(текБаркод + " barkodla mal tapılmadı!", СтатусСообщения.ОченьВажное);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументПоступления.Товары.Добавить();
		НоваяСтрока.Товар = НайденнаяНоменклатураПоБаркоду;
		НоваяСтрока.Количество = текКоличество;
		НоваяСтрока.Цена = текЦена;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(ДокументПоступления, НоваяСтрока, "Цена");
		НоваяСтрока.Штрихкод = текБаркод;
		НоваяСтрока.Пол = НайденнаяНоменклатураПоБаркоду.Пол;
		НоваяСтрока.Размер = НайденнаяНоменклатураПоБаркоду.Размер;
		НоваяСтрока.Сезон = НайденнаяНоменклатураПоБаркоду.Сезон;
		НоваяСтрока.Марка = НайденнаяНоменклатураПоБаркоду.Марка;
		НоваяСтрока.ТипНоменклатуры = НайденнаяНоменклатураПоБаркоду.ТипНоменклатуры;
		НоваяСтрока.Единица = НайденнаяНоменклатураПоБаркоду.БазоваяЕдиница;
		НоваяСтрока.Коэффициент = НайденнаяНоменклатураПоБаркоду.БазоваяЕдиница.Коэффициент;
		НоваяСтрока.Артикул = НайденнаяНоменклатураПоБаркоду.Артикул;
		НоваяСтрока.Себестоимость = Окр(НоваяСтрока.Себестоимость * ДокументПоступления.Курс, 2, РежимОкругления.Окр15как20);
		НоваяСтрока.РознЦена = текРознЦена;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(ДокументПоступления, НоваяСтрока, "РознЦена");
		
		
	КонецЦикла;
	
	Попытка
		ДокументПоступления.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ДокументПоступления.Записать(РежимЗаписиДокумента.Запись);
		Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
	КонецПопытки;
	
	Для Каждого стр из ДокументПоступления.Товары Цикл
		запись = Регистрысведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
		запись.Период = ДокументПоступления.Дата;
		запись.Номенклатура = стр.Товар;
		запись.ТипЦен = Справочники.ТипыЦен.НайтиПоНаименованию("Satış qiyməti");
		запись.Док = ДокументПоступления.ссылка;
		запись.Цена = стр.РознЦена;
		запись.Валюта = ДокументПоступления.Валюта;
		запись.Единица = стр.Единица;
		запись.Записать();
	КонецЦикла;
	
	КнигаЭкселя.Close();
	Excel = 0;
	
КонецПроцедуры

Процедура ПриОткрытии()
	НомерПервойСтроки = 2;
	НомерКолонкиНаименования = 1;
	НомерКолонкиКода = 2;
	НомерКолонкиБаркода = 3;
	НомерКолонкиПола = 4;
	НомерКолонкиРазмера = 5;
	НомерКолонкиСезона = 6;
	НомерКолонкиКоличества = 7;
	НомерКолонкиЦены = 8;
	НомерКолонкиРознЦены = 10;
	ДатаЗагрузки = ТекущаяДата();
КонецПроцедуры

Процедура ПутьКфайлуНачалоВыбора(Элемент, СтандартнаяОбработка)
	Mode = FileDialogMode.Open;
	OpeningFileDialogue = New FileDialog(Mode);
	OpeningFileDialogue.FullFileName = "";
	Filter = "Excel faylları"
	+ "(*.xls,*.xlsx)|*.xls;*.xlsx";
	OpeningFileDialogue.Filter = Filter;
	OpeningFileDialogue.Multiselect = True;
	OpeningFileDialogue.Title = "Excel faylları seçin, zəhmət olmasa";
	If OpeningFileDialogue.Choose() Then
		FilesArray = OpeningFileDialogue.SelectedFiles;
		For Each FileName In FilesArray Do
			Selection = New File(FileName);
			ПутьКфайлу = FileName;
			Message(FileName
			+ "Excel faylının ölçüsü "
			+Selection.Size());
			Excel = Новый COMОбъект("Excel.Application");
			КнигаЭкселя = Excel.WorkBooks.Open(ПутьКфайлу);
			ЭлементыФормы.СтраницаЭкселя.СписокВыбора.Очистить();
			Для Каждого лист из Excel.Sheets Цикл
				ЭлементыФормы.СтраницаЭкселя.СписокВыбора.Добавить(лист.Name);
			КонецЦикла;
			
			//Версия = Лев(Excel.Version,Найти(Excel.Version,".")-1);
			//Если Версия = "8" тогда
			//	КоличествоСтрок = Excel.Cells.CurrentRegion.Rows.Count;
			//Иначе
			//	КоличествоСтрок = Excel.Cells(1,1).SpecialCells(11).Row;				
			//Конецесли;
		EndDo;
	Else
		DoMessageBox("Fayl(lar) seçilməyib!");
	EndIf;
КонецПроцедуры

