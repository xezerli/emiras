
Процедура ТабличноеПолеТипПриАктивизацииСтроки(Элемент)
КонецПроцедуры

Процедура ТабличноеПолеТипВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	закрыть(ТабличноеПолеТип.Индекс(элементыформы.ТабличноеПолеТип.ТекущиеДанные));
КонецПроцедуры

Процедура кнВыборНажатие(Элемент)
	Если элементыформы.ТабличноеПолеТип.ТекущиеДанные<>неопределено Тогда
	    закрыть(элементыформы.ТабличноеПолеТип.ТекущиеДанные.Тип);
	КонецЕсли; 
	КонецПроцедуры
Если автор.ОплатаОтПокупателя Тогда
   стр= ТабличноеПолеТип.Добавить();
   стр.Наименование="Alıcıdan ödəniş";
   стр.тип=0;
   Если ТипОплата=0 Тогда
       стр.Картинка="√";
   КонецЕсли; 
КонецЕсли; 
Если автор.ВозвратОплатаПокупателью Тогда
   стр= ТабличноеПолеТип.Добавить();
   стр.Наименование="Alıcya geri ödəniş";
   стр.тип=1;
   Если ТипОплата=1 Тогда
       стр.Картинка="√";
   КонецЕсли; 
КонецЕсли; 
Если автор.ОплатаПоставщику Тогда
   стр= ТабличноеПолеТип.Добавить();
   стр.Наименование="Tədarükcüyə ödəniş";
   стр.тип=2;
   Если ТипОплата=2 Тогда
       стр.Картинка="√";
   КонецЕсли; 
КонецЕсли; 

Если автор.ОплатаПоставщику Тогда
   стр= ТабличноеПолеТип.Добавить();
   стр.Наименование="Tədarükcüdən geri ödəniş";
   стр.тип=3;
   Если ТипОплата=3 Тогда
       стр.Картинка="√";
   КонецЕсли; 
КонецЕсли; 



