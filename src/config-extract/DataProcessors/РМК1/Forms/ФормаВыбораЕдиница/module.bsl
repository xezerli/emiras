Процедура ЗаполнитьТП()
     Запрос=Новый Запрос;
	 запрос.Текст="ВЫБРАТЬ
	              |	ЕдиницыИзмерения.Ссылка
	              |ИЗ
	              |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	              |ГДЕ
	              |	ЕдиницыИзмерения.Владелец = &Товар";
				  
				  
	 
	 Запрос.Параметры.Вставить("Товар",Товар);
				  
	выборка=Запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() Цикл
	    стр=ТабличноеПоле.Добавить();
		стр.Ссылка=выборка.Ссылка;		
		стр.Код=выборка.Ссылка.Код;		
		стр.ЕдиницаПоКлассификатору=выборка.Ссылка.ЕдиницаПоКлассификатору;		
		стр.Коэффициент=выборка.Ссылка.Коэффициент;		
		стр.Штрихкод=стр.Ссылка.Штрихкод;		
		стр.Коэффициент=стр.Ссылка.Коэффициент;		
		Если ЗначениеЗаполнено(ТипЦен) Тогда
		    СтуктураЦена=УправлениеНоменклатурой.ПолучитьСтруктураЦена(выборка.ссылка.Владелец,ТипЦен,стр.ссылка,Дата);
			Если СтуктураЦена<>Неопределено Тогда
			    ЦенаЦены=СтуктураЦена.Цена;
				ЕдЦены= СтуктураЦена.Единица;
				ВалютаЦены=СтуктураЦена.Валюта;
				ЦенаЦены= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ЦенаЦены/ЕдЦены.Коэффициент,ВалютаЦены,Валюта,Дата,Курс);
				стр.цена=ЦенаЦены;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
				  
	мТЗ=новый ТаблицаЗначений;
	мТЗ.Колонки.Добавить("Единица",новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	мТЗ.Колонки.Добавить("Количество",новый ОписаниеТипов(Новый КвалификаторыЧисла(10, 0)));

КонецПроцедуры
 


Процедура ПриОткрытии()
	этаформа.Заголовок=""+Товар.наименование+" malının çeşidləri" ;
	ЗаполнитьТП();
КонецПроцедуры


Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	Если не ЗначениеЗаполнено(Товар) Тогда
	    ОбщегоНазначения.Хебердарлыг("Heç bir mal seçilməyib!",,"Xəbərdarlıq");
		Отказ=истина;
	КонецЕсли; 
КонецПроцедуры


Процедура ТабличноеПолеВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	  закрыть(ВыбраннаяСтрока.Ссылка);
КонецПроцедуры


Процедура кнPGDN_PGUP(Элемент)
	этаформа.ТекущийЭлемент=Элемент.ИсточникДействий;
	глперем.ОбКомКалк.mysendkeys(Элемент.Подсказка);
КонецПроцедуры

Процедура кнВыборНажатие(Элемент)
	ТабличноеПолеВыбор(элементыформы.ТабличноеПоле, элементыформы.ТабличноеПоле.ТекущиеДанные, элементыформы.ТабличноеПоле.ТекущаяКолонка, ложь)
КонецПроцедуры

