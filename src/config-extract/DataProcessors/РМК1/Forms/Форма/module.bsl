Процедура ТабличноеПолеТоварыВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	СтандартнаяОбработка=ложь;
	кол=1;
	 
	
	кол=РаботаСДиалогами.ВводКоличество(кол,,3,"Miqdar daxil edin!");
	Если не значениезаполнено(кол) Тогда
		возврат;
	КонецЕсли; 
	
	Ячейки=Элемент.ОформлениеСтроки (ВыбраннаяСтрока).Ячейки;
	ед=Ячейки.Ед1.значение;
	Если Колонка.имя="Ед2" Тогда
		Если значениеЗаполнено(Ячейки.Ед2.значение) Тогда
		   ед=Ячейки.Ед2.значение;
		КонецЕсли; 
	КонецЕсли; 
	стр=товары.Найти(ед.получить(0).значение,"Единица");
	
	Если стр=неопределено Тогда
	   стр=товары.Добавить();
	   стр.Единица=ед.получить(0).значение;
	   стр.Товар=стр.Единица.владелец;
	   стр.Коэффициент=стр.Единица.Коэффициент;
	   стр.Цена=ед.получить(1).значение;
	   стр.ПроцентСкидки=ПроцентСкидки;
	КонецЕсли; 
	стр.Количество=стр.Количество+кол;
	
	РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,"Количество");
	//стр.Сумма=стр.Цена*стр.Количество;
	элементыформы.Товары.ТекущаяСтрока=стр;
	элементыформы.Товары.ТекущаяКолонка=Элементыформы.Товары.Колонки.Количество;
КонецПроцедуры

