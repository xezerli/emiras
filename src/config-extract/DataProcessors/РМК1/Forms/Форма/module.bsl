Процедура ФилтрТабличноеПолеГруп()
	
	Список=Склад.ГруппыТоваров.ВыгрузитьКолонку("Группа");
	Если Список.Количество()=0 Тогда
	    возврат;
	КонецЕсли; 
	запрос=новый запрос;
	запрос.Текст="ВЫБРАТЬ
	             |	Номенклатура.Ссылка
	             |ИЗ
	             |	Справочник.Номенклатура КАК Номенклатура
	             |ГДЕ
	             |	Номенклатура.Ссылка В ИЕРАРХИИ (&Список)
	             |	И Номенклатура.ЭтоГруппа";
				 запрос.Параметры.Вставить("Список",Список);
	тз=запрос.Выполнить().Выгрузить();			 
	СписокОтбора =новый СписокЗначений;
	СписокОтбора.ЗагрузитьЗначения(тз.ВыгрузитьКолонку("Ссылка"));
	

	ТабличноеПолеГруп.Отбор.Ссылка.ВидСравнения                        = ВидСравнения.ВСписке;
	ТабличноеПолеГруп.Отбор.Ссылка.Значение                            = СписокОтбора;
	ТабличноеПолеГруп.Отбор.Ссылка.Использование                       = Истина;
	

КонецПроцедуры
 



