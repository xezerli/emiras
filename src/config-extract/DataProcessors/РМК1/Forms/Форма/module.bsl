Процедура ТоварыПриИзменении(Элемент)
	стр=элементыформы.Товары.ТекущиеДанные;
	колонка=элементыформы.Товары.ТекущаяКолонка.имя;
	Если колонка="Единица" Тогда
		РаботаСТЧДокумента.ИзмЕдин(этотобъект,стр);
	Иначе
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,Элементыформы.Товары.ТекущаяКолонка.Имя);
	КонецЕсли; 
КонецПроцедуры


Процедура кнИзменитьСтрокаТоварыНажатие(Элемент)
	колонка= Элементыформы.Товары.ТекущаяКолонка;
	Если колонка.Имя="Цена" Тогда
		Если не Автор.ДоступЦена Тогда
			ОбщегоНазначения.Хебердарлыг("Sizin qiyməti dəyişmək hüququnuz yoxdur!",,"Xəbərdarliq");
			Возврат;
		КонецЕсли; 
	КонецЕсли;  
	Если колонка.Имя="Скидка" или колонка.Имя="ПроцентСкидки" Тогда
		Если не Автор.ДоступСкидка Тогда
			ОбщегоНазначения.Хебердарлыг("Sizin endirim təyin etmək hüququnuz yoxdur!",,"Xəbərdarliq");
			Возврат;
		КонецЕсли; 
