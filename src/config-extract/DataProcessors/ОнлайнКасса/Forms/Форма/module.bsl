
Процедура КнопкаВыполнитьНажатие(Кнопка)
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.Чек") Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Чек.Ссылка,
		|	Чек.Номер,
		|	Чек.Дата,
		|	Чек.СуммаДокумента,
		|	Чек.СуммаОплатаБС
		|ИЗ
		|	Документ.Чек КАК Чек
		|ГДЕ
		|	Чек.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		
		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ТекстВопроса = Строка(ВыборкаДетальныеЗаписи.ссылка);
			Ответ        = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Метаданные().Представление());
			
			Если Ответ = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
			
			Ссылка = ВыборкаДетальныеЗаписи.Ссылка;
			Товары = ВыборкаДетальныеЗаписи.Ссылка.Товары;
			
			//Если ВыборкаДетальныеЗаписи.Видоплаты = Перечисления.ВидыОплаты.Безналичная тогда
			//	СуммаБезналичнойОплаты = ВыборкаДетальныеЗаписи.СуммаБезналичнойОплаты;
			//	СуммаНаличнойОплаты = 0;
			//ИначеЕсли ВыборкаДетальныеЗаписи.Видоплаты = Перечисления.ВидыОплаты.Наличная тогда
			//	СуммаНаличнойОплаты = ВыборкаДетальныеЗаписи.СуммаНаличнойОплаты;
			//	СуммаБезналичнойОплаты = 0;
			//КонецЕсли;
			СуммаДокумента = ВыборкаДетальныеЗаписи.СуммаДокумента;
			СуммаБезналичнойОплаты =  ВыборкаДетальныеЗаписи.СуммаОплатаБС;
			НомерЧека = ПечатьЧека(Сервер,Порт, Ссылка, Товары, СуммаДокумента, СуммаБезналичнойОплаты);
			Док = Ссылка.ПолучитьОбъект();
			Док.Комментарий = НомерЧека;
			Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ПриОткрытии()
	Сервер = "192.168.31.133";
	Порт   = 5544;
КонецПроцедуры
