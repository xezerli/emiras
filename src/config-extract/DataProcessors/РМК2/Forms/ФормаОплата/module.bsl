Процедура БС1НачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
Спис=Новый СписокЗначений;
	
Запрос = Новый Запрос;
 	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Кассы.Ссылка
		|ИЗ
		|	Справочник.Кассы КАК Кассы
		|ГДЕ
		|	Кассы.ПометкаУдаления = ЛОЖЬ
		|	И Кассы.ТипКассы = &ТипКассы
		|	И Кассы.Подразделения = &Подразделения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Кассы.Наименование";
	

	Запрос.УстановитьПараметр("ТипКассы", Перечисления.ТипыКассы.БС);
Запрос.УстановитьПараметр("Подразделения",Автор.Подразделения);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Спис.Добавить(ВыборкаДетальныеЗаписи.Ссылка,ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
    ЭлементыФормы.БС1.СписокВыбора=Спис; 
  	
КонецПроцедуры

Процедура БС1ПриИзменении(Элемент)
	
 Проценты=БС1.Проценты.Выгрузить();
 
КонецПроцедуры

Процедура ПроцентыПриАктивизацииСтроки(Элемент)
	//Если ДокументВозврата Тогда
	//	Возврат;
	//КонецЕсли;
	
	ТекДан=ЭлементыФормы.Проценты.ТекущиеДанные;
	Если ТекДан=Неопределено Тогда
		ТекДанПроцДоп=0;
	Иначе
		ТекДанПроцДоп=ТекДан.ПроцДоп;
		
	КонецЕсли;
 
	ПолеВводаСуммаДокумента=ПолеВводаСуммаДокументаНач+макс(0,(ПолеВводаСуммаДокументаНач-ПолеВводаСуммаОплата-ПолеВводаСуммаБонуса))*ТекДанПроцДоп/100;
	ПолеВводаСуммаОплатаБС=ПолеВводаСуммаДокумента-ПолеВводаСуммаОплата-ПолеВводаСуммаБонуса;
    
	
КонецПроцедуры

