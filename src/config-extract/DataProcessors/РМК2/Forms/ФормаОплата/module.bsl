Процедура ПолеВводаСуммаОплатаБСПриИзменении(Элемент)

	Если ДокументВозврата Тогда
		//Если ПолеВводаСуммаОплатаБС>=ПолеВводаСуммаДокументаНач  Тогда
		//	ПолеВводаСуммаОплатаБС=ПолеВводаСуммаДокументаНач;
			ПолеВводаСуммаБонуса=0;
		//	ПолеВводаСуммаОплата=0;
		//	ПолеВводаСуммаДокумента=ПолеВводаСуммаОплатаБС;;
		//	Возврат;
		//КонецЕсли;
		//ПолеВводаСуммаБонуса=0;		
		//ПолеВводаСуммаОплата=ПолеВводаСуммаДокумента-ПолеВводаСуммаОплатаБС;
		//ПолеВводаСуммаОплатаПриИзменении(Элемент);
		//Возврат;
	КонецЕсли;

	ТекДан=ЭлементыФормы.Проценты.ТекущиеДанные;
	Если ТекДан=Неопределено Тогда
		ТекДанПроцДоп=0;
	Иначе
		ТекДанПроцДоп=ТекДан.ПроцДоп;
		
	КонецЕсли;

	Если ПолеВводаСуммаОплатаБС>=(ПолеВводаСуммаДокументаНач+ПолеВводаСуммаДокументаНач*ТекДанПроцДоп/100)  Тогда
		 ПолеВводаСуммаОплатаБС=(ПолеВводаСуммаДокументаНач+ПолеВводаСуммаДокументаНач*ТекДанПроцДоп/100);
		 ПолеВводаСуммаБонуса=0;
		 ПолеВводаСуммаОплата=0;
		 ПолеВводаСуммаДокумента=ПолеВводаСуммаОплатаБС;;
		 Возврат;
		 
	КонецЕсли;
	
		
   	//Если Контрагент.Пустая() тогда
 	ПолеВводаСуммаОплата=((100+ТекДанПроцДоп)*ПолеВводаСуммаДокументаНач-100*ПолеВводаСуммаОплатаБС)/(ТекДанПроцДоп+100)-ПолеВводаСуммаБонуса;
	ПолеВводаСуммаДокумента=ПолеВводаСуммаОплата+ПолеВводаСуммаБонуса+ПолеВводаСуммаОплатаБС;;
	//Конецесли;
КонецПроцедуры


Процедура Кнопка4Нажатие(Элемент)
	
	ПолеВводаСуммаБонуса=РаботаСДиалогами.ВводКоличество(СуммаБонуса,,2,"Bonus məbləği...");
	Если  ПолеВводаСуммаБонуса>ПолеВводаСуммаДокумента Тогда
		 ПолеВводаСуммаБонуса=ПолеВводаСуммаДокумента;
	 КонецЕсли;

	
	//ПолеВводаСуммаОплата=ПолеВводаСуммаДокумента-ПолеВводаСуммаБонуса-ПолеВводаСуммаОплатаБС;
    ПолеВводаСуммаОплатаПриИзменении(Элемент);
КонецПроцедуры

