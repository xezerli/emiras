
Процедура ЗагрузкаИзЕксел()
	
	ТекД=Документы.ПоступлениеТоваров.СоздатьДокумент();
	Текд.ИнстализацияДокумента();
	Текд.Дата=ТекущаяДата();
	
	ДокСкид=Документы.УстановкаСкидкиПоНоменклатуре.СоздатьДокумент();
	ДокСкид.ИнстализацияДокумента();
	ДокСкид.Дата=ТекущаяДата();

	
	
	 // индекс листа
	СчСтроки = 2; // номер строки на листе
	НомСтр = 0;
	Док = ПолучитьCOMОбъект(ФайлЗагрузки); 
	Сообщить(ТекущаяДата());
	Пока Док.Sheets(ТекНомер).Cells(СчСтроки,1).Text <> "" Цикл
		ОбработкаПрерыванияПользователя();
		//Сообщить(Строка);
		Штрихкод = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 2).Text);
		Наименованиетов = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 3).Text);
		//ВалНаим = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 5).Text);

		//Если врег(ВалНаим)<> ЭлементыФормы.ПолеВалюта.Значение Тогда
		//	СчСтроки = СчСтроки + 1;
		//	Продолжить;
		//КонецЕсли;
		
		
		
		Попытка
			Количество=Число(СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 4).Text));
		Исключение
			Количество=0;
		КонецПопытки;
		
		Если Количество=0 тогда
			СчСтроки = СчСтроки + 1;
			Продолжить;
		КонецЕсли;
		
		
		Попытка
			Пцена=Число(СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 5).Text));
		Исключение
			Пцена=0;
		КонецПопытки;
		
		Попытка
			Зцена=Число(СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 10).Text));
			//Если врег(ВалНаим)="AZN" Тогда
			//	Зцена=Зцена*3.3;
			//КонецЕсли;
			//Если врег(ВалНаим)="USD" Тогда
			//	Зцена=Зцена*5.5;
			//КонецЕсли;

			
		Исключение
			Зцена=0;
		КонецПопытки;
		
		
		Попытка
			ПроцСкид=Число(СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 6).Text));
		Исключение
			ПроцСкид=0;
		КонецПопытки;
		
		
		
		
		Кодтов=Неопределено;
		Если Лев(Штрихкод,2)="22" Тогда
			Кодтов=Прав(Лев(Штрихкод,8),6);
		КонецЕсли;
		
		
		//КартНомер = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 4).Text);
		
		//Кодтов = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 2).Text);
		//Кодтов=прав("000000000"+СтрЗаменить(Кодтов,",",""),9);	
		
		НовЭл=Неопределено;
		Единица=Неопределено;
		Если Штрихкод<>"" Тогда			
			//НовЭл=Справочники.Номенклатура.НайтиПоРеквизиту("Штрихкод",Штрихкод);;
			
			Единица= справочники.ЕдиницыИзмерения.НайтиПоРеквизиту("Штрихкод",Штрихкод);
			Если значениезаполнено(Единица) Тогда
				НовЭл=единица.Владелец;
			Иначе
				НовЭл=Справочники.Номенклатура.НайтиПоНаименованию(Наименованиетов,Истина);
				Если ЗначениеЗаполнено(НовЭл) Тогда
					НовЕд = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
					НовЕд.Владелец = НовЭл.Ссылка;
					НовЕд.ЕдиницаПоКлассификатору = НовЭл.КлБазоваяЕдиница;
					НовЕд.Коэффициент = 1;
					НовЕд.Наименование = НовЭл.КлБазоваяЕдиница.Наименование;
					НовЕд.Штрихкод = Штрихкод;
					НовЕд.Записать();
					Сообщить("Yeni vahid yarandı "+НовЭл+" - "+Штрихкод);
    				Единица=  НовЕд.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
		Иначе 
			СчСтроки = СчСтроки + 1;
			Продолжить;
		КонецЕсли;

		
		//Если НовЭл.Наименование<>Наименованиетов Тогда
		//	Сообщить(""+НовЭл.Наименование+"<-->"+Наименованиетов);
		//КонецЕсли;
		
		Если  не ЗначениеЗаполнено(НовЭл) Тогда 
			
			Марка=Неопределено;
			ТипНомен=Неопределено;
			Цвет=Неопределено;
			Размер=Неопределено;
			Пол=Неопределено;
			Сезон=Неопределено; 		
			Арикул="";
			
			Строка	        = СтрЗаменить(Наименованиетов, "/", Символы.ПС);
			Колраз=СтрЧислоСтрок(Строка);
			
			
			для Индекс=0 по Колраз-3 Цикл
				инд=Колраз-Индекс;
				Стр3= сокрлп(СтрПолучитьСтроку(Строка, инд));
				Если Стр3="" Тогда 
					Продолжить;
				КонецЕсли;
				
				Если Индекс=0 Тогда
					Артикул=Стр3;
					Продолжить;
				КонецЕсли;
				Если Индекс=1 Тогда
					Сезон=Справочники.Сезон.НайтиПоНаименованию(Стр3,Истина);
					Если ЗначениеЗаполнено(Сезон) или инд=6 Тогда  
						Продолжить;
					Иначе
						Размер=Справочники.Размер.НайтиПоНаименованию(Стр3,Истина);
						Если ЗначениеЗаполнено(Размер) или инд=5 Тогда
							Продолжить;
						Иначе
							Цвет=Справочники.Цвет.НайтиПоНаименованию(Стр3,Истина);
							Если ЗначениеЗаполнено(Цвет) или инд=4 Тогда
								Продолжить;
							Иначе
								Пол=Справочники.Пол.НайтиПоНаименованию(Стр3,Истина);
								Если ЗначениеЗаполнено(Пол) или инд=3 Тогда
									Продолжить;														
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;				
				КонецЕсли;
				
				Если Индекс=2 Тогда
					Размер2=Справочники.Размер.НайтиПоНаименованию(Стр3,Истина);
					Если не ЗначениеЗаполнено(Размер)  и ( ЗначениеЗаполнено(Размер2) или инд=5 )Тогда
						Размер=Размер2;				
						Продолжить;
						
					Иначе
						
						Цвет2=Справочники.Цвет.НайтиПоНаименованию(Стр3,Истина);
						Если не ЗначениеЗаполнено(Цвет) и (ЗначениеЗаполнено(Цвет2) или инд=4) Тогда
							Цвет=Цвет2;
							Продолжить;
						Иначе
							Пол2=Справочники.Пол.НайтиПоНаименованию(Стр3,Истина);
							Если не ЗначениеЗаполнено(Пол) и (ЗначениеЗаполнено(Пол2) или инд=3) Тогда
								Пол=Пол2;
								Продолжить;														
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
				
				Если Индекс=3 Тогда
					Цвет2=Справочники.Цвет.НайтиПоНаименованию(Стр3,Истина);
					Если не ЗначениеЗаполнено(Цвет) и (ЗначениеЗаполнено(Цвет2) или инд=4) Тогда
						Цвет=Цвет2;
						Продолжить;
					Иначе
						Пол2=Справочники.Пол.НайтиПоНаименованию(Стр3,Истина);
						Если не ЗначениеЗаполнено(Пол) и (ЗначениеЗаполнено(Пол2) или инд=3) Тогда
							Пол=Пол2;
							Продолжить;														
						КонецЕсли;
					КонецЕсли;
					
					
				КонецЕсли;
				
				Если Индекс=4 Тогда
					Пол2=Справочники.Пол.НайтиПоНаименованию(Стр3,Истина);
					Если не ЗначениеЗаполнено(Пол) и (ЗначениеЗаполнено(Пол2) или инд=3) Тогда
						Пол=Пол2;
						Продолжить;														
					КонецЕсли;
				КонецЕсли; 			
			КонецЦикла;
			
			МаркаСтр   = сокрлп(СтрПолучитьСтроку(Строка, 1));
			Марка=Справочники.Марка.НайтиПоНаименованию(МаркаСтр,Истина);
			Если не ЗначениеЗаполнено(Марка) Тогда  
				Марка=Справочники.Марка.СоздатьЭлемент();
				Марка.Наименование=МаркаСтр;
				Марка.Записать();
				Марка=Марка.Ссылка;
			КонецЕсли;
			
			ТипСтр   = сокрлп(СтрПолучитьСтроку(Строка, 2));
			ТипНомен=Справочники.ТипНоменклатуры.НайтиПоНаименованию(ТипСтр,Истина);
			Если не ЗначениеЗаполнено(ТипНомен) Тогда  
				ТипНомен=Справочники.ТипНоменклатуры.СоздатьЭлемент();
				ТипНомен.Наименование=ТипСтр;
				ТипНомен.Записать();
				ТипНомен=ТипНомен.Ссылка;
			КонецЕсли;
			
			
			НовЭл=Справочники.Номенклатура.СоздатьЭлемент();
			
			НовЭл.Наименование=Наименованиетов;
			НовЭл.код=Кодтов;
			НовЭл.Штрихкод=Штрихкод;
			НовЭл.КлБазоваяЕдиница=Константы.ТипБазовойЕдиницыПоУмолчанию.Получить();
			
			НовЭл.Артикул=Артикул;
			НовЭл.Марка=Марка;
			НовЭл.ТипНоменклатуры=ТипНомен;
			НовЭл.Цвет=Цвет;
			НовЭл.Размер=Размер;
			НовЭл.Пол=Пол;
			НовЭл.Сезон=Сезон;
			
			НовЭл.Записать();
			
			НовЕд = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			НовЕд.Владелец = НовЭл.Ссылка;
			НовЕд.ЕдиницаПоКлассификатору = НовЭл.КлБазоваяЕдиница;
			НовЕд.Коэффициент = 1;
			НовЕд.Наименование = НовЭл.КлБазоваяЕдиница.Наименование;
			НовЕд.Штрихкод = Штрихкод;
			НовЕд.Записать();
			
			НовЭл.БазоваяЕдиница =  НовЕд.Ссылка;
			НовЭл.ОсновнаяЕдиница = НовЕд.Ссылка;
			Единица=  НовЕд.Ссылка;

			НовЭл.Записать();
			
		 			
			Сообщить("Yeni mal: "+НовЭл);

		конецесли;
		
		
		
		
		
		Если Пцена>0 Тогда
			запись= регистрысведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
			запись.Период=ТекущаяДата();
			запись.Номенклатура=НовЭл.Ссылка;
			запись.ТипЦен=глперем.ТекущийПользователь.РозничныйТипЦен; 		
			запись.Цена=Пцена;
			запись.Валюта=Константы.БазоваяВалюта.Получить();
			запись.Единица=Единица;
			запись.Записать();
		КонецЕсли;
		
		Если Зцена>0 Тогда
			
			запись= регистрысведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
			запись.Период=ТекущаяДата();
			запись.Номенклатура=НовЭл.Ссылка;
			запись.ТипЦен=глперем.ТекущийПользователь.ЗакупочныйТипЦен; 		
			запись.Цена=Зцена;
			запись.Валюта=Константы.ИноВалюта.Получить();
			запись.Единица=Единица;
			запись.Записать();
		КонецЕсли;
		

		
		
		НоваяСтрока = ТекД.Товары.Добавить();
		НоваяСтрока.Товар = НовЭл.Ссылка;
		
		НоваяСтрока.Единица = Единица;
		НоваяСтрока.Коэффициент =Единица.Коэффициент;
		НоваяСтрока.Количество = Количество;
		
		
		НоваяСтрока.Цена=Зцена;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(Текд,НоваяСтрока);
		НоваяСтрока.РознЦена=Пцена;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(Текд,НоваяСтрока,"РознЦена");
		ЗаполнитьМарки(НоваяСтрока);
		
		НоваяСтрока.Штрихкод=  НоваяСтрока.Единица.Штрихкод;
		Если  НоваяСтрока.Штрихкод<>Штрихкод Тогда
			
			Сообщить(""+НоваяСтрока.НомерСтроки+". "+НоваяСтрока.Товар.Наименование+"("+НоваяСтрока.Товар.Штрихкод+")"
			+"<>"+ Наименованиетов+"("+Штрихкод+")");
			

		КонецЕсли;
		
		
		
		Если ПроцСкид >0 Тогда
			НовСк=ДокСкид.Товары.Добавить();
			НовСк.Товар=НовЭл.Ссылка;
			НовСк.Единица = Единица;
		    НовСк.Коэффициент =Единица.Коэффициент;
            НовСк.СкидкаПроцент=ПроцСкид;
			
		КонецЕсли;
		

		Состояние(""+НовЭл+"  -  "+Количество);
		
		СчСтроки = СчСтроки + 1;
		
		
	КонецЦикла;   
	
	Текд.ПолучитьФорму().Открыть();
	
	ДокСкид.ПолучитьФорму().Открыть();

	
КонецПроцедуры

Процедура ЗагрузкаИзCsv()
	
	ТекНомер = 1; // индекс листа
	СчСтроки = 3; // номер строки на листе
	НомСтр = 0;
	Файл = Новый ТекстовыйДокумент();
	Попытка
		Файл.Прочитать(ФайлЗагрузки);
	Исключение
		Сообщить("Ощибка при чтение файла");		
	КонецПопытки;
	Для Н = 1 По Файл.КоличествоСтрок() Цикл
		Строка = Файл.ПолучитьСтроку(Н);
		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Строка	        = СтрЗаменить(Строка, ";", Символы.ПС);
		
		Наименованиетов	    = СтрПолучитьСтроку(Строка, 3);
		КартНомер =СтрПолучитьСтроку(Строка, 4);		
		Кодтов  = СтрПолучитьСтроку(Строка, 2);   
		Кодтов=прав("000000000"+СтрЗаменить(Кодтов,",",""),9);		
		Спрконт=Неопределено;
		Если Кодтов<>"" Тогда
			
			Спрконт=Справочники.Контрагенты.НайтиПоКоду(Кодтов);
		Иначе 
			Продолжить;
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(Спрконт) Тогда
			
			Продолжить; 			
			
		конецесли    ;
		
		Спр=Справочники.Контрагенты.СоздатьЭлемент();
		
		Спр.Наименование=Наименованиетов;
		Спр.код=Кодтов;
		спр.Родитель=Груп;
		спр.КартНомер=КартНомер;
		Спр.Записать();
		
		
		Сообщить(""+СчСтроки+" "+Спрконт);
		
		СчСтроки = СчСтроки + 1;
		
		
		
	КонецЦикла; 	
	
	
	
	
КонецПроцедуры

Процедура Кнопка1Нажатие(Элемент)
	ФайлНаДиске = Новый Файл(ФайлЗагрузки);
	Если нРег(ФайлНаДиске.Расширение) = ".xls" ИЛИ нРег(ФайлНаДиске.Расширение) = ".xlsx" Тогда
		ЗагрузкаИзЕксел();
	ИначеЕсли нРег(ФайлНаДиске.Расширение) = ".csv" Тогда
		ЗагрузкаИзCsv();
	КонецЕсли;
	
КонецПроцедуры


Процедура КнопкаЗагрузкаНажатие(Элемент)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Прочитать табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.csv;*.xls;*.xlsx)|*.csv;*.xls;*.xlsx";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		
	КонецЕсли;
КонецПроцедуры


Процедура КоманднаяПанель2УдалитьЦены(Кнопка)
	Выборка= регистрысведений.ЦеныНоменклатуры.Выбрать(,,новый структура("Док",Неопределено)) ;
	
	Пока Выборка.Следующий() Цикл
		запись=Выборка.ПолучитьМенеджерЗаписи();
		Состояние (запись.Номенклатура.Наименование);
		
		запись.Удалить();
		//запись.Записать();
	КонецЦикла; 
КонецПроцедуры

Процедура ЗаполнитьМарки(стр)
	стр.Марка=  стр.Товар.Марка;
	стр.ТипНоменклатуры=  стр.Товар.ТипНоменклатуры;
	стр.Пол=  стр.Товар.Пол;
	стр.Цвет=  стр.Товар.Цвет;
	стр.Сезон=  стр.Товар.Сезон;
	стр.Размер=  стр.Товар.Размер;
	стр.Артикул=  стр.Товар.Артикул;
	
КонецПроцедуры

Процедура КоманднаяПанель2Перенумеровать(Кнопка)
	
	нн=1;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Штрихкод,
		|	Номенклатура.Наименование,
