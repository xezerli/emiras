Процедура КоманднаяПанель1кнПодбор(Кнопка)
	формаподбора=справочники.Номенклатура.ПолучитьФормуСписка("ФормаПодбора",этаформа) ;
	формаподбора.РежимВыбора=Истина;
	формаподбора.объект=этотобъект;
	формаподбора.ВыборГруппы=Истина;
	формаподбора.ЗакрыватьПриВыборе=Ложь;
	формаподбора.Открыть();

КонецПроцедуры


Процедура ОбработкаВыбора(ЗначениеВыбора, Источник)
	перем КлючиСтроки;
	
	Если ТипЗнч(ЗначениеВыбора) = Тип("Структура")  Тогда
		Если ЗначениеВыбора.Номенклатура.эТОГРУППА Тогда
			выборка=справочники.Номенклатура.Выбрать(ЗначениеВыбора.Номенклатура);
			Пока выборка.Следующий() Цикл
				Если выборка.ЭтоГруппа Тогда
				     продолжить;
				КонецЕсли; 
				стр=товары.Найти(выборка.ОсновнаяЕдиница,"Единица") ;
				Если стр=неопределено Тогда
					стр=товары.Добавить();
					стр.Товар=выборка.Ссылка;
					стр.Единица=выборка.ОсновнаяЕдиница;
					стр.Штрихкод=Стр.Единица.Штрихкод;
					ПолучитьЦену(Стр);					
				КонецЕсли; 
				стр.Количество=стр.Количество+ЗначениеВыбора.Количество;
			КонецЦикла; 
			
		Иначе
			стр=товары.Найти(ЗначениеВыбора.единица,"Единица") ;
			Если стр=неопределено Тогда
				стр=товары.Добавить();
				стр.Товар=ЗначениеВыбора.Номенклатура;
				стр.Единица=ЗначениеВыбора.Единица;
				стр.Штрихкод=Стр.Единица.Штрихкод;
				ПолучитьЦену(Стр);
			КонецЕсли; 
			стр.Количество=стр.Количество+ЗначениеВыбора.Количество;
			элементыформы.Товары.ТекущаяСтрока =стр;
			элементыформы.Товары.ТекущаяКолонка =элементыформы.Товары.Колонки.Количество;
		КонецЕсли; 
	 ИначеЕсли ТипЗнч(ЗначениеВыбора) = Тип("ДокументСсылка.ПоступлениеТоваров")  Тогда
		 Товары.Очистить();
		  Для каждого стр Из ЗначениеВыбора.товары Цикл
		      стрТовары=Товары.Добавить();
			  стрТовары.Товар=стр.Товар;
			  стрТовары.Единица=стр.единица;
			  стрТовары.Штрихкод=стрТовары.Единица.Штрихкод;
			  ПолучитьЦену(стрТовары);
			  стрТовары.Количество=1;
		  КонецЦикла; 

	КонецЕсли; 
КонецПроцедуры

Процедура КоманднаяПанель1менюИзПоступление(Кнопка)
	формаподбора=Документы.ПоступлениеТоваров.ПолучитьФормуВыбора("ФормаСписка",Этаформа) ;
	формаподбора.РежимВыбора=Истина;
	формаподбора.ЗакрыватьПриВыборе=Истина;
	формаподбора.Открыть();
КонецПроцедуры

Процедура ВнешнееСобытие(Источник, Событие, Данные)
		перем единица,Количество,КлючиСтроки;
	глперем.СканерИзФормы=истина;

	Если не ВводДоступен() Тогда
		возврат;
	КонецЕсли;   
	Если Источник="BarCodeScaner" и Событие ="BarCodeValue" Тогда
		Штрихкод =Сокрлп(глперем.Сканер.ScanData);
		товар=УправлениеНоменклатурой.НайтиПоШтрихкоду(Штрихкод,единица,Количество);
		если товар<>неопределено тогда
			
			стр=товары.Найти(единица,"Единица") ;
			Если стр=неопределено Тогда
				стр=товары.Добавить();
				стр.Товар=единица.Владелец;
				стр.Единица=единица;
				стр.Штрихкод=Стр.Единица.Штрихкод;
				ПолучитьЦену(Стр);
	
			КонецЕсли; 
			стр.Количество=стр.Количество+Количество;
			элементыформы.Товары.ТекущаяСтрока =стр;
			элементыформы.Товары.ТекущаяКолонка =элементыформы.Товары.Колонки.Количество;
		КонецЕсли; 
	КонецЕсли; 
	глперем.Сканер.DeleteEvent();
	глперем.Сканер.DataEventEnabled = 1;

КонецПроцедуры

Процедура ТоварыЕдиницаПриИзменении(Элемент)
	стр=ЭлементыФормы.Товары.ТекущиеДанные;
	стр.Штрихкод=Стр.Единица.Штрихкод;
	ПолучитьЦену(Стр);
КонецПроцедуры

Процедура ПриОткрытии()
	
	Для каждого стр из Товары цикл
		ПолучитьЦену(стр);
		 стр.Штрихкод=стр.Единица.Штрихкод;
	КонецЦикла;
	
КонецПроцедуры


