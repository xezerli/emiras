//Процедура реакции на нажатие кнопки на форме
Процедура Нажатие_Кнопки(Кнопка)
	// Вставить содержимое обработчика.
	Если Кнопка.Имя = "Ок" Тогда
			ЭтаФорма.Закрыть(Число(СокрЛП( ЭлементыФормы.ПолеЗначение.Значение)));
	ИначеЕсли Кнопка.Имя = "Сброс" Тогда
		ПолеЗначение = "0";
		позТочка=0;
	ИначеЕсли Кнопка.Имя = "Выход" Тогда
		ЭтаФорма.Закрыть(Неопределено);
	Иначе
		Если  (Кнопка.Заголовок=".") тогда
			Если флПервыйНажатие Тогда
			   флПервыйНажатие=ложь;
			   ЭлементыФормы.ПолеЗначение.Значение="0.";
			   позТочка=2;
			КонецЕсли; 
			если   точность>0 и позТочка=0 Тогда
				ЭлементыФормы.ПолеЗначение.Значение = ЭлементыФормы.ПолеЗначение.Значение + Кнопка.Заголовок;
				позТочка=стрДлина(ЭлементыФормы.ПолеЗначение.Значение);
			КонецЕсли;
		Иначе
			Если  не (позТочка>0 и стрдлина(ЭлементыФормы.ПолеЗначение.Значение)>=позТочка+точность) Тогда
			Если флПервыйНажатие Тогда
			   флПервыйНажатие=ложь;
			   ЭлементыФормы.ПолеЗначение.Значение="";
			КонецЕсли; 
				Если ПолеЗначение="0" Тогда
				    ЭлементыФормы.ПолеЗначение.Значение="";
				КонецЕсли; 
			     ЭлементыФормы.ПолеЗначение.Значение = ЭлементыФормы.ПолеЗначение.Значение + Кнопка.Заголовок;
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
	ЭтаФорма.ТекущийЭлемент = ЭлементыФормы.Ок;
КонецПроцедуры

