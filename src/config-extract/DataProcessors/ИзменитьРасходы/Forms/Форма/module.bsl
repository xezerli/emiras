
Процедура КнопкаВыполнитьНажатие(Кнопка)
	 Если Не ЗначениеЗаполнено(СтатРасх) тогда
		Возврат;
	КонецЕсли;

	Если ТабРасходы.Количество()=0  тогда
		Возврат;
	КонецЕсли;
	
		
	 	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрочиеРасходыТЧ.Ссылка
		|ИЗ
		|	Документ.ПрочиеРасходы.ТЧ КАК ПрочиеРасходыТЧ
		|ГДЕ
		|	ПрочиеРасходыТЧ.СтатяЗатрат В(&СписРасход)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПрочиеРасходыТЧ.Ссылка.Дата";
	
	Запрос.УстановитьПараметр("СписРасход", ТабРасходы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка  = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Док=Выборка.Ссылка.ПолучитьОбъект();
		Сообщить(Док);
		 
		
		Для Каждого стр из Док.ТЧ Цикл
			Для каждого стррас из ТабРасходы Цикл
				Если стр.СтатяЗатрат=стррас.Значение Тогда
					стр.СтатяЗатрат= СтатРасх.Ссылка;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если Док.Проведен Тогда
		Док.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
	Иначе
		Док.Записать(РежимЗаписиДокумента.Запись );
	КонецЕсли;

	КонецЦикла;
	
	
	 
	
	
КонецПроцедуры
