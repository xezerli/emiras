
Процедура КнопкаВыполнитьНажатие(Кнопка)
	
 	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Чек.Ссылка
		|ИЗ
		|	Документ.Чек КАК Чек
		|ГДЕ
		|	Чек.СуммаОплатаБС > 0
		|	И Чек.КолМес > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сообщить(Выборка.ссылка);
		Док=Выборка.ссылка.ПолучитьОбъект();
		
		Для каждого стр из Док.Товары Цикл
					
			СтруктураЦены = УправлениеНоменклатурой.ПолучитьСтруктураЦена(стр.товар,Док.ТипЦен,стр.единица,док.Дата);
			Если СтруктураЦены<>неопределено Тогда
				ценацены=СтруктураЦены.цена;
				Валютацены=СтруктураЦены.Валюта;
				Единицацены=СтруктураЦены.Единица;
				Если (значениезаполнено(ценацены)и значениезаполнено(Валютацены)и значениезаполнено(Единицацены)) Тогда
					ценацены=ценацены*стр.коэффициент/ Единицацены. коэффициент;
					ценацены=МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ценацены,Валютацены,Док.валюта,МодульВалютногоУчета.ПолучитьКурсВалюты(Валютацены,док.дата).курс,док.курс);
					стр.СуммаБезПроцентов= ценацены*стр.Количество*(1-стр.ПроцентСкидки/100);
				иначе
					стр.СуммаБезПроцентов= стр.цена*стр.Количество*(1-стр.ПроцентСкидки/100);
				КонецЕсли; 
			КонецЕсли;
			
			
		КонецЦикла;
		
		
		Док.записать();
		
	КонецЦикла;
	
 
	
	
	
	
	
	
	
КонецПроцедуры

Процедура ОсновныеДействияФормыОчиститьМарки(Кнопка)
	
	
	   	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Марка.Ссылка КАК Ссылка,
		|	Марка.Наименование КАК Наименование,
		|	КОЛИЧЕСТВО(Марка.Ссылка) КАК КОЛИЧЕСТВО
		|ИЗ
		|	Справочник.Цвет КАК Марка
		|
		|СГРУППИРОВАТЬ ПО
		|	Марка.Наименование,
		|	Марка.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|ИТОГИ
		|	СУММА(КОЛИЧЕСТВО)
		|ПО
		|	Наименование,
		|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		Состояние(""+Выборка.Наименование+" - "+Выборка.КОЛИЧЕСТВО);
		
		Если Выборка.КОЛИЧЕСТВО<=1 Тогда
			Продолжить;
		КонецЕсли;
		Сообщить(""+Выборка.Наименование+" - "+Выборка.КОЛИЧЕСТВО);
		
		ВыборкаСсылка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		перв=ложь;
		МаркаОсн=Неопределено;
		Пока ВыборкаСсылка.Следующий() Цикл
			марка=ВыборкаСсылка.ссылка;
			Если не перв тогда
				Перв= истина;
				МаркаОсн=марка;
			иначе
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Номенклатура.Ссылка
				|ИЗ
				|	Справочник.Номенклатура КАК Номенклатура
				|ГДЕ
				|	Номенклатура.Цвет = &Марка";
				
				Запрос.УстановитьПараметр("Марка", Марка);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаНоменклатура = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаНоменклатура.Следующий() Цикл
					 Товар=ВыборкаНоменклатура.Ссылка.ПолучитьОбъект();
					 Товар.Цвет=МаркаОсн;
					 Товар.Записать();
					 МаркаОб= Марка.ПолучитьОбъект();
					 Маркаоб.УстановитьПометкуУдаления(Истина,Истина);
					 Маркаоб.Записать();
					
					
				КонецЦикла;
				
				
			КонецЕсли;
					
		КонецЦикла;

		
		
		
		
		
		
	КонецЦикла;
	
	

	
	
	
	
	
	
	
КонецПроцедуры

Процедура ОсновныеДействияФормыФилиалыВРАсходах(Кнопка)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетПроцентОтПродаж.Ссылка
		|ИЗ
		|	Документ.РасчетПроцентОтПродаж КАК РасчетПроцентОтПродаж
		|ГДЕ
		|	РасчетПроцентОтПродаж.Проведен = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	РасчетПроцентОтПродаж.Дата";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Док=Выборка.ссылка.ПолучитьОбъект();
		Док.Подразделения=Док.Сотрудник.Подразделения;
		стр=док.Сотрудники.Добавить();
		Стр.Сотрудник=Док.Сотрудник;
		Стр.ДатаНачала=Док.ДатаНачала;
		
		Для каждого стрТЧ из Док.Тч Цикл
			 стрТЧ.Сотрудник=Док.Сотрудник;
		КонецЦикла;
		
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
			Сообщить(""+Док);
		Исключение
			Сообщить("Sehv! "+Док);
		КонецПопытки;
	КонецЦикла;
	
	
	
	
	
	
КонецПроцедуры

Процедура ОсновныеДействияФормыДействие(Кнопка)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка Как ссылка,
		|	ЗарплатыСотрудниковСрезПоследних.Сумма Как сумма
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗарплатыСотрудников.СрезПоследних КАК ЗарплатыСотрудниковСрезПоследних
		|		ПО Сотрудники.Ссылка = ЗарплатыСотрудниковСрезПоследних.Сотрудник.Ссылка
		|ГДЕ
		|	Сотрудники.ЭтоГруппа = ЛОЖЬ
		|	И ЗарплатыСотрудниковСрезПоследних.Сумма > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка  = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	    Сотрудник=Выборка.Ссылка.ПолучитьОбъект();
		Сотрудник.Зарплата=Выборка.Сумма;
		Сотрудник.Записать();
		Сообщить(""+Сотрудник+" = "+ Выборка.Сумма);
		
	КонецЦикла;
КонецПроцедуры
