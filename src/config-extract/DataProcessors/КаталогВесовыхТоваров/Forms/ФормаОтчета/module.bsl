Процедура кнНастройкаНажатие(Элемент)
	ф= ПолучитьОбщуюФорму("ФормаНастройкаОтчета",этаформа);
	ф.объект=ОтчетОбъект;
	ф.ЭлементыФормы.панель1.Страницы.Страница3.видимость=Истина;
	
	Если ф.ОткрытьМодально()<>неопределено Тогда
		Отчет(элементыформы.ПолеТабличногоДокумента1);
	КонецЕсли;
	
КонецПроцедуры

Процедура кнСформироватьНажатие(Элемент)
	Отчет(элементыформы.ПолеТабличногоДокумента1);
КонецПроцедуры

Процедура ЗаполнитьТаблицуЦен()
	
	ТаблицаЦен.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК ЦенаТовара,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&КонПериода, ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних";

	Запрос.УстановитьПараметр("КонПериода", КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);

	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	ТаблицаЦен.Индексы.Добавить("Номенклатура");
	
КонецПроцедуры

Процедура ЗаполнитьПЛУ()
	
	ТаблицаПЛУ.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПЛУНомер.Номенклатура КАК Номенклатура,
		|	ПЛУНомер.НомерПЛУ
		|ИЗ
		|	РегистрСведений.ПЛУНомер КАК ПЛУНомер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";

	Запрос.УстановитьПараметр("КонПериода", КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);

	ТаблицаПЛУ = Запрос.Выполнить().Выгрузить();
	ТаблицаПЛУ.Индексы.Добавить("Номенклатура");
	
КонецПроцедуры

Процедура Отчет(ТабДок)

    ЗаполнитьТаблицуЦен();
	ЗаполнитьПЛУ();	
	
	Макет = ПолучитьМакет("Макет");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Наименование,
		|	Номенклатура.Штрихкод,
		|	Номенклатура.Ссылка КАК Товар
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Весовой = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";

	Результат = Запрос.Выполнить().Выбрать();

	//ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьПодвалТаблицы = Макет.ПолучитьОбласть("ПодвалТаблицы");
	ОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("Детали");

	ТабДок.Очистить();
	//ТабДок.Вывести(ОбластьЗаголовок);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	ТабДок.НачатьАвтогруппировкуСтрок();
	//н = н+1;
	Пока Результат.Следующий() Цикл
		ОбработкаПрерыванияПользователя();
		СтрокаЦены = ТаблицаЦен.Найти(Результат.Товар, "Номенклатура");
		Цена = 0;
		Если СтрокаЦены <> Неопределено Тогда
			Цена = СтрокаЦены.ЦенаТовара;
		КонецЕсли;
		
		СтрокаПЛУ = ТаблицаПЛУ.Найти(Результат.Товар, "Номенклатура");
		КодПЛУ = 0;
		Если СтрокаПЛУ <> Неопределено Тогда
			КодПЛУ = СтрокаПЛУ.НомерПЛУ;
		КонецЕсли;
		
		ОбластьДетальныхЗаписей.Параметры.КодПЛУ = КодПЛУ;
		ОбластьДетальныхЗаписей.Параметры.Код = Строка(Результат.Товар.Код);
		ОбластьДетальныхЗаписей.Параметры.Штрихкод = СокрЛП(Результат.Товар.Штрихкод);
		ОбластьДетальныхЗаписей.Параметры.Цена = Цена;
		ОбластьДетальныхЗаписей.Параметры.Наименование = СокрЛП(Результат.Товар.Наименование);
		  //ОбластьДетальныхЗаписей.Параметры.Заполнить(Результат);
		//ОбластьДетальныхЗаписей.Параметры.КодС = "22";
		ОбластьДетальныхЗаписей.Параметры.ПечОтд = "22";
		Если Цена>0 Тогда
			ТабДок.Вывести(ОбластьДетальныхЗаписей, Результат.Уровень());
		КонецЕсли;	
	КонецЦикла;

	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	ТабДок.Вывести(ОбластьПодвалТаблицы);
	ТабДок.Вывести(ОбластьПодвал);
	
	
	
КонецПроцедуры


