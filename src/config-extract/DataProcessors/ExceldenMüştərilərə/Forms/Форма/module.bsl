
Процедура ЗагрузкаИзЕксел()
	
	
	
	ТекНомер = 1; // индекс листа
	СчСтроки = 2; // номер строки на листе
	НомСтр = 0;
	Док = ПолучитьCOMОбъект(ФайлЗагрузки); 
	Сообщить(ТекущаяДата());
	Пока Док.Sheets(ТекНомер).Cells(СчСтроки,1).Text <> "" Цикл
		ОбработкаПрерыванияПользователя();
		//Сообщить(Строка);
		
		Наименование = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 1).Text);
		КартНомер = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 2).Text);
		Телефоны = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 3).Text);
		ДатаРожденияТ = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 4).Text);		
		ПолТ = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 5).Text);
		МестоРаботы = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 6).Text);
		СемПоложенияТ = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 7).Text);
		Ввел = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 8).Text);
		ДатаВводаТ = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 9).Text);
		
	    СемПоложения=Неопределено;
		Если Лев(СемПоложенияТ,1)="E" Тогда
			СемПоложения=Перечисления.СемПоложения.Evli;
		ИначеЕсли Лев(СемПоложенияТ,1)="S" Тогда
			СемПоложения=Перечисления.СемПоложения.Subay;
		КонецЕсли;
		
	    Пол=Неопределено;
		Если Лев(ПолТ,1)="K" Тогда
			Пол=Перечисления.Пол.Kişi;
		ИначеЕсли Лев(СемПоложенияТ,1)="Q" Тогда
			Пол=Перечисления.Пол.Qadın;
		КонецЕсли;
		
		   ДатаРождения=Неопределено;
		Если ДатаРожденияТ<>"" Тогда
			ДатаРождения = Дата(ДатаРожденияТ+" 01:01:01");
 
		КонецЕсли;
		
		   ДатаВвода=Неопределено;
		Если ДатаВводаТ<>"" Тогда
			ДатаВвода = Дата(ДатаВводаТ+":00");
 
		КонецЕсли;
		
		
		найдКонт=справочники.Контрагенты.НайтиПоРеквизиту("КартНомер",КартНомер);
		если не найдКонт.Пустая()  тогда
			если СокрЛП(найдКонт.Наименование)=Наименование Тогда
				СчСтроки = СчСтроки + 1;
				Продолжить;
			КонецЕсли;
			
			Сообщить(Наименование);
			Сообщить("Kart nömrəsi " +КартНомер+" artıq "+найдКонт+" kontragentində istifadə olunub.");
			СчСтроки = СчСтроки + 1;
			Продолжить;
		Конецесли;
		
		
		
		
		НовЭл=Справочники.Контрагенты.СоздатьЭлемент();
		НовЭл.Наименование=Наименование;
		НовЭл.КартНомер=КартНомер;
		НовЭл.Телефоны=Телефоны;
		НовЭл.ДатаРождения=ДатаРождения;
		НовЭл.Пол=Пол;
		НовЭл.МестоРаботы=МестоРаботы;
		НовЭл.СемПоложения=СемПоложения;
		НовЭл.Ввел=Ввел;
		НовЭл.ДатаВвода=ДатаВвода;
        НовЭл.Родитель= Груп;
		
		Попытка
			НовЭл.Записать();
		Исключение
			Сообщить(""+КартНомер+"  "+Наименование);
            Сообщить(ОписаниеОшибки());
		КонецПопытки;

		
		
		Состояние(""+КартНомер+"  "+Наименование);

				
		СчСтроки = СчСтроки + 1;
		
		//Если  СчСтроки>1000 Тогда
		//	Прервать;
		//КонецЕсли;
		
		
	КонецЦикла;      
	 	
КонецПроцедуры


Процедура Кнопка1Нажатие(Элемент)
	ФайлНаДиске = Новый Файл(ФайлЗагрузки);
	Если нРег(ФайлНаДиске.Расширение) = ".xls" ИЛИ нРег(ФайлНаДиске.Расширение) = ".xlsx" Тогда
		ЗагрузкаИзЕксел();
 	КонецЕсли;
	
КонецПроцедуры


Процедура КнопкаЗагрузкаНажатие(Элемент)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Прочитать табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.csv;*.xls;*.xlsx)|*.csv;*.xls;*.xlsx";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		
	КонецЕсли;
КонецПроцедуры

