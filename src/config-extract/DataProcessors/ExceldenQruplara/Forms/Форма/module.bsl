
Процедура ЗагрузкаИзЕксел()
	
	
	
	ТекНомер = 1; // индекс листа
	СчСтроки = 2; // номер строки на листе
	НомСтр = 0;
	Док = ПолучитьCOMОбъект(ФайлЗагрузки); 
	Сообщить(ТекущаяДата());
	Пока Док.Sheets(ТекНомер).Cells(СчСтроки,1).Text <> "" Цикл
		ОбработкаПрерыванияПользователя();
		//Сообщить(Строка);
		
		ТипНоменклатурыТ=СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки,3).Text);
		ТипГрупТ=СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки,4).Text);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ТипНоменклатуры КАК ТипНоменклатуры
		|ГДЕ
		|	ТипНоменклатуры.ЭтоГруппа = ЛОЖЬ
		|	И ТипНоменклатуры.Наименование = &Наименование";
		
		Запрос.УстановитьПараметр("Наименование", ТипНоменклатурыТ); 	
		РезультатЗапроса = Запрос.Выполнить();	
		Выборка = РезультатЗапроса.Выбрать(); 	
		Пока Выборка.Следующий() Цикл
			ТипНоменклатуры= Выборка.Ссылка;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТипНоменклатуры.Ссылка
			|ИЗ
			|	Справочник.ТипНоменклатуры КАК ТипНоменклатуры
			|ГДЕ
			|	ТипНоменклатуры.ЭтоГруппа = Истина
			|	И ТипНоменклатуры.Наименование = &Наименование";
			
			Запрос.УстановитьПараметр("Наименование", ТипГрупТ); 	
			РезультатЗапроса = Запрос.Выполнить();	
			Выборка2 = РезультатЗапроса.Выбрать(); 	
			Если Выборка2.Следующий() Тогда
				ТипГруп= Выборка2.Ссылка;
			Иначе
				ТипГруп=Справочники.ТипНоменклатуры.СоздатьГруппу();
				ТипГруп.Наименование= ТипГрупТ;
				ТипГруп.Записать();
				ТипГруп=ТипГруп.Ссылка;
			КонецЕсли;
			
			если ТипНоменклатуры.Родитель<>ТипГруп тогда
				ТипНоменклатуры=ТипНоменклатуры.ПолучитьОбъект();
				ТипНоменклатуры.Родитель=ТипГруп;
				ТипНоменклатуры.записать();
				Сообщить(""+ ТипНоменклатуры+ " вгруппе "+ТипГруп);
			КонецЕсли;
		КонецЦикла;	 
		Состояние(""+СчСтроки);
		
		СчСтроки = СчСтроки + 1;
		
		//Если  СчСтроки>1000 Тогда
		//	Прервать;
		//КонецЕсли;
		
		
	КонецЦикла;      
	
КонецПроцедуры


Процедура Кнопка1Нажатие(Элемент)
	ФайлНаДиске = Новый Файл(ФайлЗагрузки);
	Если нРег(ФайлНаДиске.Расширение) = ".xls" ИЛИ нРег(ФайлНаДиске.Расширение) = ".xlsx" Тогда
		ЗагрузкаИзЕксел();
	КонецЕсли;
	
КонецПроцедуры


Процедура КнопкаЗагрузкаНажатие(Элемент)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Прочитать табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.csv;*.xls;*.xlsx)|*.csv;*.xls;*.xlsx";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		
	КонецЕсли;
КонецПроцедуры


