
Процедура ЗагрузкаИзTXT()
	
	
	ДокСкид=Документы.УстановкаСкидкиПоНоменклатуре.СоздатьДокумент();
	ДокСкид.ИнстализацияДокумента();
	ДокСкид.Дата=ТекущаяДата();
	типцен=УправлениеПользователями.ЗначениеПоУмолчания("РозничныйТипЦен");
    ДокСкид.Комментарий= ""+ФайлЗагрузки;
	
	ТекНомер = 1; // индекс листа
	СчСтроки = 2; // номер строки на листе
	НомСтр = 0;
	
	ФайлГ = Новый ТекстовыйДокумент();
		Попытка
			ФайлГ.Прочитать(ФайлЗагрузки);
		Исключение
			Сообщить(ОписаниеОшибки());
			Возврат;
		КонецПопытки;

	
	
	Для Н = 1 По ФайлГ.КоличествоСтрок() Цикл
				Строка = ФайлГ.ПолучитьСтроку(Н);
				Если ПустаяСтрока(Строка) Тогда
					Продолжить;
				КонецЕсли;
				Строка	        = СтрЗаменить(Строка, Символы.Таб, Символы.ПС);
				пТоварГруппаКод	        = СтрПолучитьСтроку(Строка, 1);
				пТоварГруппа	        = СтрПолучитьСтроку(Строка, 2);

 		ОбработкаПрерыванияПользователя();
		//Сообщить(Строка);
		
		Марка=СокрЛП(СтрПолучитьСтроку(Строка, 1));
		ТипНоменклатуры=СокрЛП(СтрПолучитьСтроку(Строка, 2));
		Пол =СокрЛП(СтрПолучитьСтроку(Строка, 3));
		Цвет=СокрЛП(СтрПолучитьСтроку(Строка, 4));
        Сезон	=СокрЛП(СтрПолучитьСтроку(Строка, 5));
		Размер	=СокрЛП(СтрПолучитьСтроку(Строка,6));
		Артикул	=СокрЛП(СтрПолучитьСтроку(Строка, 7));
		Товар=СокрЛП(СтрПолучитьСтроку(Строка, 8));

			
			
		Попытка
			Цена=Число(СокрЛП(СтрПолучитьСтроку(Строка, 10)));
		Исключение
			Цена=0;
		КонецПопытки;
		
		Попытка
			СкидкаПроцент=Число(СокрЛП(СтрПолучитьСтроку(Строка, 11)));
		Исключение
			СкидкаПроцент=0;
		КонецПопытки;
		
		Попытка
			СкидкаЦена=Число(СокрЛП(СтрПолучитьСтроку(Строка, 12)));
		Исключение
			СкидкаЦена=0;
		КонецПопытки;
		
		Попытка
			ЦенасоСкидкой=Число(СокрЛП(СтрПолучитьСтроку(Строка, 13)));
		Исключение
			ЦенасоСкидкой=0;
		КонецПопытки;



		
		
		
		Марка=?(Марка="",Справочники.Марка.ПустаяСсылка(),Справочники.Марка.НайтиПоНаименованию(Марка,Истина));
		ТипНоменклатуры=?(ТипНоменклатуры="",Справочники.ТипНоменклатуры.ПустаяСсылка(),Справочники.ТипНоменклатуры.НайтиПоНаименованию(ТипНоменклатуры,Истина));
		Цвет=?(Цвет="",Справочники.Цвет.ПустаяСсылка(),Справочники.Цвет.НайтиПоНаименованию(Цвет,Истина));
		Пол=?(Пол="",Справочники.Пол.ПустаяСсылка(),Справочники.Пол.НайтиПоНаименованию(Пол,Истина));
		Сезон=?(Сезон="",Справочники.Сезон.ПустаяСсылка(),Справочники.Сезон.НайтиПоНаименованию(Сезон,Истина));
		Размер	=?(Размер="",Справочники.Размер.ПустаяСсылка(),Справочники.Размер.НайтиПоНаименованию(Размер,Истина));
		Товар=?(Товар="",Справочники.Номенклатура.ПустаяСсылка(),Справочники.Номенклатура.НайтиПоНаименованию(Товар,Истина));
		
		
		МассивСтрок = ДокСкид.товары.НайтиСтроки(Новый Структура("Марка,ТипНоменклатуры,Цвет,Пол,Сезон,Размер,Артикул,Товар", Марка,ТипНоменклатуры,Цвет,Пол,Сезон,Размер,Артикул,Товар));
		Если МассивСтрок.количество()>0 Тогда
			НовСк=МассивСтрок[0];
			
			НовСк.Цена=Цена;			 
			НовСк.СкидкаПроцент=?(НовСк.СкидкаПроцент<СкидкаПроцент,НовСк.СкидкаПроцент,СкидкаПроцент);
		    НовСк.СкидкаЦена=?(НовСк.СкидкаЦена<СкидкаЦена,НовСк.СкидкаЦена,СкидкаЦена);
			НовСк.ЦенасоСкидкой=?(НовСк.ЦенасоСкидкой>ЦенасоСкидкой,НовСк.ЦенасоСкидкой,ЦенасоСкидкой);

		Иначе
			
			
			НовСк=ДокСкид.Товары.Добавить();
			НовСк.Марка=Марка;
			НовСк.ТипНоменклатуры=ТипНоменклатуры;
			НовСк.Цвет=Цвет;
			НовСк.Пол=Пол;
			НовСк.Сезон=Сезон;
			НовСк.Размер=Размер;
			НовСк.Артикул=Артикул;
			НовСк.Товар=Товар;
			
			НовСк.Цена=Цена;
			НовСк.СкидкаПроцент=СкидкаПроцент;
		    НовСк.СкидкаЦена=СкидкаЦена;
			НовСк.ЦенасоСкидкой=ЦенасоСкидкой;
		КонецЕсли;
		
		Состояние(""+СчСтроки);
 	
	
		СчСтроки = СчСтроки + 1;
		
		//Если  СчСтроки>1000 Тогда
		//	Прервать;
		//КонецЕсли;
		
		
	КонецЦикла;      
	
	ДокСкид.ПолучитьФорму().Открыть();
	
КонецПроцедуры


Процедура Кнопка1Нажатие(Элемент)
	ФайлНаДиске = Новый Файл(ФайлЗагрузки);
	Если нРег(ФайлНаДиске.Расширение) = ".txt"  Тогда
		ЗагрузкаИзTXT();
	
	КонецЕсли;
	
КонецПроцедуры


Процедура КнопкаЗагрузкаНажатие(Элемент)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Прочитать табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "TXT (*.txt)|*.txt";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		
	КонецЕсли;
КонецПроцедуры


Процедура ЗаполнитьМарки(стр)
	стр.Марка=  стр.Товар.Марка;
	стр.ТипНоменклатуры= стр.Товар.ТипНоменклатуры;
	стр.Пол=  стр.Товар.Пол;
	стр.Цвет=стр.Товар.Цвет;
	стр.Сезон=  стр.Товар.Сезон;
	стр.Размер=  стр.Товар.Размер;
	стр.Артикул= стр.Товар.Артикул;
	
КонецПроцедуры
