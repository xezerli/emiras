
Процедура КнопкаВыполнитьНажатие(Кнопка)
	
		Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	КОЛИЧЕСТВО(Номенклатура.Ссылка) КАК КОЛИЧЕСТВО
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ПометкаУдаления = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура.Наименование,
		|	Номенклатура.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|ИТОГИ
		|	СУММА(КОЛИЧЕСТВО)
		|ПО
		|	Наименование,
		|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		Состояние(""+Выборка.Наименование+" - "+Выборка.КОЛИЧЕСТВО);
		
		Если Выборка.КОЛИЧЕСТВО<=1 Тогда
			Продолжить;
		КонецЕсли;
		
		Сообщить(""+Выборка.Наименование+" - "+Выборка.КОЛИЧЕСТВО);
		
		ВыборкаСсылка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		перв=ложь;
		ТоварОсн=Неопределено;
		Пока ВыборкаСсылка.Следующий() Цикл
			Товар=ВыборкаСсылка.ссылка;
			Если не перв тогда
				Перв= истина;
				ТоварОсн=Товар;
			иначе
				ТоварОб=Товар.ПолучитьОбъект();
				Ед=ТоварОб.ОсновнаяЕдиница.ПолучитьОбъект();
				Ед.Владелец=ТоварОсн ;
				Ед.Записать();
				
				НаборЗаписей = РегистрыСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Номенклатура.Значение = Товар;
				НаборЗаписей.Отбор.Номенклатура.Использование = Истина;
				НаборЗаписей.Прочитать();
				
				НовыйНабор = РегистрыСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
				НовыйНабор.Отбор.Номенклатура.Значение = Товаросн;
				НовыйНабор.Отбор.Номенклатура.Использование = Истина;
				ВременнаяТаблица = НаборЗаписей.Выгрузить();
				ВременнаяТаблица.ЗаполнитьЗначения(Товаросн, "Номенклатура");
				НовыйНабор.Загрузить(ВременнаяТаблица);
				НаборЗаписей.Очистить();
				НовыйНабор.Записать();
				НаборЗаписей.Записать();
				
				
				
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Партии.Ссылка
				|ИЗ
				|	Справочник.Партии КАК Партии
				|ГДЕ
				|	Партии.Владелец = &Владелец";
				
				Запрос.УстановитьПараметр("Владелец", Товар);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаПартии = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаПартии.Следующий() Цикл
					Партия=ВыборкаПартии.ССылка.ПолучитьОбъект();
					Партия.Владелец=ТоварОсн;
					пАРТИЯ.зАПИСАТЬ();
				КонецЦикла;
				
				
							
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ТоварыНаСкладах.Регистратор
				|ИЗ
				|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
				|ГДЕ
				|	ТоварыНаСкладах.Товар = &Товар
				|
				|СГРУППИРОВАТЬ ПО
				|	ТоварыНаСкладах.Регистратор
				|
				|УПОРЯДОЧИТЬ ПО
				|	ТоварыНаСкладах.Регистратор.Дата";
				
				Запрос.УстановитьПараметр("Товар", Товар);
				
				Результат = Запрос.Выполнить();
				
				ВыбДетЗап = Результат.Выбрать();
				
				Пока ВыбДетЗап.Следующий() Цикл
					Сообщить(ВыбДетЗап.Регистратор);
					док= ВыбДетЗап.Регистратор.получитьОбъект();
					
					если док.Метаданные().ТабличныеЧасти.Найти("Товары")<>неопределено тогда
						Товары=док.товары;
					ИначеЕсли док.Метаданные().ТабличныеЧасти.Найти("ТоварыП")<>неопределено тогда
						Товары=док.ТоварыП;
					Конецесли;
					
					Если  Товары<>неопределено тогда
						Для каждого стр Из Товары Цикл
							Если стр.Товар=Товар тогда
								стр.Товар=Товаросн;
								//стр.Единица=Ед.Ссылка;
								//стр.Коэффициент=стр.Единица.Коэффициент;
								
							конецесли;
						КонецЦикла;
					конецесли;
					
					
					
					если док.Метаданные().ТабличныеЧасти.Найти("ТоварыВ")<>неопределено тогда
						Товары=док.товарыВ;
 						Для каждого стр Из Товары Цикл
							Если стр.Товар=Товар тогда
								стр.Товар=Товаросн;
								//стр.Единица=Ед.Ссылка;
								//стр.Коэффициент=стр.Единица.Коэффициент;

							конецесли;
						КонецЦикла;
						
					Конецесли;
					
					если док.Метаданные().ТабличныеЧасти.Найти("ТЧ")<>неопределено тогда
						Товары=док.товарыВ;
						Для каждого стр Из Товары Цикл
							Если стр.Товар=Товар тогда
								стр.Товар=Товаросн;
								//стр.Единица=Ед.Ссылка;
								//стр.Коэффициент=стр.Единица.Коэффициент;
								
							конецесли;
						КонецЦикла;
						
					Конецесли;
					док.Записать();
					
					//если док.Проведен тогда
					//	док.Записать(РежимЗаписиДокумента.Проведение);
					//иначе
					//	док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					//КонецЕсли;
				КонецЦикла;
				
				
								
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	УстановкаСкидкиПоНоменклатуреТовары.Ссылка.Ссылка
				|ИЗ
				|	Документ.УстановкаСкидкиПоНоменклатуре.Товары КАК УстановкаСкидкиПоНоменклатуреТовары
				|ГДЕ
				|	УстановкаСкидкиПоНоменклатуреТовары.Товар = &Товар";
				
				Запрос.УстановитьПараметр("Товар", Товар);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаСкидка = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаСкидка.Следующий() Цикл
					док=  ВыборкаСкидка.Ссылка.ПолучитьОбъект();
					Сообщить(док);
					Товары=док.товары;
					Для каждого стр Из Товары Цикл
						Если стр.Товар=Товар тогда
							стр.Товар=Товаросн;
							
						конецесли;
					КонецЦикла;  
					
					док.Записать();

					
					//если док.Проведен тогда
					//	док.Записать(РежимЗаписиДокумента.Проведение);
					//иначе
					//	док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					//КонецЕсли;

				КонецЦикла;
				
						
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИнвентаризацияТовары.Ссылка.Ссылка
				|ИЗ
				|	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
				|ГДЕ
				|	ИнвентаризацияТовары.Товар = &Товар";
				
				Запрос.УстановитьПараметр("Товар", Товар);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаИнвентаризация = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаИнвентаризация.Следующий() Цикл
					док=  ВыборкаИнвентаризация.Ссылка.ПолучитьОбъект();
					Сообщить(док);
					Товары=док.товары;
					Для каждого стр Из Товары Цикл
						Если стр.Товар=Товар тогда
							стр.Товар=Товаросн;
							
						конецесли;
					КонецЦикла; 
					док.Записать();

					
					//если док.Проведен тогда
					//	док.Записать(РежимЗаписиДокумента.Проведение);
					//иначе
					//	док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					//КонецЕсли;

				КонецЦикла;

							ТоварОб.УстановитьПометкуУдаления(Истина,Истина);
				ТоварОб.Записать();
	
			КонецЕсли;	
			

		КонецЦикла;
		
		
		
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
	
	
	
	
	
КонецПроцедуры

