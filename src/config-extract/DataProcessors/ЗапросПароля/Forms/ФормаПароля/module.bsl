
Процедура Нажатие_Кнопки(Кнопка)
	ЭтаФорма.Закрыть("Выход");
КонецПроцедуры

Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	ВзаимодействиеСТоргОборудованием.РаботаСРидером(1);
	Если ПустаяСтрока(Информация) Тогда
		ЭлементыФормы.Панель2.Лево      = 0;
		ЭлементыФормы.Панель2.Высота    = 0;
		ЭлементыФормы.Панель2.Видимость = Ложь;
		ЭтаФорма.Высота                 = 64;
	КонецЕсли;
КонецПроцедуры

Процедура ОбновлениеОтображения()
	ВК_Контекст.SetCenter();
КонецПроцедуры

Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Пароль = "";
	Если ВзаимодействиеСТоргОборудованием.ПолучитьВнешнииДанные(Источник, Событие, Данные,Пароль) Тогда
		ЭтаФорма.Закрыть(СокрЛП(Пароль));
	КонецЕсли;		
КонецПроцедуры

Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	ВзаимодействиеСТоргОборудованием.РаботаСРидером(0);
КонецПроцедуры

