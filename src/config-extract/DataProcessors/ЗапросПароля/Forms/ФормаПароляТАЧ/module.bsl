//Процедура реакции на нажатие кнопки на форме
Процедура Нажатие_Кнопки(Кнопка)
	// Вставить содержимое обработчика.
	Если Кнопка.Имя = "Ок" Тогда
		Если СтрДлина(Пароль)=0 Тогда
			ОбщегоНазначения.Хебердарлыг("Пароль задан неверно", , 1);
			Возврат;
		Иначе
			ЭтаФорма.Закрыть(СокрЛП(Пароль));
		КонецЕсли;
	ИначеЕсли Кнопка.Имя = "Сброс" Тогда
		Пароль = "";
	ИначеЕсли Кнопка.Имя = "Выход" Тогда
		ЭтаФорма.Закрыть("Выход");
	Иначе
		Пароль = Пароль + Кнопка.Заголовок;
	КонецЕсли;
	ЭлементыФормы.Пароль.Заголовок = "";
	Для I=1 По СтрДлина(Пароль) Цикл
		ЭлементыФормы.Пароль.Заголовок = ЭлементыФормы.Пароль.Заголовок + "*";
	КонецЦикла;
	ЭтаФорма.ТекущийЭлемент = ЭлементыФормы.Ок;
КонецПроцедуры

Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ПустаяСтрока(Информация) Тогда
		ЭлементыФормы.Панель2.Лево         = 0;
		ЭлементыФормы.Панель2.Высота       = 0;
		ЭтаФорма.Высота                    = 324;
	КонецЕсли;
КонецПроцедуры

