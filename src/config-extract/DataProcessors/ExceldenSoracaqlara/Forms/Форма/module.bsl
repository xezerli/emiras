
Процедура ЗагрузкаИзЕксел()
	Справочник= Справочники.Пользователи;

	
	ТекНомер = 1; // индекс листа
	СчСтроки = 1; // номер строки на листе
	НомСтр = 0;
 	
	Док = ПолучитьCOMОбъект(ФайлЗагрузки); 
	Сообщить(ТекущаяДата());
	Пока Док.Sheets(ТекНомер).Cells(СчСтроки,1).Text <> "" Цикл
		ОбработкаПрерыванияПользователя();
		//Сообщить(Строка);
		
		Наименованиетов = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 1).Text);
		//КартНомер = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 4).Text);

		//Кодтов = СокрЛП(Док.Sheets(ТекНомер).Cells(СчСтроки, 2).Text);
		//Кодтов=прав("000000000"+СтрЗаменить(Кодтов,",",""),9);		
		Спрконт=Неопределено;
		Если Наименованиетов<>"" Тогда			
			Спрконт=Справочник.НайтиПоНаименованию(Наименованиетов,Истина);
		Иначе 
			СчСтроки = СчСтроки + 1;
			Продолжить;
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(Спрконт) Тогда 
			СчСтроки = СчСтроки + 1;
			Продолжить; 
		конецесли;
		
		 Спр=Справочник.СоздатьЭлемент();
		 
		 Спр.Наименование=Наименованиетов;
		 //Спр.код=Кодтов;
		 //спр.Родитель=Груп;
		 //спр.КартНомер=КартНомер;
		 Спр.Записать();
			
	 		
		Сообщить(""+СчСтроки+" "+Наименованиетов);
		
		СчСтроки = СчСтроки + 1;
		
		
		
	КонецЦикла;      
 	
КонецПроцедуры

Процедура ЗагрузкаИзCsv()
	
	ТекНомер = 1; // индекс листа
	СчСтроки = 3; // номер строки на листе
	НомСтр = 0;
	Файл = Новый ТекстовыйДокумент();
	Попытка
		Файл.Прочитать(ФайлЗагрузки);
	Исключение
		Сообщить("Ощибка при чтение файла");		
	КонецПопытки;
	Для Н = 1 По Файл.КоличествоСтрок() Цикл
		Строка = Файл.ПолучитьСтроку(Н);
		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Строка	        = СтрЗаменить(Строка, ";", Символы.ПС);
		
		Наименованиетов	    = СтрПолучитьСтроку(Строка, 3);
		КартНомер =СтрПолучитьСтроку(Строка, 4);		
		Кодтов  = СтрПолучитьСтроку(Строка, 2);   
		Кодтов=прав("000000000"+СтрЗаменить(Кодтов,",",""),9);		
		Спрконт=Неопределено;
		Если Кодтов<>"" Тогда
			
			Спрконт=Справочники.Контрагенты.НайтиПоКоду(Кодтов);
		Иначе 
			Продолжить;
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(Спрконт) Тогда
			
			Продолжить; 			
			
		конецесли    ;
		
		 Спр=Справочники.Контрагенты.СоздатьЭлемент();
		 
		 Спр.Наименование=Наименованиетов;
		 Спр.код=Кодтов;
		 спр.Родитель=Груп;
		 спр.КартНомер=КартНомер;
		 Спр.Записать();
			
	 		
		Сообщить(""+СчСтроки+" "+Спрконт);
		
		СчСтроки = СчСтроки + 1;
		
		
		
	КонецЦикла; 	
		
		
		
		
	КонецПроцедуры

Процедура Кнопка1Нажатие(Элемент)
	ФайлНаДиске = Новый Файл(ФайлЗагрузки);
	Если нРег(ФайлНаДиске.Расширение) = ".xls" ИЛИ нРег(ФайлНаДиске.Расширение) = ".xlsx" Тогда
		ЗагрузкаИзЕксел();
	ИначеЕсли нРег(ФайлНаДиске.Расширение) = ".csv" Тогда
		 ЗагрузкаИзCsv();
	КонецЕсли;
	
КонецПроцедуры

 
Процедура КнопкаЗагрузкаНажатие(Элемент)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Прочитать табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.csv;*.xls;*.xlsx)|*.csv;*.xls;*.xlsx";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
		 		
	КонецЕсли;
КонецПроцедуры

Процедура КоманднаяПанель2беден(Кнопка)
	 спр=Справочники.Размер.Выбрать();
	 Пока спр.Следующий() цикл
		 об=спр.ПолучитьОбъект();
		 об.Наименование=СтрЗаменить(об.Наименование,"BEDEN", "");
		 об.Записать();
	 КонецЦикла;
	 
	
	
КонецПроцедуры
