перем Excel;
перем КнигаЭкселя;
перем ЛистЭкселя;
Процедура КнопкаВыполнитьНажатие(Кнопка)
	
	ФормаЗагрузки = "";
	
	Для нс = НомерПервойСтроки по КоличествоСтрок Цикл
		текНаименование = ЛистЭкселя.Cells(нс, НомерКолонкиНаименования).Text;
		текАртикул = ЛистЭкселя.Cells(нс, НомерКолонкиАртикула).Text;
		текБаркод = ЛистЭкселя.Cells(нс, НомерКолонкиБаркода).Text;
		текПол = ЛистЭкселя.Cells(нс, НомерКолонкиПола).Text;
		текРазмер = ЛистЭкселя.Cells(нс, НомерКолонкиРазмера).Text;
		текСезон = ЛистЭкселя.Cells(нс, НомерКолонкиСезона).Text;
		текНаимПапки =  ЛистЭкселя.Cells(нс, НомерКолонкиПапки).Text;
		текМарка =  ЛистЭкселя.Cells(нс, НомерКолонкиМарки).Text;

		
		НайденнаяНоменклатураПоБаркоду = Справочники.Номенклатура.НайтиПоРеквизиту("Штрихкод", СокрЛП(текБаркод));
		Если НайденнаяНоменклатураПоБаркоду.Пустая() Тогда
			НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
			ФормаЗагрузки = " sistemə yazıldı";
		Иначе
			НоменклатураОбъект = НайденнаяНоменклатураПоБаркоду .ПолучитьОбъект();
			ФормаЗагрузки = " sistemdə yeniləndi";
		КонецЕсли;
		
		НайденнаяПапка = Справочники.Номенклатура.НайтиПоНаименованию(СокрЛП(текНаимПапки));
		Если НайденнаяПапка.Пустая() Тогда
			Сообщить("Sətir № " + Строка(нс)+ ": " + текНаимПапки +" adla sistemdə malın qovluğu yoxdur", СтатусСообщения.ОченьВажное);
			Продолжить;	
		КонецЕсли;
		
		НайденныйТип = Справочники.ТипНоменклатуры.НайтиПоНаименованию(СокрЛП(текНаимПапки));
		Если НайденныйТип.Пустая() Тогда
			Сообщить("Sətir № " + Строка(нс)+ ": " + текНаимПапки +" adla sistemdə malın tipi yoxdur", СтатусСообщения.ОченьВажное);
			Продолжить;
		КонецЕсли;
		
		НайденныйПол = Справочники.Пол.НайтиПоНаименованию(СокрЛП(текПол));
		Если НайденныйПол.Пустая() Тогда
			Сообщить("Sətir № " + Строка(нс)+ ": Sistemdə belə cins yoxdur: " + текПол, СтатусСообщения.ОченьВажное);
			Продолжить;	
		КонецЕсли;
		
		НайденныйРазмер = Справочники.Размер.НайтиПоНаименованию(СокрЛП(текРазмер));
		Если НайденныйРазмер.Пустая() Тогда
			Сообщить("Sətir № " + Строка(нс)+ ": Sistemdə belə ölçü yoxdur: " + текРазмер, СтатусСообщения.ОченьВажное);
			Продолжить;	
		КонецЕсли;
		
		
		НайденныйСезон = Справочники.Сезон.НайтиПоНаименованию(СокрЛП(текСезон));
		Если НайденныйСезон.Пустая() Тогда
			Сообщить("Sətir № " + Строка(нс)+ ": Sistemdə belə mövsüm yoxdur: " + текСезон, СтатусСообщения.ОченьВажное);
			Продолжить;	
		КонецЕсли;
		
		НайденнаяМарка = Справочники.Марка.НайтиПоНаименованию(СокрЛП(текМарка));
		Если НайденнаяМарка.Пустая() Тогда
			Сообщить("Sətir № " + Строка(нс)+ ": Sistemdə belə marka yoxdur: " + текМарка, СтатусСообщения.ОченьВажное);
			Продолжить;	
		КонецЕсли;

		
		НоменклатураОбъект.Наименование = текНаименование;
		НоменклатураОбъект.Родитель = НайденнаяПапка;
		НоменклатураОбъект.Пол = НайденныйПол;
		НоменклатураОбъект.Артикул = текАртикул;
		НоменклатураОбъект.Штрихкод = текБаркод;
		НоменклатураОбъект.ТипНоменклатуры = НайденныйТип;
		НоменклатураОбъект.Сезон = НайденныйСезон;
		НоменклатураОбъект.Размер = НайденныйРазмер;
		НоменклатураОбъект.Марка = НайденнаяМарка;
		Попытка
			НоменклатураОбъект.Записать();
			Сообщить(текНаименование + " adlı mal və " + текБаркод + " barkodla uğurla" + ФормаЗагрузки);
		Исключение
			Сообщить(текНаименование + " adla malı sistemə aşağıdaki səbəbi ilə yazılmadı:", СтатусСообщения.ОченьВажное);
			Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		КонецПопытки;
		
	
		
	КонецЦикла;
	
		
	КнигаЭкселя.Close();
	Excel = 0;
	
КонецПроцедуры

Процедура ПриОткрытии()
	
	НомерПервойСтроки = 2;
	НомерКолонкиНаименования = 1;
	НомерКолонкиАртикула = 2;
	НомерКолонкиБаркода = 3;
	НомерКолонкиПола = 4;
	НомерКолонкиРазмера = 5;
	НомерКолонкиСезона = 6;
	НомерКолонкиПапки = 7;
	НомерКолонкиМарки = 8;
	
КонецПроцедуры

Процедура ПутьКфайлуНачалоВыбора(Элемент, СтандартнаяОбработка)
	Mode = FileDialogMode.Open;
	OpeningFileDialogue = New FileDialog(Mode);
	OpeningFileDialogue.FullFileName = "";
	Filter = "Excel faylları"
	+ "(*.xls,*.xlsx)|*.xls;*.xlsx";
	OpeningFileDialogue.Filter = Filter;
	OpeningFileDialogue.Multiselect = True;
	OpeningFileDialogue.Title = "Excel faylları seçin, zəhmət olmasa";
	If OpeningFileDialogue.Choose() Then
		FilesArray = OpeningFileDialogue.SelectedFiles;
		For Each FileName In FilesArray Do
			Selection = New File(FileName);
			ПутьКфайлу = FileName;
			Message(FileName
			+ "Excel faylının ölçüsü "
			+Selection.Size());
			Excel = Новый COMОбъект("Excel.Application");
			КнигаЭкселя = Excel.WorkBooks.Open(ПутьКфайлу);
			ЭлементыФормы.СтраницаЭкселя.СписокВыбора.Очистить();
			Для Каждого лист из Excel.Sheets Цикл
				ЭлементыФормы.СтраницаЭкселя.СписокВыбора.Добавить(лист.Name);
			КонецЦикла;
			
			//Версия = Лев(Excel.Version,Найти(Excel.Version,".")-1);
			//Если Версия = "8" тогда
			//	КоличествоСтрок = Excel.Cells.CurrentRegion.Rows.Count;
			//Иначе
			//	КоличествоСтрок = Excel.Cells(1,1).SpecialCells(11).Row;				
			//Конецесли;
		EndDo;
	Else
		DoMessageBox("Fayl(lar) seçilməyib!");
	EndIf;
КонецПроцедуры

Процедура СтраницаЭкселяПриИзменении(Элемент)
	
	Excel.Sheets(СтраницаЭкселя).Select();
	//КнигаЭкселя = Excel.WorkBooks.Open(ПутьКфайлу);
	ЛистЭкселя =  КнигаЭкселя.ActiveSheet;
	КоличествоСтрок = КнигаЭкселя.ActiveSheet.UsedRange.Rows.Count;

КонецПроцедуры
