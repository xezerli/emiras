Функция Долг(ВыбКонтрагент)
	если не ЗначениеЗаполнено(ВыбКонтрагент) тогда
		Возврат "";
	Конецесли;
	Долги=РегистрыНакопления.Взаиморасчеты.Остатки(,Новый Структура("ВидДолги,Контрагент",2,ВыбКонтрагент),"Контрагент","Долг");
	долг=0;
	если Долги.Количество()>0 тогда
		долг= Долги.Итог("Долг");
	Конецесли;
	если долг>0 Тогда
		возврат "Borc: "+формат(долг,"ЧДЦ=2");
	Иначеесли долг<0 Тогда
		возврат "Bizim borc: "+формат(-долг,"ЧДЦ=2");
	Иначе
		возврат "";
	Конецесли;
		возврат "";
		
КонецФункции

Процедура кнВыборКонтрагентНажатие(Элемент)
	зн=справочники.Контрагенты.ПолучитьФормуВыбора("ФормаВыборадляРМК").ОткрытьМодально();
	Если зн<>неопределено Тогда
	    контрагент=зн;
		элементыформы.НадписьКонтрагент.Заголовок="Alıcı: "+Контрагент+Символы.ПС+Долг(контрагент);
		Для каждого стр Из Товары Цикл
			стр.ПроцентСкидки=ПроцентСкидки;		
			РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,"ПроцентСкидки");
		КонецЦикла;

	КонецЕсли;
	Дата=ТекущаяДата();
	
КонецПроцедуры

