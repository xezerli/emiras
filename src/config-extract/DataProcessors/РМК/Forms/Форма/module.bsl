Процедура ВнешнееСобытие(Источник, Событие, Данные)
	перем единица,Количество,КлючиСтроки;
	глперем.СканерИзФормы=истина;
	
	Если не ВводДоступен() Тогда
		возврат;
	КонецЕсли; 
	Данные=ТорговоеОборудование.ПолучитьДанныеСканера(Событие);
	
	
	Если Источник="BarCodeScaner" и Событие ="BarCodeValue" Тогда
		Штрихкод =Данные;
		
		
		//Если лев(Штрихкод,2)= "19" Тогда
			Спр = Справочники.Пользователи;
			Найд = Спр.НайтиПоРеквизиту("БарКод",СокрЛП(Штрихкод));
			Если Найд<>Спр.ПустаяСсылка() Тогда
				ЭтаФорма.ТолькоПросмотр = Ложь;
				Автор = Найд.Ссылка;
				АвторПриИзменении(ЭтаФорма);
				ЭлементыФормы.ТабличноеПолеТовары.ТолькоПросмотр = Ложь;
				глперем.Сканер.DeleteEvent();
				глперем.Сканер.DataEventEnabled = 1;
				
				Возврат;
			КонецЕсли;
		//КонецЕсли;
		
		товар=неопределено;
		товар=УправлениеНоменклатурой.НайтиПоШтрихкоду(Штрихкод,единица,Количество,2);
		
		Если значениеЗаполнено(товар) Тогда
			работаСТЧДокумента.ОбработкаПодбора(Этотобъект,Этаформа, Товары, Товар, Товар.ОсновнаяЕдиница, Количество,КлючиСтроки);
			////РаботаСТЧДокумента.РессчетАвтоСкидкиПоСхемы(этотобъект,товары,этаформа,СледСумма,СледПроцент);
			элементыформы.Товары.ТекущаяСтрока =КлючиСтроки;
			элементыформы.Товары.ТекущаяКолонка =элементыформы.Товары.Колонки.Количество;
		КонецЕсли; 
	Иначеесли Событие ="MagneticStripeCardValue"  Тогда
		Штрихкод =Данные; 	
		
		//Если лев(Штрихкод,2)= "19" Тогда
		Спр = Справочники.Пользователи;
		Найд = Спр.НайтиПоРеквизиту("БарКод",СокрЛП(Штрихкод));
		Если Найд<>Спр.ПустаяСсылка() Тогда
			ЭтаФорма.ТолькоПросмотр = Ложь;
			Автор = Найд.Ссылка;
			АвторПриИзменении(ЭтаФорма);
			ЭлементыФормы.ТабличноеПолеТовары.ТолькоПросмотр = Ложь;
			глперем.Сканер.DeleteEvent();
			глперем.Сканер.DataEventEnabled = 1;
			
			Возврат;
		КонецЕсли;
		//КонецЕсли;  	
		
	КонецЕсли; 
	глперем.Сканер.DeleteEvent();
	глперем.Сканер.DataEventEnabled = 1;

КонецПроцедуры

