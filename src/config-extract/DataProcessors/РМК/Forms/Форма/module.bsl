Процедура кнИзменитьСтрокаТоварыНажатие(Элемент)
	колонка= Элементыформы.Товары.ТекущаяКолонка;
	
	Если не ПолныеПрава.ПроверитьДоступ(Автор,колонка.Имя) Тогда
		Возврат;
	КонецЕсли;

	
	стр=элементыформы.Товары.ТекущиеДанные;
	Если стр=неопределено Тогда
	    возврат;
	КонецЕсли; 
	Если колонка.ЭлементУправления.ТипЗначения.Типы()[0]=тип("Число") Тогда
	   точность=колонка.ЭлементУправления.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти;
		зн=РаботаСДиалогами.ВводКоличество(стр[колонка.Имя],,точность,колонка.ТекстШапки+"...");
		Если не значениезаполнено(зн) Тогда
			возврат;
		КонецЕсли; 
		стр[колонка.Имя]=зн;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,колонка.Имя);
		КонецЕсли; 
