Процедура кнСвернутьНажатие(Элемент)
	ВыбраннаяСтрока= ЭлементыФормы.ТабличноеПолеГруп.ТекущаяСтрока ;
	УзелРазвернут = ЭлементыФормы.ТабличноеПолеГруп.Развернут(ВыбраннаяСтрока);
	Если УзелРазвернут Тогда
		ЭлементыФормы.ТабличноеПолеГруп.Свернуть(ВыбраннаяСтрока);
	Иначе
		ЭлементыФормы.ТабличноеПолеГруп.Развернуть(ВыбраннаяСтрока);
	КонецЕсли;
	ОбновлениеИзображениекнСвернуть();

КонецПроцедуры

