Процедура  ПечатьПродаж_Возврат(Выход=1) 
	
	ТабДок = элементыформы.ТабличныйДокумент;
	ТабДок.Очистить();
	Макет = ПолучитьМакет("Печать");
	// Заголовок
	// Шапка
	ТабДок.ИмяПараметровПечати="Чек_РМК";
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Заполнить(док);
	Шапка.Параметры.Фирма=константы.Фирма.Получить();
	Шапка.Параметры.Заголовок=ОбщегоНазначения.ПредставлениеДокумента(док)+" №"+док.Номер;
	Шапка.Параметры.Автор = док.Автор;
	ИмяДок=врег(Док.ссылка.получитьОбъект().Метаданные().имя);

	Шапка.Параметры.Дата=док.дата;//формат(док.дата,"ДФ=dd.MM.yyyy");
	Попытка
	      Шапка.Параметры.Контрагент=док.Контрагент;
	Исключение
	КонецПопытки; 
	
	ТабДок.Вывести(Шапка);
	// Товары
	Область = Макет.ПолучитьОбласть("ТоварыШапка");
	ТабДок.Вывести(Область);
	ОбластьТовары = Макет.ПолучитьОбласть("Товары");
	номерстроки=0;
	Для Каждого ТекСтрокаТовары Из док.Товары Цикл
		номерстроки=номерстроки+1;
		ОбластьТовары.Параметры.Заполнить(ТекСтрокаТовары);
		ОбластьТовары.Параметры.НомерСтроки=номерстроки;
		если ИмяДок="РЕАЛИЗАЦИЯТОВАРОВ" тогда
			ОбластьТовары.Параметры.ПроцентСкидки=ТекСтрокаТовары.ПроцентСкидки;
			ОбластьТовары.Параметры.Скидка=ТекСтрокаТовары.Скидка;
		Конецесли;
		//////ОбластьТовары.Параметры.Артикул =ТекСтрокаТовары.Единица.Артикул;
		//////ОбластьТовары.Параметры.Цвет =ТекСтрокаТовары.Единица.Цвет;
		//////ОбластьТовары.Параметры.Размер =ТекСтрокаТовары.Единица.Размер;
		//////
		//////ОбластьТовары.Параметры.Коллекция =ТекСтрокаТовары.Единица.Коллекция;
		ОбластьТовары.Параметры.Штрихкод =ТекСтрокаТовары.Единица.Штрихкод;

		ТабДок.Вывести(ОбластьТовары);
	КонецЦикла;
	// Подвал
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Заполнить(док);
	Подвал.Параметры.СуммаПропийю="Cəmi: "+Форматирование.СуммаПрописю(док.товары.Итог("Сумма"),док.Валюта.Наименование,док.валюта.НаименованиеМонета);
	Подвал.Параметры.итог=док.Товары.Итог("Сумма");
	Подвал.Параметры.ИтогСкидки=док.Товары.Итог("Скидка");
    Подвал.Параметры.СуммаСкидки="Endirim: "+док.товары.Итог("Скидка")+" "+док.Валюта.Наименование;

	СуммаОплата=0;
	если ИмяДок="ЧЕК" тогда
		СуммаОплата=док.товары.Итог("Сумма")-док.СуммаОплатаБС;
	Иначе
		СуммаОплата=док.СуммаОплата;
		СуммаБонуса=док.СуммаБонуса;
		СуммаДокументаМанат=Док.СуммаДокумента;
		СуммаОборота=ОбщегоНазначения.СуммаОборота(Док.Контрагент,Док.дата);	
		РасчБонус=0;
		Если СуммаОборота+СуммаДокументаМанат>=200 Тогда
			РасчБонус=СуммаДокументаМанат*Константы.БонусПроцент.Получить()/100;
		КонецЕсли;
				
		ОстБонус=ОбщегоНазначения.СуммаБонуса(Док.Контрагент,Док.Дата+2);
		Подвал.Параметры.СуммаБонуса="Çekdəki bonus: "+формат(РасчБонус,"ЧЦ=10; ЧДЦ=2; ЧРД=.")
		+"; Qalıq bonus: "+формат(ОстБонус,"ЧЦ=10; ЧДЦ=2; ЧРД=.");
		
	Конецесли;
	суммаоплатаБС=док.суммаоплатаБС;
	Подвал.Параметры.СуммаОплата=?(СуммаОплата+СуммаБонуса=0,"Nəğd:--","Nəğd: "+сокрлп(формат(СуммаОплата,"ЧЦ=15; ЧДЦ=2; ЧРД=.")+" ("+Форматирование.СуммаПрописю(СуммаОплата,Валюта.Наименование,валюта.НаименованиеМонета))+")"
	+?(СуммаБонуса=0,"",", Bonusdan: "+формат(СуммаБонуса,"ЧЦ=10; ЧДЦ=2; ЧРД=.")+" ("+Форматирование.СуммаПрописю(СуммаБонуса,Валюта.Наименование,валюта.НаименованиеМонета))+")" );
	Подвал.Параметры.СуммаОплатаБС=?(суммаоплатаБС=0,"Kredit kartla ödəniş:--","Kredit kartla ödəniş: "+сокрлп(формат(СуммаОплатаБС,"ЧЦ=15; ЧДЦ=2; ЧРД=.")+" ("+Форматирование.СуммаПрописю(СуммаОплатаБС,Валюта.Наименование,валюта.НаименованиеМонета))+")");
	
	ТабДок.Вывести(Подвал);
	
	ТабДок.ПолеСверху=0;
	ТабДок.ПолеСлева=0;
	ТабДок.ПолеСправа=0;
	ТабДок.ПолеСнизу=0;
	//	ТабДок.ВерхнийКолонтитул=0;
//	ТабДок.НижнийКолонтитул=0;
	ТабДок.АвтоМасштаб=Истина;
	
	//}}_КОНСТРУКТОР_ПЕЧАТИ_ЭЛЕМЕНТ
КонецПроцедуры
Процедура  ПечатьПКО_РКО(ИмяМакета) 
	
	ТабДок = элементыформы.ТабличныйДокумент;
	ТабДок.Очистить();

	Макет = ПолучитьМакет(ИмяМакета);
	ТабДок.ИмяПараметровПечати="Документ_"+ИмяМакета+"_РМК";
	// Заголовок
	// Шапка
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Заполнить(Док);
	Шапка.Параметры.Фирма=константы.Фирма.Получить();
	Шапка.Параметры.Дата=формат(дата,"ДФ=dd.MM.yyyy");
	Шапка.Параметры.СуммаПрописью=Форматирование.СуммаПрописю(Док.Сумма,Док.Валюта.Наименование,Док.валюта.НаименованиеМонета);

	ТабДок.Вывести(Шапка);

	
	ТабДок.ПолеСверху=0;
	ТабДок.ПолеСлева=0;
	ТабДок.ПолеСправа=0;
	ТабДок.ПолеСнизу=0;
//	ТабДок.ВерхнийКолонтитул=0;
//	ТабДок.НижнийКолонтитул=0;
	ТабДок.АвтоМасштаб=Истина;
	
	//}}_КОНСТРУКТОР_ПЕЧАТИ_ЭЛЕМЕНТ
КонецПроцедуры
Процедура  Печать(Выход=1) экспорт
	
	ИмяДок=врег(Док.ссылка.получитьОбъект().Метаданные().имя);
	если ИмяДок="ПКО" или ИмяДок="РКО" тогда
		 ПечатьПКО_РКО(ИмяДок);
	 Иначе
		 ПечатьПродаж_Возврат();
	 Конецесли;
	 
КонецПроцедуры



Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	Если ПечатьЧек<=0 Тогда
		////ОбщегоНазначения.Хебердарлыг("Bu əməliyyat üçün sizin hüququnuz yoxdur!",,"Xəbərdarlıq!");
	    Отказ=Истина;
	КонецЕсли; 
	Печать();
	Если ПечатьЧек=2 Тогда
		кнСразуПечатьНажатие(элементыформы.кнСразуПечать);
        Отказ=Истина;
	КонецЕсли; 
КонецПроцедуры

Процедура кнСразуПечатьНажатие(Элемент)
	элементыформы.ТабличныйДокумент.Напечатать(Истина);
	если этаформа.Открыта() тогда
		Закрыть();
	конецесли;
КонецПроцедуры

Процедура кнПечатьНажатие(Элемент)
	элементыформы.ТабличныйДокумент.Напечатать(Ложь);

КонецПроцедуры

