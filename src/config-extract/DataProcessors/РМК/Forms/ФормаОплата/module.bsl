Процедура Кнопка2Нажатие(Элемент)
	ПолеВводаСдача=0;
		Если Контрагент.Пустая() тогда
			ПолеВводаСуммаОплатаБС=ПолеВводаСуммаДокумента-ПолеВводаСуммаОплата-ПолеВводаСуммаБонуса+ПолеВводаСдача;
		Конецесли;
КонецПроцедуры

Процедура Кнопка1Нажатие(Элемент)
	ПолеВводаСуммаОплата=РаботаСДиалогами.ВводКоличество(ПолеВводаСуммаОплата,,2,"Ödəniş...");
	ПолеВводаСдача=ПолеВводаСуммаОплата-ПолеВводаСуммаДокумента+ПолеВводаСуммаБонуса;
КонецПроцедуры

Процедура Кнопка3Нажатие(Элемент)
	НачСумма=макс(ПолеВводаСуммаДокумента- ПолеВводаСуммаОплата,0);
	НачСумма=?(ПолеВводаСуммаОплатаБС=0,НачСумма,ПолеВводаСуммаОплатаБС);
	ПолеВводаСуммаОплатаБС=РаботаСДиалогами.ВводКоличество(ПолеВводаСуммаОплатаБС,,2,"Bank ödənişi...");
	ПолеВводаСуммаОплатаБСПриИзменении(Элемент);
КонецПроцедуры

Процедура кнОКНажатие(Элемент)
	Если не ЗначениеЗаполнено(Касса1) тогда
		Предупреждение(НСтр("az = 'Kassa seçilməyib'; ru = 'Не выбрана касса'"));
	иначеЕсли ПолеВводаСуммаБонуса> СуммаБонуса тогда
		Если ТекущийЯзык().КодЯзыка = "az" Тогда
			Предупреждение("Bonus məbləği "+Суммабонуса+" dən çox ola bilməz");
		Иначе
			Предупреждение("Сумма бонуса не может быть больше " + СуммаБонуса);
		КонецЕсли;

		Закрыть(ПолеВводаСуммаОплата-ПолеВводаСдача-ПолеВводаСуммаБонуса);
	КонецЕсли;
КонецПроцедуры


Процедура ПолеВводаСуммаОплатаПриИзменении(Элемент)
		ПолеВводаСдача=ПолеВводаСуммаОплата-ПолеВводаСуммаДокумента+ПолеВводаСуммаБонуса;
		Если Контрагент.Пустая() тогда
			ПолеВводаСуммаОплатаБС=ПолеВводаСуммаДокумента-ПолеВводаСуммаОплата+ПолеВводаСдача;
		Конецесли;
КонецПроцедуры


Процедура ПриОткрытии()
	если Автор.ОсновнаяБС.Пустая() тогда
		элементыформы.ПолеВводаСуммаОплатаБС.Доступность=Ложь;
		элементыформы.Кнопка3.Доступность=Ложь;
	Конецесли;
	
КонецПроцедуры


Процедура ПолеВводаСуммаОплатаБСПриИзменении(Элемент)
	Если Контрагент.Пустая() тогда
		ПолеВводаСуммаОплатаБС=мин(ПолеВводаСуммаОплатаБС,ПолеВводаСуммаДокумента);
		ПолеВводаСуммаОплата=ПолеВводаСуммаДокумента-ПолеВводаСуммаОплатаБС;
		ПолеВводаСуммаОплатаПриИзменении(Элемент);
	Конецесли;
КонецПроцедуры


Процедура Кнопка4Нажатие(Элемент)
	
	ПолеВводаСуммаБонуса=РаботаСДиалогами.ВводКоличество(СуммаБонуса,,2,"Bonus məbləği...");
	Если  ПолеВводаСуммаБонуса>ПолеВводаСуммаДокумента Тогда
		 ПолеВводаСуммаБонуса=ПолеВводаСуммаДокумента;
	 КонецЕсли;

	ПолеВводаСдача=0;
	ПолеВводаСуммаОплата=ПолеВводаСуммаДокумента-ПолеВводаСуммаБонуса;

КонецПроцедуры

