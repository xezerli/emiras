Перем мТЗ;
перем мЖирныйШрифт;
Процедура ЗаполнитьТП()
     Запрос=Новый Запрос;
	 запрос_Текст="ВЫБРАТЬ
	              |	ЕдиницыИзмерения.Ссылка,
	              |	ВЫРАЗИТЬ(ОстаткиТоваров.КоличествоОстаток КАК ЧИСЛО) КАК КоличествоОстаток
	              |ИЗ
	              |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	              |				&Дата,Склад = &Склад) КАК ОстаткиТоваров
	              |		ПО ОстаткиТоваров.Единица = ЕдиницыИзмерения.Ссылка
	              |ГДЕ
	              |	";
				  
	нн=1;			   
	Если значениеЗаполнено(ТоварДляПоиск) Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Владелец= &Владелец";
		Запрос.УстановитьПараметр("Владелец", ТоварДляПоиск);
		нн=нн+1;
	КонецЕсли; 	
	Если Сокрлп(НаименованиеДляПоиск)<>"" Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Владелец.Наименование= &Наименование";
		Запрос.УстановитьПараметр("Наименование", Сокрлп(НаименованиеДляПоиск));
		нн=нн+1;
	КонецЕсли; 	
	Если Сокрлп(АртикулДляПоиск)<>"" Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Артикул= &Артикул";
		Запрос.УстановитьПараметр("Артикул", Сокрлп(АртикулДляПоиск));
		нн=нн+1;
	КонецЕсли; 	
	Если Сокрлп(ШтрихкодДляПоиск)<>"" Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Штрихкод= &Штрихкод";
		Запрос.УстановитьПараметр("Штрихкод", Сокрлп(ШтрихкодДляПоиск));
		нн=нн+1;
	КонецЕсли; 	
	Если значениеЗаполнено(ЦветДляПоиск) Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Цвет= &Цвет";
		Запрос.УстановитьПараметр("Цвет", ЦветДляПоиск);
		нн=нн+1;
	КонецЕсли; 	
	Если значениеЗаполнено(РазмерДляПоиск) Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Размер= &Размер";
		Запрос.УстановитьПараметр("Размер", РазмерДляПоиск);
		нн=нн+1;
	КонецЕсли; 	
	Если значениеЗаполнено(КоллекцияДляПоиск) Тогда
	    Запрос_Текст=Запрос_Текст+Символы.ПС+ ?(нн=1,""," И ")+"ЕдиницыИзмерения.Коллекция= &Коллекция";
		Запрос.УстановитьПараметр("Коллекция", КоллекцияДляПоиск);
		нн=нн+1;
	КонецЕсли; 	
	
	Если не ЗначениеЗаполнено(Дата) Тогда
	     Дата=ТекущаяДата();
	КонецЕсли; 			  
	Если не ЗначениеЗаполнено(Склад) Тогда
	     Склад=глперем.ТекущийПользователь.ОсновнойСклад;
	КонецЕсли; 			  
	Если не ЗначениеЗаполнено(Валюта) Тогда
	     Дата=глперем.манат;
		 Курс=1;
	 ИначеЕсли не ЗначениеЗаполнено(Курс) тогда
		 Курс=МодульВалютногоУчета.ПолучитьКурсВалюты(Валюта,Дата).курс;
	 КонецЕсли; 
	 
	 Запрос.Параметры.Вставить("Дата",Дата);
	 Запрос.Параметры.Вставить("Склад",Склад);
	 
	 запрос.Текст= Запрос_Текст;
				  
	выборка=Запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() Цикл
	    стр=ТабличноеПоле.Добавить();
		стр.Товар=выборка.Ссылка.Владелец;		
		стр.Ссылка=выборка.Ссылка;		
		стр.Штрихкод=стр.Ссылка.Штрихкод;		
		стр.Артикул=стр.Ссылка.Артикул;		
		стр.Цвет=стр.Ссылка.Цвет;		
		стр.Размер=стр.Ссылка.Размер;		
		стр.Коллекция=стр.Ссылка.Коллекция;		
		стр.Остаток=выборка.КоличествоОстаток;	
		Если ЗначениеЗаполнено(ТипЦен) Тогда
		    СтуктураЦена=УправлениеНоменклатурой.ПолучитьСтруктураЦена(выборка.ссылка.Владелец,ТипЦен,стр.ссылка,Дата);
			Если СтуктураЦена<>Неопределено Тогда
			    ЦенаЦены=СтуктураЦена.Цена;
				ЕдЦены= СтуктураЦена.Единица;
				ВалютаЦены=СтуктураЦена.Валюта;
				ЦенаЦены= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ЦенаЦены/ЕдЦены.Коэффициент,ВалютаЦены,Валюта,Дата,Курс);
				стр.цена=ЦенаЦены;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
				  
	мТЗ=новый ТаблицаЗначений;
	мТЗ.Колонки.Добавить("Единица",новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	мТЗ.Колонки.Добавить("Количество",новый ОписаниеТипов(Новый КвалификаторыЧисла(10, 0)));
	мТЗ.Колонки.Добавить("Цена");

КонецПроцедуры
 
                                                                                                                                                                                                                          

Процедура ПриОткрытии()
	Если не ТоварДляПоиск.Пустая() тогда
		этаформа.Заголовок=""+ТоварДляПоиск.наименование+" malının çeşidləri" ;
	Иначе
		этаформа.Заголовок="Çeşidlərin seçimi" ;
	Конецесли;
	элементыформы.ТабличноеПоле.ТекущаяКолонка=элементыформы.ТабличноеПоле.Колонки.Количество;
	ЗаполнитьТП();
КонецПроцедуры


Процедура ПередОткрытием(Отказ, СтандартнаяОбработка)
	Если не ЗначениеЗаполнено(ТоварДляПоиск) и не ЗначениеЗаполнено(ЦветДляПоиск) и не ЗначениеЗаполнено(РазмерДляПоиск) и не ЗначениеЗаполнено(КоллекцияДляПоиск)и Сокрлп(АртикулДляПоиск)="" и Сокрлп(ШтрихкодДляПоиск)="" и Сокрлп(НаименованиеДляПоиск)="" Тогда
	    ОбщегоНазначения.Хебердарлыг("Fərqləndirmək üçün heç bir xüsusiyyət seşilməyib!",,"Xəbərdarlıq");
		Отказ=истина;
	КонецЕсли; 
КонецПроцедуры


Процедура ТабличноеПолеВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	кол=?(ВыбраннаяСтрока.Количество=0,1,ВыбраннаяСтрока.Количество);
	 
	
	кол=РаботаСДиалогами.ВводКоличество(кол,,3,"Miqdar daxil edin!");
	Если не значениезаполнено(кол) Тогда
		возврат;
	КонецЕсли; 
	ВыбраннаяСтрока.Количество=кол;
	стр=мТЗ.Найти(ВыбраннаяСтрока.Ссылка,"Единица");
	Если стр<>неопределено Тогда
		Если кол=0 Тогда
			мТЗ.Удалить(стр);
		Иначе
			стр.количество=кол;
		КонецЕсли; 
	Иначе
		Если кол<>0 Тогда
			стр=мТЗ.Добавить();
			стр.Единица= ВыбраннаяСтрока.Ссылка;
			стр.Количество=кол;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры


Процедура кнОКНажатие(Элемент)
	Закрыть(мТЗ);
КонецПроцедуры

Процедура кнPGDN_PGUP(Элемент)
	этаформа.ТекущийЭлемент=Элемент.ИсточникДействий;
	глперем.ОбКомКалк.mysendkeys(Элемент.Подсказка);
КонецПроцедуры

Процедура кнВыборНажатие(Элемент)
	ТабличноеПолеВыбор(элементыформы.ТабличноеПоле, элементыформы.ТабличноеПоле.ТекущиеДанные, элементыформы.ТабличноеПоле.ТекущаяКолонка, ложь)
КонецПроцедуры


Процедура ТабличноеПолеПриАктивизацииСтроки(Элемент)
     Запрос=Новый Запрос;
	 запрос.Текст="ВЫБРАТЬ
	              |	ОстаткиТоваров.Склад Как Склад,
	              |	ВЫРАЗИТЬ(ОстаткиТоваров.КоличествоОстаток КАК ЧИСЛО) КАК Остаток
	              |ИЗ
	              |		РегистрНакопления.ОстаткиТоваров.Остатки(
	              |				&Дата,Единица = &Единица) КАК ОстаткиТоваров
	              |	";
	запрос.УстановитьПараметр("Единица",элементыформы.ТабличноеПоле.ТекущаяСтрока.ссылка);	
	запрос.УстановитьПараметр("Дата",?(ЗначениеЗаполнено(Дата),Дата,ТекущаяДата()));	
	ТПОстатки=запрос.Выполнить().Выгрузить().Скопировать();
КонецПроцедуры


Процедура ТПОстаткиПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	Если  ДанныеСтроки.склад=Склад тогда
		 ОформлениеСтроки.Шрифт=мЖирныйШрифт;
	Конецесли;
	
КонецПроцедуры
мЖирныйШрифт    = Новый Шрифт(,, Истина);