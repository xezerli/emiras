
Процедура КнопкаВыполнитьНажатие(Кнопка)
	
	ТекД = Документы.ПоступлениеТоваров.СоздатьДокумент();
	ТекД.ИнстализацияДокумента();
	ТекД.Дата = ТекущаяДата();
	ТекД.Контрагент = Контрагент;
	ТекД.Склад = Склад;
	ТекД.ТипЦен = ТипЦен;
	ТекД.ОновлениеЦены = Истина;
	ТекД.Валюта = Валюта;
	ТекД.Автор = Полизавател;
	ТекД.Курс = Курс;
	
	Попытка 
		Excel = Новый ComObject("Excel.Application");
	Исключение                
		Сообщить (ОписаниеОшибки() + "Excel не найден");
	 	Возврат; 		
	КонецПопытки;
	
	Книга = Excel.Workbooks.Open(ФайлЗагрузки);
	Лист = Книга.Worksheets(1);
	
    СтрокаКод = 0;
	СтЗаказ = "";
	НомСтр = 0;
	ВсегоСтрок = Лист.Cells(1,1).SpecialCells(11).Row;	
	Для Строка = 3 По ВсегоСтрок Цикл
		Marka = Лист.Cells(Строка,1).Value;
		Maltipi = Лист.Cells(Строка,2).Value;
		Cins = Лист.Cells(Строка,3).Value;
		Reng = Лист.Cells(Строка,4).Value;
		Movsum = Лист.Cells(Строка,5).Value;
		Olci = Лист.Cells(Строка,6).Value;
		Kod = Лист.Cells(Строка,7).Value;
		Miqdar = Лист.Cells(Строка,10).Value;
		AlisQiymeti = Лист.Cells(Строка,13).Value;
		Mebleg = Лист.Cells(Строка,14).Value;
		Mayadeyeri = Лист.Cells(Строка,15).Value;
		Satisqiymeti = Лист.Cells(Строка,16).Value;
		Satismeblegi = Лист.Cells(Строка,17).Value;
		
		стр = ТекД.Товары.Добавить();
		
		Марка = Справочники.Марка.НайтиПоНаименованию(Marka);
		Если Марка <> Справочники.Марка.ПустаяСсылка() Тогда 
			текМарка = Марка.Ссылка;
		Иначе
			новМарка = Справочники.Марка.СоздатьЭлемент();
			новМарка.Наименование = Marka;
			новМарка.Записать();
			текМарка = новМарка.Ссылка;
		КонецЕсли;	
		
		ТипНоменклатуры = Справочники.ТипНоменклатуры.НайтиПоНаименованию(Maltipi);
		Если ТипНоменклатуры <> Справочники.ТипНоменклатуры.ПустаяСсылка() Тогда 
			текТипНоменклатуры = ТипНоменклатуры.Ссылка;
		Иначе
			новТипНоменклатуры = Справочники.ТипНоменклатуры.СоздатьЭлемент();
			новТипНоменклатуры.Наименование = Maltipi;
			новТипНоменклатуры.Записать();
			текТипНоменклатуры = новТипНоменклатуры.Ссылка;
		КонецЕсли;	
		
		Пол = Справочники.Пол.НайтиПоНаименованию(Cins);
		Если Пол <> Справочники.Пол.ПустаяСсылка() Тогда 
			текПол = Пол.Ссылка;
		Иначе
			новПол = Справочники.Пол.СоздатьЭлемент();
			новПол.Наименование = Cins;
			новПол.Записать();
			текПол = новПол.Ссылка;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Reng) Тогда 
			Цвет = Справочники.Цвет.НайтиПоНаименованию(Reng);
			Если Цвет <> Справочники.Цвет.ПустаяСсылка() Тогда 
				текЦвет = Цвет.Ссылка;
			Иначе
				новЦвет = Справочники.Цвет.СоздатьЭлемент();
				новЦвет.Наименование = Reng;
				новЦвет.Записать();
				текЦвет = новЦвет.Ссылка;
			КонецЕсли;
		Иначе
			текЦвет = "";
		КонецЕсли;	
		
		Сезон = Справочники.Сезон.НайтиПоНаименованию(Movsum);
		Если Сезон <> Справочники.Сезон.ПустаяСсылка() Тогда 
			текСезон = Сезон.Ссылка;
		Иначе
			новСезон = Справочники.Сезон.СоздатьЭлемент();
			новСезон.Наименование = Movsum;
			новСезон.Записать();
			текСезон = новСезон.Ссылка;
		КонецЕсли;
		Если ЗначениеЗаполнено(Olci) Тогда 
			Размер = Справочники.Размер.НайтиПоНаименованию(Olci);
			Если Размер <> Справочники.Размер.ПустаяСсылка() Тогда 
				текРазмер = Размер.Ссылка;
			Иначе
				новРазмер = Справочники.Сезон.СоздатьЭлемент();
				новРазмер.Наименование = Olci;
				новРазмер.Записать();
				текРазмер = новРазмер.Ссылка;
			КонецЕсли;
		Иначе
			текРазмер = "";
		КонецЕсли;
		
		стр.Марка = текМарка;
		стр.ТипНоменклатуры = текТипНоменклатуры;
		стр.Пол = текПол;
		стр.Цвет = текЦвет;
		стр.Сезон = текСезон;
		стр.Размер = текРазмер;
		стр.Артикул = Kod;
		стр.Количество = Miqdar;
		стр.Цена = AlisQiymeti;
		стр.Сумма = Mebleg;
		стр.Себестоимость = Mayadeyeri;
		стр.РознЦена = Satisqiymeti;
		стр.РознСумма = Satismeblegi;
	КонецЦикла;
	ТекД.ПолучитьФорму().Открыть();
	Excel.Quit();
КонецПроцедуры

Процедура КнопкаЗагрузкаНажатие(Элемент)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Прочитать табличный документ из файла";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.csv;*.xls;*.xlsx)|*.csv;*.xls;*.xlsx";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры
