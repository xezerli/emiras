


Процедура ПриОткрытии()
	
	
	ОбновитьЗаг();	
	Если ЗначениеЗаполнено(ПолеНаименование) или ЗначениеЗаполнено(ПолеШтрихкод) или ЗначениеЗаполнено(ПолеАртикул) тогда
		кнПоискНажатие(ЭтаФорма) ;
	Иначе
		НачальныйОтбор();
		
	КонецЕсли;
	
	РаботаСДиалогами.УстановитьФильтрПоМаркамУПользователя(ТабличноеПолеТовары);
	
	
КонецПроцедуры






Процедура кнВыборНаименованиеНажатие(Элемент)
	форма=обработки.ЭкраннаяКлавиатура.ПолучитьФорму("Форма");
	форма.режимПарола=ложь;
	выбстр=форма.ОткрытьМодально();
	если   выбстр<>неопределено тогда
		ПолеШтрихкод="";
		ПолеАртикул="";
		ПолеНаименование=выбстр;
		кнПоискНажатие(ЭтаФорма) ;
	Конецесли;
	
КонецПроцедуры




Процедура кнВыборШтрихкодНажатие(Элемент)
	форма=обработки.ЭкраннаяКлавиатура.ПолучитьФорму("Форма");
	форма.режимПарола=ложь;
	выбстр=форма.ОткрытьМодально();
	если   выбстр<>неопределено тогда
		ПолеНаименование="";
		ПолеАртикул="";
		ПолеШтрихкод=выбстр;
		кнПоискНажатие(ЭтаФорма) ;
	Конецесли;
КонецПроцедуры







Процедура кнСвернутьНажатие(Элемент)
	ВыбраннаяСтрока= ЭлементыФормы.ТабличноеПолеГруп.ТекущаяСтрока ;
	УзелРазвернут = ЭлементыФормы.ТабличноеПолеГруп.Развернут(ВыбраннаяСтрока);
	Если УзелРазвернут Тогда
		ЭлементыФормы.ТабличноеПолеГруп.Свернуть(ВыбраннаяСтрока);
	Иначе
		ЭлементыФормы.ТабличноеПолеГруп.Развернуть(ВыбраннаяСтрока);
	КонецЕсли;
	ОбновлениеИзображениекнСвернуть();
	
КонецПроцедуры

Процедура ТабличноеПолеГрупВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	УзелРазвернут = ЭлементыФормы.ТабличноеПолеГруп.Развернут(ВыбраннаяСтрока);
	Если УзелРазвернут Тогда
		ЭлементыФормы.ТабличноеПолеГруп.Свернуть(ВыбраннаяСтрока);
	Иначе
		ЭлементыФормы.ТабличноеПолеГруп.Развернуть(ВыбраннаяСтрока);
	КонецЕсли;
	ОбновлениеИзображениекнСвернуть();
КонецПроцедуры
Процедура ОбновлениеИзображениекнСвернуть()
	ВыбраннаяСтрока= ЭлементыФормы.ТабличноеПолеГруп.ТекущаяСтрока ;
	если ВыбраннаяСтрока=неопределено тогда
		возврат;
	Конецесли;
	
	УзелРазвернут = ЭлементыФормы.ТабличноеПолеГруп.Развернут(ВыбраннаяСтрока);
	Если УзелРазвернут Тогда
		ЭлементыФормы.кнСвернуть.Картинка=БиблиотекаКартинок.Развернуть;	
	Иначе
		ЭлементыФормы.кнСвернуть.Картинка=БиблиотекаКартинок.Свернуть;	
	КонецЕсли;
КонецПроцедуры


Процедура ТабличноеПолеГрупПередРазворачиванием(Элемент, Строка, Отказ)
	ОбновлениеИзображениекнСвернуть();
	
КонецПроцедуры

Процедура ТабличноеПолеГрупПередСворачиванием(Элемент, Строка, Отказ)
	ОбновлениеИзображениекнСвернуть();
	
КонецПроцедуры

Процедура ТабличноеПолеТоварыВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	СтандартнаяОбработка=ложь;
	
	
	Если РольДоступна("OperatorSatışsız") или РольДоступна("smm3") Тогда  
		Товар=ВыбраннаяСтрока.ссылка; 
		Если значениеЗаполнено(товар) Тогда
			
			ПолеМарка=Товар.Марка;
			ПолеТипНоменклатуры=Товар.ТипНоменклатуры;
			ПолеПол=Товар.Пол;
			ПолеЦвет=Товар.Цвет;
			ПолеСезон=Товар.Сезон;
			ПолеРазмер=Товар.Размер;
			ПолеАртикул=Товар.Артикул;
			
		КонецЕсли; 
		
		Возврат;
	КонецЕсли;
	
	
	
	
	Результат= Элемент.ОформлениеСтроки (ВыбраннаяСтрока.ссылка).Ячейки;
	КолонкаТабл=Колонка;
	Закрыть(1);	
КонецПроцедуры

Процедура кнВыборТоварНажатие(Элемент)
	ТабличноеПолеТоварыВыбор(элементыформы.ТабличноеПолеТовары, элементыформы.ТабличноеПолеТовары.ТекущиеДанные, элементыформы.ТабличноеПолеТовары.ТекущаяКолонка, истина);
КонецПроцедуры

Процедура кнПоискНажатие(Элемент)
	
	
	
	запрос=новый запрос;
	
	
	Запрос_Текст="ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК Остаток,
	|	ЕдиницыИзмерения.Владелец.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Склад = &Склад) КАК ОстаткиТоваровОстатки
	|		ПО ЕдиницыИзмерения.Владелец.Ссылка = ОстаткиТоваровОстатки.Товар.Ссылка
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец.Блок = ЛОЖЬ";
	
	
	нн=1;			   
	Если СтрДлина(Сокрлп(ПолеНаименование))>2 Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС +" И ЕдиницыИзмерения.Владелец.Наименование ПОДОБНО &Наименование";
		Запрос.УстановитьПараметр("Наименование", "%"+Сокрлп(ПолеНаименование)+"%");
		нн=нн+1;
	КонецЕсли; 	
	Если Сокрлп(ПолеАртикул)<>"" Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Артикул ПОДОБНО &Артикул";
		Запрос.УстановитьПараметр("Артикул", "%"+Сокрлп(ПолеАртикул)+"%");
		нн=нн+1;
	КонецЕсли; 	
	Если СтрДлина(Сокрлп(ПолеШтрихкод))>5 Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС+ " И ЕдиницыИзмерения.Штрихкод ПОДОБНО &Штрихкод";
		Запрос.УстановитьПараметр("Штрихкод", "%"+Сокрлп(ПолеШтрихкод)+"%");
		нн=нн+1;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолеМарка) Тогда
		
		Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Марка=&Марка";
		Запрос.УстановитьПараметр("Марка", ПолеМарка);
		нн=нн+1;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолеТипНоменклатуры)  Тогда
		Если ПолеТипНоменклатуры.ЭтоГруппа Тогда
			Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.ТипНоменклатуры В ИЕРАРХИИ( &ТипНоменклатуры)";
			Запрос.УстановитьПараметр("ТипНоменклатуры", ПолеТипНоменклатуры);
			нн=нн+1;
			
		Иначе
			//onların uyğunsuzlu kodudur
			//Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.ТипНоменклатуры.Наименование ПОДОБНО &ТипНоменклатуры";
			//Запрос.УстановитьПараметр("ТипНоменклатуры", "%"+Сокрлп(ПолеТипНоменклатуры)+"%");
			//mən dəyişdim bir az:
			Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.ТипНоменклатуры = &ТипНоменклатуры";
			Запрос.УстановитьПараметр("ТипНоменклатуры", ПолеТипНоменклатуры);
			
			нн=нн+1;
		КонецЕсли; 
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолеПол) Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Пол.Наименование ПОДОБНО &Пол";
		Запрос.УстановитьПараметр("Пол", "%"+Сокрлп(ПолеПол)+"%");
		нн=нн+1;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолеЦвет) Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Цвет.Наименование ПОДОБНО &Цвет";
		Запрос.УстановитьПараметр("Цвет", "%"+Сокрлп(ПолеЦвет)+"%");
		нн=нн+1;
	КонецЕсли; 
	
	//bu onların gic-gic kodudur
	//Если ЗначениеЗаполнено(ПолеРазмер) Тогда
	//	Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Размер.Наименование ПОДОБНО &Размер";
	//	Запрос.УстановитьПараметр("Размер", "%"+Сокрлп(ПолеРазмер)+"%");
	//	нн=нн+1;
	//КонецЕсли; 
	//bu isə mənim, düzəldilmiş bir az
	Если ЗначениеЗаполнено(ПолеРазмер) Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Размер = &Размер";
		Запрос.УстановитьПараметр("Размер", ПолеРазмер);
		нн=нн+1;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолеСезон) Тогда
		Запрос_Текст=Запрос_Текст+Символы.ПС+" И  ЕдиницыИзмерения.Владелец.Сезон.Наименование ПОДОБНО &Сезон";
		Запрос.УстановитьПараметр("Сезон", "%"+Сокрлп(ПолеСезон)+"%");
		нн=нн+1;
	КонецЕсли; 	
	
	
	Если нн=1 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Если ВЭтомСкладе Тогда
		Запрос_Текст=СтрЗаменить(Запрос_Текст,"//Вэтомскладе","");
	КонецЕсли;
	
	запрос.Текст=Запрос_Текст;
	СписокОтбора=новый списокзначений;
	СписокОтбора.ЗагрузитьЗначения(запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	ТабличноеПолеТовары.Отбор.Ссылка.ВидСравнения                        = ВидСравнения.ВСписке;
	ТабличноеПолеТовары.Отбор.Ссылка.Значение                            = СписокОтбора;
	ТабличноеПолеТовары.Отбор.Ссылка.Использование                       = Истина;
	
	ЭлементыФормы.ТабличноеПолеТовары.ИерархическийПросмотр                 = Ложь;
	ЭлементыФормы.ТабличноеПолеТовары.НастройкаОтбора.Ссылка.Доступность    = Истина;
	ЭлементыФормы.ТабличноеПолеТовары.НастройкаОтбора.ЭтоГруппа.Доступность = Истина;
	ЭлементыФормы.ТабличноеПолеТовары.ПросмотрГруппИЭлементов            = ИспользованиеГруппИЭлементов.Элементы;
	
	ТекущийЭлемент = ЭлементыФормы.ТабличноеПолеТовары;
	
	
	
	
	
КонецПроцедуры
Процедура ТабличноеПолеГрупПриАктивизацииСтроки(Элемент)
	ОбновлениеИзображениекнСвернуть();
	//Дмитрий Бабинцев ----
	ВыбСтрока = ЭлементыФормы.ТабличноеПолеГруп.ТекущиеДанные;
	Если (ВыбСтрока <> Неопределено) Тогда
		ТабличноеПолеТовары.Отбор.Ссылка.ВидСравнения = ВидСравнения.ВИерархии;
		ТабличноеПолеТовары.Отбор.Ссылка.Значение = ВыбСтрока.Ссылка;
		ТабличноеПолеТовары.Отбор.Ссылка.Использование = Истина;
	КонецЕсли;
КонецПроцедуры


Процедура ТабличноеПолеТоварыПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	если ДанныеСтроки=неопределено тогда
		возврат;
	КонецЕсли;
	
	товар=ДанныеСтроки.Ссылка; 
	Если РольДоступна("smm3") Тогда
		//əvvəlki kod
		//остаток=регистрынакопления.ОстаткиТоваров.Остатки(,Новый Структура("Товар",Товар),,"Количество");
		//если остаток.Количество()>0 тогда
		//	ОформлениеСтроки.Ячейки.Остаток.Значение=""+ остаток.Итог("Количество")+Символы.ПС+товар.БазоваяЕдиница;
		//Конецесли;
		
		//Dmitriyin kodu:
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&Дата,
		|			Склад = &Склад
		|				И Товар = &Товар) КАК ТоварыНаСкладахОстатки";
		
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Товар", Товар);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ОформлениеСтроки.Ячейки.Остаток.Значение=""+ ВыборкаДетальныеЗаписи.Количество+Символы.ПС+товар.БазоваяЕдиница;
		Конецесли;

		
	ИначеЕсли   РольДоступна("GM02") или РольДоступна("Onlayn") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ОстаткиТоваровОстатки.КоличествоОстаток) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&Дата,
		|			Товар = &Товар
		|				И Склад В (&Отб)) КАК ОстаткиТоваровОстатки";
		
		Отб=новый СписокЗначений;
		Отб.Добавить(Справочники.Склады.НайтиПоКоду(2));
		Отб.Добавить(Справочники.Склады.НайтиПоКоду(14));
		
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("Отб", Отб);
		Запрос.УстановитьПараметр("Товар", Товар);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка  = РезультатЗапроса.Выбрать();
		остаток=0;
		Если Выборка.Следующий() Тогда
			остаток=Выборка.Остаток;
		КонецЕсли;;
		
		если остаток >0 тогда
			ОформлениеСтроки.Ячейки.Остаток.Значение=""+ остаток+Символы.ПС+товар.БазоваяЕдиница;
		Конецесли;
	ИначеЕсли   РольДоступна("GM01") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ОстаткиТоваровОстатки.КоличествоОстаток) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&Дата,
		|			Товар = &Товар
		|				И Склад НЕ В (&Отб)) КАК ОстаткиТоваровОстатки";
		
		Отб=новый СписокЗначений;
		Отб.Добавить(Справочники.Склады.НайтиПоКоду(2));
		Отб.Добавить(Справочники.Склады.НайтиПоКоду(14));
		
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("Отб", Отб);
		Запрос.УстановитьПараметр("Товар", Товар);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка  = РезультатЗапроса.Выбрать();
		остаток=0;
		Если Выборка.Следующий() Тогда
			остаток=Выборка.Остаток;
		КонецЕсли;;
		
		если остаток >0 тогда
			ОформлениеСтроки.Ячейки.Остаток.Значение=""+ остаток+Символы.ПС+товар.БазоваяЕдиница;
		Конецесли;
		
	иначе
		//əvvəlki kodu:
		//остаток=регистрынакопления.ОстаткиТоваров.Остатки(,Новый Структура("Склад,Товар",Склад,Товар),,"Количество");
		//если остаток.Количество()>0 тогда
		//ОформлениеСтроки.Ячейки.Остаток.Значение=""+ остаток[0].Количество+Символы.ПС+товар.БазоваяЕдиница;
		
		
		//Dmitriyin kodu:
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&Дата,
		|			Склад = &Склад
		|				И Товар = &Товар) КАК ТоварыНаСкладахОстатки";
		
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Товар", Товар);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ОформлениеСтроки.Ячейки.Остаток.Значение=""+ ВыборкаДетальныеЗаписи.Количество+Символы.ПС+товар.БазоваяЕдиница;
		Конецесли;
		
	КонецЕсли;
	
	
	
	
	запрос=новый запрос;
	запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 2
	             |	ЕдиницыИзмерения.Ссылка КАК Единица,
	             |	ЦеныНоменклатурыСрезПоследних.Цена,
	             |	ЦеныНоменклатурыСрезПоследних.Валюта
	             |ИЗ
	             |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	             |				,
	             |				ТипЦен = &ТипЦен
	             |					И Номенклатура = &Номенклатура
	             |					И (&ПоВсемСкладам
	             |						ИЛИ Склад = &Склад)) КАК ЦеныНоменклатурыСрезПоследних
	             |		ПО ЕдиницыИзмерения.Владелец = ЦеныНоменклатурыСрезПоследних.Номенклатура
	             |ГДЕ
	             |	ЕдиницыИзмерения.Владелец = &Номенклатура";
	запрос.УстановитьПараметр("ТипЦен",ТипЦен);
	запрос.УстановитьПараметр("Номенклатура",Товар);
	запрос.УстановитьПараметр("Склад", Склад);
	запрос.УстановитьПараметр("ПоВсемСкладам", Не ЗначениеЗаполнено(Склад));

	
	тз=запрос.Выполнить().Выгрузить();
	
	ед1="";
	ед2="";
	Вал1="";
	вал2="";
	Цена1=0;
	Цена2=0;
	если тз.количество()>0 тогда
		ед1=тз[0].Единица;
		Вал1=тз[0].Валюта;
		Цена1=тз[0].Цена;
		Цена1=?( значениезаполнено(Вал1)и значениезаполнено(Цена1) ,Цена1*МодульВалютногоУчета.ПолучитьКурсВалюты(вал1,ТекущаяДата()).курс,0);
	КонецЕсли;
	если тз.количество()>1 тогда
		ед2=тз[1].Единица;
		Вал2=тз[1].Валюта;
		Цена2=тз[1].Цена;
		Цена2=?(значениезаполнено(Вал2)и значениезаполнено(Цена2),Цена2*МодульВалютногоУчета.ПолучитьКурсВалюты(вал2,ТекущаяДата()).курс,0);
		
	КонецЕсли;
	если не значениезаполнено(Цена1)и значениеЗаполнено(ед2) тогда  
		если  значениезаполнено(Цена2) тогда
			Цена1=окр(Цена2/ед2.Коэффициент*ед1.Коэффициент,2,1);
		Конецесли;
	КонецЕсли;
	если не значениезаполнено(Цена2) и значениеЗаполнено(ед1)и значениеЗаполнено(ед2) тогда  
		если  значениезаполнено(Цена1) тогда
			Цена2=окр(Цена1/ед1.Коэффициент*ед2.Коэффициент,2,1);
		Конецесли;
	КонецЕсли;
	если значениеЗаполнено(ед1) тогда
		СписокЕД=новый СписокЗначений;
		СписокЕД.Вставить(0,Ед1,Ед1.наименование);
		СписокЕД.Вставить(1,Цена1,?(Цена1=0," ",Символы.ПС+сокрлп(формат(цена1,"ЧЦ=15; ЧДЦ=2; ЧРД=."))+" "+Сокрлп(глперем.манат)));
		ОформлениеСтроки.Ячейки.Ед1.Значение =СписокЕД;
	КонецЕсли;
	//если значениеЗаполнено(ед2) тогда
	//	СписокЕД=новый СписокЗначений;
	//	СписокЕД.Вставить(0,Ед2,Ед2.наименование);
	//	СписокЕД.Вставить(1,Цена2,?(Цена2=0," ",Символы.ПС+сокрлп(формат(цена2,"ЧЦ=15; ЧДЦ=2; ЧРД=."))+" "+Сокрлп(глперем.манат)));
	//	ОформлениеСтроки.Ячейки.Ед2.Значение =СписокЕД;
	//КонецЕсли;
	
	
	
	
	
	
	
	
	
	
	
КонецПроцедуры


Функция ЦенаСоСкидкой(Товар,Цена)
	
	
	АтоматимескаяСкидка=0;
	Запрос=новый запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	СкидкиПоНоменклатуреСрезПоследних.Товар,
	|	СкидкиПоНоменклатуреСрезПоследних.СкидкаПроцент,
	|	СкидкиПоНоменклатуреСрезПоследних.СкидкаЦена,
	|	СкидкиПоНоменклатуреСрезПоследних.ЦенасоСкидкой
	|ИЗ
	|	РегистрСведений.СкидкиПоНоменклатуре.СрезПоследних(
	|			&Период,
	|			Товар = &Товар
	|				И ДатаОкончания >= &ДатаОкончания
	|				И Период < &ДатаОкончания
	|				И (Склад = &Склад
	|					ИЛИ Склад ЕСТЬ NULL
	|					ИЛИ Склад = &СкладПустой)) КАК СкидкиПоНоменклатуреСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкидкиПоНоменклатуреСрезПоследних.Период УБЫВ";
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("СкладПустой", Справочники.Склады.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("ДатаОкончания", ТекущаяДата());
	АтоматимескаяСкидкаТовара = Запрос.Выполнить().Выгрузить();
	
	Попытка
		Если ЗначениеЗаполнено(АтоматимескаяСкидкаТовара[0].СкидкаПроцент) Тогда
			АтоматимескаяСкидка = АтоматимескаяСкидкаТовара[0].СкидкаПроцент;
		ИначеЕсли ЗначениеЗаполнено(АтоматимескаяСкидкаТовара[0].ЦенасоСкидкой) Тогда
			Возврат АтоматимескаяСкидкаТовара[0].ЦенасоСкидкой;
		ИначеЕсли Цена<>0 Тогда 
			
			Возврат (Цена-АтоматимескаяСкидкаТовара[0].СкидкаЦена);
			
		КонецЕсли;
	Исключение КонецПопытки;
	
	
	
	ценаСоСкидкой=Окр(цена*(1-АтоматимескаяСкидка/100),0,2);
	
	Возврат  ценаСоСкидкой;
	
КонецФункции




