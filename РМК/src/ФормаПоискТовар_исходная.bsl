		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиТоваровОстатки.КоличествоОстаток / ОстаткиТоваровОстатки.Товар.ОсновнаяЕдиница.Коэффициент КАК Количество,
		|	ОстаткиТоваровОстатки.Склад.Ссылка КАК Склад,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар) КАК ОстаткиТоваровОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Товар) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ОстаткиТоваровОстатки.Склад = ЦеныНоменклатурыСрезПоследних.Склад
		|			И ОстаткиТоваровОстатки.Товар = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|ГДЕ
		|	ОстаткиТоваровОстатки.КоличествоОстаток > 0
		|	И ОстаткиТоваровОстатки.Склад <> &Склад
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОстаткиТоваровОстатки.Склад.Наименование";
		
		
		Запрос.УстановитьПараметр("Товар", стр.ссылка);
		Запрос.УстановитьПараметр("Склад", Склад);
		
		
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	ТПостатки=Результат.Выгрузить();
	
	
	
	
	запрос=новый запрос;
	запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 2
	             |	ЕдиницыИзмерения.Ссылка КАК Единица,
	             |	ЦеныНоменклатурыСрезПоследних.Цена,
	             |	ЦеныНоменклатурыСрезПоследних.Валюта
	             |ИЗ
	             |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	             |				,
	             |				ТипЦен = &ТипЦен
	             |					И Номенклатура = &Номенклатура
	             |					И (&ПоВсемСкладам
	             |						ИЛИ Склад = &Склад)) КАК ЦеныНоменклатурыСрезПоследних
	             |		ПО ЕдиницыИзмерения.Ссылка = ЦеныНоменклатурыСрезПоследних.Единица
	             |ГДЕ
	             |	ЕдиницыИзмерения.Владелец = &Номенклатура";
	запрос.УстановитьПараметр("ТипЦен",ТипЦен);
	запрос.УстановитьПараметр("Номенклатура",стр.ссылка);
	
	запрос.УстановитьПараметр("Склад", Склад);
	запрос.УстановитьПараметр("ПоВсемСкладам", Не ЗначениеЗаполнено(Склад));
	
	тз=запрос.Выполнить().Выгрузить();
	
	ед1="";
	ед2="";
	Вал1="";
	вал2="";
	Цена1=0;
	Цена2=0;
	если тз.количество()>0 тогда
		ед1=тз[0].Единица;
		Вал1=тз[0].Валюта;
		Цена1=тз[0].Цена;
		Цена1=?( значениезаполнено(Вал1)и значениезаполнено(Цена1) ,Цена1*МодульВалютногоУчета.ПолучитьКурсВалюты(вал1,ТекущаяДата()).курс,0);
	КонецЕсли;
	если тз.количество()>1 тогда
		ед2=тз[1].Единица;
		Вал2=тз[1].Валюта;
		Цена2=тз[1].Цена;
		Цена2=?(значениезаполнено(Вал2)и значениезаполнено(Цена2),Цена2*МодульВалютногоУчета.ПолучитьКурсВалюты(вал2,ТекущаяДата()).курс,0);
		
	КонецЕсли;
	если не значениезаполнено(Цена1)и значениеЗаполнено(ед2) тогда  
		если  значениезаполнено(Цена2) тогда
			Цена1=окр(Цена2/ед2.Коэффициент*ед1.Коэффициент,2,1);
		Конецесли;
	КонецЕсли;
	
	
	ЦенаСк= ЦенаСоСкидкой(стр.ссылка,Цена1);
	
	ЭлементыФормы.НадписьЦена.Заголовок=""+формат(ЦенаСк,"ЧЦ=15; ЧДЦ=2; ЧРД=.");
	
	
КонецПроцедуры


