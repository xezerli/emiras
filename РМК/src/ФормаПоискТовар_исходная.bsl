Процедура НачальныйОтбор()
	
	
	Если не ВЭтомСкладе Тогда
		ТабличноеПолеТовары.Отбор.Сбросить();
		ТабличноеПолеТовары.Отбор.Ссылка.Использование = Ложь;
		
		ЭлементыФормы.ТабличноеПолеТовары.ИерархическийПросмотр   = Истина;
		ЭлементыФормы.ТабличноеПолеТовары.ПросмотрГруппИЭлементов = ИспользованиеГруппИЭлементов.Элементы;
		
		Возврат;
	КонецЕсли;
	
	
	запрос=новый запрос;
	Запрос_Текст="ВЫБРАТЬ
	|	ОстаткиТоваров.Товар.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Склад = &Склад) КАК ОстаткиТоваров
	|ГДЕ
	|	ОстаткиТоваров.КоличествоОстаток > 0";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	запрос.Текст=Запрос_Текст;
	ТаблицаОстатков = запрос.Выполнить().Выгрузить();
	МассивСсылок = ТаблицаОстатков.ВыгрузитьКолонку("Ссылка");
	СписокОтбора=новый списокзначений;
	СписокОтбора.ЗагрузитьЗначения(МассивСсылок);
	ТабличноеПолеТовары.Отбор.Ссылка.ВидСравнения                        = ВидСравнения.ВСписке;
	ТабличноеПолеТовары.Отбор.Ссылка.Значение                            = СписокОтбора;
	ТабличноеПолеТовары.Отбор.Ссылка.Использование                       = Истина;
	
	//ЭлементыФормы.ТабличноеПолеТовары.ИерархическийПросмотр                 = Ложь;
	ЭлементыФормы.ТабличноеПолеТовары.НастройкаОтбора.Ссылка.Доступность    = Истина;
	ЭлементыФормы.ТабличноеПолеТовары.НастройкаОтбора.ЭтоГруппа.Доступность = Истина;
	ЭлементыФормы.ТабличноеПолеТовары.ПросмотрГруппИЭлементов            = ИспользованиеГруппИЭлементов.Элементы;
	
	ТекущийЭлемент = ЭлементыФормы.ТабличноеПолеТовары;
	
	
	
	
	
КонецПроцедуры


