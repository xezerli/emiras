		Возврат;
	КонецЕсли;
	товары.Сортировать("Цена Убыв");
	безск=колвс-Цел(колвс/2);
	
	кол=0;
	СуммаСкидки=0;
	Суммавсего=0;
	Для каждого стр из товары цикл
		Если не ПроверитьУсловия(стр,Компания) Тогда
			Продолжить;
		КонецЕсли;
		
		кол=кол+1;
		стр.АвтоматимескаяСкидка=0;
		стр.процентскидки=0;
		стр.Скидка=0;				
		стр.сумма=стр.цена*стр.количество;
		Суммавсего=Суммавсего+стр.сумма;
		Если кол<=безск Тогда
			Продолжить;
		КонецЕсли;
		СуммаСкидки=СуммаСкидки+стр.сумма;
		
	КонецЦикла;
	АвтоСкидка=СуммаСкидки*100/Суммавсего;
	Для каждого стр из товары цикл
		Если не ПроверитьУсловия(стр,Компания) Тогда
			Продолжить;
		КонецЕсли;
		
		стр.АвтоматимескаяСкидка=АвтоСкидка;
		стр.процентскидки=0;
		ценаСоСкидкой=стр.цена*(1-стр.АвтоматимескаяСкидка/100);
		стр.сумма=ценаСоСкидкой*стр.количество;
		
		стр.скидка=стр.цена*стр.количество*стр.АвтоматимескаяСкидка/100;
		
	КонецЦикла;
    стр.сумма=стр.сумма-(Товары.Итог("Сумма")-Окр(Товары.Итог("Сумма"),Компания.Точность));	
КонецПроцедуры



Процедура КомпанияПроцентСкидки(Компания)
	если Компания.процент<=0 тогда
		Возврат;
	КонецЕсли;
	
	Для каждого стр из товары цикл
		Если не ПроверитьУсловия(стр,Компания) Тогда
			Продолжить;
		КонецЕсли;
		
		стр.процентскидки=Компания.Процент;
		РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,"ПроцентСкидки");

	КонецЦикла;
	стр.сумма=стр.сумма-(Товары.Итог("Сумма")-Окр(Товары.Итог("Сумма"),Компания.Точность));	

КонецПроцедуры



Процедура КомпанияВторомуЦена(Компания)
	
	таб=новый ТаблицаЗначений;
	таб.Колонки.Добавить("Товар");
	таб.Колонки.Добавить("Цена");
	кол=0;
	Для каждого стр из товары цикл
		Если не ПроверитьУсловия(стр,Компания) Тогда
			Продолжить;
		КонецЕсли;
		
		кол=кол+1; 			
		Если стр.Количество>1 тогда
			для н=2 по  стр.Количество цикл 
				
				новстр=товары.Добавить();
				ЗаполнитьЗначенияСвойств(новстр,стр);
				новстр.Количество=1;
				РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,новстр,"Количество");
				
			КонецЦикла;
			
			стр.Количество=1;
			РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,"Количество");
			
		КонецЕсли;
	КонецЦикла;
	Если Товары.Количество()<2 тогда
		Возврат;
	КонецЕсли;
	товары.Сортировать("Цена Убыв");
	безск=Цел(кол/2);
	Если безск<(кол/2) Тогда 
		безск=безск+1;   
	КонецЕсли;
	кол=0;
	Для каждого стр из товары цикл
		Если не ПроверитьУсловия(стр,Компания) Тогда
			Продолжить;
		КонецЕсли;
		
		кол=кол+1;
		Если кол<=безск Тогда
			стр.АвтоматимескаяСкидка=0;
			стр.процентскидки=0;
			стр.Скидка=0;
			ценаСоСкидкой=стр.цена*(1-стр.АвтоматимескаяСкидка/100);
			стр.сумма=ценаСоСкидкой*стр.количество;
			стр.сумма=Окр(стр.сумма,Компания.Точность);
			Продолжить;
		КонецЕсли;
		
		  
		стр.процентскидки=0;
		Если Стр.Цена>0 Тогда
			стр.АвтоматимескаяСкидка=(Стр.Цена-Компания.Процент)*100/Стр.Цена;
		Иначе
			стр.АвтоматимескаяСкидка=100;
		КонецЕсли;
		
		ценаСоСкидкой=Компания.Процент;
		стр.сумма=ценаСоСкидкой*стр.количество;
		стр.сумма=Окр(стр.сумма,Компания.Точность);
		стр.скидка=стр.цена*стр.количество*стр.АвтоматимескаяСкидка/100;
		
		
		
	КонецЦикла;
	 стр.сумма=стр.сумма-(Товары.Итог("Сумма")-Окр(Товары.Итог("Сумма"),Компания.Точность));	

КонецПроцедуры

Процедура СкидочнаяКартаПриИзменении(Элемент)
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкидочныеКартыСрезПоследних.Контрагент,
		|	СкидочныеКартыСрезПоследних.ШтрихкодСкидки,
		|	СкидочныеКартыСрезПоследних.ПроцентСкидки
		|ИЗ
		|	РегистрСведений.СкидочныеКарты.СрезПоследних(&Дата, ШтрихкодСкидки = &ШтрихкодСкидки) КАК СкидочныеКартыСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ШтрихкодСкидки", СкидочнаяКарта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаСкидочныхКарт = РегистрыСведений.СкидочныеКарты.Выбрать(,КонецДня(Дата), Новый Структура("ШтрихкодСкидки", СкидочнаяКарта));
	
	Если ВыборкаСкидочныхКарт.Следующий() Тогда
		Если Не ЗначениеЗаполнено(ВыборкаСкидочныхКарт.Контрагент) Тогда
			МенеджерЗаписи = ВыборкаСкидочныхКарт.ПолучитьМенеджерЗаписи();
			новМенЗаписи = РегистрыСведений.СкидочныеКарты.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(новМенЗаписи, МенеджерЗаписи);
			МенеджерЗаписи.Удалить();
			ФормаСкидок = новМенЗаписи.ПолучитьФорму("ФормаЗаписи", ЭтаФорма);
			ФормаСкидок.ОткрытиеЧерезФормуПродажи = Истина;
			ФормаСкидок.ОткрытьМодально();
			//Если ФормаСкидок <> Неопределено Тогда
			//	новМенЗаписи.Контрагент = ФормаСкидок.Контрагент;				
			//	новМенЗаписи.ПроцентСкидки = новМенЗаписи.Контрагент.ПроцентСкидки;
			//	новМенЗаписи.ШтрихкодСкидки = СкидочнаяКарта;
			//	новМенЗаписи.Записать(Истина);
			//	
			//КонецЕсли; 
			
			Контрагент = новМенЗаписи.Контрагент;
			ПроцентСкидки = новМенЗаписи.ПроцентСкидки;
			
			
			
		Иначе
			
			Контрагент = ВыборкаСкидочныхКарт.Контрагент;
			ПроцентСкидки = ВыборкаСкидочныхКарт.ПроцентСкидки;
			
			
		КонецЕсли;		
		
				
	Иначе
		
		МенеджерЗаписи = РегистрыСведений.СкидочныеКарты.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ШтрихкодСкидки = СкидочнаяКарта;
		ФормаСкидок = МенеджерЗаписи.ПолучитьФорму("ФормаЗаписи", ЭтаФорма);
		ФормаСкидок.ОткрытиеЧерезФормуПродажи = Истина;
		ФормаСкидок.ОткрытьМодально();

		//МенеджерЗаписи.Контрагент = ФормаСкидок.Контрагент;
		//МенеджерЗаписи.ПроцентСкидки = МенеджерЗаписи.Контрагент.ПроцентСкидки;
		//МенеджерЗаписи.Записать(Истина);
		
		Контрагент = МенеджерЗаписи.Контрагент;
		ПроцентСкидки = МенеджерЗаписи.Контрагент.ПроцентСкидки;


		
	КонецЕсли;
	
	
