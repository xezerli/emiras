Процедура ВводТовара(Товар,Цена)
	
	Едизм=   Товар.ОсновнаяЕдиница;
	Штрихкод= Товар.Штрихкод;
	
	если Товар.ОсновнаяЕдиница<> Товар.БазоваяЕдиница  Тогда
		выбедфор=ПолучитьФорму("ФормаВыбораЕдиница");
		выбедфор.Товар=Товар;
		выбедфор.ТипЦен=ТипЦен;
		выбедфор.Валюта=Валюта;
		выбедфор.Курс=Курс;
		выбедфор.Дата=Дата;
		
		Едизм=выбедфор.ОткрытьМодально();
	КонецЕсли;
	
	Если Едизм=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	
	
	Если  Едизм<>Товар.ОсновнаяЕдиница Тогда
		
		СтуктураЦена=УправлениеНоменклатурой.ПолучитьСтруктураЦена(Товар,ТипЦен,Едизм,Дата);
		Если СтуктураЦена<>Неопределено Тогда
			ЦенаЦены=СтуктураЦена.Цена;
			ЕдЦены= СтуктураЦена.Единица;
			ВалютаЦены=СтуктураЦена.Валюта;
			ЦенаЦены= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(Едизм.Коэффициент*ЦенаЦены/ЕдЦены.Коэффициент,ВалютаЦены,Валюта,Дата,Курс);
			Цена=ЦенаЦены;
		КонецЕсли; 
	КонецЕсли;
	кол=1;  
	кол=ВводКоличествоТовара(кол,,3,НСтр("az = 'Miqdar daxil edin!'; ru = 'Введите количество!'"),Товар,Цена,Едизм);
	Если не значениезаполнено(кол) Тогда
		возврат;
	КонецЕсли; 
	
	
	//МассивСтрок=Товары.НайтиСтроки(Новый Структура("Товар, Единица", товар,Едизм));
	
	остаток=УправлениеЗапасами.ОстатокТовара( Текущаядата(),товар, Склад);;
	
	//Если МассивСтрок.количество()>0 Тогда
	//	стр=МассивСтрок[0];
	//Иначе
	стр=товары.Добавить();
	стр.Единица=Едизм;
	стр.Коэффициент=стр.Единица.Коэффициент;
	стр.Товар=Товар;
	стр.Цена=Цена;
	стр.ПроцентСкидки=ПроцентСкидки;
	//КонецЕсли; 
	стр.Количество=стр.Количество+кол;
	стр.Остаток=остаток/Едизм.коэффициент;;
	РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,"Количество");
	элементыформы.Товары.ТекущаяСтрока=стр;
	элементыформы.Товары.ТекущаяКолонка=Элементыформы.Товары.Колонки.Количество;
	
	
	
КонецПроцедуры

Процедура ДобавитьТоварНажатие(ПолеНаименование="",ПолеШтрихкод="",ПолеАртикул="")
	ФормаФилтр=ПолучитьФорму("ФормаПоискТовар");
	ФормаФилтр.склад=Склад;
	ФормаФилтр.ТипЦен=ТипЦен;
