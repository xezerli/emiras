Функция ПолучитьЦеныИОстатки(СписокТовары)
	запрос=новый запрос;
	запрос.Текст="ВЫБРАТЬ
	|	ЕдиницыИзмерения.Владелец КАК Товар,
	|	ЕдиницыИзмерения.Ссылка КАК Единица,
	|	Выразить (ЦеныНоменклатурыСрезПоследних.Цена как число) как цена,
	|	ЦеныНоменклатурыСрезПоследних.Валюта,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Дата,
	|				ТипЦен = &ТипЦен
	|					 ) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО (ЦеныНоменклатурыСрезПоследних.Единица = ЕдиницыИзмерения.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&Дата,
	|				Склад = &Склад
	|					 ) КАК ТоварыНаСкладахОстатки
	|		ПО ЕдиницыИзмерения.Владелец = ТоварыНаСкладахОстатки.Товар
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец.родитель= (&СписокТовары)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕдиницыИзмерения.Код
	|ИТОГИ
	|	СУММА(КоличествоОстаток)
	|ПО
	|	Товар";
	
	запрос.Параметры.Вставить("Дата",ТекущаяДата());
	запрос.Параметры.Вставить("ТипЦен",ТипЦен);
	запрос.Параметры.Вставить("СписокТовары",СписокТовары);
	запрос.Параметры.Вставить("Склад",Склад);
	возврат запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса .ПоГруппировкам);
	
КонецФункции

