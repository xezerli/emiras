Процедура кнПодтвердитьНажатие(Элемент)
	
	колонка= Элементыформы.Товары.ТекущаяКолонка;
	
	Если (не ПолныеПрава.ПроверитьДоступ(Автор,колонка.Имя)) И колонка.Имя<>"Количество" Тогда
		АктивКолонка=Неопределено;
		ПолеЗначение="";
		позТочка=0;
		флПервыйНажатие=Истина;
		ЭлементыФормы.ПолеЗначение.Видимость=Ложь;
		Возврат;
	КонецЕсли;
	
	Если колонка.ЭлементУправления.ТипЗначения.Типы()[0]=тип("Число") Тогда
		АктивКолонка=колонка;
	КонецЕсли;

	
	
	
	
	Если АктивКолонка=Неопределено тогда
		возврат;
	КонецЕсли; 	
	
	зн =?(СокрЛП(ПолеЗначение)="",0, Число(СокрЛП(ПолеЗначение)));
	Если не значениезаполнено(зн) Тогда
		возврат;
	КонецЕсли; 
	
	стр=ЭлементыФормы.Товары.ТекущиеДанные;	
	Если стр=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если АктивКолонка.Имя="Количество" Тогда
		Если зн<стр.количество Тогда
			Если не ПолныеПрава.ПроверитьДоступ(Автор,"Уменшить") Тогда
				
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	
	
	
	
	стр[АктивКолонка.Имя]=зн;
	
	
	Если стр.ПроцентСкидки <> 0 Тогда
		стр.АвтоматимескаяСкидка = 0;
	КонецЕсли;
	
	
	МаксимумСкидки = Автор.МаксимумПроцентСкидки;
	
	Если ЗначениеЗаполнено(МаксимумСкидки) Тогда
		Если стр.ПроцентСкидки > МаксимумСкидки Тогда
			стр.ПроцентСкидки = МаксимумСкидки;
		КонецЕсли;
	КонецЕсли;
	

	
	РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр,АктивКолонка.Имя);
	АктивКолонка=Неопределено;
	ПолеЗначение="";
	позТочка=0;
	флПервыйНажатие=Истина;
	ЭлементыФормы.ПолеЗначение.Видимость=Ложь;
КонецПроцедуры

