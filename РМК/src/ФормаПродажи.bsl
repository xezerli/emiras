	СуммаОплата=ФормаОплата.ПолеВводаСуммаОплата-ФормаОплата.ПолеВводаСдача ;
	
	
	
	Если суммаоплата+СуммаОплатаБС<>ФормаОплата.ПолеВводаСуммаДокумента Тогда
