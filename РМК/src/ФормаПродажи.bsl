Процедура КнопкаКомпанииНажатие(Элемент)
	
	
	
	//Компании
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Компании.Ссылка,
	|	Компании.Наименование
	|ИЗ
	|	Справочник.Компании КАК Компании
	|ГДЕ
	|	Компании.ДатаНачала < &ДатаНачала
	|	И Компании.Подразделения = &Подразделения
	|	И Компании.Актив = ИСТИНА
	|	И Компании.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Компании.ДатаНачала УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаНачала", Дата);
	Запрос.УстановитьПараметр("Подразделения", Автор.Подразделения);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ст=РезультатЗапроса.Добавить();
	ст.Наименование="KOMPANİYASIZ";	
	ст.ссылка="0";
	ФК=ПолучитьФорму("ФормаВыбораКомпании");
	Фк.ЭлементыФормы.ТПК.Значение=РезультатЗапроса;
	ВыборкаКомпания=Фк.ОткрытьМодально();	
	Если ВыборкаКомпания=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	если ВыборкаКомпания.ссылка=Неопределено тогда 
		Для Каждого стр из Товары Цикл
			стр.ПроцентСкидки=0;
			РаботаСТЧДокумента.Выч_Суммы_ТЧ(этотобъект,стр);
		КонецЦикла;
		
		
	Иначе
		
		Компания=ВыборкаКомпания.ссылка;
		
		Если Компания.ТипКомпании =Перечисления.ТипКомпании.ВторомуСкидка50 Тогда
			КомпанияВторомуСкидка50(Компания);
		ИначеЕсли  Компания.ТипКомпании =Перечисления.ТипКомпании.ВторомуСкидкасПервого Тогда
			КомпанияВторомуСкидкаСПервого(Компания);
		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.ВторомуСкидка Тогда
			КомпанияВторомуСкидка(Компания);
		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.ВторомуЦена Тогда
			КомпанияВторомуЦена(Компания);

		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.ОплатиДвоих Тогда
			КомпанияОплатиДвоих(Компания);
		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.Процентотсеб Тогда
			КомпанияПроцентотсеб(Компания);
		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.СкидкаНаМагазин Тогда
			КомпанияСкидкаНамагазин(Компания);
		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.ОплатиОдного Тогда
			КомпанияОплатиОдного(Компания);	
		ИначеЕсли Компания.ТипКомпании =Перечисления.ТипКомпании.ПроцентСкидки Тогда
			КомпанияПроцентСкидки(Компания);	
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПроверитьУсловия(стр,Компания)
	Если Компания.максПроцент>0 и стр.АвтоматимескаяСкидка>Компания.максПроцент Тогда
		Возврат Ложь;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Компания.ПолФилтир) Тогда
		Если стр.Товар.Пол=Компания.ПолФилтир Тогда
			РезультатПол=Истина;
		Иначе
			РезультатПол=Ложь;
		КонецЕсли;
		
	Иначе
		РезультатПол=Истина;
	КонецЕсли;
	
	
	т=0;
	РезультатТип=Ложь;
	
	Для каждого выб из Компания.ТАБТипНоменклатураГруп цикл
		если (ЗначениеЗаполнено(выб.ТипНоменклатураГруп) и выб.ТипНоменклатураГруп.ЭтоГруппа ) Тогда
			т=т+1;
